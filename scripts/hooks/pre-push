#!/bin/sh
# 本机 pre-push hook：推送前执行内部主题检查 + 公开仓库守卫，两者都按待推送的 local_sha 检查 git 对象（不看工作树）。
# 安装：git config core.hooksPath scripts/hooks
# fail-closed：stdin 为空或格式异常、本机读不到内部清单、git 出错、解码失败或命中任何一项 → 拒绝推送。CI 不运行本 hook。
set -u
# 整体验收 r7 BLOCKER 3：把 Git 传入的 $1（远端名）与 $2（本次实际推送 URL）交给守卫；只有推往 markjin-lab/markjin-data
# 且远端 main 等于基线时才只扫新增提交，其他情况一律全量扫描。
remote=${1-}
url=${2-}
root=$(git rev-parse --show-toplevel) || exit 1
input=$(cat) || exit 1
if [ -z "$input" ]; then
  echo "pre-push: stdin 为空（E-CHECK-STDIN），推送已拒绝" >&2; exit 1
fi
# 第一步：不可变 ref 与推送目标守卫（逐条 ref，任何 git 调用失败即 exit 1，fail-closed）。
# 不可变 ref 清单：refs/heads/main 与 refs/tags/*。禁止删除；已有 tag 不得改指（含子孙提交）；main 只能快进（由 verify-raw 祖先检查保证）。
printf '%s\n' "$input" | while read -r lref lsha rref rsha; do
  [ -n "$lref" ] || continue
  immutable=
  case "$rref" in refs/heads/main|refs/tags/*) immutable=1 ;; esac
  case "$lsha" in 0000000000000000000000000000000000000000)
    [ -n "$immutable" ] && { echo "pre-push: 禁止删除不可变 ref $rref" >&2; exit 1; }
    continue ;; esac
  case "$rsha" in 0000000000000000000000000000000000000000) rsha= ;; esac
  case "$rref" in refs/tags/*)
    if [ -n "$rsha" ] && [ "$rsha" != "$lsha" ]; then echo "pre-push: 禁止改指已有 tag $rref（$rsha → $lsha）" >&2; exit 1; fi ;; esac
  typ=$(git cat-file -t "$lsha") || { echo "pre-push: git cat-file 失败（$lref），推送已拒绝" >&2; exit 1; }
  case "$typ" in commit|tag) ;; *) echo "pre-push: $lref 推送目标不是提交（$typ），推送已拒绝" >&2; exit 1 ;; esac
  git rev-parse -q --verify "$lsha^{commit}" >/dev/null || { echo "pre-push: git rev-parse 失败或 $lref 不指向提交，推送已拒绝" >&2; exit 1; }
done || { echo "pre-push: ref 守卫未通过，推送已拒绝" >&2; exit 1; }
printf '%s\n' "$input" | python3 "$root/scripts/check-internal.py" --pre-push --remote "$remote" --remote-url "$url" || { echo "pre-push: 内部主题检查未通过，推送已拒绝" >&2; exit 1; }
# 第二步 verify-raw：逐条 ref 独立检查，以 local_sha 为目标，逐提交从 git 对象读取（不看工作树、不要求是 HEAD）。
# 基线：远端 sha（已有 ref）；新 ref 且有 origin/main → git merge-base origin/main target；无 origin/main → 交给脚本回退 target^。
printf '%s\n' "$input" | while read -r lref lsha rref rsha; do
  [ -n "$lref" ] || continue
  case "$lsha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$rsha" in 0000000000000000000000000000000000000000) rsha= ;; esac
  if [ -n "$rsha" ]; then git cat-file -e "$rsha^{commit}" 2>/dev/null || { echo "pre-push: 本地缺少远端提交 $rsha，请先 fetch" >&2; exit 1; }; fi
  target=$(git rev-parse -q --verify "$lsha^{commit}") || { echo "pre-push: git rev-parse 失败（$lref），推送已拒绝" >&2; exit 1; }
  base=$rsha
  if [ -z "$base" ]; then
    om=$(git for-each-ref --format='%(objectname)' refs/remotes/origin/main) || { echo "pre-push: git for-each-ref 失败，推送已拒绝" >&2; exit 1; }
    if [ -n "$om" ]; then
      base=$(git merge-base "$om" "$target") || { echo "pre-push: git merge-base origin/main $target 失败，推送已拒绝" >&2; exit 1; }
    fi
  fi
  VERIFY_RAW_BASE= python3 "$root/scripts/verify-raw.py" ${base:+"$base"} --target "$target" >/dev/null || { echo "pre-push: verify-raw 未通过（$lref，基线 ${base:-target^}）" >&2; exit 1; }
done || { echo "pre-push: verify-raw 检查失败，推送已拒绝" >&2; exit 1; }
printf '%s\n' "$input" | python3 "$root/scripts/check-public.py" --pre-push --remote "$remote" --remote-url "$url" || { echo "pre-push: 公开仓库守卫未通过，推送已拒绝" >&2; exit 1; }

