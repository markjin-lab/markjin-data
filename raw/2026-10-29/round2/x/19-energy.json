000Z", "edit_history_tweet_ids": ["2114980294147330231"], "entities": {"hashtags": [{"end": 266, "start": 258, "tag": "Battery"}, {"end": 277, "start": 267, "tag": "SodiumIon"}], "urls": [{"display_url": "pic.x.com/jN8r94qe3H", "end": 301, "expanded_url": "https://x.com/OUTDOBATTERY/status/2114980294147330231/video/1", "media_key": "13_2114980239126519808", "start": 278, "url": "https://t.co/jN8r94qe3H"}]}, "id": "2114980294147330231", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "❄️Don’t wait for spring🏍️\nSnowy peaks. Morning light. One road calling.\n⚡Sodium-ion starting power, even at −30°C\nMeet the OUTDO Sodium-ion Motorcycle Starter Battery — made for riders who are ready to embrace the cold.\n🌄Your next ride doesn’t have to wait.\n#Battery #SodiumIon https://t.co/jN8r94qe3H", "url": "https://x.com/OUTDOBATTERY/status/2114980294147330231"}, {"author_id": "3301587667", "created_at": "2026-10-27T22:17:31.000Z", "edit_history_tweet_ids": ["2115206283045318807"], "entities": {"urls": [{"display_url": "pic.x.com/dQvKjyRiaq", "end": 303, "expanded_url": "https://x.com/42HOWAuto/status/2115206283045318807/photo/1", "media_key": "3_2115206251411861505", "start": 280, "url": "https://t.co/dQvKjyRiaq"}]}, "id": "2115206283045318807", "public_metrics": {"bookmark_count": 0, "impression_count": 204, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "CATL's sodium-ion push into European grid storage keeps stacking up.\n\nNew today: an MOU with Germany's Intilion to deploy 3 GWh of Tener Sodium storage over 5 years, across Germany, Switzerland and Austria.\n\nEuropean sodium-ion deals CATL has announced this year:\n• Alfen: 5 GWh, https://t.co/dQvKjyRiaq", "url": "https://x.com/42HOWAuto/status/2115206283045318807"}, {"author_id": "1239152789479133185", "created_at": "2026-10-28T11:34:03.000Z", "edit_history_tweet_ids": ["2115406739273109685"