{"data": [{"author_id": "188369814", "created_at": "2026-10-28T18:36:29.000Z", "edit_history_tweet_ids": ["2115513047158866156"], "entities": {"urls": [{"display_url": "x.com/NickTimiraos/s…", "end": 268, "expanded_url": "https://twitter.com/NickTimiraos/status/2115503892905730129", "start": 245, "url": "https://t.co/vZUS6GJkjl"}]}, "id": "2115513047158866156", "public_metrics": {"bookmark_count": 4, "impression_count": 17410, "like_count": 62, "quote_count": 1, "reply_count": 20, "retweet_count": 3}, "referenced_tweets": [{"id": "2115503892905730129", "type": "quoted"}], "text": "You could argue that the only signal in this markup is the change from \"solid\" to \"strong.\"\n\n\"Strong\" implies a greater growth pace than \"solid.\" What are they trying to signal by saying that the economy is moving faster?\n\nYet they didn't hike. https://t.co/vZUS6GJkjl", "url": "https://x.com/biancoresearch/status/2115513047158866156"}, {"author_id": "14096763", "created_at": "2026-10-28T18:34:32.000Z", "edit_history_tweet_ids": ["2115512557343519176"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "ORCL"}]}, "id": "2115512557343519176", "public_metrics": {"bookmark_count": 1, "impression_count": 8541, "like_count": 14, "quote_count": 1, "reply_count": 5, "retweet_count": 0}, "text": "$ORCL best day since June 1", "url": "https://x.com/TheStalwart/status/2115512557343519176"}, {"author_id": "14096763", "created_at": "2026-10-28T18:31:44.000Z", "edit_history_tweet_ids": ["2115511853639991356"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "ORCL"}]}, "id": "2115511853639991356", "public_metrics": {"bookmark_count": 0, "impression_count": 9465, "like_count": 18, "quote_count": 0, "reply_count": 5, "retweet_count": 1}, "text": "$ORCL now up over 9%", "url": "https://x.com/TheStalwart/status/2115511853639991356"}, {"author_id": "14096763", "created_at": "2026-10-28T18:28:27.000Z", "edit_history_tweet_ids": ["2115511023947985037"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "ORCL"}, {"end": 15, "start": 10, "tag": "CRWV"}]}, "id": "2115511023947985037", "public_metrics": {"bookmark_count": 3, "impression_count": 13211, "like_count": 58, "quote_count": 1, "reply_count": 8, "retweet_count": 3}, "text": "$ORCL +8%\n$CRWV +4.5%", "url": "https://x.com/TheStalwart/status/2115511023947985037"}, {"author_id": "961132338", "created_at": "2026-10-28T18:26:49.000Z", "edit_history_tweet_ids": ["2115510612902150305"], "entities": {"urls": [{"display_url": "pic.x.com/Cd5SMdBb7o", "end": 23, "expanded_url": "https://x.com/M_C_Klein/status/2115510612902150305/photo/1", "media_key": "3_2115510484615266304", "start": 0, "url": "https://t.co/Cd5SMdBb7o"}]}, "id": "2115510612902150305", "public_metrics": {"bookmark_count": 2, "impression_count": 1886, "like_count": 31, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "https://t.co/Cd5SMdBb7o", "url": "https://x.com/M_C_Klein/status/2115510612902150305"}, {"author_id": "2961589380", "created_at": "2026-10-28T18:25:57.000Z", "edit_history_tweet_ids": ["2115510395238801527"], "entities": {"mentions": [{"end": 80, "id": "15935591", "start": 71, "username": "CMEGroup"}], "urls": [{"display_url": "pic.x.com/VijhCzt8i9", "end": 118, "expanded_url": "https://x.com/LizAnnSonders/status/2115510395238801527/photo/1", "media_key": "3_2115510390725414912", "start": 95, "url": "https://t.co/VijhCzt8i9"}]}, "id": "2115510395238801527", "public_metrics": {"bookmark_count": 2, "impression_count": 9519, "like_count": 36, "quote_count": 2, "reply_count": 12, "retweet_count": 5}, "text": "Odds of a second rate hike at next month’s Fed meeting now at 86%, per @CMEGroup FedWatch Tool https://t.co/VijhCzt8i9", "url": "https://x.com/LizAnnSonders/status/2115510395238801527"}, {"author_id": "188369814", "created_at": "2026-10-28T18:18:32.000Z", "edit_history_tweet_ids": ["2115508532086968511"], "id": "2115508532086968511", "public_metrics": {"bookmark_count": 8, "impression_count": 31590, "like_count": 143, "quote_count": 1, "reply_count": 23, "retweet_count": 10}, "text": "With Cook dissenting, four different voters have voted to hike rates against the majority between this meeting and July.\n\nThe Fed hiked rates in September. The vote was 12-0 to hike rates.\n\nTells you their direction of travel.", "url": "https://x.com/biancoresearch/status/2115508532086968511"}, {"author_id": "961132338", "created_at": "2026-10-28T18:06:56.000Z", "edit_history_tweet_ids": ["2115505611245040124"], "id": "2115505611245040124", "public_metrics": {"bookmark_count": 0, "impression_count": 3025, "like_count": 37, "quote_count": 0, "reply_count": 3, "retweet_count": 5}, "text": "\"Economic activity is expanding at a strong pace...inflation remains elevated\" and the policy move is...thoughts and prayers", "url": "https://x.com/M_C_Klein/status/2115505611245040124"}, {"author_id": "2961589380", "created_at": "2026-10-28T18:06:35.000Z", "edit_history_tweet_ids": ["2115505522816283048"], "entities": {"urls": [{"display_url": "pic.x.com/As4Alzexmm", "end": 103, "expanded_url": "https://x.com/LizAnnSonders/status/2115505522816283048/photo/1", "media_key": "3_2115505520157052929", "start": 80, "url": "https://t.co/As4Alzexmm"}]}, "id": "2115505522816283048", "public_metrics": {"bookmark_count": 11, "impression_count": 13477, "like_count": 81, "quote_count": 4, "reply_count": 19, "retweet_count": 21}, "text": "No hike, but 2 dissents … here are the statement changes relative to last month https://t.co/As4Alzexmm", "url": "https://x.com/LizAnnSonders/status/2115505522816283048"}, {"author_id": "702235316812275712", "created_at": "2026-10-28T18:03:28.000Z", "edit_history_tweet_ids": ["2115504739635036622"], "entities": {"urls": [{"display_url": "pic.x.com/dY4OsqWXQf", "end": 222, "expanded_url": "https://x.com/EconBerger/status/2115504739635036622/photo/1", "media_key": "3_2115504650921332736", "start": 199, "url": "https://t.co/dY4OsqWXQf"}]}, "id": "2115504739635036622", "public_metrics": {"bookmark_count": 1, "impression_count": 3223, "like_count": 8, "quote_count": 1, "reply_count": 0, "retweet_count": 2}, "text": "Others are better suited to analyze other parts of the FOMC statement, but here's the econ part which upgraded the state of the economy, didn't touch labor market, and signaled patience on inflation https://t.co/dY4OsqWXQf", "url": "https://x.com/EconBerger/status/2115504739635036622"}, {"author_id": "961132338", "created_at": "2026-10-28T18:02:53.000Z", "edit_history_tweet_ids": ["2115504593337807003"], "id": "2115504593337807003", "public_metrics": {"bookmark_count": 1, "impression_count": 2842, "like_count": 13, "quote_count": 1, "reply_count": 2, "retweet_count": 1}, "text": "Obviously plenty of good reasons to dissent in favor of raising rates, but hard not to think that Lisa Cook may have been motivated in part by the relentless unjustified legal threats", "url": "https://x.com/M_C_Klein/status/2115504593337807003"}, {"author_id": "733647469305864195", "created_at": "2026-10-28T17:53:22.000Z", "edit_history_tweet_ids": ["2115502195512848561"], "entities": {"urls": [{"display_url": "x.com/adam_tooze/sta…", "end": 38, "expanded_url": "https://twitter.com/adam_tooze/status/2115497770610000241", "start": 15, "url": "https://t.co/lf1NlqOuur"}]}, "id": "2115502195512848561", "public_metrics": {"bookmark_count": 3, "impression_count": 7121, "like_count": 9, "quote_count": 0, "reply_count": 2, "retweet_count": 3}, "referenced_tweets": [{"id": "2115497770610000241", "type": "quoted"}], "text": "Good questions https://t.co/lf1NlqOuur", "url": "https://x.com/Brad_Setser/status/2115502195512848561"}, {"author_id": "3311286493", "created_at": "2026-10-28T17:35:47.000Z", "edit_history_tweet_ids": ["2115497770610000241"], "entities": {"urls": [{"display_url": "pic.x.com/TBaRkO969F", "end": 149, "expanded_url": "https://x.com/adam_tooze/status/2115497770610000241/photo/1", "media_key": "3_2115497587067191298", "start": 126, "url": "https://t.co/TBaRkO969F"}]}, "id": "2115497770610000241", "public_metrics": {"bookmark_count": 3, "impression_count": 13656, "like_count": 31, "quote_count": 4, "reply_count": 5, "retweet_count": 9}, "text": "How stable is the dollar in an age of “speedball capitalism”?\nWhen the AI trade unravels, does the \"profit dolla\" go with it? https://t.co/TBaRkO969F", "url": "https://x.com/adam_tooze/status/2115497770610000241"}, {"author_id": "702235316812275712", "created_at": "2026-10-28T17:33:01.000Z", "edit_history_tweet_ids": ["2115497077337948204"], "entities": {"urls": [{"display_url": "x.com/EconBerger/sta…", "end": 127, "expanded_url": "https://twitter.com/EconBerger/status/2114805377158246588", "start": 104, "url": "https://t.co/zCXTDDPbkJ"}]}, "id": "2115497077337948204", "public_metrics": {"bookmark_count": 0, "impression_count": 1381, "like_count": 4, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "referenced_tweets": [{"id": "2114805377158246588", "type": "quoted"}], "text": "At 1 PM PT / 4 PM ET today:\n\nTim Mahedy, Lord Montagu Norman and I will be discussing the FOMC meeting! https://t.co/zCXTDDPbkJ", "url": "https://x.com/EconBerger/status/2115497077337948204"}, {"author_id": "3311286493", "created_at": "2026-10-28T17:31:16.000Z", "edit_history_tweet_ids": ["2115496635522281808"], "entities": {"urls": [{"display_url": "x.com/StateDept/stat…", "end": 119, "expanded_url": "https://twitter.com/StateDept/status/2115100751223500941", "start": 96, "url": "https://t.co/D4fsxu9RFH"}]}, "id": "2115496635522281808", "public_metrics": {"bookmark_count": 12, "impression_count": 9510, "like_count": 76, "quote_count": 0, "reply_count": 6, "retweet_count": 5}, "referenced_tweets": [{"id": "2115100751223500941", "type": "quoted"}], "text": "This would seem to be an official State Department channel celebrating the Christian tradition. https://t.co/D4fsxu9RFH", "url": "https://x.com/adam_tooze/status/2115496635522281808"}, {"author_id": "3311286493", "created_at": "2026-10-28T17:29:16.000Z", "edit_history_tweet_ids": ["2115496130997842198"], "entities": {"urls": [{"display_url": "x.com/mattyglesias/s…", "end": 142, "expanded_url": "https://twitter.com/mattyglesias/status/2115444536554258638", "start": 119, "url": "https://t.co/Fm3LwXbmhw"}]}, "id": "2115496130997842198", "public_metrics": {"bookmark_count": 5, "impression_count": 8232, "like_count": 34, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2115444536554258638", "type": "quoted"}], "text": "\"Stuyvesant v. Dalton\": The discourse around these data on the makeup of the Harvard undergraduate cohort is dizzying! https://t.co/Fm3LwXbmhw", "url": "https://x.com/adam_tooze/status/2115496130997842198"}, {"author_id": "14096763", "created_at": "2026-10-28T17:24:08.000Z", "edit_history_tweet_ids": ["2115494840284729512"], "entities": {"urls": [{"display_url": "x.com/analytichegel/…", "end": 79, "expanded_url": "https://twitter.com/analytichegel/status/2115473659179757658", "start": 56, "url": "https://t.co/CaBTxkdArx"}]}, "id": "2115494840284729512", "public_metrics": {"bookmark_count": 9, "impression_count": 13601, "like_count": 44, "quote_count": 0, "reply_count": 5, "retweet_count": 2}, "referenced_tweets": [{"id": "2115473659179757658", "type": "quoted"}], "text": "I think I'm gonna write this up in the newsletter today https://t.co/CaBTxkdArx", "url": "https://x.com/TheStalwart/status/2115494840284729512"}, {"author_id": "702235316812275712", "created_at": "2026-10-28T17:18:21.000Z", "edit_history_tweet_ids": ["2115493386379727178"], "entities": {"urls": [{"display_url": "pic.x.com/1NxKlPddFI", "end": 287, "expanded_url": "https://x.com/EconBerger/status/2115493386379727178/photo/1", "media_key": "3_2115493280997847040", "start": 264, "url": "https://t.co/1NxKlPddFI"}]}, "id": "2115493386379727178", "public_metrics": {"bookmark_count": 0, "impression_count": 1239, "like_count": 4, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Morning Consult unemployment rate index spikes up in the week ending 10/24.\n\nCould be noise, in general this index has been near its lowest levels of 2026 until this week... but it does look like the labor market recovery is slowing again after a strong September https://t.co/1NxKlPddFI", "url": "https://x.com/EconBerger/status/2115493386379727178"}, {"author_id": "961132338", "created_at": "2026-10-28T17:00:42.000Z", "edit_history_tweet_ids": ["2115488944712507628"], "id": "2115488944712507628", "public_metrics": {"bookmark_count": 0, "impression_count": 2537, "like_count": 20, "quote_count": 0, "reply_count": 1, "retweet_count": 2}, "text": "Foolish me, I initially thought that the Mbappe fracas was because people were upset that his meme trivialized Mao's violence and terror", "url": "https://x.com/M_C_Klein/status/2115488944712507628"}, {"author_id": "702235316812275712", "created_at": "2026-10-28T16:52:53.000Z", "edit_history_tweet_ids": ["2115486975134449962"], "entities": {"urls": [{"display_url": "pic.x.com/fV12e0hdcb", "end": 246, "expanded_url": "https://x.com/EconBerger/status/2115486975134449962/photo/1", "media_key": "3_2115486828296036352", "start": 223, "url": "https://t.co/fV12e0hdcb"}]}, "id": "2115486975134449962", "public_metrics": {"bookmark_count": 178, "impression_count": 48322, "like_count": 391, "quote_count": 9, "reply_count": 21, "retweet_count": 36}, "text": "Indeed job postings:\n\n1/ Software development postings are rocketing upward: Y/Y growth of almost 25%.  At that pace we're about a year away from pre-COVID levels (we're recovering from a deep depression in this category). https://t.co/fV12e0hdcb", "url": "https://x.com/EconBerger/status/2115486975134449962"}, {"author_id": "3512101", "created_at": "2026-10-28T15:14:47.000Z", "edit_history_tweet_ids": ["2115462286118646203"], "entities": {"urls": [{"display_url": "x.com/whyyoutouzhele…", "end": 296, "expanded_url": "https://twitter.com/whyyoutouzhele/status/2115448501790285845", "start": 273, "url": "https://t.co/Gm8cEMNRHZ"}]}, "id": "2115462286118646203", "public_metrics": {"bookmark_count": 2, "impression_count": 4200, "like_count": 12, "quote_count": 1, "reply_count": 0, "retweet_count": 1}, "referenced_tweets": [{"id": "2115448501790285845", "type": "quoted"}], "text": "And the 划清界限 phase “On October 27, the Mbappé controversy spilled over to table tennis Olympic champion Fan Zhendong. Weibo blogger \"Xu Ji Observation\" posted an article demanding that he \"take a firm stand and cut ties swiftly,\" stating that \"this kind of idol is utterly https://t.co/Gm8cEMNRHZ", "url": "https://x.com/niubi/status/2115462286118646203"}, {"author_id": "14096763", "created_at": "2026-10-28T15:13:17.000Z", "edit_history_tweet_ids": ["2115461910720065650"], "entities": {"urls": [{"display_url": "pic.x.com/NqtMKdKQw6", "end": 296, "expanded_url": "https://x.com/TheStalwart/status/2115461910720065650/photo/1", "media_key": "3_2115461198221107200", "start": 273, "url": "https://t.co/NqtMKdKQw6"}, {"display_url": "x.com/TheStalwart/st…", "end": 320, "expanded_url": "https://twitter.com/TheStalwart/status/2115458240834162948", "start": 297, "url": "https://t.co/kjG3MLseUX"}]}, "id": "2115461910720065650", "public_metrics": {"bookmark_count": 31, "impression_count": 34727, "like_count": 193, "quote_count": 1, "reply_count": 26, "retweet_count": 13}, "referenced_tweets": [{"id": "2115458240834162948", "type": "quoted"}], "text": "Unfortunately, I can't really blame the writer for saying this. My son and I had to move seats to avoid a scuffle between two people who were on the same side! Civic engagement gives you a rush. I get it. But I'm not so sure these meetings really make for great democracy. https://t.co/NqtMKdKQw6 https://t.co/kjG3MLseUX", "url": "https://x.com/TheStalwart/status/2115461910720065650"}, {"author_id": "3039504459", "created_at": "2026-10-28T15:03:11.000Z", "edit_history_tweet_ids": ["2115459368850247985"], "entities": {"urls": [{"description": "Researchers have proposed that structural disorder can be harnessed to generate coherent, directional light from the passage of a charged particle.", "display_url": "go.aps.org/3W8bnvD", "end": 267, "expanded_url": "https://go.aps.org/3W8bnvD", "images": [{"height": 200, "url": "https://pbs.twimg.com/news_img/2115459374307069952/e2yHhU63?format=png&name=orig", "width": 200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115459374307069952/e2yHhU63?format=png&name=150x150", "width": 150}], "start": 244, "status": 200, "title": "Brewster-Anomaly Delocalization for Free-Electron Radiation", "unwound_url": "https://journals.aps.org/prl/abstract/10.1103/fkp4-9l19", "url": "https://t.co/dUNuQsY7zY"}, {"display_url": "pic.x.com/akPai83Zbj", "end": 291, "expanded_url": "https://x.com/PhysRevLett/status/2115459368850247985/photo/1", "media_key": "3_2115459366174265344", "start": 268, "url": "https://t.co/akPai83Zbj"}]}, "id": "2115459368850247985", "public_metrics": {"bookmark_count": 8, "impression_count": 1155, "like_count": 12, "quote_count": 0, "reply_count": 0, "retweet_count": 2}, "text": "Scientists leverage the Brewster anomaly to bypass the limitations of Anderson localization and enable intensely directional free-electron radiation — a theoretical finding that could enable simple and scalable radiative platforms.\n\nRead more: https://t.co/dUNuQsY7zY https://t.co/akPai83Zbj", "url": "https://x.com/PhysRevLett/status/2115459368850247985"}, {"author_id": "14096763", "created_at": "2026-10-28T14:58:42.000Z", "edit_history_tweet_ids": ["2115458240834162948"], "entities": {"urls": [{"description": "Plus, more news for your humpday.", "display_url": "hellgatenyc.com/cb3-tompkins-c…", "end": 77, "expanded_url": "https://hellgatenyc.com/cb3-tompkins-calisthenics-gym/", "images": [{"height": 900, "url": "https://pbs.twimg.com/news_img/2115446097967562752/PmnqUUQO?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115446097967562752/PmnqUUQO?format=jpg&name=150x150", "width": 150}], "start": 54, "status": 200, "title": "East Village Pull-Up Bar Preservationists Test the Limits of Democracy", "unwound_url": "https://hellgatenyc.com/cb3-tompkins-calisthenics-gym/", "url": "https://t.co/AYiHT7lNXy"}, {"display_url": "pic.x.com/It2FQ5TNbU", "end": 101, "expanded_url": "https://x.com/TheStalwart/status/2115458240834162948/photo/1", "media_key": "3_2115458237398994944", "start": 78, "url": "https://t.co/It2FQ5TNbU"}]}, "id": "2115458240834162948", "public_metrics": {"bookmark_count": 11, "impression_count": 42961, "like_count": 47, "quote_count": 2, "reply_count": 6, "retweet_count": 2}, "text": "Writeup of last night's community meeting in Hellgate https://t.co/AYiHT7lNXy https://t.co/It2FQ5TNbU", "url": "https://x.com/TheStalwart/status/2115458240834162948"}, {"author_id": "2961589380", "created_at": "2026-10-28T14:54:02.000Z", "edit_history_tweet_ids": ["2115457067695690182"], "entities": {"urls": [{"display_url": "x.com/thestalwart/st…", "end": 31, "expanded_url": "https://twitter.com/thestalwart/status/2115247642049486943", "start": 8, "url": "https://t.co/5Z69s1Z4iy"}]}, "id": "2115457067695690182", "public_metrics": {"bookmark_count": 0, "impression_count": 16581, "like_count": 66, "quote_count": 1, "reply_count": 12, "retweet_count": 1}, "referenced_tweets": [{"id": "2115247642049486943", "type": "quoted"}], "text": "So true https://t.co/5Z69s1Z4iy", "url": "https://x.com/LizAnnSonders/status/2115457067695690182"}], "includes": {"users": [{"id": "188369814", "name": "Jim Bianco", "username": "biancoresearch"}, {"id": "14096763", "name": "Joe Weisenthal", "username": "TheStalwart"}, {"id": "961132338", "name": "Matthew C. Klein", "username": "M_C_Klein"}, {"id": "2961589380", "name": "Liz Ann Sonders", "username": "LizAnnSonders"}, {"id": "702235316812275712", "name": "Guy Berger", "username": "EconBerger"}, {"id": "733647469305864195", "name": "Brad Setser", "username": "Brad_Setser"}, {"id": "3311286493", "name": "Adam Tooze", "username": "adam_tooze"}, {"id": "3512101", "name": "Bill Bishop", "username": "niubi"}, {"id": "3039504459", "name": "Physical Review Letters", "username": "PhysRevLett"}]}, "meta": {"newest_id": "2115513047158866156", "next_token": "b26v89c19zqg8o3juzlxo2eaio6wky5iav4kp1f9zjzi5", "oldest_id": "2115457067695690182", "result_count": 25}}
