{"data": [{"author_id": "14096763", "created_at": "2026-10-28T11:23:54.000Z", "edit_history_tweet_ids": ["2115404183826583865"], "entities": {"urls": [{"description": "Israeli Prime Minister Benjamin Netanyahu edged past opposition leader Gadi Eisenkot in the country’s tight election with more than 70% of the votes counted, though neither yet has a clear path toward forming a government.", "display_url": "bloomberg.com/news/articles/…", "end": 278, "expanded_url": "https://www.bloomberg.com/news/articles/2026-10-28/israeli-vote-too-close-to-call-between-netanyahu-and-eisenkot?srnd=homepage-americas&sref=vuYGislZ", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2115404185130971137/2t60J3Ht?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115404185130971137/2t60J3Ht?format=jpg&name=150x150", "width": 150}], "start": 255, "status": 200, "title": "Netanyahu Leads Eisenkot With Over Half Israel Votes Counted", "unwound_url": "https://www.bloomberg.com/news/articles/2026-10-28/israeli-vote-too-close-to-call-between-netanyahu-and-eisenkot?srnd=homepage-americas&sref=vuYGislZ", "url": "https://t.co/k40bT4QF7W"}, {"display_url": "pic.x.com/CJ85nQalpw", "end": 302, "expanded_url": "https://x.com/TheStalwart/status/2115404183826583865/photo/1", "media_key": "3_2115404018683879424", "start": 279, "url": "https://t.co/CJ85nQalpw"}]}, "id": "2115404183826583865", "public_metrics": {"bookmark_count": 92, "impression_count": 262891, "like_count": 649, "quote_count": 24, "reply_count": 16, "retweet_count": 75}, "text": "Israeli opposition leader theoretically has enough seats to oust Netanyahu. The problem is he'd need the support from the Arab parties. And if they join government, then the non-Arab parties will no longer support him. \n\nShekel worst performing currency\n\nhttps://t.co/k40bT4QF7W https://t.co/CJ85nQalpw", "url": "https://x.com/TheStalwart/status/2115404183826583865"}, {"author_id": "2961589380", "crea