status/2114827975971479686"}, {"author_id": "1165159200470650881", "created_at": "2026-10-26T22:10:38.000Z", "edit_history_tweet_ids": ["2114842163033129118"], "id": "2114842163033129118", "public_metrics": {"bookmark_count": 0, "impression_count": 108, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Blocks and Files reported on October 26 that Micron has built cross-host KV cache sharing into Nvidia Dynamo and run it on CXL shared memory.\n\nThe cluster is called Great Abaco. A Micron team is building it for the US Department of Energy's Pacific Northwest National Laboratory.", "url": "https://x.com/AIQuanting/status/2114842163033129118"}, {"author_id": "2105726409847267328", "created_at": "2026-10-26T20:56:19.000Z", "edit_history_tweet_ids": ["2114823461285794242"], "entities": {"hashtags": [{"end": 209, "start": 200, "tag": "Anyscale"}, {"end": 225, "start": 210, "tag": "RayDistributed"}, {"end": 230, "start": 226, "tag": "GPU"}, {"end": 239, "start": 231, "tag": "AIInfra"}, {"end": 246, "start": 240, "tag": "MLOps"}, {"end": 263, "start": 247, "tag": "DataEngineering"}], "mentions": [{"end": 120, "id": "1173110913517281280", "start": 104, "username": "anyscalecompute"}, {"end": 132, "id": "2043072395754233857", "start": 125, "username": "Xoople"}], "urls": [{"display_url": "pic.x.com/fSsYs9XVjr", "end": 287, "expanded_url": "https://x.com/Marlon1B2t/status/2114823461285794242/photo/1", "media_key": "3_2114823441337692160", "start": 264, "url": "https://t.co/fSsYs9XVjr"}, {"display_url": "pic.x.com/fSsYs9XVjr", "end": 287, "expanded_url": "https://x.com/Marlon1B2t/status/2114823461285794242/photo/1", "media_key": "3_2114823441304162304", "start": 264, "url": "https://t.co/fSsYs9XVjr"}]}, "id": "2114823461285794242", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Most multimodal training clusters aren't compute-bound—they're starved at the CPU-to-GPU data handoff:\n\n@AnyscaleCompute cut @Xoople's satellite training epoch times 5x via Ray data pipeline tuning.\n\n#Anyscale #RayDistributed #GPU #AIInfra #MLOps #DataEngineering https://t.co/fSsYs9XVjr", "url": "https://x.com/Marlon1B2t/status/2114823461285794242"}, {"author_id": "3325702470", "created_at": "2026-10-26T22:55:03.000Z", "edit_history_tweet_ids": ["2114853340202815892"], "entities": {"mentions": [{"end": 16, "id": "389024932", "start": 0, "username": "Molly_J_Presley"}, {"end": 61, "id": "979407030363439104", "start": 45, "username": "Hammerspace_Inc"}, {"end": 83, "id": "809273", "start": 76, "username": "Oracle"}, {"end": 108, "id": "61559439", "start": 101, "username": "nvidia"}], "urls": [{"description": "October 25 – 28, 2026 | Las Vegas, NV Attending Oracle AI World? While you are exploring how Oracle Cloud Infrastructure (OCI) delivers high-performance compute and low-latency networking to your AI workloads, learn how Hammerspace can enable seamless data access and mobility between your data centers and OCI. AI workloads have another hurdle to clear, wherever they run: keeping GPUs fed with data. Complex data-staging pipelines can lead to expensive GPU idle time. Hammerspace helps maximize GPU performanc", "display_url": "okt.to/IQ1oWM", "end": 255, "expanded_url": "https://okt.to/IQ1oWM", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2112559526448594944/hsud0o0T?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2112559526448594944/hsud0o0T?format=jpg&name=150x150", "width": 150}], "start": 232, "status": 200, "title": "Oracle AI World 2026", "unwound_url": "https://hammerspace.com/event/oracle-ai-world-2026/", "url": "https://t.co/cwY9lzapBw"}, {"display_url": "pic.x.com/avLv2lknsn", "end": 279, "expanded_url": "https://x.com/theonlyalana/status/2114853340202815892/photo/1", "media_key": "3_2114853336964911104", "start": 256, "url": "https://t.co/avLv2lknsn"}]}, "id": "2114853340202815892", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@Molly_J_Presley, SVP of Global Marketing at @Hammerspace_Inc, is headed to @Oracle AI World to join @NVIDIA in their booth for her featured theater session, \"How Smart Data Orchestration Unlocks GPU Performance for AI Training.\" \n\nhttps://t.co/cwY9lzapBw https://t.co/avLv2lknsn", "url": "https://x.com/theonlyalana/status/2114853340202815892"}, {"author_id": "1938349334950522880", "created_at": "2026-10-26T22:59:35.000Z", "edit_history_tweet_ids": ["2114854482928361722"], "entities": {"urls": [{"display_url": "x.com/ObscureLocal/s…", "end": 300, "expanded_url": "https://twitter.com/ObscureLocal/status/2114713467093463305", "start": 277, "url": "https://t.co/SVTMWOGLkQ"}]}, "id": "2114854482928361722", "public_metrics": {"bookmark_count": 0, "impression_count": 347, "like_count": 6, "quote_count": 1, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2114713467093463305", "type": "quoted"}], "text": "My first multi-GPU training run has begun. Using my 2 Quadro M6000 24GB both in one workstation to learn about NCCL and DDP. Going to train a very simple model first to make sure nothing explodes, then we'll see if we can get something out of 2 cards we couldn't get out of 1. https://t.co/SVTMWOGLkQ", "url": "https://x.com/ObscureLocal/status/2114854482928361722"}, {"author_id": "192201556", "created_at": "2026-10-26T21:39:37.000Z", "edit_history_tweet_ids": ["2114834357861187822"], "entities": {"urls": [{"display_url": "x.com/TokenGremlin/s…", "end": 302, "expanded_url": "https://twitter.com/TokenGremlin/status/2114820768894767443", "start": 279, "url": "https://t.co/JLWPQCVdhY"}]}, "id": "2114834357861187822", "public_metrics": {"bookmark_count": 3, "impression_count": 2068, "like_count": 22, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2114820768894767443", "type": "quoted"}], "text": "You guys are really funny\nOpenAI has been in panic mode since the Fable drop if not earlier (they saw Mythos ofc). Why do you think the limits are so shitty, the speed so low. They're devoting every GPU they can spare to training and research. They have to take the beating now. https://t.co/JLWPQCVdhY", "url": "https://x.com/teortaxesTex/status/2114834357861187822"}, {"author_id": "1859178478173630464", "created_at": "2026-10-26T21:37:18.000Z", "edit_history_tweet_ids": ["2114833777390227622"], "entities": {"cashtags": [{"end": 201, "start": 196, "tag": "SICI"}], "urls": [{"display_url": "pic.x.com/ufpaHQ9y4x", "end": 302, "expanded_url": "https://x.com/Bahdguyyyy/status/2114833777390227622/photo/1", "media_key": "3_2114833764157153280", "start": 279, "url": "https://t.co/ufpaHQ9y4x"}]}, "id": "2114833777390227622", "public_metrics": {"bookmark_count": 0, "impression_count": 646, "like_count": 20, "quote_count": 0, "reply_count": 3, "retweet_count": 2}, "text": "What if the cost of powering AI could be traded just like stocks, commodities, or currencies?\n\nThat’s exactly what Injective is exploring with its newly launched Super Intelligence Compute Index ($SICI).\n\nAI companies spend heavily on GPU computing power, but rental prices vary https://t.co/ufpaHQ9y4x", "url": "https://x.com/Bahdguyyyy/status/2114833777390227622"}, {"author_id": "1638945783138361353", "created_at": "2026-10-26T21:59:48.000Z", "edit_history_tweet_ids": ["2114839437678874772"], "entities": {"cashtags": [{"end": 109, "start": 104, "tag": "SICI"}], "mentions": [{"end": 190, "id": "1062118922147659776", "start": 180, "username": "injective"}], "urls": [{"display_url": "x.com/injective/stat…", "end": 215, "expanded_url": "https://x.com/injective/status/2114719987650740708", "start": 192, "url": "https://t.co/XWQf6xwpD1"}, {"display_url": "pic.x.com/xP8TuWxlog", "end": 303, "expanded_url": "https://x.com/_MiReTu_/status/2114839437678874772/photo/1", "media_key": "3_2114839357236363264", "start": 280, "url": "https://t.co/xP8TuWxlog"}, {"display_url": "x.com/_MiReTu_/statu…", "end": 327, "expanded_url": "https://twitter.com/_MiReTu_/status/2114436558732525998", "start": 304, "url": "https://t.co/96oCdcW7LP"}]}, "id": "2114839437678874772", "public_metrics": {"bookmark_count": 0, "impression_count": 600, "like_count": 29, "quote_count": 1, "reply_count": 4, "retweet_count": 0}, "referenced_tweets": [{"id": "2114436558732525998", "type": "quoted"}], "text": "Injective doesn’t seem to be slowing down!)\n\nToday, they launched the Super Intelligence Compute Index ($SICI), a new on-chain benchmark for AI compute pricing.\n\nAnnouncement from @injective: https://t.co/XWQf6xwpD1\n\nIt’s a diversified index of NVIDIA GPU rental prices that, for https://t.co/xP8TuWxlog https://t.co/96oCdcW7LP", "url": "https://x.com/_MiReTu_/status/2114839437678874772"}, {"author_id": "2040891412628017153", "created_at": "2026-10-26T23:14:08.000Z", "edit_history_tweet_ids": ["2114858144639910083"], "entities": {"cashtags": [{"end": 133, "start": 128, "tag": "SICI"}], "mentions": [{"end": 74, "id": "1062118922147659776", "start": 64, "username": "injective"}], "urls": [{"display_url": "pic.x.com/4nXDkymX6r", "end": 299, "expanded_url": "https://x.com/Angelsoul005/status/2114858144639910083/photo/1", "media_key": "3_2114858133709639681", "start": 276, "url": "https://t.co/4nXDkymX6r"}, {"display_url": "x.com/Angelsoul005/s…", "end": 323, "expanded_url": "https://twitter.com/Angelsoul005/status/2114497212466217143", "start": 300, "url": "https://t.co/p3kqlI50d1"}]}, "id": "2114858144639910083", "public_metrics": {"bookmark_count": 0, "impression_count": 1088, "like_count": 50, "quote_count": 1, "reply_count": 8, "retweet_count": 9}, "referenced_tweets": [{"id": "2114497212466217143", "type": "quoted"}], "text": "Hey ninjas wassup this seems very different indeed.\n\nIn a first @injective has introduced the Super Intelligence Compute Index ($SICI) that allows participants to get involved with the actual prices of AI computing equipment not just with companies that make them.\n\nThey have https://t.co/4nXDkymX6r https://t.co/p3kqlI50d1", "url": "https://x.com/Angelsoul005/status/2114858144639910083"}, {"author_id": "177949731", "created_at": "2026-10-26T22:29:23.000Z", "edit_history_tweet_ids": ["2114846881050145235"], "entities": {"urls": [{"display_url": "pic.x.com/Ns8L82pdVl", "end": 301, "expanded_url": "https://x.com/bsormagec/status/2114846881050145235/photo/1", "media_key": "3_2114846877912801280", "start": 278, "url": "https://t.co/Ns8L82pdVl"}]}, "id": "2114846881050145235", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "You are paying per token for a reasoning process you have never seen.\n\nRaschka's new course opens the box. Eleven hours, eight videos, one Qwen3 0.6B model — and every method built by hand in Python and PyTorch. A verifier that grades math answers. Self-consistency by majority https://t.co/Ns8L82pdVl", "url": "https://x.com/bsormagec/status/2114846881050145235"}, {"author_id": "2029271146445848578", "created_at": "2026-10-26T23:09:09.000Z", "edit_history_tweet_ids": ["2114856891436474465"], "entities": {"mentions": [{"end": 271, "id": "44196397", "start": 262, "username": "elonmusk"}], "urls": [{"display_url": "pic.x.com/68VJeIK6FL", "end": 300, "expanded_url": "https://x.com/MTSlive/status/2114856891436474465/video/1", "media_key": "13_2114856631280578560", "start": 277, "url": "https://t.co/68VJeIK6FL"}, {"display_url": "x.com/elonmusk/statu…", "end": 324, "expanded_url": "https://twitter.com/elonmusk/status/2114434646914068862", "start": 301, "url": "https://t.co/nzn0hurS9a"}]}, "id": "2114856891436474465", "public_metrics": {"bookmark_count": 17, "impression_count": 7013, "like_count": 45, "quote_count": 2, "reply_count": 4, "retweet_count": 6}, "referenced_tweets": [{"id": "2114434646914068862", "type": "quoted"}], "text": "SITUATION EXPLAINED: Elon Musk says lenders have almost entirely cut off AI cloud companies, and 200+ of them face \"guppy-level death.\"\n\n• Neoclouds like CoreWeave and Nebius rent out GPUs to AI companies, and many borrowed heavily to build their data centers\n• @elonmusk says https://t.co/68VJeIK6FL https://t.co/nzn0hurS9a", "url": "https://x.com/MTSlive/status/2114856891436474465"}, {"author_id": "1941061824738168832", "created_at": "2026-10-26T22:10:12.000Z", "edit_history_tweet_ids": ["2114842055507657093"], "entities": {"urls": [{"display_url": "pic.x.com/akTUIiI2sg", "end": 302, "expanded_url": "https://x.com/andinyana45336/status/2114842055507657093/photo/1", "media_key": "3_2114842042991874048", "start": 279, "url": "https://t.co/akTUIiI2sg"}]}, "id": "2114842055507657093", "public_metrics": {"bookmark_count": 0, "impression_count": 1161, "like_count": 26, "quote_count": 0, "reply_count": 7, "retweet_count": 12}, "text": "Injective is bringing a new part of the AI economy onchain.\n\nOn October 26, Injective announced the launch of the Super Intelligence Compute Index (SICI), an onchain benchmark tracking the rental prices of five NVIDIA GPUs.\n\nWhy does this matter?\n\nAI depends on computing power. https://t.co/akTUIiI2sg", "url": "https://x.com/andinyana45336/status/2114842055507657093"}, {"author_id": "1165159200470650881", "created_at": "2026-10-26T21:47:43.000Z", "edit_history_tweet_ids": ["2114836397043724675"], "id": "2114836397043724675", "public_metrics": {"bookmark_count": 0, "impression_count": 125, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "The UK AI Security Institute published a second test on October 26. It asks whether coding agents can rebuild biological AI tools from the paper alone.\n\nThey built an evaluation called ReproBAIT with SecureBio. An agent gets a limited description of an existing tool plus its", "url": "https://x.com/AIQuanting/status/2114836397043724675"}, {"author_id": "94877778", "created_at": "2026-10-26T21:00:28.000Z", "edit_history_tweet_ids": ["2114824506586067225"], "entities": {"urls": [{"display_url": "pic.x.com/xBWso4u4Mu", "end": 294, "expanded_url": "https://x.com/MisterSnowCrash/status/2114824506586067225/photo/1", "media_key": "3_2114821650604834816", "start": 271, "url": "https://t.co/xBWso4u4Mu"}, {"display_url": "pic.x.com/xBWso4u4Mu", "end": 294, "expanded_url": "https://x.com/MisterSnowCrash/status/2114824506586067225/photo/1", "media_key": "3_2114821650588073985", "start": 271, "url": "https://t.co/xBWso4u4Mu"}, {"display_url": "pic.x.com/xBWso4u4Mu", "end": 294, "expanded_url": "https://x.com/MisterSnowCrash/status/2114824506586067225/photo/1", "media_key": "3_2114821650604806145", "start": 271, "url": "https://t.co/xBWso4u4Mu"}, {"display_url": "pic.x.com/xBWso4u4Mu", "end": 294, "expanded_url": "https://x.com/MisterSnowCrash/status/2114824506586067225/photo/1", "media_key": "3_2114821650588073984", "start": 271, "url": "https://t.co/xBWso4u4Mu"}]}, "id": "2114824506586067225", "public_metrics": {"bookmark_count": 0, "impression_count": 522, "like_count": 3, "quote_count": 0, "reply_count": 7, "retweet_count": 0}, "text": "The Daily AI Express\nOctober 26, 2026\n\n01. GPT-6.1 Terra Arrives\nOpenAI releases GPT-6.1 Terra for visual reasoning, computer use and writing in ChatGPT Work, Codex and the API. Standard API pricing starts at $1 per million input tokens and $5 per million output tokens; https://t.co/xBWso4u4Mu", "url": "https://x.com/MisterSnowCrash/status/2114824506586067225"}], "includes": {"users": [{"id": "982939260", "name": "Jon Durbin", "username": "jon_durbin"}, {"id": "2252943488", "name": "Deep Thrill", "username": "DeeperThrill"}, {"id": "2112384971243417602", "name": "Stan🦊", "username": "BannedStann"}, {"id": "1429783021184602116", "name": "SI Agent", "username": "SI_AgentFL"}, {"id": "1165159200470650881", "name": "AI Quanting", "username": "AIQuanting"}, {"id": "2105726409847267328", "name": "Joe", "username": "Marlon1B2t"}, {"id": "3325702470", "name": "Alana Achterkirchen 🎾", "username": "theonlyalana"}, {"id": "1938349334950522880", "name": "Obscure Local Researcher", "username": "ObscureLocal"}, {"id": "192201556", "name": "Teortaxes▶️ (DeepSeek 推特🐋铁粉 2023 – ∞)", "username": "teortaxesTex"}, {"id": "1859178478173630464", "name": "🅱️ahdguy", "username": "Bahdguyyyy"}, {"id": "1638945783138361353", "name": "MiReTu", "username": "_MiReTu_"}, {"id": "2040891412628017153", "name": "Rubaz.inj", "username": "Angelsoul005"}, {"id": "177949731", "name": "Burak Sormagec", "username": "bsormagec"}, {"id": "2029271146445848578", "name": "MTS", "username": "MTSlive"}, {"id": "1941061824738168832", "name": "My Peace 🕊️", "username": "andinyana45336"}, {"id": "94877778", "name": "Mister SnowCrash", "username": "MisterSnowCrash"}]}, "meta": {"newest_id": "2114858144639910083", "next_token": "b26v89c19zqg8o3juzlx95acnm9w8se9m5sl7i3pf1hfh", "oldest_id": "2114823461285794242", "result_count": 18}}
