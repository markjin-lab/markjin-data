VZbUrZV-3BCs4mfW1NnTkZgzrVCmS5cYFw.yJmc98y4rGiGWvLtZWPDFJNsegDS9JOoayat1A0TuIQ&dib_tag=se&keywords=The+Code+Breaker%3A+Jennifer+Doudna%2C+Gene+Editing%2C+and+the+Future+of+the+Human+Race+by+Walter+Isaacson&nsdOptOutParam=true&qid=1793056109&s=books&sprefix=the+code+breaker+jennifer+doudna%2C+gene+editing%2C+and+the+future+of+the+human+race+by+walter+isaacson+%2Cstripbooks-intl-ship%2C216&sr=1-1&linkCode=sl2&tag=imecon202507-20&linkId=7b967a150f5b94fa8c068fec3b4e8812&language=en_US&gaOptInStatus=true&ref_=as_li_ss_tl&ascsubtag=srctok-68752e86673ca038&btn_type=ss&btn_ref=srctok-68752e86673ca038", "url": "https://t.co/5J9oFS5iaS"}, {"display_url": "pic.x.com/FKwF44sfd2", "end": 303, "expanded_url": "https://x.com/incprodmon/status/2114859206486475012/photo/1", "media_key": "3_2114859187758845952", "start": 280, "url": "https://t.co/FKwF44sfd2"}]}, "id": "2114859206486475012", "public_metrics": {"bookmark_count": 7, "impression_count": 631, "like_count": 18, "quote_count": 0, "reply_count": 0, "retweet_count": 3}, "text": "Thought-provoking!\n\n\"The Code Breaker: Jennifer Doudna, Gene Editing, and the Future of the Human Race\" by Walter Isaacson.\n\nhttps://t.co/5J9oFS5iaS\n\n\"When Jennifer Doudna was in sixth grade, she came home one day to find that her dad had left a paperback titled The Double Helix https://t.co/FKwF44sfd2", "url": "https://x.com/incprodmon/status/2114859206486475012"}, {"author_id": "1331825191903666176", "created_at": "2026-10-26T21:24:59.000Z", "edit_history_tweet_ids": ["2114830674775707690"], "id": "2114830674775707690", "public_metrics": {"bookmark_count": 0, "impression_count": 174, "like_count": 3, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "1,946 AI agents read a mouse brain atlas in 32 minutes.\n\nOn Oct 21, OpenAI, PerturbAI and Scripps Research posted a preprint. Each agent took one gene disruption from a whole-brain CRISPR atlas in mice. It read the cell data, searched the literature and proposed an explanation.", "url": "https://x.com/DrDan_XD/status/2114830674775707690"}, {"author_id": "852346279724146688", "created_at": "2026-10-26T21:01:35.000Z", "edit_history_tweet_ids": ["2114824788980224280"], "entities": {"mentions": [{"end": 90, "id": "55586971", "start": 83, "username": "Biocom"}], "urls": [{"display_url": "pic.x.com/hQyNzTyNQ4", "end": 303, "expanded_url": "https://x.com/scribetx/status/2114824788980224280/video/1", "media_key": "13_2114823917160546304", "start": 280, "url": "https://t.co/hQyNzTyNQ4"}]}, "id": "2114824788980224280", "public_metrics": {"bookmark_count": 0, "impression_count": 240, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 2}, "text": "Ioana L. Aanei, our Director of Business Development and Alliance Management, is a @Biocom Life Science Catalyst awardee! Join us in celebrating her recognition today (her second of this month) for shaping the future of life science and genetic medicine in California and beyond. https://t.co/hQyNzTyNQ4", "url": "https://x.com/scribetx/status/2114824788980224280"}], "includes": {"users": [{"id": "2001574449322295296", "name": "Zeynep Arıkan", "username": "EmilyBunya77439"}, {"id": "1041829807011627009", "name": "Robert Corbin | Shadowfetch Studio | AIpeoplewiki", "username": "Shadowfetch"}, {"id": "1580408538119417856", "name": "谷口研究室（北海道大学医学部 統合病理学教室）", "username": "iPatho1"}, {"id": "1900249220919197696", "name": "écorché", "username": "starrypastellar"}, {"id": "2856326414", "name": "Woody Lin, PhD", "username": "DUNQU1"}, {"id": "1718733072462700544", "name": "GODSHEROS.ORG", "username": "godsheros76762", "withheld": {"country_codes": ["TR"]}}, {"id": "1680144871925981185", "name": "Inclusive Productivity Network", "username": "incprodmon"}, {"id": "1331825191903666176", "name": "Dhiyanesh Srinivasan", "username": "DrDan_XD"}, {"id": "852346279724146688", "name": "Scribe Therapeutics", "username": "scribetx"}]}, "meta": {"newest_id": "2114864439111688416", "next_token": "b26v89c19zqg8o