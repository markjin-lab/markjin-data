{"data": [{"author_id": "612896910", "created_at": "2026-10-28T20:45:03.000Z", "edit_history_tweet_ids": ["2115545401973408040"], "entities": {"urls": [{"display_url": "pic.x.com/n3DkQvHIug", "end": 304, "expanded_url": "https://x.com/BLS_gov/status/2115545401973408040/photo/1", "media_key": "3_2115544986489847808", "start": 281, "url": "https://t.co/n3DkQvHIug"}]}, "id": "2115545401973408040", "public_metrics": {"bookmark_count": 0, "impression_count": 816, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Behind every emergency response are dedicated professionals. In 2025, there were more than a million first responders. Thank you to the police officers, firefighters, emergency medical technicians (EMTs), paramedics, and other first responders who serve our communities every day. https://t.co/n3DkQvHIug", "url": "https://x.com/BLS_gov/status/2115545401973408040"}, {"author_id": "26538229", "created_at": "2026-10-28T20:33:37.000Z", "edit_history_tweet_ids": ["2115542524727300351"], "entities": {"hashtags": [{"end": 51, "start": 46, "tag": "FOMC"}], "urls": [{"description": "Transcript (PDF): https://www.federalreserve.gov/mediacenter/files/...", "display_url": "youtube.com/shorts/Txga74V…", "end": 113, "expanded_url": "https://youtube.com/shorts/Txga74VI9UE", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2115542533325680640/kNrgR1lh?format=jpg&name=orig", "width": 405}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115542533325680640/kNrgR1lh?format=jpg&name=150x150", "width": 150}], "start": 90, "status": 200, "title": "FOMC Press Conference, October 28, 2026: Chairman Warsh quote #shorts", "unwound_url": "https://www.youtube.com/shorts/Txga74VI9UE", "url": "https://t.co/QjiMBx7Cgt"}]}, "id": "2115542524727300351", "public_metrics": {"bookmark_count": 1, "impression_count": 12708, "like_count": 9, "quote_count": 1, "reply_count": 1, "retweet_count": 3}, "text": "Chairman Warsh reads opening statement 