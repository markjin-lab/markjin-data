eight": 150, "url": "https://pbs.twimg.com/news_img/2115541763762814976/T26e_KSA?format=jpg&name=150x150", "width": 150}], "start": 169, "status": 200, "title": "October 27-28, 2026 FOMC Meeting", "unwound_url": "https://www.federalreserve.gov/monetarypolicy/fomcpresconf20261028.htm", "url": "https://t.co/9i8rFGPp6M"}]}, "id": "2115541762647138404", "public_metrics": {"bookmark_count": 3, "impression_count": 12506, "like_count": 11, "quote_count": 0, "reply_count": 5, "retweet_count": 2}, "text": "Watch Chairman Warsh’s statement from the #FOMC press conference:\n\nIntro clip: https://t.co/iaHcZgermN\n\nFull video: https://t.co/wk5S490J5w\n\nPress conference materials: https://t.co/9i8rFGPp6M", "url": "https://x.com/federalreserve/status/2115541762647138404"}, {"author_id": "25098482", "created_at": "2026-10-28T20:01:10.000Z", "edit_history_tweet_ids": ["2115534359516364933"], "entities": {"mentions": [{"end": 33, "id": "123109597", "start": 22, "username": "KGeorgieva"}], "urls": [{"description": "Washington, DC – October 28, 2026: Kristalina Georgieva, Managing Director of the International Monetary Fund (IMF), announced today that Deputy Managing Director Bo LI will be leaving the IMF on November 30, 2026, at the conclusion of his term, and that Mr. Min LIAO, currently Vice Minister of Finance of the People's Republic of China, is proposed to succeed Mr. Li as Deputy Managing Director, effective December 1, 2026.", "display_url": "imf.org/en/news/articl…", "end": 279, "expanded_url": "https://imf.org/en/news/articles/2026/10/28/pr26341-imf-announces-departure-of-dmd-bo-li-proposes-appointment-mr-min-liao-as-dmd", "images": [{"height": 405, "url": "https://pbs.twimg.com/news_img/2115440319231631360/_HCd4VYr?format=png&name=orig", "width": 400}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115440319231631360/_HCd4VYr?format=png&name=150x150", "width": 150}], "start": 256, "status": 200, "title": "IMF Announces Departure of Deputy Managing Director Bo LI and Proposes Appointment of Mr. Min LIAO as Deputy Managing Director", "unwound_url": "https://www.imf.org/en/news/articles/2026/10/28/pr26341-imf-announces-departure-of-dmd-bo-li-proposes-appointment-mr-min-liao-as-dmd", "url": "https://t.co/dw1bF2Em8K"}, {"display_url": "x.com/KGeorgieva/sta…", "end": 303, "expanded_url": "https://twitter.com/KGeorgieva/status/2115518197004918834", "start": 280, "url": "https://t.co/rqvzA8wGQR"}]}, "id": "2115534359516364933", "public_metrics": {"bookmark_count": 1, "impression_count": 6657, "like_count": 17, "quote_count": 2, "reply_count": 3, "retweet_count": 4}, "referenced_tweets": [{"id": "2115518197004918834", "type": "quoted"}], "text": "IMF Managing Director @KGeorgieva announced that Deputy Managing Director Bo Li will leave the IMF on Nov. 30, 2026, at the conclusion of his term, and proposed Min Liao, currently Vice Minister of Finance of China, to succeed him, effective Dec. 1, 2026. https://t.co/dw1bF2Em8K https://t.co/rqvzA8wGQR", "url": "https://x.com/IMFNews/status/2115534359516364933"}, {"author_id": "26538229", "created_at": "2026-10-28T19:56:55.000Z", "edit_history_tweet_ids": ["2115533289125708228"], "entities": {"urls": [{"description": "The Federal Reserve Board of Governors in Washington DC.", "display_url": "federalreserve.gov/monetarypolicy…", "end": 117, "expanded_url": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2113257092215967744/O0ZwvthP?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113257092215967744/O0ZwvthP?format=jpg&name=150x150", "width": 150}], "start": 94, "status": 200, "title": "Meeting calendars and information", "unwound_url": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm", "url": "https://t.co/siWde1ROZb"}, {"display_url": "pic.x.com/Y2wXlz8bbh", "end": 141, "expanded_url": "https://x.com/federalreserve/status/2115533289125708228/photo/1", "media_key": "3_2115533263515107328", "start": 118, "url": "https://t.co/Y2wXlz8bbh"}]}, "id": "2115533289125708228", "public_metrics": {"bookmark_count": 3, "impression_count": 13846, "like_count": 29, "quote_count": 3, "reply_count": 7, "retweet_count": 6}, "text": "Chairman Warsh answers reporters' questions at the FOMC press conference on October 28, 2026. https://t.co/siWde1ROZb https://t.co/Y2wXlz8bbh", "url": "https://x.com/federalreserve/status/2115533289125708228"}, {"author_id": "279036722", "created_at": "2026-10-28T19:34:02.000Z", "edit_history_tweet_ids": ["2115527530446987564"], "id": "2115527530446987564", "public_metrics": {"bookmark_count": 3, "impression_count": 6893, "like_count": 44, "quote_count": 1, "reply_count": 6, "retweet_count": 0}, "text": "I have long thought the Fed spends too much time on the immediate and not nearly enough time thinking about longer-term strategy.\n\nGreat move by Chair Warsh to devote one meeting to strategy next year and two the following year.", "url": "https://x.com/jasonfurman/status/2115527530446987564"}, {"author_id": "26538229", "created_at": "2026-10-28T19:08:19.000Z", "edit_history_tweet_ids": ["2115521059432636679"], "entities": {"hashtags": [{"end": 59, "start": 54, "tag": "FOMC"}], "urls": [{"display_url": "federalreserve.gov/mediacenter/fi…", "end": 108, "expanded_url": "https://www.federalreserve.gov/mediacenter/files/FOMCpresconf20261028.pdf", "start": 85, "status": 200, "unwound_url": "https://www.federalreserve.gov/mediacenter/files/FOMCpresconf20261028.pdf", "url": "https://t.co/TPqQ7MKO7m"}, {"display_url": "pic.x.com/1SUkOfaU0T", "end": 132, "expanded_url": "https://x.com/federalreserve/status/2115521059432636679/photo/1", "media_key": "3_2115521008857706496", "start": 109, "url": "https://t.co/1SUkOfaU0T"}]}, "id": "2115521059432636679", "public_metrics": {"bookmark_count": 8, "impression_count": 21211, "like_count": 94, "quote_count": 14, "reply_count": 16, "retweet_count": 34}, "text": "Read Chairman Warsh's full opening statement from the #FOMC press conference (PDF):  https://t.co/TPqQ7MKO7m https://t.co/1SUkOfaU0T", "url": "https://x.com/federalreserve/status/2115521059432636679"}, {"author_id": "332617373", "created_at": "2026-10-28T18:44:06.000Z", "edit_history_tweet_ids": ["2115514963225960659"], "id": "2115514963225960659", "public_metrics": {"bookmark_count": 12, "impression_count": 17418, "like_count": 116, "quote_count": 0, "reply_count": 12, "retweet_count": 12}, "text": "In an important change that's both needed and will be welcomed by many, Federal Reserve Chair Kevin Warsh just announced a shift in the FOMC meeting schedule to allow for deeper, strategic discussions.\nNext year, one of the eight traditional policy meetings will be dedicated to a", "url": "https://x.com/elerianm/status/2115514963225960659"}, {"author_id": "59603406", "created_at": "2026-10-28T18:37:08.000Z", "edit_history_tweet_ids": ["2115513210736680969"], "id": "2115513210736680969", "public_metrics": {"bookmark_count": 21, "impression_count": 43023, "like_count": 243, "quote_count": 14, "reply_count": 27, "retweet_count": 49}, "text": "Warsh: The Fed will have 8 meetings as scheduled in 2027, but one won't have a vote on monetary policy settings and instead focus on strategy. In 2028, two of the 8 meetings will be devoted to policy strategy. Those meetings won't be \"live.\"", "url": "https://x.com/NickTimiraos/status/2115513210736680969"}, {"author_id": "332617373", "created_at": "2026-10-28T18:32:46.000Z", "edit_history_tweet_ids": ["2115512112131064101"], "id": "2115512112131064101", "public_metrics": {"bookmark_count": 13, "impression_count": 17631, "like_count": 119, "quote_count": 0, "reply_count": 18, "retweet_count": 10}, "text": "Quite a few of those now calling for rate hikes because inflation has exceeded target for over five years supported a series of rate cuts last year—when inflation had already been above target for four years.\nThis isn't an argument against a policy response; inflation demands", "url": "https://x.com/elerianm/status/2115512112131064101"}, {"author_id": "26538229", "created_at": "2026-10-28T18:30:36.000Z", "edit_history_tweet_ids": ["2115511566389170595"], "entities": {"hashtags": [{"end": 37, "start": 32, "tag": "FOMC"}], "urls": [{"description": "The Federal Reserve Board of Governors in Washington DC.", "display_url": "federalreserve.gov", "end": 77, "expanded_url": "https://www.federalreserve.gov/", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2113100610958467072/fFh4Mv1q?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113100610958467072/fFh4Mv1q?format=jpg&name=150x150", "width": 150}], "start": 54, "status": 200, "title": "Home", "unwound_url": "https://www.federalreserve.gov/", "url": "https://t.co/1uJrua5Yif"}, {"description": "Official channel of the Federal Reserve Board of Governors", "display_url": "youtube.com/federalreserve", "end": 106, "expanded_url": "https://www.youtube.com/federalreserve", "images": [{"height": 900, "url": "https://pbs.twimg.com/news_img/2115449400529178624/kaf7NInX?format=jpg&name=orig", "width": 900}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115449400529178624/kaf7NInX?format=jpg&name=150x150", "width": 150}], "start": 83, "status": 200, "title": "Federal Reserve", "unwound_url": "https://www.youtube.com/federalreserve", "url": "https://t.co/FJa6TblbC1"}]}, "id": "2115511566389170595", "public_metrics": {"bookmark_count": 10, "impression_count": 23234, "like_count": 76, "quote_count": 6, "reply_count": 12, "retweet_count": 15}, "text": "LIVE NOW: Press conference with #FOMC Chairman Warsh: https://t.co/1uJrua5Yif  and https://t.co/FJa6TblbC1", "url": "https://x.com/federalreserve/status/2115511566389170595"}, {"author_id": "332617373", "created_at": "2026-10-28T18:11:17.000Z", "edit_history_tweet_ids": ["2115506704028778937"], "id": "2115506704028778937", "public_metrics": {"bookmark_count": 10, "impression_count": 18290, "like_count": 124, "quote_count": 2, "reply_count": 12, "retweet_count": 17}, "text": "As widely expected, the Fed kept interest rates unchanged in a 10–2 vote.\nDe facto avoiding forward guidance, the  FOMC's statement noted that \"the accumulation of more information will help the Conmittee determine the policy stance appropriate to ensure a timely return of", "url": "https://x.com/elerianm/status/2115506704028778937"}, {"author_id": "26538229", "created_at": "2026-10-28T18:01:22.000Z", "edit_history_tweet_ids": ["2115504207977435556"], "entities": {"hashtags": [{"end": 28, "start": 23, "tag": "FOMC"}], "urls": [{"description": "The Federal Open Market Committee approved the following statement for release by a 10 – 2 vote: The Committee decided to maintain the target range for", "display_url": "federalreserve.gov/newsevents/pre…", "end": 63, "expanded_url": "https://www.federalreserve.gov/newsevents/pressreleases/monetary20261028a.htm", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2115504091686473728/cuWDUUVn?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115504091686473728/cuWDUUVn?format=jpg&name=150x150", "width": 150}], "start": 40, "status": 200, "title": "Federal Reserve issues FOMC statement", "unwound_url": "https://www.federalreserve.gov/newsevents/pressreleases/monetary20261028a.htm", "url": "https://t.co/D6u2WlUUav"}]}, "id": "2115504207977435556", "public_metrics": {"bookmark_count": 92, "impression_count": 161974, "like_count": 615, "quote_count": 45, "reply_count": 49, "retweet_count": 157}, "text": "Federal Reserve issues #FOMC statement: https://t.co/D6u2WlUUav", "url": "https://x.com/federalreserve/status/2115504207977435556"}, {"author_id": "59603406", "created_at": "2026-10-28T18:00:54.000Z", "edit_history_tweet_ids": ["2115504092910850425"], "entities": {"urls": [{"display_url": "x.com/NickTimiraos/s…", "end": 209, "expanded_url": "https://twitter.com/NickTimiraos/status/2115503892905730129", "start": 186, "url": "https://t.co/esM6EY3qsU"}]}, "id": "2115504092910850425", "public_metrics": {"bookmark_count": 22, "impression_count": 40098, "like_count": 212, "quote_count": 14, "reply_count": 25, "retweet_count": 52}, "referenced_tweets": [{"id": "2115503892905730129", "type": "quoted"}], "text": "FOMC statement: \"The accumulation of more information will help the committee determine the policy stance appropriate to ensure a timely return of inflation to the committee’s 2% goal.\" https://t.co/esM6EY3qsU", "url": "https://x.com/NickTimiraos/status/2115504092910850425"}, {"author_id": "59603406", "created_at": "2026-10-28T18:00:06.000Z", "edit_history_tweet_ids": ["2115503892905730129"], "entities": {"urls": [{"display_url": "pic.x.com/nUKDM6n8Zp", "end": 119, "expanded_url": "https://x.com/NickTimiraos/status/2115503892905730129/photo/1", "media_key": "3_2115503873175535616", "start": 96, "url": "https://t.co/nUKDM6n8Zp"}]}, "id": "2115503892905730129", "public_metrics": {"bookmark_count": 54, "impression_count": 175394, "like_count": 625, "quote_count": 46, "reply_count": 60, "retweet_count": 149}, "text": "The Fed holds steady.\n\nThe decision is 10-2.\n\nLisa Cook and Beth Hammack voted for an increase. https://t.co/nUKDM6n8Zp", "url": "https://x.com/NickTimiraos/status/2115503892905730129"}, {"author_id": "612896910", "created_at": "2026-10-28T15:21:30.000Z", "edit_history_tweet_ids": ["2115463978910716220"], "entities": {"hashtags": [{"end": 92, "start": 84, "tag": "BLSdata"}], "urls": [{"description": "The .gov means it's official. Federal government websites often end in .gov or .mil. Before sharing sensitive information, make sure you're on a federal government site. The site is secure. The https:// ensures that you are connecting to the official website and that any information you provide is encrypted and transmitted securely. As trick-or-treat time approaches, the quest for the ulti