iubi/status/2115530994551758868", "start": 63, "url": "https://t.co/lxhDyswNia"}]}, "id": "2115533944448049454", "public_metrics": {"bookmark_count": 3, "impression_count": 2164, "like_count": 11, "quote_count": 1, "reply_count": 1, "retweet_count": 2}, "referenced_tweets": [{"id": "2115530994551758868", "type": "quoted"}], "text": "what a coincidence...and it is working https://t.co/BB1f0M7UJf https://t.co/lxhDyswNia", "url": "https://x.com/niubi/status/2115533944448049454"}, {"author_id": "3512101", "created_at": "2026-10-28T19:47:48.000Z", "edit_history_tweet_ids": ["2115530994551758868"], "entities": {"urls": [{"description": "State-funded tours, co-ordinated hashtags, cash competitions... Beijing counters criticism of its new Ethnic Unity Law via foreigners on social media.", "display_url": "toosimple.substack.com/p/how-china-is…", "end": 83, "expanded_url": "https://toosimple.substack.com/p/how-china-is-covertly-using-western?r=2e&utm_campaign=post-expanded-share&utm_medium=web", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2115530995193577473/OfyfqChe?format=jpg&name=orig", "width": 1600}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115530995193577473/OfyfqChe?format=jpg&name=150x150", "width": 150}], "start": 60, "status": 200, "title": "How China is covertly using Western influencers in Xinjiang", "unwound_url": "https://toosimple.substack.com/p/how-china-is-covertly-using-western?r=2e&utm_campaign=post-expanded-share&utm_medium=web", "url": "https://t.co/NRRvU0C7Q2"}]}, "id": "2115530994551758868", "public_metrics": {"bookmark_count": 2, "impression_count": 2628, "like_count": 10, "quote_count": 1, "reply_count": 0, "retweet_count": 3}, "text": "How China is covertly using Western influencers in Xinjiang https://t.co/NRRvU0C7Q2 \"the foreign influencers and the Chinese state are playing a dangerous game. And the hashtags establish a direct link between supposed ‘individual accounts’ and Chinese state propaganda campaigns.", "url": "https://x.com/niubi/status/2115530994551758868"}, {"author_id": "702235316812275712", "created_at": "2026-10-28T19:43:05.000Z", "edit_history_tweet_ids": ["2115529809031991449"], "entities": {"urls": [{"display_url": "pic.x.com/HGb0ezjtlP", "end": 301, "expanded_url": "https://x.com/EconBerger/status/2115529809031991449/photo/1", "media_key": "3_2115529805848526848", "start": 278, "url": "https://t.co/HGb0ezjtlP"}]}, "id": "2115529809031991449", "public_metrics": {"bookmark_count": 0, "impression_count": 1101, "like_count": 5, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "Q1 Business Employment Dynamics:\n\n1/ The labor market is \"frozen\", with lower hiring &amp; separations relative to pre-pandemic.\n\nBUT: turnover due to \"creative destruction\" (openings/births &amp; closings/deaths of establishments) has actually increased over this same period. https://t.co/HGb0ezjtlP", "url": "https://x.com/EconBerger/status/2115529809031991449"}, {"author_id": "3512101", "created_at": "2026-10-28T19:35:09.000Z", "edit_history_tweet_ids": ["2115527811259912230"], "id": "2115527811259912230", "public_metrics": {"bookmark_count": 2, "impression_count": 998, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "who from dc think tanks/universities is going to this? \"Against this backdrop, the “China-US Intergenerational Dialogue 2026,” jointly hosted by The Paper and the Shanghai Institutes for International Studies, will be held in Shanghai on October 30. The event’s Chinese theme is", "url": "https://x.com/niubi/status/2115527811259912230"}, {"author_id": "14096763", "created_at": "2026-10-28T19:24:34.000Z", "edit_history_tweet_ids": ["2115525147323248744"], "entities": {"mentions": [{"end": 128, "id": "33805522", "start": 115, "username": "sunraysunray"}], "urls": [{"display_url": "pic.x.com/P3jDV3UV0t", "end": 283, "expanded_url": "https://x.com/TheStalwart/status/2115525147323248744/photo/1", "media_key": "3_2115525014506065920", "start": 260, "url": "https://t.co/P3jDV3UV0t"}, {"display_url": "pic.x.com/P3jDV3UV0t", "end": 283, "expanded_url": "https://x.com/TheStalwart/status/2115525147323248744/photo/1", "media_key": "3_2115525033137225728", "start": 260, "url": "https://t.co/P3jDV3UV0t"}, {"display_url": "pic.x.com/P3jDV3UV0t", "end": 283, "expanded_url": "https://x.com/TheStalwart/status/2115525147323248744/photo/1", "media_key": "3_2115525056172322816", "start": 260, "url": "https://t.co/P3jDV3UV0t"}, {"display_url": "x.com/analytichegel/…", "end": 307, "expanded_url": "https://twitter.com/analytichegel/status/2115473662363271560", "start": 284, "url": "https://t.co/OUyMFzh9zN"}]}, "id": "2115525147323248744", "public_metrics": {"bookmark_count": 60, "impression_count": 14605, "like_count": 88, "quote_count": 6, "reply_count": 13, "retweet_count": 13}, "referenced_tweets": [{"id": "2115473662363271560", "type": "quoted"}], "text": "WILL AI MAKE CAPITALISM OBSOLETE?\n\nIn today's newsletter, I wrote about a brief moment at the end of our chat with @sunraysunray (actually it was kind of after the end of the episode, but our producers left it in, which is good) about AI and central planning. https://t.co/P3jDV3UV0t https://t.co/OUyMFzh9zN", "url": "https://x.com/TheStalwart/status/2115525147323248744"}, {"author_id": "14096763", "created_at": "2026-10-28T19:16:11.000Z", "edit_history_tweet_ids": ["2115523039354073451"], "entities": {"urls": [{"display_url": "pic.x.com/pVAmxgNzsK", "end": 295, "expanded_url": "https://x.com/TheStalwart/status/2115523039354073451/photo/1", "media_key": "3_2115521630130573312", "start": 272, "url": "https://t.co/pVAmxgNzsK"}]}, "id": "2115523039354073451", "public_metrics": {"bookmark_count": 0, "impression_count": 10549, "like_count": 42, "quote_count": 1, "reply_count": 9, "retweet_count": 1}, "text": "City Council Member Harvey Epstein and State Assembly Member Keith Powers have come out in favor of preserving the existing exercise equipment at Tompkins Square. I still think this ADA angle is a bit of a red herring, designed to make the bars defenders look like jerks. https://t.co/pVAmxgNzsK", "url": "https://x.com/TheStalwart/status/2115523039354073451"}, {"author_id": "3512101", "created_at": "2026-10-28T19:09:40.000Z", "edit_history_tweet_ids": ["2115521396331991380"], "entities": {"urls": [{"description": "China's proposed artificial intelligence export curbs will push a business model favoured by Beijing and the industry's biggest players: keeping ​valuable technology at home while selling access to it abroad as rivalry with the US intensifies.", "display_url": "reuters.com/business/retai…", "end": 87, "expanded_url": "https://www.reuters.com/business/retail-consumer/chinas-new-export-curbs-draw-line-around-its-ai-crown-jewels-2026-10-28/", "images": [{"height": 1005, "url": "https://pbs.twimg.com/news_img/2115357406821490688/Gq9QJBb_?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115357406821490688/Gq9QJBb_?format=jpg&name=150x150", "width": 150}], "start": 64, "status": 200, "title": "China's new export curbs draw a line around its AI crown jewels", "unwound_url": "https://www.reuters.com/business/retail-consumer/chinas-new-export-curbs-draw-line-around-its-ai-crown-jewels-2026-10-28/", "url": "https://t.co/IuFfgitCdd"}]}, "id": "2115521396331991380", "public_metrics": {"bookmark_count": 0, "impression_count": 995, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "China's new export curbs draw a line around its AI crown jewels https://t.co/IuFfgitCdd \"Researchers at major Chinese AI labs are seeking clarification on whether they can train or run their most advanced models on foreign-owned overseas servers, according to a person briefed on", "url": "https://x.com/niubi/status/2115521396331991380"}, {"author_id": "14096763", "created_at": "2026-10-28T19:07:56.000Z", "edit_history_tweet_ids": ["2115520963378917876"], "entities": {"cashtags": [{"end": 19, "start": 14, "tag": "ORCL"}], "urls": [{"display_url": "pic.x.com/lGeSYpFOlc", "end": 83, "expanded_url": "https://x.com/TheStalwart/status/2115520963378917876/photo/1", "media_key": "3_2115520945972449280", "start": 60, "url": "https://t.co/lGeSYpFOlc"}]}, "id": "2115520963378917876", "public_metrics": {"bookmark_count": 5, "impression_count": 8883, "like_count": 47, "quote_count": 0, "reply_count": 3, "retweet_count": 6}, "text": "Nice rally in $ORCL 10-year bonds, with a strong move today https://t.co/lGeSYpFOlc", "url": "https://x.com/TheStalwart/status/2115520963378917876"}, {"author_id": "14096763", "created_at": "2026-10-28T19:00:18.000Z", "edit_history_tweet_ids": ["2115519042354053475"], "entities": {"mentions": [{"end": 35, "id": "2356714968", "start": 22, "username": "HyunSongShin"}]}, "id": "2115519042354053475", "public_metrics": {"bookmark_count": 2, "impression_count": 8004, "like_count": 13, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "Warsh just called out @HyunSongShin and said he's talented and he's glad to see him managing the central bank of Korea", "url": "https://x.com/TheStalwart/status/2115519042354053475"}, {"author_id": "961132338", "created_at": "2026-10-28T18:56:25.000Z", "edit_history_tweet_ids": ["2115518065823945194"], "id": "2115518065823945194", "public_metrics": {"bookmark_count": 1, "impression_count": 2096, "like_count": 6, "quote_count": 1, "reply_count": 2, "retweet_count": 0}, "text": "Seems as if he is trying to put us to sleep", "url": "https://x.com/M_C_Klein/status/2115518065823945194"}, {"author_id": "497231011", "created_at": "2026-10-28T18:54:17.000Z", "edit_history_tweet_ids": ["2115517527795372515"], "id": "2115517527795372515", "public_metrics": {"bookmark_count": 1, "impression_count": 1098, "like_count": 4, "quote_count": 0, "reply_count": 1, "retweet_count": 3}, "text": "\"As the economy slumped in recent yrs, the strain on Chinese companies has increased &amp; their finances have deteriorated. Total net profit at 5,400 🇨🇳 companies listed on local stock exchanges fell for the 3rd consecutive yr in 2025...Excess factory capacity &amp; weak domestic demand", "url": "https://x.com/ChinaBeigeBook/status/2115517527795372515"}, {"author_id": "14096763", "created_at": "2026-10-28T18:53:49.000Z", "edit_history_tweet_ids": ["2115517408203116887"], "entities": {"urls": [{"description": "Explore the most interesting topics in finance, markets and economics, for subscribers only.", "display_url": "bloomberg.com/account/newsle…", "end": 155, "expanded_url": "https://www.bloomberg.com/account/newsletters/odd-lots", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2113338194108219392/GXbIwo9k?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113338194108219392/GXbIwo9k?format=jpg&name=150x150", "width": 150}], "start": 132, "status": 200, "title": "Odd Lots", "unwound_url": "https://www.bloomberg.com/account/newsletters/odd-lots", "url": "https://t.co/25c7dc92bu"}]}, "id": "2115517408203116887", "public_metrics": {"bookmark_count": 4, "impression_count": 10936, "like_count": 76, "quote_count": 2, "reply_count": 4, "retweet_count": 3}, "text": "\"I'm not a Wall Street newsletter\" -- Kevin Warsh\n\nNeither am I, but I do co-write a newsletter which you should subscribe to here. https://t.co/25c7dc92bu", "url": "https://x.com/TheStalwart/status/2115517408203116887"}, {"author_id": "14096763", "created_at": "2026-10-28T18:49:12.000Z", "edit_history_tweet_ids": ["2115516249031803280"], "id": "2115516249031803280", "public_metrics": {"bookmark_count": 2, "impression_count": 10275, "like_count": 91, "quote_count": 0, "reply_count": 18, "retweet_count": 1}, "text": "FOMC press conferences don't have a long history, so as I've said before, I don't think it'd be the end of the world if they got rid of them. \n\nAnd actually, given how little Warsh says during these pressers, it's surprising he hasn't killed them yet.", "url": "https://x.com/TheStalwart/status/2115516249031803280"}, {"author_id": "2961589380", "created_at": "2026-10-28T18:45:50.000Z", "edit_history_tweet_ids": ["2115515400377249900"], "entities": {"mentions": [{"end": 259, "id": "793097212070944768", "start": 248, "username": "IraFJersey"}]}, "id": "2115515400377249900", "public_metrics": {"bookmark_count": 2, "impression_count": 9631, "like_count": 42, "quote_count": 3, "reply_count": 11, "retweet_count": 7}, "text": "Warsh noted that there will be few policy setting meetings going forward, suggesting that some meetings may price for greater moves and risks and more rate-market volatility around meetings, particularly if forward guidance continues to be reduced\n@IraFJersey", "url": "https://x.com/LizAnnSonders/status/2115515400377249900"}, {"author_id": "961132338", "created_at": "2026-10-28T18:45:27.000Z", "edit_history_tweet_ids": ["2115515302683591162"], "id": "2115515302683591162", "public_metrics": {"bookmark_count": 0, "impression_count": 1409, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "If the one strategy meeting in 2027 goes reasonably well, why would the Fed need to have *two* strategy meetings in 2028?", "url": "https://x.com/M_C_Klein/status/2115515302683591162"}, {"author_id": "2961589380", "created_at": "2026-10-28T18:43:43.000Z", "edit_history_tweet_ids": ["2115514869155868878"], "id": "2115514869155868878", "public_metrics": {"bookmark_count": 2, "impression_count": 9438, "like_count": 46, "quote_count": 1, "reply_count": 9, "retweet_count": 8}, "text": "Fed is shifting to a 7/1 then 6/2 meeting schedule: 7 on policy, 1 on major economic issues in 2027; followed by 6 and 2 in 2028", "url": "https://x.com/LizAnnSonders/status/2115514869155868878"}, {"author_id": "14096763", "created_at": "2026-10-28T18:37:55.000Z", "edit_history_tweet_ids": ["2115513407327944829"], "id": "2115513407327944829", "public_metrics": {"bookmark_count": 2, "impression_count": 8434, "like_count": 31, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "*WARSH: FOMC SCHEDULE WILL CHANGE AS OF NEXT FALL", "url": "https://x.com/TheStalwart/status/2115513407327944829"}, {"author_id": "14096763", "created_at": "2026-10-28T18:37:20.000Z", "edit_history_tweet_ids": ["2115513263060406502"], "id": "2115513263060406502", "public_metrics": {"bookmark_count": 3, "impression_count": 17455, "like_count": 56, "quote_count": 4, "reply_count": 4, "retweet_count": 5}, "text": "*ORACLE TO LIMIT ADDITIONAL CAPITAL RAISES TO $20B FOR FY27-FY30", "url": "https://x.com/TheStalwart/status/2115513263060406502"}, {"author_id": "188369814", "created_at": "2026-10-28T18:36:29.000Z", "edit_history_tweet_ids": ["2115513047158866156"], "entities": {"urls": [{"display_url": "x.com/NickTimiraos/s…", "end": 268, "expanded_url": "https://twitter.com/NickTimiraos/status/2115503892905730129", "start": 245, "url": "https://t.co/vZUS6GJkjl"}]}, "id": "2115513047158866156", "public_metrics": {"bookmark_count": 5, "impression_count": 15922, "like_count": 55, "quote_count": 1, "reply_count": 18, "retweet_count": 3}, "referenced_tweets": [{"id": "2115503892905730129", "type": "quoted"}], "text": "You could argue that the only signal in this markup is the change from \"solid\" to \"strong.\"\n\n\"Strong\" implies a greater growth pace than \"solid.\" What are they trying to signal by saying that the economy is moving faster?\n\nYet they didn't hike. https://t.co/vZUS6GJkjl", "url": "https://x.com/biancoresearch/status/2115513047158866156"}, {"author_id": "14096763", "created_at": "2026-10-28T18:34:32.000Z", "edit_history_tweet_ids": ["2115512557343519176"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "ORCL"}]}, "id": "2115512557343519176", "public_metrics": {"bookmark_count": 2, "impression_count": 8090, "like_count": 14, "quote_count": 1, "reply_count": 5, "retweet_count": 0}, "text": "$ORCL best day since June 1", "ur