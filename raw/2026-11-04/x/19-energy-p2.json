istory_tweet_ids": ["2117041946451656778"], "entities": {"urls": [{"display_url": "x.com/mahcus_smaht/s…", "end": 302, "expanded_url": "https://twitter.com/mahcus_smaht/status/2117027511863517440", "start": 279, "url": "https://t.co/B6fRx8ujvC"}]}, "id": "2117041946451656778", "public_metrics": {"bookmark_count": 3, "impression_count": 3012, "like_count": 59, "quote_count": 0, "reply_count": 3, "retweet_count": 1}, "referenced_tweets": [{"id": "2117027511863517440", "type": "quoted"}], "text": "This is true. The midrange is broken down into short midrange and long midrange. The LMR shots are the bad ones people don’t like. The SMR shots are not. When you look at the greatest playoff scorers ever, they go to that shot, defenses can’t take it away like paint shots or 3s https://t.co/B6fRx8ujvC", "url": "https://x.com/_Adubis_/status/2117041946451656778"}, {"author_id": "2100748706047983616", "created_at": "2026-11-01T23:41:01.000Z", "edit_history_tweet_ids": ["2117039236348293506"], "entities": {"urls": [{"display_url": "x.com/SpursRuinedMe/…", "end": 304, "expanded_url": "https://twitter.com/SpursRuinedMe/status/2116984510432924040", "start": 281, "url": "https://t.co/hXlYYPwWg3"}]}, "id": "2117039236348293506", "public_metrics": {"bookmark_count": 3, "impression_count": 799, "like_count": 16, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2116984510432924040", "type": "quoted"}], "text": "you know it's insecure tears when spurs morons haven't done their research\n\nHe was #1 in the entire league in Floater PPP as a rookie at 18 lol\n\nQuite possible that guy with one of the best floater touches is now gone be high 50s SMR at least, not 66% obviously but high 50s fasho https://t.co/hXlYYPwWg3", "url": "https://x.com/BorzBratherAlt/status/2117039236348293506"}, {"author_id": "1631000040276918272", "created_at": "2026-11-01T21:53:09.000Z", "edit_history_tweet_ids": ["2117012093702701175"], "id": "2117012093702701175", "public_metrics": {"bookmark_count": 10, "impression_count": 4061, "like_count": 94, "quote_count": 1, "reply_count": 4, "retweet_count": 3}, "text": "Franz has such an odd player profile in the sense that his best skills (finishing, SMR, ball handling) are star skills but he’s not elite enough at any of them to be a superstar, but he can’t really scale down either bc his role player traits (shooting, screening, etc) are ass", "url": "https://x.com/CousinTurn/status/2117012093702701175"}, {"author_id": "1573124370741878785", "created_at": "2026-11-01T22:03:07.000Z", "edit_history_tweet_ids": ["2117014600327536880"], "entities": {"hashtags": [{"end": 275, "start": 267, "tag": "AIWorld"}], "urls": [{"description": "Fusion Companion and Fusion Agentic Home help organizations achieve business outcomes by enabling employees to execute work across different AI clients while maintaining enterprise security and control.", "display_url": "social.ora.cl/6015BHtXNx", "end": 266, "expanded_url": "https://social.ora.cl/6015BHtXNx", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2117265643875491840/IYVxDq-2?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117265643875491840/IYVxDq-2?format=jpg&name=150x150", "width": 150}], "start": 243, "status": 200, "title": "Oracle Introduces New AI-Powered Ways to Execute Work Across Oracle Fusion Applications", "unwound_url": "https://www.oracle.com/news/announcement/ai-world-oracle-introduces-new-ai-powered-ways-to-execute-work-across-oracle-fusion-applications-2026-10-26/?source=:so:ch:or:awr::::RC_WWMK260421P00055:FusionCompanion&SC=:so:ch:or:awr::::RC_WWMK260421P00055:FusionCompanion&pcode=WWMK260421P00055", "url": "https://t.co/ip0HfVh42L"}, {"display_url": "pic.x.com/0RqIReSA5L", "end": 299, "expanded_url": "https://x.com/RamonCastroII/status/2117014600327536880/photo/1", "media_key": "3_2117014597429256192", "start": 276, "url": "https://t.co/0RqIReSA5L"}]}, "id": "211701460032753