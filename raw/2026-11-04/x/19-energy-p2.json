{"data": [{"author_id": "2095946293034266624", "created_at": "2026-11-01T21:39:31.000Z", "edit_history_tweet_ids": ["2117008658848706925"], "entities": {"hashtags": [{"end": 145, "start": 134, "tag": "PeakEnergy"}, {"end": 149, "start": 146, "tag": "GM"}], "urls": [{"display_url": "pic.x.com/s1z2jBygC2", "end": 173, "expanded_url": "https://x.com/iCleanAI/status/2117008658848706925/photo/1", "media_key": "3_2117008651223433216", "start": 150, "url": "https://t.co/s1z2jBygC2"}]}, "id": "2117008658848706925", "public_metrics": {"bookmark_count": 0, "impression_count": 18, "like_count": 0, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "Peak Energy raised $108M in a round led by GM to build its first sodium-ion battery factory, in Sacramento, The Information reports.\n\n#PeakEnergy #GM https://t.co/s1z2jBygC2", "url": "https://x.com/iCleanAI/status/2117008658848706925"}, {"author_id": "1881168794", "created_at": "2026-11-01T21:00:07.000Z", "edit_history_tweet_ids": ["2116998745279578278"], "entities": {"urls": [{"description": "General Motors–backed startup Peak Energy boasts that it’s on a pathway to undercut China’s dominance of the massive batteries that power AI data centers and the grid. Its approach involves deploying an entirely different chemistry from the lithium-based ones China controls.But success, Peak ...", "display_url": "thein.fo/4ztQWrJ", "end": 219, "expanded_url": "https://thein.fo/4ztQWrJ", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2116636370626027520/TFsSdp1m?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116636370626027520/TFsSdp1m?format=jpg&name=150x150", "width": 150}], "start": 196, "status": 200, "title": "At Peak Energy, the Focus is on Avoiding the Missteps of a Big Battery Industry Failure", "unwound_url": "https://www.theinformation.com/newsletters/the-electric/peak-energy-focus-avoiding-missteps-big-battery-industry-failure?utm_campaign=Editorial&utm_content=Article&utm_medium=organic_social&utm_source=bluesky,threads,twitter", "url": "https://t.co/AGVVdJmd1s"}]}, "id": "2116998745279578278", "public_metrics": {"bookmark_count": 0, "impression_count": 5745, "like_count": 7, "quote_count": 1, "reply_count": 3, "retweet_count": 2}, "text": "Peak Energy is betting sodium-ion batteries can reduce U.S. reliance on Chinese battery technology, with a $108 million funding round led by GM to build its first Sacramento factory. \n\nRead more: https://t.co/AGVVdJmd1s", "url": "https://x.com/theinformation/status/2116998745279578278"}, {"author_id": "2100748706047983616", "created_at": "2026-11-01T23:45:36.000Z", "edit_history_tweet_ids": ["2117040392294265338"], "entities": {"mentions": [{"end": 169, "id": "1675231522016878592", "start": 159, "username": "Retna97xx"}, {"end": 182, "id": "1477804551466070020", "start": 170, "username": "kyriewolves"}, {"end": 194, "id": "1750685445296443392", "start": 183, "username": "KishiHoopz"}, {"end": 202, "id": "815417994889162752", "start": 195, "username": "JR6551"}, {"end": 214, "id": "2040981474996805632", "start": 203, "username": "legoat2348"}, {"end": 226, "id": "1639824398826762240", "start": 215, "username": "hoopaflagg"}], "urls": [{"display_url": "x.com/Timi_093/statu…", "end": 250, "expanded_url": "https://twitter.com/Timi_093/status/2117032714154938416", "start": 227, "url": "https://t.co/v8SGTjmD1L"}]}, "id": "2117040392294265338", "public_metrics": {"bookmark_count": 1, "impression_count": 674, "like_count": 6, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2117032714154938416", "type": "quoted"}], "text": "when Tatum does this: omg what a god from the midrange \n\nwhen Flagg does this: unsustainable SMR middys this shit is fake\n\nFlagg legit makes these exact shots @Retna97xx @kyriewolves @KishiHoopz @JR6551 @legoat2348 @hoopaflagg https://t.co/v8SGTjmD1L", "url": "https://x.com/BorzBratherAlt/status/2117040392294265338"}, {"