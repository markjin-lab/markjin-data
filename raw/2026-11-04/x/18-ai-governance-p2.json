{"data": [{"author_id": "539206628", "created_at": "2026-11-01T22:34:30.000Z", "edit_history_tweet_ids": ["2117022497334050913"], "entities": {"urls": [{"description": "It is worth asking whether Anthropic’s approach to allowing independent evaluations of its models will create meaningful oversight.", "display_url": "justsecurity.org/161488/frontie…", "end": 95, "expanded_url": "https://www.justsecurity.org/161488/frontier-ai-independent-evaluations-inconvenient-questions/", "images": [{"height": 1280, "url": "https://pbs.twimg.com/news_img/2117022504548286464/UxaWkP_s?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117022504548286464/UxaWkP_s?format=jpg&name=150x150", "width": 150}], "start": 72, "status": 200, "title": "Frontier AI and Independent Evaluations: Some Inconvenient Questions", "unwound_url": "https://www.justsecurity.org/161488/frontier-ai-independent-evaluations-inconvenient-questions/", "url": "https://t.co/Yan4gBW7ke"}]}, "id": "2117022497334050913", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Frontier AI and Independent Evaluations: Some Inconvenient Questions at https://t.co/Yan4gBW7ke", "url": "https://x.com/reckthei/status/2117022497334050913"}, {"author_id": "1683208137489227776", "created_at": "2026-11-01T23:12:45.000Z", "edit_history_tweet_ids": ["2117032124746248456"], "entities": {"urls": [{"display_url": "pic.x.com/tEVGTlpRWh", "end": 298, "expanded_url": "https://x.com/guilleflorvs/status/2117032124746248456/photo/1", "media_key": "3_2117032119708811264", "start": 275, "url": "https://t.co/tEVGTlpRWh"}]}, "id": "2117032124746248456", "public_metrics": {"bookmark_count": 7, "impression_count": 1014, "like_count": 10, "quote_count": 0, "reply_count": 3, "retweet_count": 1}, "text": "BREAKING: xAI just claimed the #1 spot in the global AI compute race.\n\nColossus 2 in Memphis is now the world's most powerful AI data center at 1.11M H100 equivalents.\n\nThat puts it ahead of OpenAI's Stargate in Abilene (1.02M), Amazon's New Carlisle (818K), and Microsoft's https://t.co/tEVGTlpRWh", "url": "https://x.com/guilleflorvs/status/2117032124746248456"}, {"author_id": "43156539", "created_at": "2026-11-01T23:09:41.000Z", "edit_history_tweet_ids": ["2117031351673409731", "2117033353019044135", "2117033401014526076", "2117033577523400992"], "entities": {"urls": [{"display_url": "x.com/jmaraganore/st…", "end": 179, "expanded_url": "https://twitter.com/jmaraganore/status/2116364866424619430", "start": 156, "url": "https://t.co/buC9ozMpVY"}]}, "id": "2117031351673409731", "public_metrics": {"bookmark_count": 0, "impression_count": 450, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2116364866424619430", "type": "quoted"}], "text": "Proud and excited to be working closely with Alnylam on accelerating and expanding their platform with our frontier AI models for sequence-based medicines. https://t.co/buC9ozMpVY", "url": "https://x.com/kyosu/status/2117031351673409731"}, {"author_id": "1899375311680372736", "created_at": "2026-11-01T22:02:38.000Z", "edit_history_tweet_ids": ["2117014476834877919"], "entities": {"urls": [{"display_url": "x.com/larsencc/statu…", "end": 169, "expanded_url": "https://twitter.com/larsencc/status/2117006841481937345", "start": 146, "url": "https://t.co/ZOk2eU0VeB"}]}, "id": "2117014476834877919", "public_metrics": {"bookmark_count": 1, "impression_count": 3517, "like_count": 79, "quote_count": 0, "reply_count": 10, "retweet_count": 1}, "referenced_tweets": [{"id": "2117006841481937345", "type": "quoted"}], "text": "I work on frontier AI and somehow made it to 2026 without ever using Wi-Fi on a plane.\n\nPosting this from 35,000 feet.\n\nTechnology is incredible. https://t.co/ZOk2eU0VeB", "url": "https://x.com/larsencc/status/2117014476834877919"}, {"author_id": "135922295", "created_at":