{"data": [{"author_id": "28164923", "created_at": "2026-11-02T21:26:52.000Z", "edit_history_tweet_ids": ["2117367866668224814"], "entities": {"urls": [{"description": "U.S. stocks ended mixed after hopes for U.S.-Iranian negotiations caused a slide in the price of oil, while concerns about a potential AI bust weighed on the technology sector.", "display_url": "on.wsj.com/4sGa8jB", "end": 83, "expanded_url": "https://on.wsj.com/4sGa8jB", "images": [{"height": 640, "url": "https://pbs.twimg.com/news_img/2117367868580823040/skkcpcAk?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117367868580823040/skkcpcAk?format=jpg&name=150x150", "width": 150}], "start": 60, "status": 200, "title": "U.S. Stocks Mixed as Percolating AI Fears Offset Oil Relief", "unwound_url": "https://www.wsj.com/finance/stocks/u-s-stocks-mixed-as-percolating-ai-fears-offset-oil-relief-6c9535a6?reflink=e2twmkts", "url": "https://t.co/xwcKXKhfsw"}]}, "id": "2117367866668224814", "public_metrics": {"bookmark_count": 3, "impression_count": 10410, "like_count": 9, "quote_count": 1, "reply_count": 5, "retweet_count": 0}, "text": "U.S. Stocks Mixed as Percolating AI Fears Offset Oil Relief https://t.co/xwcKXKhfsw", "url": "https://x.com/WSJmarkets/status/2117367866668224814"}, {"author_id": "3290364847", "created_at": "2026-11-02T20:34:50.000Z", "edit_history_tweet_ids": ["2117354771807883318"], "entities": {"hashtags": [{"end": 139, "start": 126, "tag": "midterms2026"}], "urls": [{"display_url": "pic.x.com/PZTfkj0fYL", "end": 163, "expanded_url": "https://x.com/statnews/status/2117354771807883318/video/1", "media_key": "13_2117354700169232384", "start": 140, "url": "https://t.co/PZTfkj0fYL"}]}, "id": "2117354771807883318", "public_metrics": {"bookmark_count": 0, "impression_count": 1843, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "How will Democrats and Republicans react to the election results? That's what STAT's Daniel Payne will be on the lookout for. #midterms2026 https://t.co/PZTfkj0fYL", "url": "https://x.com/statnews/status/2117354771807883318"}, {"author_id": "407985006", "created_at": "2026-11-02T20:29:39.000Z", "edit_history_tweet_ids": ["2117353467765276678"], "entities": {"urls": [{"description": "Researchers have used radio observations of rapidly spinning neutron stars to search for signals from supermassive black hole pairs at the dawn of galaxy formation.", "display_url": "go.aps.org/4kv9bIA", "end": 276, "expanded_url": "https://go.aps.org/4kv9bIA", "images": [{"height": 250, "url": "https://pbs.twimg.com/news_img/2117343352358416384/UCbrlKfj?format=png&name=orig", "width": 500}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117343352358416384/UCbrlKfj?format=png&name=150x150", "width": 150}], "start": 253, "status": 200, "title": "Using Pulsars to Probe Early Growth of Black Holes", "unwound_url": "https://physics.aps.org/articles/v19/146", "url": "https://t.co/7YOGTnUxG4"}, {"display_url": "pic.x.com/vSkvOqiZN9", "end": 300, "expanded_url": "https://x.com/PhysicsMagazine/status/2117353467765276678/photo/1", "media_key": "3_2117353464535613440", "start": 277, "url": "https://t.co/vSkvOqiZN9"}]}, "id": "2117353467765276678", "public_metrics": {"bookmark_count": 1, "impression_count": 1241, "like_count": 13, "quote_count": 1, "reply_count": 1, "retweet_count": 2}, "text": "Did black holes start massive, grow massive, or build up through mergers? Researchers used rapidly spinning neutron stars to place the first direct gravitational-wave limits on supermassive black hole growth at the dawn of galaxy formation.\n\nRead more: https://t.co/7YOGTnUxG4 https://t.co/vSkvOqiZN9", "url": "https://x.com/PhysicsMagazine/status/2117353467765276678"}, {"author_id": "32372834", "created_at": "2026-11-02T20:23:02.000Z", "edit_history_tweet_ids": ["2117351799908667833"], "entities": {"hashtags": [{"end": 206, "start": 192, "tag": "ScienceReview"}], "urls": [{"display_url": "pic.x.com/1qlkixv1A3", "end": 299, "expanded_url": "https://x.com/ScienceMagazine/status/2117351799908667833/photo/1", "media_key": "3_2117351795987005441", "start": 276, "url": "https://t.co/1qlkixv1A3"}]}, "id": "2117351799908667833", "public_metrics": {"bookmark_count": 280, "impression_count": 44125, "like_count": 616, "quote_count": 18, "reply_count": 22, "retweet_count": 183}, "text": "Menopause research has historically been underfunded and understudied, despite its enormous impact on half of the human population and nearly 40% of a woman’s lifespan. \n\nResearchers in a new #ScienceReview argue that menopause research needs a major rethink, shifting from a https://t.co/1qlkixv1A3", "url": "https://x.com/ScienceMagazine/status/2117351799908667833"}, {"author_id": "3290364847", "created_at": "2026-11-02T19:25:53.000Z", "edit_history_tweet_ids": ["2117337418848161971"], "entities": {"urls": [{"description": "Health care affordability is a major issue for voters, and a new kind of medical clinic sticks some patients with big bills.", "display_url": "trib.al/GW057VQ", "end": 148, "expanded_url": "https://trib.al/GW057VQ", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2117337427358478336/QiGw93vN?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117337427358478336/QiGw93vN?format=jpg&name=150x150", "width": 150}], "start": 125, "status": 200, "title": "The health care affordability midterms, and billing urgent care as ER", "unwound_url": "https://www.statnews.com/2026/11/02/health-care-affordability-midterms-hybrid-er-urgent-care-clinics-health-care-inc/?utm_campaign=twitter_organic&utm_source=twitter&utm_medium=social", "url": "https://t.co/Gd4RhvcVA5"}]}, "id": "2117337418848161971", "public_metrics": {"bookmark_count": 0, "impression_count": 1637, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Health care affordability is a major issue for voters, and a new kind of medical clinic sticks some patients with big bills. https://t.co/Gd4RhvcVA5", "url": "https://x.com/statnews/status/2117337418848161971"}, {"author_id": "32372834", "created_at": "2026-11-02T19:00:15.000Z", "edit_history_tweet_ids": ["2117330968755253597"], "entities": {"mentions": [{"end": 250, "id": "248897605", "start": 240, "username": "ScienceTM"}], "urls": [{"description": "CCR8xCD3 bispecific antibody potently boosts antitumor immunity by engaging T cells for the depletion of immunosuppressive intratumoral Treg cells.", "display_url": "scim.ag/4dZ2uL2", "end": 274, "expanded_url": "https://scim.ag/4dZ2uL2", "images": [{"height": 550, "url": "https://pbs.twimg.com/news_img/2115534043781455872/sw2amseF?format=jpg&name=orig", "width": 715}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115534043781455872/sw2amseF?format=jpg&name=150x150", "width": 150}], "start": 251, "status": 200, "title": "T cell–mediated depletion of intratumoral regulatory T cells using a CCR8xCD3 T cell–engaging bispecific antibody (TCB) promotes antitumor immunity in preclinical mouse models", "unwound_url": "https://www.science.org/doi/10.1126/scitranslmed.aea7127?utm_campaign=ScienceMagazine&utm_medium=ownedSocial&utm_source=twitter", "url": "https://t.co/YgPRqfZk6X"}, {"display_url": "pic.x.com/yeWDu5YsTR", "end": 298, "expanded_url": "https://x.com/ScienceMagazine/status/2117330968755253597/photo/1", "media_key": "3_2117330966146318337", "start": 275, "url": "https://t.co/yeWDu5YsTR"}]}, "id": "2117330968755253597", "public_metrics": {"bookmark_count": 45, "impression_count": 20469, "like_count": 150, "quote_count": 3, "reply_count": 4, "retweet_count": 33}, "text": "A new bispecific antibody targets both CCR8 to deplete regulatory T cells and CD3 to revitalize the broader anti-tumor T cell armada. It combated multiple tumor types and potentiated immunotherapy in mice while being safe in large animals. @ScienceTM https://t.co/YgPRqfZk6X https://t.co/yeWDu5YsTR", "url": "https://x.com/ScienceMagazine/status/2117330968755253597"}, {"author_id": "3290364847", "created_at": "2026-11-02T18:30:51.000Z", "edit_history_tweet_ids": ["2117323568836960677"], "entities": {"urls": [{"description": "Five Bay Area labs teamed up to compare lasting effects of psilocybin on anxiety and depression-like behavior in mice, with limited results:", "display_url": "trib.al/l3lV5iM", "end": 277, "expanded_url": "https://trib.al/l3lV5iM", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2117303360936124417/2Nueuf3D?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117303360936124417/2Nueuf3D?format=jpg&name=150x150", "width": 150}], "start": 254, "status": 200, "title": "Psilocybin's lasting benefits prove elusive in mice", "unwound_url": "https://www.statnews.com/2026/11/02/biotech-news-psilocybin-lasting-benefits-prove-elusive-in-mice/?utm_source=twitter&utm_medium=social&utm_campaign=twitter_organic", "url": "https://t.co/v1OXAn5lOC"}]}, "id": "2117323568836960677", "public_metrics": {"bookmark_count": 5, "impression_count": 2111, "like_count": 8, "quote_count": 0, "reply_count": 1, "retweet_count": 2}, "text": "In mice, researchers found that a single dose of psilocybin produced immediate effects in anxiety and reduced fear expression.\n\nBut 24 hours later, results showed no reproducible improvements in depression-like behavior, anxiety, or social interactions. https://t.co/v1OXAn5lOC", "url": "https://x.com/statnews/status/2117323568836960677"}, {"author_id": "15862891", "created_at": "2026-11-02T18:28:00.000Z", "edit_history_tweet_ids": ["2117322853666144533"], "entities": {"urls": [{"description": "Nature - An experimental concept enabling attosecond-precision, subcycle band-structure videography covering the entire first Brillouin zone is demonstrated and used to visualize the...", "display_url": "go.nature.com/4iH6Adj", "end": 117, "expanded_url": "https://go.nature.com/4iH6Adj", "images": [{"height": 1353, "url": "https://pbs.twimg.com/news_img/2117322867658326016/9rjbs6DZ?format=jpg&name=orig", "width": 1704}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117322867658326016/9rjbs6DZ?format=jpg&name=150x150", "width": 150}], "start": 94, "status": 200, "title": "Subcycle videography of Landau–Zener–Majorana transitions in graphene", "unwound_url": "https://www.nature.com/articles/s41586-026-11214-y?utm_source=x&utm_medium=social&utm_campaign=nature&linkId=64260476&error=cookies_not_supported&code=80f0ffd6-a37a-4a88-9bd1-62d62659653c", "url": "https://t.co/xUXmDNevNj"}]}, "id": "2117322853666144533", "public_metrics": {"bookmark_count": 19, "impression_count": 16279, "like_count": 57, "quote_count": 1, "reply_count": 4, "retweet_count": 31}, "text": "Nature research paper: Subcycle videography of Landau–Zener–Majorana transitions in graphene\n\nhttps://t.co/xUXmDNevNj", "url": "https://x.com/Nature/status/2117322853666144533"}, {"author_id": "3290364847", "created_at": "2026-11-02T18:15:56.000Z", "edit_history_tweet_ids": ["2117319814519685494"], "entities": {"urls": [{"description": "Pioneering IVF technique to reduce the risk of children inheriting mitochondrial diseases is being marketed as a fertility procedure for older women, despite little evidence it works.", "display_url": "statnews.com/2026/11/02/thr…", "end": 219, "expanded_url": "https://www.statnews.com/2026/11/02/three-parent-ivf-fertility-tourism-investigation-mrt-therapy/", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2117196310709202944/hdFagA7e?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117196310709202944/hdFagA7e?format=jpg&name=150x150", "width": 150}], "start": 196, "status": 200, "title": "Women travel thousands of miles for a reproductive moonshot. Scientists say they've been misled", "unwound_url": "https://www.statnews.com/2026/11/02/three-parent-ivf-fertility-tourism-investigation-mrt-th