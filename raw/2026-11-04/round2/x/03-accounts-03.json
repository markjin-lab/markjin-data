{"data": [{"author_id": "14096763", "created_at": "2026-11-03T21:53:38.000Z", "edit_history_tweet_ids": ["2117736989399109725"], "id": "2117736989399109725", "public_metrics": {"bookmark_count": 0, "impression_count": 2993, "like_count": 64, "quote_count": 1, "reply_count": 2, "retweet_count": 1}, "text": "These are the fun hours. Not enough data to really know anything. But enough data to accuse your opponents of engaging in “cope” and whatnot, which I’m sure must feel good.", "url": "https://x.com/TheStalwart/status/2117736989399109725"}, {"author_id": "497231011", "created_at": "2026-11-03T21:49:05.000Z", "edit_history_tweet_ids": ["2117735843922055598"], "entities": {"mentions": [{"end": 142, "id": "620021507", "start": 133, "username": "USCC_GOV"}], "urls": [{"description": "US officials have held up approval for American chipmaking equipment needed by SK ​Hynix to expand production in China, complicating the South Korean chipmaker's plans for new memory-chip plants in New York, according to people familiar with the matter.", "display_url": "reuters.com/world/china/sk…", "end": 214, "expanded_url": "https://www.reuters.com/world/china/sk-hynixs-new-york-chip-plans-hit-snag-over-us-restrictions-china-sources-say-2026-11-03/", "images": [{"height": 1005, "url": "https://pbs.twimg.com/news_img/2117721571208933376/PVEOevSi?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117721571208933376/PVEOevSi?format=jpg&name=150x150", "width": 150}], "start": 191, "status": 200, "title": "EXCLUSIVE: SK Hynix's New York chip plans hit snag over US restrictions on China, sources say", "unwound_url": "https://www.reuters.com/world/china/sk-hynixs-new-york-chip-plans-hit-snag-over-us-restrictions-china-sources-say-2026-11-03/", "url": "https://t.co/mVq8mbsaUl"}]}, "id": "2117735843922055598", "public_metrics": {"bookmark_count": 0, "impression_count": 456, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "\"Ultimately, none of this is going to go forward w/o a green light from the White House,\" said Leland Miller, ⁠a commissioner of the @USCC_GOV, a bipartisan panel created by the US Congress\"\nhttps://t.co/mVq8mbsaUl", "url": "https://x.com/ChinaBeigeBook/status/2117735843922055598"}, {"author_id": "14096763", "created_at": "2026-11-03T21:38:43.000Z", "edit_history_tweet_ids": ["2117733236386509060"], "entities": {"urls": [{"display_url": "x.com/nic_carter/sta…", "end": 294, "expanded_url": "https://twitter.com/nic_carter/status/2117700959166173482", "start": 271, "url": "https://t.co/MuabL65C0V"}]}, "id": "2117733236386509060", "public_metrics": {"bookmark_count": 0, "impression_count": 8584, "like_count": 32, "quote_count": 0, "reply_count": 12, "retweet_count": 0}, "referenced_tweets": [{"id": "2117700959166173482", "type": "quoted"}], "text": "I agree with Nic. Prediction markets can get it Wrong, not just wrong.\n\nI wonder what 2016 would’ve been like had we had Poly/Kalshi. OOH, a lot of people thought Trump had no shot. OTOH, a big liquid market may have incentivized people to examine real data more closely https://t.co/MuabL65C0V", "url": "https://x.com/TheStalwart/status/2117733236386509060"}, {"author_id": "30034124", "created_at": "2026-11-03T20:57:01.000Z", "edit_history_tweet_ids": ["2117722740199190879"], "entities": {"urls": [{"description": "Physicists have spent generations chasing a theory that could unify...", "display_url": "youtu.be/pLmLi-pJ604", "end": 185, "expanded_url": "https://youtu.be/pLmLi-pJ604", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2115591597798916096/Bej3fxyK?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115591597798916096/Bej3fxyK?format=jpg&name=150x150", "width": 150}], "start": 162, "status": 200, "title": "How long until we find a theory of everything | Don Lincoln", "unwound_url": "https://www.youtube.com/watch?v=pLmLi-pJ604&feature=youtu.be", "url": "https://t.co/gXBB62J922"}]}, "id": "2117722740199190879", "public_metrics": {"bookmark_count": 1, "impression_count": 701, "like_count": 7, "quote_count": 1, "reply_count": 2, "retweet_count": 1}, "text": "The search for a theory that fully describes all phenomena in the universe is the ultimate goal of physics research. How close are we do a theory of everything? \nhttps://t.co/gXBB62J922", "url": "https://x.com/Fermilab/status/2117722740199190879"}, {"author_id": "702235316812275712", "created_at": "2026-11-03T20:56:25.000Z", "edit_history_tweet_ids": ["2117722590311792888"], "entities": {"urls": [{"display_url": "pic.x.com/oUDgCWVU8M", "end": 154, "expanded_url": "https://x.com/EconBerger/status/2117722590311792888/photo/1", "media_key": "3_2117722586998333440", "start": 131, "url": "https://t.co/oUDgCWVU8M"}]}, "id": "2117722590311792888", "public_metrics": {"bookmark_count": 0, "impression_count": 989, "like_count": 4, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Only a few more hours until we find out if the forecasts are correct\n\n(of very light snowfall in the mountains west of Lake Tahoe) https://t.co/oUDgCWVU8M", "url": "https://x.com/EconBerger/status/2117722590311792888"}], "includes": {"users": [{"id": "14096763", "name": "Joe Weisenthal", "username": "TheStalwart"}, {"id": "497231011", "name": "China Beige Book", "username": "ChinaBeigeBook"}, {"id": "30034124", "name": "Fermilab", "username": "Fermilab"}, {"id": "702235316812275712", "name": "Guy Berger", "username": "EconBerger"}]}, "meta": {"newest_id": "2117736989399109725", "next_token": "b26v89c19zqg8o3juzlyijzg7xwl9y5rqylawjtjmkkn1", "oldest_id": "2117722590311792888", "result_count": 5}}
