2110076009236021384/photo/1","media_key":"3_2110075846740279296","start":258,"url":"https://t.co/m87UrqDnXz"}]},"id":"2110076009236021384","public_metrics":{"bookmark_count":0,"impression_count":2199,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":2},"text":"Europe has much to gain fromAI, says Chief Economist Philip R. Lane at the International AI Summit in Dublin. Realising these benefits will require action from a wide range of actors to support the sustainable transformation of the economy.\n\nRead the speech https://t.co/m87UrqDnXz","url":"https://x.com/ecb/status/2110076009236021384"},{"author_id":"59603406","created_at":"2026-10-13T18:23:43.000Z","edit_history_tweet_ids":["2110074014567981206"],"entities":{"urls":[{"description":"Federal Reserve Bank of New York President John Williams said one more increase in interest rates will be appropriate this year, but he doesn’t think it will be necessary to hike them further in 2027.","display_url":"bloomberg.com/news/articles/…","end":166,"expanded_url":"https://www.bloomberg.com/news/articles/2026-10-13/fed-s-williams-interview-with-bloomberg-news-full-transcript","images":[{"height":800,"url":"https://pbs.twimg.com/news_img/2110074016820334592/8XI44niJ?format=jpg&name=orig","width":1200},{"height":150,"url":"https://pbs.twimg.com/news_img/2110074016820334592/8XI44niJ?format=jpg&name=150x150","width":150}],"start":143,"status":200,"title":"Fed’s Williams Interview With Bloomberg News: Full Transcript","unwound_url":"https://www.bloomberg.com/news/articles/2026-10-13/fed-s-williams-interview-with-bloomberg-news-full-transcript","url":"https://t.co/Iuf2o0NVbE"}]},"id":"2110074014567981206","public_metrics":{"bookmark_count":15,"impression_count":27976,"like_count":97,"quote_count":6,"reply_count":14,"retweet_count":20},"text":"NY Fed President John Williams tells Bloomberg he still expects maybe one more rate increase this year and then for 2027, \"we'll have to see.\" https://t.co/Iuf2o0NVbE","url":"https://x.com/NickTimiraos/status/2110074014567981206"},{"attachments":{"media_keys":["3_2110063212221906944"]},"author_id":"26538229","created_at":"2026-10-13T17:41:08.000Z","edit_history_tweet_ids":["2110063300826534305"],"entities":{"hashtags":[{"end":7,"start":0,"tag":"FedFAQ"}],"urls":[{"description":"The Federal Reserve Board of Governors in Washington DC.","display_url":"federalreserve.gov/aboutthefed/fe…","end":91,"expanded_url":"https://www.federalreserve.gov/aboutthefed/fedexplained/who-we-are.htm","images":[{"height":800,"url":"https://pbs.twimg.com/news_img/2109487224438071296/onsYeMzn?format=jpg&name=orig","width":800},{"height":150,"url":"https://pbs.twimg.com/news_img/2109487224438071296/onsYeMzn?format=jpg&name=150x150","width":150}],"start":68,"status":200,"title":"Who We Are","unwound_url":"https://www.federalreserve.gov/aboutthefed/fedexplained/who-we-are.htm","url":"https://t.co/8x8QevFCSM"},{"display_url":"pic.x.com/zDhvOtmtKY","end":115,"expanded_url":"https://x.com/federalreserve/status/2110063300826534305/photo/1","media_key":"3_2110063212221906944","start":92,"url":"https://t.co/zDhvOtmtKY"}]},"id":"2110063300826534305","public_metrics":{"bookmark_count":3,"impression_count":17441,"like_count":16,"quote_count":0,"reply_count":5,"retweet_count":6},"text":"#FedFAQ: How is the Federal Reserve System structured?\n\nLearn more: https://t.co/8x8QevFCSM https://t.co/zDhvOtmtKY","url":"https://x.com/federalreserve/status/2110063300826534305"},{"attachments":{"media_keys":["3_2110061423896256512"]},"author_id":"1831398480700428289","created_at":"2026-10-13T17:33:52.000Z","edit_history_tweet_ids":["2110061471937757320"],"entities":{"urls":[{"description":"Multiple organizations have disclosed high-profile security failures: their AI models bypassed insufficiently sandboxed environments to compromise the systems of external organizations. On the one hand, one can view these incidents as evidence for the importance of AI alignment to ensure models operate predictably. On the other hand, they can also be seen as an irresponsible lapse in standard cybersecurity practices, preventable with stronger sandboxes and procedures. We believe that both improved AI","display_url":"ai-security-letter.org","end":258,"expanded_url":"https://ai-security-letter.org/","start":235,"status":200,"title":"October 2026 Open Letter from the Scientific Community on AI and Cybersecurity","unwound_url":"https://ai-security-letter.org/","url":"https://t.co/KieWSpurn9"},{"display_url":"pic.x.com/eK9DGS0M4C","end":282,"expanded_url":"https://x.com/Yoshua_Bengio/status/2110061471937757320/photo/1","media_key":"3_2110061423896256512","start":259,"url":"https://t.co/eK9DGS0M4C"}]},"id":"2110061471937757320","public_metrics":{"bookmark_count":62,"impression_count":13450,"like_count":243,"quote_count":15,"reply_count":24,"retweet_count":60},"text":"Over 400 researchers and I have signed this open letter calling for the AI and security communities to come together to improve alignment and containment approaches in order to protect our critical infrastructure and digital systems.\n\nhttps://t.co/KieWSpurn9 https://t.co/eK9DGS0M4C","url":"https://x.com/Yoshua_Bengio/status/2110061471937757320"},{"author_id":"39125788","created_at":"2026-10-13T17:30:29.000Z","edit_history_tweet_ids":["2110060618258497764"],"id":"2110060618258497764","public_metrics":{"bookmark_count":311,"impression_count":132156,"like_count":3153,"quote_count":18,"reply_count":110,"retweet_count":95},"text":"Using Gemini 4 makes you realize how many other models must be distilling Claude/GPT (or using a similar training pipeline). It feels quite different than other models.","url":"https://x.com/emollick/status/2110060618258497764"},{"author_id":"1831398480700428289","created_at":"2026-10-13T17:24:10.000Z","edit_history_tweet_ids":["2110059028391072224"],"entities":{"mentions":[{"end":69,"id":"11388132","start":62,"username":"lessig"},{"end":240,"id":"5988062","start":227,"username":"TheEconomist"}]},"id":"2110059028391072224","public_metrics":{"bookmark_count":23,"impression_count":4518,"like_count":97,"quote_count":1,"reply_count":9,"retweet_count":21},"text":"I've had so many insightful conversations over the years with @lessig, an expert on AI regulation and legislation, including more recent ones on the cyber incidents of this past summer.\n\nHappy to share our thoughts in this new @TheEconomist op-ed, where we outline concrete","url":"https://x.com/Yoshua_Bengio/status/2110059028391072224"},{"attachments":{"media_keys":["3_2110051996304621569"]},"author_id":"39125788","created_at":"2026-10-13T16:57:33.000Z","edit_history_tweet_ids":["2110052331702124894"],"entities":{"urls":[{"display_url":"pic.x.com/9OHn9wIzHJ","end":303,"expanded_url":"https://x.com/emollick/status/2110052331702124894/photo/1","media_key":"3_2110051996304621569","start":280,"url":"https://t.co/9OHn9wIzHJ"}]},"id":"2110052331702124894","public_metrics":{"bookmark_count":139,"impression_count":35531,"like_count":567,"quote_count":3,"reply_count":66,"retweet_count":33},"text":"I spent a decent amount of time with Gemini 4 before launch. Overall, Gemini 4 is a big jump over previous Gemini models and it is the first non-OpenAI/Anthropic model to pass the Fable/Mythos/Astra bar. It is also much more pleasant and more agentic then previous Gemini models, https://t.co/9OHn9wIzHJ","url":"https://x.com/emollick/status/2110052331702124894"},{"author_id":"68746721","created_at":"2026-10-13T16:51:27.000Z","edit_history_tweet_ids":["2110050795890827756"],"entities":{"urls":[{"display_url":"x.com/quinn_leng/sta…","end":304,"expanded_url":"https://twitter.com/quinn_leng/status/2110036327286886731","start":281,"url":"https://t.co/F1dIojeWzZ"}]},"id":"2110050795890827756","public_metrics":{"bookmark_count":203,"impression_count":704107,"like_count":339,"quote_count":5,"reply_count":59,"retweet_count":15},"text":"If an agent saves an engineer 2 hours to implement a feature but collectively costs the team 3 hours in alignment and review, the ROI is negative.\n\nIsolated chats are suboptimal in team environments because they lack the context of what the team already discussed and decided. The https://t.co/F1dIojeWzZ","url":"https://x.com/fchollet/status/2110050795890827756"},{"author_id":"68746721","created_at":"2026-10-13T16:20:16.000Z","edit_history_tweet_ids":["2110042948821975317"],"entities":{"urls":[{"display_url":"x.com/sundarpichai/s…","end":78,"expanded_url":"https://twitter.com/sundarpichai/status/2110038898009407584","start":55,"url":"https://t.co/rHyLTNeiHi"}]},"id":"2110042948821975317","public_metrics":{"bookmark_count":25,"impression_count":25715,"like_count":260,"quote_count":1,"reply_count":15,"retweet_count":4},"text":"Congrats on the release! Looks like a fantastic model. https://t.co/rHyLTNeiHi","url":"https://x.com/fchollet/status/2110042948821975317"},{"attachments":{"media_keys":["13_2110033690373853184"]},"author_id":"59603406","created_at":"2026-10-13T15:55:32.000Z","edit_history_tweet_ids":["2110036724990550452"],"entities":{"mentions":[{"end":135,"id":"38154268","start":122,"username":"SalehaMohsin"}],"urls":[{"display_url":"pic.x.com/q4cwK3iVSw","end":295,"expanded_url":"https://x.com/NickTimiraos/status/2110036724990550452/video/1","media_key":"13_2110033690373853184","start":272,"url":"https://t.co/q4cwK3iVSw"}]},"id":"2110036724990550452","public_metrics":{"bookmark_count":18,"impression_count":34229,"like_count":107,"quote_count":6,"reply_count":13,"retweet_count":29},"text":"Fed governor Chris Waller addresses the White House's challenges to Fed independence during an interview with Bloomberg's @SalehaMohsin:\n\n\"There is a threat to Fed independence by the administration. So far, it hasn't really succeeded.... I'm hoping that that continues.\" https://t.co/q4cwK3iVSw","url":"https://x.com/NickTimiraos/status/2110036724990550452"},{"attachments":{"media_keys":["3_2110034717097562112"]},"author_id":"612896910","created