{"data":[{"attachments":{"media_keys":["3_2110109324156846080"]},"author_id":"25098482","created_at":"2026-10-13T20:44:02.000Z","edit_history_tweet_ids":["2110109327478657051"],"entities":{"urls":[{"description":"Stay tuned for the IMF's October 2026 World Economic Outlook, with analytical chapters released on October 5 and 6 and the full report published on October 13 during the 2026 Annual Meetings in Bangkok, Thailand.","display_url":"imf.org/en/publication…","end":279,"expanded_url":"https://www.imf.org/en/publications/weo/issues/2026/10/13/world-economic-outlook-october-2026?cid=sm-com-x-am26-WEOEA20206002","images":[{"height":350,"url":"https://pbs.twimg.com/news_img/2108769532861177856/r-ID7Ofg?format=png&name=orig","width":600},{"height":150,"url":"https://pbs.twimg.com/news_img/2108769532861177856/r-ID7Ofg?format=png&name=150x150","width":150}],"start":256,"status":200,"title":"Coming Soon: World Economic Outlook, October 2026","unwound_url":"https://www.imf.org/en/publications/weo/issues/2026/10/13/world-economic-outlook-october-2026?cid=sm-com-x-am26-WEOEA20206002","url":"https://t.co/vwXHRxkW4n"},{"display_url":"pic.x.com/aqtMJgXWww","end":303,"expanded_url":"https://x.com/IMFNews/status/2110109327478657051/photo/1","media_key":"3_2110109324156846080","start":280,"url":"https://t.co/aqtMJgXWww"}]},"id":"2110109327478657051","public_metrics":{"bookmark_count":0,"impression_count":4568,"like_count":7,"quote_count":0,"reply_count":1,"retweet_count":1},"text":"Growth in advanced economies is projected at 2.1% in 2026 and 1.8% in 2027. Outcomes remain uneven, with net energy exporters partly cushioned by favorable terms of trade, while net energy importers face a larger drag from higher energy prices. Read more: https://t.co/vwXHRxkW4n https://t.co/aqtMJgXWww","url":"https://x.com/IMFNews/status/2110109327478657051"},{"attachments":{"media_keys":["3_2110087978626244608"]},"author_id":"1161370756208648193","created_at":"2026-10-13T19:19:37.000Z","edit_history_