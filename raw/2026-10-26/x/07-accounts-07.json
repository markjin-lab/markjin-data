com/steveflanders2…", "end": 94, "expanded_url": "https://twitter.com/steveflanders22/status/2113653559317377055", "start": 71, "url": "https://t.co/vasDpvQs2w"}]}, "id": "2113795439602569339", "public_metrics": {"bookmark_count": 48, "impression_count": 21318, "like_count": 109, "quote_count": 0, "reply_count": 10, "retweet_count": 5}, "referenced_tweets": [{"id": "2113653559317377055", "type": "quoted"}], "text": "This actually looks rather bad for several major market categories!!!! https://t.co/vasDpvQs2w", "url": "https://x.com/lymanstoneky/status/2113795439602569339"}, {"author_id": "34743251", "created_at": "2026-10-24T00:14:01.000Z", "edit_history_tweet_ids": ["2113786051009696177"], "entities": {"mentions": [{"end": 30, "id": "1330170106501079041", "start": 21, "username": "Starlink"}], "urls": [{"display_url": "pic.x.com/OHHSEsn3Qz", "end": 81, "expanded_url": "https://x.com/SpaceX/status/2113786051009696177/photo/1", "media_key": "3_2113785942351704064", "start": 58, "url": "https://t.co/OHHSEsn3Qz"}, {"display_url": "pic.x.com/OHHSEsn3Qz", "end": 81, "expanded_url": "https://x.com/SpaceX/status/2113786051009696177/photo/1", "media_key": "3_2113785951587643392", "start": 58, "url": "https://t.co/OHHSEsn3Qz"}]}, "id": "2113786051009696177", "public_metrics": {"bookmark_count": 189, "impression_count": 2426491, "like_count": 9406, "quote_count": 151, "reply_count": 444, "retweet_count": 988}, "text": "Falcon 9 launches 27 @Starlink satellites from California https://t.co/OHHSEsn3Qz", "url": "https://x.com/SpaceX/status/2113786051009696177"}, {"author_id": "34743251", "created_at": "2026-10-23T23:51:12.000Z", "edit_history_tweet_ids": ["2113780307904381100"], "entities": {"mentions": [{"end": 26, "id": "1330170106501079041", "start": 17, "username": "Starlink"}]}, "id": "2113780307904381100", "public_metrics": {"bookmark_count": 93, "impression_count": 1768061, "like_count": 10298, "quote_count": 41, "reply_count": 283, "retweet_count": 542}, "text": "Deployment of 27 @Starlink satellites confirmed", "url": "https://x.com/SpaceX/status/2113780307904381100"}, {"author_id": "11348282", "created_at": "2026-10-23T23:37:56.000Z", "edit_history_tweet_ids": ["2113776971603689874"], "entities": {"urls": [{"description": "Before astronauts return to the lunar surface, NASA will first conduct one of the most ambitious and complex test missions in the agency's history. ", "display_url": "go.nasa.gov/4jzartX", "end": 188, "expanded_url": "https://go.nasa.gov/4jzartX", "images": [{"height": 2250, "url": "https://pbs.twimg.com/news_img/2113776976758444032/75yidGQd?format=jpg&name=orig", "width": 4000}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113776976758444032/75yidGQd?format=jpg&name=150x150", "width": 150}], "start": 165, "status": 200, "title": "NASA’s Artemis III Mission to Test Future Moon Lander Operations - NASA", "unwound_url": "https://www.nasa.gov/missions/artemis/nasas-artemis-iii-mission-to-test-future-moon-lander-operations/?utm_source=TWITTER&utm_medium=NASA&utm_campaign=NASASocial&linkId=1026248244", "url": "https://t.co/jSHP2lHuOx"}, {"display_url": "pic.x.com/m8taK5B7Oy", "end": 298, "expanded_url": "https://x.com/NASA/status/2113776971603689874/video/1", "media_key": "13_2113776813121941504", "start": 275, "url": "https://t.co/m8taK5B7Oy"}]}, "id": "2113776971603689874", "public_metrics": {"bookmark_count": 342, "impression_count": 1278872, "like_count": 7478, "quote_count": 84, "reply_count": 344, "retweet_count": 978}, "text": "We are not slowing down. 🚀\n\nOur Artemis III mission will send four astronauts to low Earth orbit next year to test critical systems needed for future lunar landings https://t.co/jSHP2lHuOx and we’re accelerating efforts to ensure the success of Artemis IV, the first Artemis https://t.co/m8taK5B7Oy", "url": "https://x.com/NASA/status/2113776971603689874"}, {"author_id": "17217640", "created_at": "2026-10-23T22:51:35.000Z", "edit_history_tweet_ids": ["2113765304354378192"], "entities": {"urls": [{"description": "Watch live coverage as SpaceX launches a Falcon 9 rocket from Calif...", "display_url": "youtube.com/watch?v=hANSUk…", "end": 203, "expanded_url": "https://www.youtube.com/watch?v=hANSUkrKDwQ", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2113747297037402112/MbXkLWWZ?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113747297037402112/MbXkLWWZ?format=jpg&name=150x150", "width": 150}], "start": 180, "status": 200, "title": "SpaceX Falcon 9 rocket launches from California with 27 Starlink satellites", "unwound_url": "https://www.youtube.com/watch?v=hANSUkrKDwQ", "url": "https://t.co/NcN9jHkYrN"}, {"display_url": "pic.x.com/uBmJ5orpqy", "end": 227, "expanded_url": "https://x.com/SpaceflightNow/status/2113765304354378192/photo/1", "media_key": "3_2113764994030436352", "start": 204, "url": "https://t.co/uBmJ5orpqy"}]}, "id": "2113765304354378192", "public_metrics": {"bookmark_count": 2, "impression_count": 8260, "like_count": 101, "quote_count": 2, "reply_count": 4, "retweet_count": 11}, "text": "Liftoff! After three previous scrubs, the Starlink 15-15 mission launched on a Falcon 9 rocket from Vandenberg Space Force Base at 3:48 pm PT (6:48 pm ET / 2248 UTC).\n\nWatch live: https://t.co/NcN9jHkYrN https://t.co/uBmJ5orpqy", "url": "https://x.com/SpaceflightNow/status/2113765304354378192"}, {"author_id": "34743251", "created_at": "2026-10-23T22:37:56.000Z", "edit_history_tweet_ids": ["2113761872264712327"], "entities": {"mentions": [{"end": 34, "id": "1330170106501079041", "start": 25, "username": "Starlink"}], "urls": [{"description": "Starlink Mission", "display_url": "x.com/i/broadcasts/1…", "end": 94, "expanded_url": "https://x.com/i/broadcasts/1qKDzWkEraoJV", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2113638961234984960/kCGmcUYU?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/211363896123498496