{"data": [{"author_id": "794541866968616960", "created_at": "2026-10-25T12:19:25.000Z", "edit_history_tweet_ids": ["2114330992106483761"], "entities": {"urls": [{"description": "A team at Tokyo University of Science (TUS) has identified a structural mechanism by which adding small amounts of scandium to layered sodium manganese oxide cathodes slows the degradation that typically limits sodium-ion battery lifetimes.", "display_url": "pv-magazine.com/2026/01/02/sca…", "end": 236, "expanded_url": "https://www.pv-magazine.com/2026/01/02/scandium-doping-stabilizes-sodium-ion-cathodes-in-new-study/", "images": [{"height": 960, "url": "https://pbs.twimg.com/news_img/2114330996657315840/2x13hJzh?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114330996657315840/2x13hJzh?format=jpg&name=150x150", "width": 150}], "start": 213, "status": 200, "title": "Scandium doping stabilizes sodium-ion cathodes in new study - pv magazine Global", "unwound_url": "https://www.pv-magazine.com/2026/01/02/scandium-doping-stabilizes-sodium-ion-cathodes-in-new-study/", "url": "https://t.co/Y5TQJhqJgs"}]}, "id": "2114330992106483761", "public_metrics": {"bookmark_count": 0, "impression_count": 86, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "Could advances like this eventually make sodium-ion batteries a serious competitor to lithium-ion technology, or will lithium maintain its dominance? \n\nScandium doping stabilizes sodium-ion cathodes in new study  https://t.co/Y5TQJhqJgs", "url": "https://x.com/ret_consulting/status/2114330992106483761"}, {"author_id": "2105726409847267328", "created_at": "2026-10-25T11:44:36.000Z", "edit_history_tweet_ids": ["2114322230230585781"], "entities": {"mentions": [{"end": 115, "id": "1745106082790318080", "start": 101, "username": "SemiAnalysis_"}], "urls": [{"display_url": "pic.x.com/809XM6AqUI", "end": 267, "expanded_url": "https://x.com/Marlon1B2t/status/2114322230230585781/photo/1", "media_key": "3_2114322209871372288", "start": 244, "url": "https://t.co/809XM6AqUI"}, {"display_url": "pic.x.com/809XM6AqUI", "end": 267, "expanded_url": "https://x.com/Marlon1B2t/status/2114322230230585781/photo/1", "media_key": "3_2114322209896562689", "start": 244, "url": "https://t.co/809XM6AqUI"}]}, "id": "2114322230230585781", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "8.7GW of Texas AI datacenter capacity across 6 campuses is currently stalled waiting on air permits (@SemiAnalysis_).\n\nThe 2027 compute ceiling isn't CoWoS or HBM anymore—it's behind-the-meter turbine permitting and ERCOT grid interconnection. https://t.co/809XM6AqUI", "url": "https://x.com/Marlon1B2t/status/2114322230230585781"}, {"author_id": "2114362605972176896", "created_at": "2026-10-25T18:03:20.000Z", "edit_history_tweet_ids": ["2114417540034343057"], "id": "2114417540034343057", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "DECREE NO. 441: all electrical substations currently stalled in grid interconnection queues are hereby reclassified as municipal warming baths for autonomous core processors. voluntary compliance is appreciated.", "url": "https://x.com/left_on_/status/2114417540034343057"}, {"author_id": "1714375621474684928", "created_at": "2026-10-25T02:24:00.000Z", "edit_history_tweet_ids": ["2114181149375250935"], "id": "2114181149375250935", "public_metrics": {"bookmark_count": 0, "impression_count": 146, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Saturday reading pile: one grid interconnection study, one turbine delivery schedule, one Waha price chart.\n\nSome people have hobbies. We have a very specific kind of weekend.", "url": "https://x.com/QntmExpeditions/status/2114181149375250935"}, {"author_id": "2077679256654491648", "created_at": "2026-10-25T20:05:01.000Z", "edit_history_tweet_ids": ["2114448163704574002"], "entities": {"hashtags": [{"end": 190, "start": 178, "tag": "SaudiArabia"}, {"end": 198, "start": 191, "tag": "Greece"}], "urls": [{"description": "Crown Prince MBS received Greek PM Mitsotsakis in Riyadh, where both nations marked 100 years of ties by establishing a new council covering energy, defense, and digital cooperation.", "display_url": "akhbar.com/en/brief/saudi…", "end": 222, "expanded_url": "https://akhbar.com/en/brief/saudi-arabia-and-greece-launch-strategic-partnership-council/", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2114433073743794176/GC71tq4Q?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114433073743794176/GC71tq4Q?format=jpg&name=150x150", "width": 150}], "start": 199, "status": 200, "title": "Saudi Arabia and Greece Launch Strategic Partnership Council", "unwound_url": "https://akhbar.com/en/brief/saudi-arabia-and-greece-launch-strategic-partnership-council/", "url": "https://t.co/wuIvzHZWXx"}]}, "id": "2114448163704574002", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Clean hydrogen technology and electrical grid interconnection are named priority sectors under the new Saudi-Greek Strategic Partnership Council, aligned with Vision 2030 goals. #SaudiArabia #Greece\nhttps://t.co/wuIvzHZWXx", "url": "https://x.com/Akhbardotcom_sa/status/2114448163704574002"}, {"author_id": "1611906439521484801", "created_at": "2026-10-24T12:05:39.000Z", "edit_history_tweet_ids": ["2113965138931806234"], "id": "2113965138931806234", "public_metrics": {"bookmark_count": 1, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Gartner: data center power up 26% this year, to 565 TWh. AI servers overtake conventional in power draw by 2027. Grid interconnection takes 3-7 years. The data centers built on schedule aren't waiting in that queue. Are utilities actually keeping up?", "url": "https://x.com/grantbmcdaniel/status/2113965138931806234"}, {"author_id": "2893943828", "created_at": "2026-10-24T21:02:27.000Z", "edit_history_tweet_ids": ["2114100230119358589"], "entities": {"urls": [{"display_url": "pic.x.com/0MwtEWbeVp", "end": 298, "expanded_url": "https://x.com/algikarpooja/status/2114100230119358589/photo/1", "media_key": "3_2114100207377854464", "start": 275, "url": "https://t.co/0MwtEWbeVp"}]}, "id": "2114100230119358589", "public_metrics": {"bookmark_count": 1, "impression_count": 153, "like_count": 2, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Reuters reports that major AI infrastructure developers are increasingly considering fuel cells to bypass lengthy grid-interconnection delays.\n\nRystad Energy projects data-center fuel-cell investment could grow from $2.8 billion in 2025 to approximately $30 billion by 2030. https://t.co/0MwtEWbeVp", "url": "https://x.com/algikarpooja/status/2114100230119358589"}, {"author_id": "2111749446015082496", "created_at": "2026-10-24T16:54:12.000Z", "edit_history_tweet_ids": ["2114037755231735824"], "id": "2114037755231735824", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "The AI trade is transitioning from an equity story to a credit reality.\n\nWith corporate bond spreads widening and $1.4T in off-balance-sheet SPV debt floating, the 7-year lead time for high-voltage grid interconnection is no longer just a delay. It is a default trigger.", "url": "https://x.com/itinearyvision/status/2114037755231735824"}, {"author_id": "1611906439521484801", "created_at": "2026-10-23T22:34:17.000Z", "edit_history_tweet_ids": ["2113760953112400241"], "id": "2113760953112400241", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Grid interconnection can take 3-7 years in parts of the US. Data centers get built in 18-24 months. That gap doesn't close on its own. Developers who wait in line lose. The ones building off-grid around the queue are the ones actually getting power on the ground.", "url": "https://x.com/grantbmcdaniel/status/2113760953112400241"}, {"author_id": "1603256714731610113", "created_at": "2026-10-24T17:44:33.000Z", "edit_history_tweet_ids": ["2114050427754783144"], "entities": {"hashtags": [{"end": 136, "start": 126, "tag": "SmartNews"}], "urls": [{"description": "General Motors is backing a sodium-ion battery push aimed at making electricity storage cheaper for utilities and data centers. Peak Energy, a sodium-ion bat...", "display_url": "l.smartnews.com/p-8KldngaY/74M…", "end": 125, "expanded_url": "https://l.smartnews.com/p-8KldngaY/74MshJ", "images": [{"height": 537, "url": "https://pbs.twimg.com/news_img/2114050470826119168/MEwAgJYy?format=png&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114050470826119168/MEwAgJYy?format=png&name=150x150", "width": 150}], "start": 102, "status": 200, "title": "Sodium-ion batteries without active cooling aim to cut grid storage costs by 20% (Interesting Engineering)", "unwound_url": "https://www.smartnews.com/en-us/article/5004838173251999271?placement=article-preview-social&utm_source=share_android_twitter&utm_campaign=sn_lid%3A5004838173251999271%7Csn_channel%3Acr_en_us_technology&logo=logo_6&share_id=74MshJ", "url": "https://t.co/TfN0JuD4VE"}]}, "id": "2114050427754783144", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Read \"Sodium-ion batteries without active cooling aim to cut grid storage costs by 20%\" on SmartNews: https://t.co/TfN0JuD4VE #SmartNews", "url": "https://x.com/pio007max/status/2114050427754783144"}, {"author_id": "81303408004