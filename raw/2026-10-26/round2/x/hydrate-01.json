{"data": [{"author_id": "332617373", "created_at": "2026-10-25T21:05:05.000Z", "edit_history_post_ids": ["2114463279800307807"], "entities": {"mentions": [{"end": 143, "id": "5988062", "start": 130, "username": "TheEconomist"}]}, "id": "2114463279800307807", "public_metrics": {"bookmark_count": 1, "impression_count": 12222, "like_count": 24, "quote_count": 0, "reply_count": 9, "repost_count": 0}, "text": "From The Economist article on Europe:\n\"Today, while centrists huddle together for protection, all the energy is at the extremes.\"\n@TheEconomist", "url": "https://x.com/elerianm/status/2114463279800307807"}, {"author_id": "3512101", "created_at": "2026-10-25T22:00:00.000Z", "edit_history_post_ids": ["2114477098442084685"], "entities": {"urls": [{"display_url": "x.com/benmullin/stat…", "end": 58, "expanded_url": "https://twitter.com/benmullin/status/2114462704970985576", "start": 35, "url": "https://t.co/rjF2FxTQn7"}]}, "id": "2114477098442084685", "public_metrics": {"bookmark_count": 0, "impression_count": 310, "like_count": 1, "quote_count": 0, "reply_count": 0, "repost_count": 0}, "referenced_tweets": [{"id": "2114462704970985576", "type": "quoted"}], "text": "Too bad, have done some great work https://t.co/rjF2FxTQn7", "url": "https://x.com/niubi/status/2114477098442084685"}, {"author_id": "860158302", "created_at": "2026-10-25T21:44:00.000Z", "edit_history_post_ids": ["2114473075488047208"], "entities": {"urls": [{"description": "Unlike other recent AI proofs, this one has been unpacked by human experts. The implications, one mathematician said, are “staggering.”", "display_url": "quantamagazine.org/ai-proved-the-…", "end": 279, "expanded_url": "https://www.quantamagazine.org/ai-proved-the-quasi-riemann-hypothesis-what-happens-now-20261019/", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2112208775390060545/X8JrAynA?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2112208775390060545/X8JrAynA?f