5337073/photo/1","media_key":"3_2113028989203668993","start":141,"url":"https://t.co/OtZWVdv49v"}]},"id":"2113029005595337073","public_metrics":{"bookmark_count":9,"impression_count":11897,"like_count":573,"quote_count":4,"reply_count":33,"retweet_count":31},"text":"Honored to receive this evening the Loftus Space Sustainability Award from the International Association for the Advancement of Space Safety https://t.co/OtZWVdv49v","url":"https://x.com/planet4589/status/2113029005595337073"},{"author_id":"626660983","created_at":"2026-10-21T21:23:01.000Z","edit_history_tweet_ids":["2113018242411405396"],"entities":{"urls":[{"display_url":"x.com/shashj/status/…","end":300,"expanded_url":"https://twitter.com/shashj/status/2113014148145582262","start":277,"url":"https://t.co/wZoyco9fhR"}]},"id":"2113018242411405396","public_metrics":{"bookmark_count":23,"impression_count":11690,"like_count":153,"quote_count":2,"reply_count":34,"retweet_count":15},"text":"So the story I heard is:\n\nRussia lowkey has threatened to destroy the Starlink satellite network and Elon is freaked out, because the threat is plausible.\n\nThat would possibly justify scaling back its use.\n\nBut if such a threat exists... surely you go public with it right???? https://t.co/wZoyco9fhR","url":"https://x.com/lymanstoneky/status/2113018242411405396"},{"attachments":{"media_keys":["3_2113007414404427776"]},"author_id":"17217640","created_at":"2026-10-21T20:40:06.000Z","edit_history_tweet_ids":["2113007440010821833"],"entities":{"urls":[{"display_url":"spaceflightnow.com/2026/10/20/liv…","end":278,"expanded_url":"https://spaceflightnow.com/2026/10/20/live-coverage-spacex-to-launch-27-starlink-satellites-on-falcon-9-rocket-from-vandenberg-sfb-5/","images":[{"height":381,"url":"https://pbs.twimg.com/news_img/2112655230558945281/3ixGMg5z?format=jpg&name=orig","width":678},{"height":150,"url":"https://pbs.twimg.com/news_img/2112655230558945281/3ixGMg5z?format=jpg&name=150x150","width":150}],"start":255,"status":200,"title":"Live coverage: SpaceX to launch 27 Starlink satellites on Falcon 9 rocket from Vandenberg SFB – Spaceflight Now","unwound_url":"https://spaceflightnow.com/2026/10/20/live-coverage-spacex-to-launch-27-starlink-satellites-on-falcon-9-rocket-from-vandenberg-sfb-5/","url":"https://t.co/NYIMGmtSM3"},{"display_url":"pic.x.com/Xs7plFeQmL","end":302,"expanded_url":"https://x.com/SpaceflightNow/status/2113007440010821833/photo/1","media_key":"3_2113007414404427776","start":279,"url":"https://t.co/Xs7plFeQmL"}]},"id":"2113007440010821833","public_metrics":{"bookmark_count":1,"impression_count":6541,"like_count":66,"quote_count":1,"reply_count":3,"retweet_count":10},"text":"SpaceX adjusted the planned launch time for the Starlink 15-15 mission from Vandenberg. The current T-0 is 4:22 p.m. PDT (7:22 p.m. EDT / 2322 UTC). The weather, however, may be a complicating factor. The satellite view is from NOAA.\n\nMission background: https://t.co/NYIMGmtSM3 https://t.co/Xs7plFeQmL","url":"https://x.com/SpaceflightNow/status/2113007440010821833"},{"author_id":"626660983","created_at":"2026-10-21T19:10:30.000Z","edit_history_tweet_ids":["2112984891625480416"],"entities":{"urls":[{"display_url":"x.com/Heminator/stat…","end":301,"expanded_url":"https://twitter.com/Heminator/status/2112965022775386397","start":278,"url":"https://t.co/4wCamJbQf6"}]},"id":"2112984891625480416","public_metrics":{"bookmark_count":8,"impression_count":15413,"like_count":224,"quote_count":4,"reply_count":22,"retweet_count":10},"text":"There are several possible ends:\n1) Putin has a heart attack\n2) Putin has a \"heart attack\"\n3) Ukraine suffers total defeat and considerable annexation\n4) Ukraine retakes its territory and Putin is so totally politically discredited that he is deposed, or, see 1-2\n\n#4 remains a https://t.co/4wCamJbQf6","url":"https://x.com/lymanstoneky/status/2112984891625480416"},{"author_id":"626660983","created_at":"2026-10-21T19:00:15.000Z","edit_history_tweet_ids":["21129