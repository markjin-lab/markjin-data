{"data": [{"author_id": "114782468", "created_at": "2026-11-10T16:42:21.000Z", "edit_history_tweet_ids": ["2120195365286588418"], "entities": {"cashtags": [{"end": 23, "start": 19, "tag": "SPX"}, {"end": 92, "start": 87, "tag": "NVDA"}, {"end": 97, "start": 94, "tag": "MU"}, {"end": 107, "start": 102, "tag": "AVGO"}]}, "id": "2120195365286588418", "public_metrics": {"bookmark_count": 16, "impression_count": 9887, "like_count": 52, "quote_count": 1, "reply_count": 10, "retweet_count": 7}, "text": "UBS: \n\nWe forecast $SPX EPS growth of 18% to $430 in 2027 and 14% to $490 in '28, with $NVDA, $MU and $AVGO alone ~45% of next year's growth.\"", "url": "https://x.com/carlquintanilla/status/2120195365286588418"}, {"author_id": "1413027896", "created_at": "2026-11-10T16:20:59.000Z", "edit_history_tweet_ids": ["2120189991489785870"], "entities": {"urls": [{"display_url": "pic.x.com/g0tfNY0i89", "end": 102, "expanded_url": "https://x.com/charliebilello/status/2120189991489785870/photo/1", "media_key": "3_2120189536214876160", "start": 79, "url": "https://t.co/g0tfNY0i89"}, {"display_url": "x.com/charliebilello…", "end": 126, "expanded_url": "https://twitter.com/charliebilello/status/2118535378877415677", "start": 103, "url": "https://t.co/V2x8Wo65p0"}]}, "id": "2120189991489785870", "public_metrics": {"bookmark_count": 19, "impression_count": 42140, "like_count": 181, "quote_count": 7, "reply_count": 39, "retweet_count": 39}, "referenced_tweets": [{"id": "2118535378877415677", "type": "quoted"}], "text": "US Home Prices fell 0.4% over the past year, the first YoY decline since 2023. https://t.co/g0tfNY0i89 https://t.co/V2x8Wo65p0", "url": "https://x.com/charliebilello/status/2120189991489785870"}, {"author_id": "23922797", "created_at": "2026-11-10T16:18:54.000Z", "edit_history_tweet_ids": ["2120189467042496839"], "entities": {"urls": [{"description": "Last week’s midterm election results, a multilateral agenda and persistent trade friction must be factored in, observers say.", "display_url": "scmp.com/news/china/dip…", "end": 106, "expanded_url": "https://www.scmp.com/news/china/diplomacy/article/3373969/xi-and-trump-set-apec-talks-major-deliverables-expected-wait-g20?utm_medium=Social&utm_source=Twitter#Echobox=1794326262", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2120155520342650880/xEB74X9D?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120155520342650880/xEB74X9D?format=jpg&name=150x150", "width": 150}], "start": 83, "status": 200, "title": "Xi and Trump set for Apec talks, but major deliverables expected to wait for G20", "unwound_url": "https://www.scmp.com/news/china/diplomacy/article/3373969/xi-and-trump-set-apec-talks-major-deliverables-expected-wait-g20?utm_medium=Social&utm_source=Twitter#Echobox=1794326262", "url": "https://t.co/wkdcTY0B5O"}]}, "id": "2120189467042496839", "public_metrics": {"bookmark_count": 0, "impression_count": 2529, "like_count": 5, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "Xi and Trump set for Apec talks, but major deliverables expected to wait for G20 \n\nhttps://t.co/wkdcTY0B5O", "url": "https://x.com/SCMPNews/status/2120189467042496839"}, {"author_id": "3346529644", "created_at": "2026-11-10T16:07:18.000Z", "edit_history_tweet_ids": ["2120186544950788450"], "entities": {"urls": [{"description": "October 2026 was the warmest October on record globally, with a global-average surface air temperature of 15.35 ° C, 0.90 ° C above the 1991 – 2020 average, according to ERA5 data. October 2026 was 1.75 ° C above the estimated 1850 – 1900 pre-industrial average, marking the third consecutive month above 1.5 ° C. The previous run of at least three consecutive months ended in April 2025. The average global temperature for 2026 is virtually certain to exceed 1.5 ° C above the pre-industrial level, according", "display_url": "climate.copernicus.eu/climate-bullet…", "end": 280, "expanded_url": "https://climate.copernicus.eu/climate-bulletin", "images": [{"height": 400, "url": "https://pbs.twimg.com/news_img/2119397877466419201/MSqYVkVw?format=jpg&name=orig", "width": 400}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2119397877466419201/MSqYVkVw?format=jpg&name=150x150", "width": 150}], "start": 257, "status": 200, "title": "Climate Bulletins", "unwound_url": "https://climate.copernicus.eu/climate-bulletin", "url": "https://t.co/HRse68adc6"}, {"display_url": "pic.x.com/AI9qU0BXpk", "end": 307, "expanded_url": "https://x.com/CopernicusECMWF/status/2120186544950788450/photo/1", "media_key": "3_2120186455913824256", "start": 284, "url": "https://t.co/AI9qU0BXpk"}, {"display_url": "pic.x.com/AI9qU0BXpk", "end": 307, "expanded_url": "https://x.com/CopernicusECMWF/status/2120186544950788450/photo/1", "media_key": "3_2120186455968317440", "start": 284, "url": "https://t.co/AI9qU0BXpk"}]}, "id": "2120186544950788450", "public_metrics": {"bookmark_count": 5, "impression_count": 1751, "like_count": 50, "quote_count": 5, "reply_count": 4, "retweet_count": 28}, "text": "October 2026, sea-surface temperature in Niño 3.4 region reached an all-time high of 29.94°C. The anomaly was also a record: 3.21°C above 1991–2020 average. Both figures exceeded peaks of very strong El Niño events of 1982–1983,1997–1998 &amp; 2015–2016.\n🔗 https://t.co/HRse68adc6\n⬇️ https://t.co/AI9qU0BXpk", "url": "https://x.com/CopernicusECMWF/status/2120186544950788450"}, {"author_id": "114782468", "created_at": "2026-11-10T16:03:14.000Z", "edit_history_tweet_ids": ["2120185525113897046"], "entities": {"hashtags": [{"end": 269, "start": 265, "tag": "CPI"}], "urls": [{"display_url": "pic.x.com/zL4pEYR9MI", "end": 293, "expanded_url": "https://x.com/carlquintanilla/status/2120185525113897046/photo/1", "media_key": "3_2120185521590673408", "start": 270, "url": "https://t.co/zL4pEYR9MI"}]}, "id": "2120185525113897046", "public_metrics": {"bookmark_count": 11, "impression_count": 11155, "like_count": 107, "quote