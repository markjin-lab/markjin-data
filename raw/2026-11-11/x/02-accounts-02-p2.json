9867640"], "entities": {"hashtags": [{"end": 213, "start": 205, "tag": "economy"}, {"end": 222, "start": 214, "tag": "markets"}, {"end": 238, "start": 223, "tag": "federalreserve"}], "mentions": [{"end": 244, "id": "20402945", "start": 239, "username": "CNBC"}], "urls": [{"display_url": "pic.x.com/tO4HmZro3E", "end": 268, "expanded_url": "https://x.com/elerianm/status/2120145665879867640/photo/1", "media_key": "3_2120145610007367681", "start": 245, "url": "https://t.co/tO4HmZro3E"}]}, "id": "2120145665879867640", "public_metrics": {"bookmark_count": 6, "impression_count": 19136, "like_count": 71, "quote_count": 1, "reply_count": 10, "retweet_count": 13}, "text": "Following Federal Reserve Governor Waller’s remarks today (see the CNBC summary below), both the implied market probability and prediction markets now point to a December rate hike as a virtual certainty.\n#economy #markets #federalreserve @CNBC https://t.co/tO4HmZro3E", "url": "https://x.com/elerianm/status/2120145665879867640"}, {"author_id": "279036722", "created_at": "2026-11-10T13:19:54.000Z", "edit_history_tweet_ids": ["2120144418799771705"], "entities": {"urls": [{"display_url": "x.com/econvitals/sta…", "end": 195, "expanded_url": "https://twitter.com/econvitals/status/2120108114246582615", "start": 172, "url": "https://t.co/5Y932I19av"}]}, "id": "2120144418799771705", "public_metrics": {"bookmark_count": 12, "impression_count": 7823, "like_count": 55, "quote_count": 3, "reply_count": 5, "retweet_count": 13}, "referenced_tweets": [{"id": "2120108114246582615", "type": "quoted"}], "text": "There are two investment booms right now. Everyone knows about one of them. The other is oil and gas.\n\nAll other business investment is up at a 2% rate over the last year. https://t.co/5Y932I19av", "url": "https://x.com/jasonfurman/status/2120144418799771705"}, {"author_id": "83466368", "created_at": "2026-11-10T13:04:56.000Z", "edit_history_tweet_ids": ["2120140651190698475"], "entities": {"hashtags": [{"end": 146, "start": 129, "tag": "EconomicBulletin"}], "urls": [{"display_url": "pic.x.com/kMRNsKDaar", "end": 282, "expanded_url": "https://x.com/ecb/status/2120140651190698475/photo/1", "media_key": "3_2120137126121480192", "start": 259, "url": "https://t.co/kMRNsKDaar"}]}, "id": "2120140651190698475", "public_metrics": {"bookmark_count": 1, "impression_count": 5771, "like_count": 27, "quote_count": 1, "reply_count": 10, "retweet_count": 2}, "text": "Competitive banks withstand shocks better and transmit monetary policy more effectively.\n\nEuro area banks are in good shape. Our #EconomicBulletin explores how cross-border consolidation and the savings and investments union can boost competitiveness further https://t.co/kMRNsKDaar", "url": "https://x.com/ecb/status/2120140651190698475"}, {"author_id": "332617373", "created_at": "2026-11-10T12:58:54.000Z", "edit_history_tweet_ids": ["2120139132814983677"], "id": "2120139132814983677", "public_metrics": {"bookmark_count": 8, "impression_count": 24290, "like_count": 117, "quote_count": 3, "reply_count": 23, "retweet_count": 11}, "text": "Understandably, there is a lot of interest in the latest news surrounding Anthropic's upcoming IPO, including the disclosure from the company below.\nAmong what I find particularly interesting: The company's eye-popping revenue growth.\nNot only did revenue for the nine months", "url": "https://x.com/elerianm/status/2120139132814983677"}, {"author_id": "332617373", "created_at": "2026-11-10T12:28:21.000Z", "edit_history_tweet_ids": ["2120131447503688187"], "entities": {"urls": [{"display_url": "pic.x.com/1bj2cWaLbj", "end": 301, "expanded_url": "https://x.com/elerianm/status/2120131447503688187/photo/1", "media_key": "3_2120131444160774144", "start": 278, "url": "https://t.co/1bj2cWaLbj"}]}, "id": "2120131447503688187", "public_metrics": {"bookmark_count": 13, "impression_count": 21443, "like_count": 125, "quote_count": 2, "reply_count": 18, "retweet_count": 14}, "text": "Good morning.\nA busy day of US price data, headlined by the upcoming CPI inflation report, starts with some encouraging news at the pump.\nThe AAA is reporting that the national average price for a gallon of regular gasoline has fallen below $4, down from $4.37 a month ago. The https://t.co/1bj2cWaLbj", "url": "https://x.com/elerianm/status/2120131447503688187"}, {"author_id": "59603406", "created_at": "2026-11-10T12:00:04.000Z", "edit_history_tweet_ids": ["2120124327869997069"], "entities": {"urls": [{"display_url": "x.com/NickTimiraos/s…", "end": 303, "expanded_url": "https://twitter.com/NickTimiraos/status/2120084666531323978", "start": 280, "url": "https://t.co/eKWQ0Lw1zu"}]}, "id": "2120124327869997069", "public_metrics": {"bookmark_count": 67, "impression_count": 83949, "like_count": 295, "quote_count": 18, "reply_count": 34, "retweet_count": 53}, "referenced_tweets": [{"id": "2120084666531323978", "type": "quoted"}], "text": "During the Q&amp;A with Fed gov Waller, an exchange on how to reconcile BLS data in the rearview mirror with what's happening out the front window on energy prices....\n\nQ: You spoke in your speech a lot about the core CPI print that's coming out today. That is a backward looking https://t.co/eKWQ0Lw1zu", "url": "https://x.com/NickTimiraos/status/2120124327869997069"}, {"author_id": "59603406", "created_at": "2026-11-10T09:22:28.000Z", "edit_history_tweet_ids": ["2120084666531323978"], "entities": {"urls": [{"display_url": "x.com/federalreserve…", "end": 233, "expanded_url": "https://twitter.com/federalreserve/status/2120079543172280778", "start": 210, "url": "https://t.co/k5TSLWHOCd"}]}, "id": "2120084666531323978", "public_metrics": {"bookmark_count": 67, "impression_count": 157880, "like_count": 521, "quote_count": 48, "reply_count": 78, "retweet_count": 129}, "referenced_tweets": [{"id": "2120079543172280778", "type": "quoted"}], "text": "Fed governor Chris Waller said he's leaning toward supporting a December rate increase even if Tuesday’s inflation report shows improvement—and if it doesn't, then he says a 50 bps move should be on the table. https://t.co/k5TSLWHOCd", "url": "https://x.com/NickTimiraos/status/2120084666531323978"}, {"author_id": "83466368", "created_at": "2026-11-10T09:11:30.000Z", "edit_history_tweet_ids": ["2120081908168351809"], "entities": {"mentions": [{"end": 33, "id": "35002876", "start": 21, "username": "BloombergTV"}], "urls": [{"description": "European Central Bank Chief Economist Philip Lane said the ECB shouldn’t adjust the run-off of its bond holdings or deploy its crisis tool to help France with its budget problems. “Where this needs to be fixed is in Paris,” Lane said in an interview with Bloomberg's Francine Lacqua.", "display_url": "bloomberg.com/news/videos/20…", "end": 185, "expanded_url": "https://www.bloomberg.com/news/videos/2026-11-10/lane-says-ecb-shouldn-t-deploy-tools-to-ease-france-woes-video", "images": [{"height": 281, "url": "https://pbs.twimg.com/news_img/2120081909380468736/Tpf9ICVB?format=jpg&name=orig", "width": 500}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120081909380468736/Tpf9ICVB?format=jpg&name=150x150", "width": 150}], "start": 162, "status": 200, "title": "Watch Lane Says ECB Shouldn't Deploy Tools to Ease France Woes - Bloomberg", "unwound_url": "https://www.bloomberg.com/news/videos/2026-11-10/lane-says-ecb-shouldn-t-deploy-tools-to-ease-france-woes-video", "url": "https://t.co/HlpP5h0wlc"}, {"display_url": "pic.x.com/e3BUolIA0j", "end": 209, "expanded_url": "https://x.com/ecb/status/2120081908168351809/photo/1", "media_key": "3_2120081901205549056", "start": 186, "url": "https://t.co/e3BUolIA0j"}]}, "id": "2120081908168351809", "public_metrics": {"bookmark_count": 6, "impression_count": 7770, "like_count": 29, "quote_count": 2, "reply_count": 5, "retweet_count": 10}, "text": "In an interview with @BloombergTV, Chief Economist Philip R. Lane discusses the outlook for inflation and the euro area economy with Francine Lacqua.\n\nWatch here https://t.co/HlpP5h0wlc https://t.co/e3BUolIA0j", "url": "https://x.com/ecb/status/2120081908168351809"}, {"author_id": "83466368", "created_at": "2026-11-10T09:03:57.000Z", "edit_history_tweet_ids": ["2120080006206361853"], "entities": {"hashtags": [{"end": 254, "start": 237, "tag": "EconomicBulletin"}], "urls": [{"display_url": "pic.x.com/48xxkVno8T", "end": 287, "expanded_url": "https://x.com/ecb/status/2120080006206361853/photo/1", "media_key": "3_2119929260177498113", "start": 264, "url": "https://t.co/48xxkVno8T"}]}, "id": "2120080006206361853", "public_metrics": {"bookmark_count": 2, "impression_count": 5921, "like_count": 18, "quote_count": 1, "reply_count": 7, "retweet_count": 3}, "text": "The use of industrial policy is on the rise. Can it help power a more productive and resilient Europe?\n\nInterventions should:\n🔹 be targeted and time-limited\n\nThey should not:\n🔹 replace structural reforms and deeper integration\n\nRead our #EconomicBulletin for more https://t.co/48xxkVno8T", "url": "https://x.com/ecb/status/2120080006206361853"}, {"author_id": "26538229", "created_at": "2026-11-10T09:02:06.000Z", "edit_history_tweet_ids": ["2120079543172280778"], "entities": {"mentions": [{"end": 66, "id": "22624441", "start": 50, "username": "KingsCollegeLon"}], "urls": [{"description": "Thank you, Paul, and welcome to Bank of England watchers, who I suspect are watching the Federal Reserve as well. 1 My subject today is the outlook for t", "display_url": "federalreserve.gov/newsevents/spe…", "end": 91, "expanded_url": "https://www.federalreserve.gov/newsevents/speech/waller20261110a.htm", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2120079544883544064/c3lF44Vy?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120079544883544064/c3lF44Vy?format=jpg&name=150x150", "width": 150}], "start": 68, "status": 200, "title": "Speech by Governor Waller on the economic outlook", "unwound_url": "https://www.fed