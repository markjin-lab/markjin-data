me=orig", "width": 2000}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120231097552302080/w-DDx_91?format=jpg&name=150x150", "width": 150}], "start": 238, "status": 200, "title": "SINGULUS TECHNOLOGIES Announces Major Supply Contract with SpaceX for Advanced HJT Solar Cell Manufacturing Equipment", "unwound_url": "https://www.singulus.com/2026/11/10/spacex-heterojunction-solar-cells-singulus/", "url": "https://t.co/a9bXuUK6Ti"}]}, "id": "2120231065394590007", "public_metrics": {"bookmark_count": 233, "impression_count": 224001, "like_count": 4258, "quote_count": 88, "reply_count": 146, "retweet_count": 448}, "text": "We have signed a major supply contract with SINGULUS to create a durable option for advanced solar cell manufacturing to support more than 100 GW of equipment as we accelerate the production of our Starmind satellites in Bastrop, Texas → https://t.co/a9bXuUK6Ti", "url": "https://x.com/SpaceX/status/2120231065394590007"}, {"author_id": "626660983", "created_at": "2026-11-10T19:01:35.000Z", "edit_history_tweet_ids": ["2120230407392374789"], "entities": {"urls": [{"description": "And why might it be surprisingly close to $0?", "display_url": "lymanstone.substack.com/p/what-is-the-…", "end": 267, "expanded_url": "https://lymanstone.substack.com/p/what-is-the-optimal-rate-of-charitable", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2120230409162428416/0wO4H_GZ?format=jpg&name=orig", "width": 1600}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120230409162428416/0wO4H_GZ?format=jpg&name=150x150", "width": 150}], "start": 244, "status": 200, "title": "What Is The Optimal Rate of Charitable Giving?", "unwound_url": "https://lymanstone.substack.com/p/what-is-the-optimal-rate-of-charitable", "url": "https://t.co/O9zzCxZ5xw"}]}, "id": "2120230407392374789", "public_metrics": {"bookmark_count": 44, "impression_count": 10502, "like_count": 65, "quote_count": 2, "reply_count": 10, "retweet_count": 2}, "text": "GiveWell overestimates the effect of bednets on mortality by probably 5 times. \n\nThis size of error isn't even uncommon for EA-influenced assessments.\n\nOnce you understand how small the effect of aid is, other things look better by comparison.\nhttps://t.co/O9zzCxZ5xw", "url": "https://x.com/lymanstoneky/status/2120230407392374789"}, {"author_id": "34743251", "created_at": "2026-11-10T18:21:23.000Z", "edit_history_tweet_ids": ["2120220290219208884"], "entities": {"urls": [{"display_url": "pic.x.com/iYTX1e6DEH", "end": 268, "expanded_url": "https://x.com/SpaceX/status/2120220290219208884/photo/1", "media_key": "3_2120220192139603968", "start": 245, "url": "https://t.co/iYTX1e6DEH"}, {"display_url": "pic.x.com/iYTX1e6DEH", "end": 268, "expanded_url": "https://x.com/SpaceX/status/2120220290219208884/photo/1", "media_key": "3_2120220223424937984", "start": 245, "url": "https://t.co/iYTX1e6DEH"}, {"display_url": "pic.x.com/iYTX1e6DEH", "end": 268, "expanded_url": "https://x.com/SpaceX/status/2120220290219208884/photo/1", "media_key": "3_2120220246573195264", "start": 245, "url": "https://t.co/iYTX1e6DEH"}, {"display_url": "pic.x.com/iYTX1e6DEH", "end": 268, "expanded_url": "https://x.com/SpaceX/status/2120220290219208884/photo/1", "media_key": "3_2120220268073283584", "start": 245, "url": "https://t.co/iYTX1e6DEH"}]}, "id": "2120220290219208884", "public_metrics": {"bookmark_count": 376, "impression_count": 274094, "like_count": 6912, "quote_count": 149, "reply_count": 244, "retweet_count": 882}, "text": "Super Heavy moved to the launch pad at Starbase. Booster 22 is the first Super Heavy V3 booster planned to return to the launch site for catch and was used for final catch testing upon arrival, including a suspended squeeze test at catch height https://t.co/iYTX1e6DEH", "url": "https://x.com/SpaceX/status/2120220290219208884"}, {"author_id": "21436960", "created_at": "2026-11-10T16:18:02.000Z", "edit_history_tweet_ids": ["2120189246397169865"], "entities": {"urls": [{"display_url