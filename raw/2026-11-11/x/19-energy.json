{"data": [{"author_id": "2056166204994392064", "created_at": "2026-11-10T13:00:01.000Z", "edit_history_tweet_ids": ["2120139415422960054"], "entities": {"cashtags": [{"end": 144, "start": 139, "tag": "CBAT"}], "hashtags": [{"end": 108, "start": 92, "tag": "WorldScienceDay"}], "urls": [{"display_url": "pic.x.com/hOhcwivPLy", "end": 305, "expanded_url": "https://x.com/CBAKEnergy/status/2120139415422960054/video/1", "media_key": "13_2119960656422330368", "start": 282, "url": "https://t.co/hOhcwivPLy"}]}, "id": "2120139415422960054", "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "What does it take to turn a scientific breakthrough into a manufacturable battery?   \n\nOn 🌍 #WorldScienceDay, a look inside CBAK Energy’s ($CBAT) sodium-ion R&amp;D:   \n\n🧪 Milestone: One of the first globally to develop &amp; mass-produce sodium-ion batteries\n\n🔋 From lab to scale: https://t.co/hOhcwivPLy", "url": "https://x.com/CBAKEnergy/status/2120139415422960054"}, {"author_id": "954276298284822528", "created_at": "2026-11-09T05:35:53.000Z", "edit_history_tweet_ids": ["2119665256607949107"], "entities": {"hashtags": [{"end": 250, "start": 238, "tag": "SolarEnergy"}, {"end": 262, "start": 251, "tag": "IndiaSolar"}, {"end": 278, "start": 263, "tag": "RenewableIndia"}]}, "id": "2119665256607949107", "public_metrics": {"bookmark_count": 0, "impression_count": 80, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Sodium-ion batteries approach cost parity with LFP, with 70 GWh covered by supply agreements: Sodium-ion… www.​pv-magazine-india.​com/2026/11/09/sodium-ion-batteries-approach-cost-parity-with-lfp-with-70-gwh-covered-by-supply-agreements/ #SolarEnergy #IndiaSolar #RenewableIndia", "url": "https://x.com/pvmagazineindia/status/2119665256607949107"}, {"author_id": "1882353145097109504", "created_at": "2026-11-10T09:48:00.000Z", "edit_history_tweet_ids": [