ntions": [{"end": 140, "id": "15072071", "start": 129, "username": "NewYorkFed"}], "urls": [{"display_url": "pic.x.com/FhoDct4msF", "end": 164, "expanded_url": "https://x.com/LizAnnSonders/status/2119866814322901226/photo/1", "media_key": "3_2119866804633784320", "start": 141, "url": "https://t.co/FhoDct4msF"}]}, "id": "2119866814322901226", "public_metrics": {"bookmark_count": 4, "impression_count": 19751, "like_count": 159, "quote_count": 4, "reply_count": 24, "retweet_count": 18}, "text": "Consumer expectations for higher unemployment a year from now rose to 45.3% in October, highest since the pandemic, according to @NewYorkFed https://t.co/FhoDct4msF", "url": "https://x.com/LizAnnSonders/status/2119866814322901226"}, {"author_id": "423769635", "created_at": "2026-11-09T18:46:15.000Z", "edit_history_tweet_ids": ["2119864157994659953"], "entities": {"mentions": [{"end": 109, "id": "64844802", "start": 104, "username": "a16z"}], "urls": [{"display_url": "pic.x.com/CTs8fWVGok", "end": 133, "expanded_url": "https://x.com/SoberLook/status/2119864157994659953/photo/1", "media_key": "3_2119864106370965504", "start": 110, "url": "https://t.co/CTs8fWVGok"}]}, "id": "2119864157994659953", "public_metrics": {"bookmark_count": 15, "impression_count": 8683, "like_count": 37, "quote_count": 1, "reply_count": 6, "retweet_count": 9}, "text": "Unlike its Big Tech peers, Apple has avoided a comparable surge in AI infrastructure spending.\n\nSource: @a16z https://t.co/CTs8fWVGok", "url": "https://x.com/SoberLook/status/2119864157994659953"}, {"author_id": "14096763", "created_at": "2026-11-09T18:44:17.000Z", "edit_history_tweet_ids": ["2119863666421997830"], "entities": {"urls": [{"display_url": "pic.x.com/YRIIpQ79GI", "end": 276, "expanded_url": "https://x.com/TheStalwart/status/2119863666421997830/photo/1", "media_key": "3_2119863366457925632", "start": 253, "url": "https://t.co/YRIIpQ79GI"}, {"display_url": "pic.x.com/YRIIpQ79GI", "end": 276, "expanded_url": "https://x.com/TheStalwart/status/2119863666421997830/photo/1", "media_key": "3_2119863384246022144", "start": 253, "url": "https://t.co/YRIIpQ79GI"}]}, "id": "2119863666421997830", "public_metrics": {"bookmark_count": 181, "impression_count": 42836, "like_count": 432, "quote_count": 3, "reply_count": 18, "retweet_count": 34}, "text": "THE AI BOOM HAS NEVER BEEN MORE FRAUGHT\n\nIn today's newsletter I wrote about the combo of the Jensen scandal, the Blue Tsunami, rapidly tightening financial conditions, and the big question of whether Zuck, Satya, and Sundar are truly AI-pilled or not. https://t.co/YRIIpQ79GI", "url": "https://x.com/TheStalwart/status/2119863666421997830"}, {"author_id": "14096763", "created_at": "2026-11-09T18:25:55.000Z", "edit_history_tweet_ids": ["2119859044194422981"], "id": "2119859044194422981", "public_metrics": {"bookmark_count": 69, "impression_count": 72902, "like_count": 861, "quote_count": 17, "reply_count": 87, "retweet_count": 39}, "text": "The whole thing is so strange. Doesn’t seem great for China to have one of America’s biggest advocates for chip diffusion and open source AI to get discredited.", "url": "https://x.com/TheStalwart/status/2119859044194422981"}, {"author_id": "3039504459", "created_at": "2026-11-09T17:57:33.000Z", "edit_history_tweet_ids": ["2119851905429971070"], "entities": {"urls": [{"description": "Measurements on micrometer-scale cadmium samples provide definitive evidence of an unusual charge-transport regime in a 3D metal.", "display_url": "go.aps.org/4zesoCe", "end": 278, "expanded_url": "https://go.aps.org/4zesoCe", "images": [{"height": 200, "url": "https://pbs.twimg.com/news_img/2119851909301379072/EoIrEwEN?format=png&name=orig", "width": 200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2119851909301379072/EoIrEwEN?format=png&name=150x150", "width": 150}], "start": 255, "status": 200, "title": "Hydrodynamics of the Viscous Electron Fluid in Cadmium", "unwound_url": "https://journals.aps.org/prl/abstract/10.1103/g32f-j6q2", "url": "https://t.co/L4ZBVHgmS9"}, {"display_url": "pic.x.com/TCtHQMyhus", "end": 302, "expanded_url": "https://x.com/PhysRevLett/status/2119851905429971070/photo/1", "media_key": "3_2119851903127351296", "start": 279, "url": "https://t.co/TCtHQMyhus"}]}, "id": "2119851905429971070", "public_metrics": {"bookmark_count": 14, "impression_count": 2465, "like_count": 45, "quote_count": 0, "reply_count": 2, "retweet_count": 9}, "text": "Researchers present the first definitive experimental fingerprint of a viscous electron fluid in 3D. Thanks to frequent electron-electron collisions, bulk cadmium’s conductivity scales with the square of both temperature and size in a specific window.\n\n🔗 https://t.co/L4ZBVHgmS9 https://t.co/TCtHQMyhus", "url": "https://x.com/PhysRevLett/status/2119851905429971070"}, {"author_id": "14096763", "created_at": "2026-11-09T17:48:46.000Z", "edit_history_tweet_ids": ["2119849693526344115"], "id": "2119849693526344115", "public_metrics": {"bookmark_count": 39, "impression_count": 59035, "like_count": 466, "quote_count": 13, "reply_count": 73, "retweet_count": 19}, "text": "One question is. Whether in business or politics, has Jensen done anything different than just a pure revenue-maxing CEO would?", "url": "https://x.com/TheStalwart/status/2119849693526344115"}], "includes": {"users": [{"id": "1327359720", "name": "Lisa Abramowicz", "username": "lisaabramowicz1"}, {"id": "702235316812275712", "name": "Guy Berger", "username": "EconBerger"}, {"id": "917683048782503937", "name": "Michael Pettis", "username": "michaelxpettis"}, {"id": "14096763", "name": "Joe Weisenthal", "username": "TheStalwart"}, {"id": "499603787", "name": "Lingling Wei 魏玲灵", "username": "Lingling_Wei"}, {"id": "733647469305864195", "name": "Brad Setser", "username": "Brad_Setser"}, {"id": "3512101", "name": "Bill Bishop", "username": "niubi"}, {"id": "2961589380", "name": "Liz Ann Sonders", "username": "LizAnnSonders"}, {"id": "423769635", "name": "(((The Daily Shot