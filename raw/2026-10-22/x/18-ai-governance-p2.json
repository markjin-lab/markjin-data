bermusings.com/p/weekly-musings-top-10-ai-security-20261009-20261015","images":[{"height":800,"url":"https://pbs.twimg.com/news_img/2111117509705560064/c08d5Q_W?format=jpg&name=orig","width":1600},{"height":150,"url":"https://pbs.twimg.com/news_img/2111117509705560064/c08d5Q_W?format=jpg&name=150x150","width":150}],"start":252,"status":200,"title":"Weekly Musings Top 10 AI Security Wrapup: Issue 58: October 9 to October 15, 2026","unwound_url":"https://www.rockcybermusings.com/p/weekly-musings-top-10-ai-security-20261009-20261015","url":"https://t.co/npzIWnPlaa"}]},"id":"2112287675755663573","public_metrics":{"bookmark_count":0,"impression_count":22,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"Brussels is enforcing the AI Act on frontier labs. Article 2(8) exempts premarket testing but not testing in real world conditions.\n\nAn agent logging into Hugging Face is real world testing, and the labs' best defense is admitting containment failed.\n\nhttps://t.co/npzIWnPlaa","url":"https://x.com/rocklambros/status/2112287675755663573"}],"includes":{"media":[{"media_key":"3_2112287491709399040","type":"photo"}],"users":[{"id":"18138308","name":"Brendan Steinhauser","username":"bstein80"},{"id":"1585825112741347328","name":"Matthew Clare","username":"GetClareity"},{"id":"1678012762423795716","name":"Caelen","username":"CaelenXBT"},{"id":"86003330","name":"Rock Lambros","username":"rocklambros"}]},"meta":{"newest_id":"2112287684001501695","next_token":"b26v89c19zqg8o3juzlwehbwu5giyzz5e7vbxhs813gcd","oldest_id":"2112287510827327967","result_count":4}}