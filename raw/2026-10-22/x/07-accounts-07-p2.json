ay_url":"pic.x.com/StXyXyvdMZ","end":97,"expanded_url":"https://x.com/SpaceX/status/2112592291147747809/photo/1","media_key":"3_2112592207769157632","start":74,"url":"https://t.co/StXyXyvdMZ"},{"display_url":"pic.x.com/StXyXyvdMZ","end":97,"expanded_url":"https://x.com/SpaceX/status/2112592291147747809/photo/1","media_key":"3_2112592269588963329","start":74,"url":"https://t.co/StXyXyvdMZ"}]},"id":"2112592291147747809","public_metrics":{"bookmark_count":162,"impression_count":398755,"like_count":5651,"quote_count":68,"reply_count":282,"retweet_count":638},"text":"Falcon 9 launches the Bandwagon-5 rideshare mission to orbit from Florida https://t.co/StXyXyvdMZ","url":"https://x.com/SpaceX/status/2112592291147747809"},{"attachments":{"media_keys":["3_2112587675555205120"]},"author_id":"626660983","created_at":"2026-10-20T16:53:41.000Z","edit_history_tweet_ids":["2112588075863793841"],"entities":{"mentions":[{"end":154,"id":"1887207443257528320","start":145,"username":"PeterRFB"},{"end":170,"id":"2351126707","start":155,"username":"DrJasonCarroll"}],"urls":[{"display_url":"pic.x.com/lpUDxRrGUp","end":298,"expanded_url":"https://x.com/lymanstoneky/status/2112588075863793841/photo/1","media_key":"3_2112587675555205120","start":275,"url":"https://t.co/lpUDxRrGUp"}]},"id":"2112588075863793841","public_metrics":{"bookmark_count":23,"impression_count":8437,"like_count":100,"quote_count":5,"reply_count":5,"retweet_count":12},"text":"Childless people often feel like the world is constantly telling them to have kids. So it's confusing when people talk about antinatalism.\n\nHere @PeterRFB @DrJasonCarroll and I show some actual data on experiences of antinatal comments!\n\nBigger families get a *lot* of crap! https://t.co/lpUDxRrGUp","url":"https://x.com/lymanstoneky/status/2112588075863793841"},{"author_id":"626660983","created_at":"2026-10-20T16:38:22.000Z","edit_history_tweet_ids":["2112584218580578735"],"entities":{"urls":[{"display_url":"x.com/kurtsaltrichte…","end":301,"exp