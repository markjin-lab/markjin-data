c.x.com/X1gghCsRge","end":276,"expanded_url":"https://x.com/TheStalwart/status/2112625912017465368/photo/1","media_key":"3_2112625681565728768","start":253,"url":"https://t.co/X1gghCsRge"},{"display_url":"pic.x.com/X1gghCsRge","end":276,"expanded_url":"https://x.com/TheStalwart/status/2112625912017465368/photo/1","media_key":"3_2112625700314189824","start":253,"url":"https://t.co/X1gghCsRge"},{"display_url":"pic.x.com/X1gghCsRge","end":276,"expanded_url":"https://x.com/TheStalwart/status/2112625912017465368/photo/1","media_key":"3_2112625717888397313","start":253,"url":"https://t.co/X1gghCsRge"}]},"id":"2112625912017465368","public_metrics":{"bookmark_count":2074,"impression_count":579901,"like_count":3384,"quote_count":223,"reply_count":407,"retweet_count":336},"text":"MAYBE I WAS WRONG ABOUT BLOCKCHAIN TECHNOLOGY\n\nI wrote about how I always used to make fun of the guys who said things like \"Bitcoin is speculative, but the underlying blockchain technology is interesting.\" And now I think maybe they kinda had a point. https://t.co/X1gghCsRge","url":"https://x.com/TheStalwart/status/2112625912017465368"},{"author_id":"3512101","created_at":"2026-10-20T18:00:33.000Z","edit_history_tweet_ids":["2112604900756447296"],"entities":{"mentions":[{"end":86,"id":"1233663476","start":74,"username":"stratechery"}],"urls":[{"description":"Meta has a new open source model, and to everyone’s surprise, they are are partnering with Apple to make sure you can run it locally.","display_url":"stratechery.com/2026/muse-spar…","end":69,"expanded_url":"https://stratechery.com/2026/muse-spark-open-meta-apple-thin-and-thick/","images":[{"height":240,"url":"https://pbs.twimg.com/news_img/2112484017320923136/76ps6Y9t?format=png&name=orig","width":240},{"height":150,"url":"https://pbs.twimg.com/news_img/2112484017320923136/76ps6Y9t?format=png&name=150x150","width":150}],"start":46,"status":200,"title":"Muse Spark Open, Meta + Apple, Thin and Thick","unwound_url":"http://stratechery.com/2026/muse-spark-open-meta-apple-thin-and-thick/","url":"https://t.co/3AZUiRmGzC"}]},"id":"2112604900756447296","public_metrics":{"bookmark_count":1,"impression_count":2354,"like_count":2,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"Muse Spark Open, Meta + Apple, Thin and Thick https://t.co/3AZUiRmGzC via @stratechery \"The second difference from Chinese models is that Muse Spark Open is not as good, but that’s to be expected. First, this is based on a six month old model that was a few releases behind when","url":"https://x.com/niubi/status/2112604900756447296"},{"attachments":{"media_keys":["3_2112596567135825920"]},"author_id":"48463418","created_at":"2026-10-20T17:27:26.000Z","edit_history_tweet_ids":["2112596569442730225"],"entities":{"urls":[{"description":"The coalescence of degenerate helium cores during red giant collisions---a process we term ``erythrohenosis''---introduces a novel class of transient astrophysical sources of high-energy neutrinos. Using stellar models generated with mesa and smoothed-particle hydrodynamics simulations of the final inspiral phase, we develop a semianalytical model to estimate the amount of hydrogen mixed into the cores, the energy release ($\\ensuremath{\\approx}4.28\\ifmmode\\times\\else\\texttimes\\fi{}{10}^{49}\\text{ }\\text{ }\\mathrm{erg}$) that heats the remnant to ${T}_{f}\\ensuremath{\\approx}5.3\\ifmmode\\times\\else\\texttimes\\fi{}{10}^{8}\\text{ }\\text{ }\\mathrm{K}$, the magnetic field amplification ($B\\ensuremath{\\approx}1.77\\ifmmode\\times\\else\\texttimes\\fi{}{10}^{10}\\text{ }\\text{ }\\mathrm{G}$), and the resulting neutrino flux. The predicted TeV--PeV neutrino signal may contribute to the diffuse IceCube neutrino flux; we estimate that the horizon at which a single neutrino event is expected on average at ","display_url":"go.aps.org/3TQNKXM","end":277,"expanded_url":"https://go.aps.org/3TQNKXM","start":254,"status":200,"title":"Neutrino flux from collisions of red giant cores in globular clusters","unwound_url":"https://journals.aps.org/prd/abstract/10.1103/kjkf-x79r","url":"https://t.co/obsr6czDzG"},{"display_url":"pic.x.com/Wt6sclAR4x","end":301,"expanded_url":"https://x.com/APSphysics/status/2112596569442730225/photo/1","media_key":"3_2112596567135825920","start":278,"url":"https://t.co/Wt6sclAR4x"}]},"id":"2112596569442730225","public_metrics":{"bookmark_count":1,"impression_count":2300,"like_count":15,"quote_count":2,"reply_count":1,"retweet_count":1},"text":"When the dense helium cores of two red giants collide, the merger could produce high-energy neutrinos, finds a study in Physical Review D. IceCube could expect about one such neutrino from a single merger up to 180,000 light years away.\n\nRead the study: https://t.co/obsr6czDzG https://t.co/Wt6sclAR4x","url":"https://x.com/APSphysics/status/2112596569442730225"},{"attachments":{"media_keys":["3_2112594291222556673"]},"author_id":"14096763","created_at":"2026-10-20T17:18:29.000Z","edit_history_tweet_ids":["2112594316048953798"],"entities":{"mentions":[{"end":234,"id":"418","start":229,"username":"dens"}],"urls":[{"description":"After 17 years, Foursquare’s ending is written. Writing this to share my opinions & frustrations with the final years of the company, and to honor the team who helped build & maintain FSQ’s legacy.","display_url":"teendrama.substack.com/p/some-final-w…","end":274,"expanded_url":"https://teendrama.substack.com/p/some-final-words-on-foursquare","images":[{"height":800,"url":"https://pbs.twimg.com/news_img/2112566200496787456/iSojTbsn?format=jpg&name=orig","width":1600},{"height":150,"url":"https://pbs.twimg.com/news_img/2112566200496787456/iSojTbsn?format=jpg&name=150x150","width":150}],"start":251,"status":200,"title":"Some final words on Foursquare.","unwound_url":"https://teendrama.substack.com/p/some-final-words-on-foursquare","url":"https://t.co/i71yvrrwWX"},{"display_url":"pic.x.com/Mm2acjGII1","end":298,"expanded_url":"https://x.com/TheStalwart/status/2112594316048953798/photo/1","media_key":"3_2112594291222556673","start":275,"url":"https://t.co/Mm2acjGII1"}]},"id":"2112594316048953798","public_metrics":{"bookmark_count":44,"impression_count":28334,"like_count":238,"quote_count":2,"reply_count":18,"retweet_count":13},"text":"It's hard to describe how significant Foursquare was to the NYC tech echosystem back in the old days. Would never have imagined this outcome back then, when it seemed like it could become a Twitter-sized company. Good piece from @dens on its closure. https://t.co/i71yvrrwWX https://t.co/Mm2acjGII1","url":"https://x.com/TheStalwart/status/2112594316048953798"},{"author_id":"14096763","created_at":"2026-10-20T17:10:11.000Z","edit_history_tweet_ids":["2112592228061208698"],"entities":{"urls":[{"display_url":"x.com/thought_less_/…","end":294,"expanded_url":"https://twitter.com/thought_less_/status/2112590661207884141","start":271,"url":"https://t.co/rRpVfdaywG"}]},"id":"2112592228061208698","public_metrics":{"bookmark_count":12,"impression_count":22286,"like_count":182,"quote_count":1,"reply_count":24,"retweet_count":7},"text":"I almost never use the word bubble, because I rarely find it analytically helpful. People have different definitions of it, and yes, it's usually said with some kind of value judgment.\n\nIMO, it should only be used for pure \"greater fool\"-type trading, a la NFTs in 2021. https://t.co/rRpVfdaywG","url":"https://x.com/TheStalwart/status/2112592228061208698"},{"attachments":{"media_keys":["3_2112590703486468096"]},"author_id":"702235316812275712","created_at":"2026-10-20T17:04:38.000Z","edit_history_tweet_ids":["2112590831530238284"],"entities":{"urls":[{"display_url":"pic.x.com/Kb0P5hAZHu","end":103,"expanded_url":"https://x.com/EconBerger/status/2112590831530238284/photo/1","media_key":"3_2112590703486468096","start":80,"url":"https://t.co/Kb0P5hAZHu"}]},"id":"2112590831530238284","public_metrics":{"bookmark_count":2,"impression_count":3352,"like_count":10,"quote_count":0,"reply_