/2113013274803617873"}],"includes":{"media":[{"media_key":"13_2112688578803150848","type":"video"},{"media_key":"3_2113020897367875584","type":"photo"},{"media_key":"3_2113020896449265664","type":"photo"},{"media_key":"3_2113020896810008577","type":"photo"},{"media_key":"3_2113020896508002304","type":"photo"},{"media_key":"3_2113022329412370433","type":"photo"},{"media_key":"3_2113013644644814848","type":"photo"},{"media_key":"3_2113013644598685696","type":"photo"},{"media_key":"13_2113023880080027648","type":"video"},{"media_key":"3_2112980729084952576","type":"photo"},{"media_key":"3_2113016753961807872","type":"photo"}],"users":[{"id":"14739100","name":"Paco Solsona","username":"solsona"},{"id":"2001085257983148032","name":"Evitable","username":"EvitableOrg"},{"id":"1176366698745737217","name":"Noving","username":"IconNoving"},{"id":"1576979083208298496","name":"Daily Muse","username":"_dailymuse"},{"id":"1718110946789580800","name":"Collinear AI","username":"CollinearAI"},{"id":"6452362","name":"Mike Gannotti 🔳","username":"MichaelGannotti"},{"id":"2104691573682233344","name":"Bullished","username":"TheBullished"},{"id":"143561593","name":"SPE International","username":"SPEtweets"},{"id":"1944393310690263040","name":"Akshaj","username":"AkshajSatyawada"},{"id":"1572681125952192514","name":"Make The Call","username":"MTCMarketsHQ"},{"id":"1175714145133633536","name":"Gideon Futerman","username":"GFuterman"},{"id":"21335196","name":"Ruth Heasman 🌳🌷🦚🐉😃","username":"ruthheasman"},{"id":"209800623","name":"Pietro di Walsi","username":"pietro_di_walsi"},{"id":"1810528551680323584","name":"MIR .CHEN","username":"MRchen881"},{"id":"1768649126814658560","name":"Dan Greenheck","username":"dangreenheck"},{"id":"1495252049319297027","name":"Risk Professionals","username":"riskprofs"},{"id":"2078844585569329153","name":"Voryntel","username":"Voryntel"},{"id":"1810527821632327680","name":"BradXBT","username":"niuyeye945a"},{"id":"2077130693138612225","name":"Almokhtar | The C