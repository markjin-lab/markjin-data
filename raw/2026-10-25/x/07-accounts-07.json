_url": "https://x.com/SpaceX/status/2113786051009696177/photo/1", "media_key": "3_2113785951587643392", "start": 58, "url": "https://t.co/OHHSEsn3Qz"}]}, "id": "2113786051009696177", "public_metrics": {"bookmark_count": 155, "impression_count": 1862461, "like_count": 7868, "quote_count": 99, "reply_count": 367, "retweet_count": 793}, "text": "Falcon 9 launches 27 @Starlink satellites from California https://t.co/OHHSEsn3Qz", "url": "https://x.com/SpaceX/status/2113786051009696177"}, {"author_id": "34743251", "created_at": "2026-10-23T23:51:12.000Z", "edit_history_tweet_ids": ["2113780307904381100"], "entities": {"mentions": [{"end": 26, "id": "1330170106501079041", "start": 17, "username": "Starlink"}]}, "id": "2113780307904381100", "public_metrics": {"bookmark_count": 81, "impression_count": 1535686, "like_count": 9033, "quote_count": 40, "reply_count": 261, "retweet_count": 480}, "text": "Deployment of 27 @Starlink satellites confirmed", "url": "https://x.com/SpaceX/status/2113780307904381100"}, {"attachments": {"media_keys": ["13_2113776813121941504"]}, "author_id": "11348282", "created_at": "2026-10-23T23:37:56.000Z", "edit_history_tweet_ids": ["2113776971603689874"], "entities": {"urls": [{"description": "Before astronauts return to the lunar surface, NASA will first conduct one of the most ambitious and complex test missions in the agency's history. ", "display_url": "go.nasa.gov/4jzartX", "end": 188, "expanded_url": "https://go.nasa.gov/4jzartX", "images": [{"height": 2250, "url": "https://pbs.twimg.com/news_img/2113776976758444032/75yidGQd?format=jpg&name=orig", "width": 4000}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113776976758444032/75yidGQd?format=jpg&name=150x150", "width": 150}], "start": 165, "status": 200, "title": "NASA’s Artemis III Mission to Test Future Moon Lander Operations - NASA", "unwound_url": "https://www.nasa.gov/missions/artemis/nasas-artemis-iii-mission-to-test-future-moon-lander-operations/?utm_source=TWITTER&utm_medium=NASA&utm_campaign=NASASocial&linkId=1026248244", "url": "https://t.co/jSHP2lHuOx"}, {"display_url": "pic.x.com/m8taK5B7Oy", "end": 298, "expanded_url": "https://x.com/NASA/status/2113776971603689874/video/1", "media_key": "13_2113776813121941504", "start": 275, "url": "https://t.co/m8taK5B7Oy"}]}, "id": "2113776971603689874", "public_metrics": {"bookmark_count": 292, "impression_count": 1103725, "like_count": 6219, "quote_count": 68, "reply_count": 266, "retweet_count": 798}, "text": "We are not slowing down. 🚀\n\nOur Artemis III mission will send four astronauts to low Earth orbit next year to test critical systems needed for future lunar landings https://t.co/jSHP2lHuOx and we’re accelerating efforts to ensure the success of Artemis IV, the first Artemis https://t.co/m8taK5B7Oy", "url": "https://x.com/NASA/status/2113776971603689874"}, {"attachments": {"media_keys": ["3_2113764994030436352"]}, "author_id": "17217640", "created_at": "2026-10-23T22:51:35.000Z", "edit_history_tweet_ids": ["2113765304354378192"], "entities": {"urls": [{"description": "Watch live coverage as SpaceX launches a Falcon 9 rocket from Calif...", "display_url": "youtube.com/watch?v=hANSUk…", "end": 203, "expanded_url": "https://www.youtube.com/watch?v=hANSUkrKDwQ", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2113747297037402112/MbXkLWWZ?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113747297037402112/MbXkLWWZ?format=jpg&name=150x150", "width": 150}], "start": 180, "status": 200, "title": "SpaceX Falcon 9 rocket launches from California with 27 Starlink satellites", "unwound_url": "https://www.youtube.com/watch?v=hANSUkrKDwQ", "url": "https://t.co/NcN9jHkYrN"}, {"display_url": "pic.x.com/uBmJ5orpqy", "end": 227, "expanded_url": "https://x.com/SpaceflightNow/status/2113765304354378192/photo/1", "media_key": "3_2113764994030436352", "start": 204, "url": "https://t.co/uBmJ5orpqy"}]}, "id": "2113765304354378192", "public_metrics": {"bookmark_count": 2, "impression_count": 7563, "like_count": 94, "quote_count": 2, "reply_count": 4, "retweet_count": 11}, "text": "Liftoff! After three previous scrubs, the Starlink 15-15 mission launched on a Falcon 9 rocket from Vandenberg Space Force Base at 3:48 pm PT (6:48 pm ET / 2248 UTC).\n\nWatch live: https://t.co/NcN9jHkYrN https://t.co/uBmJ5orpqy", "url": "https://x.com/SpaceflightNow/status/2113765304354378192"}, {"author_id": "34743251", "created_at": "2026-10-23T22:37:56.000Z", "edit_history_tweet_ids": ["2113761872264712327"], "entities": {"mentions": [{"end": 34, "id": "1330170106501079041", "start": 25, "username": "Starlink"}], "urls": [{"description": "Starlink Mission", "display_url": "x.com/i/broadcasts/1…", "end": 94, "expanded_url": "https://x.com/i/broadcasts/1qKDzWkEraoJV", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2113638961234984960/kCGmcUYU?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113638961234984960/kCGmcUYU?format=jpg&name=150x150", "width": 150}], "start": 71, "status": 200, "title": "SpaceX", "unwound_url": "https://x.com/i/broadcasts/1qKDzWkEraoJV", "url": "https://t.co/mqBCvjX0bi"}]}, "id": "2113761872264712327", "public_metrics": {"bookmark_count": 259, "impression_count": 1236063, "like_count": 5521, "quote_count": 85, "reply_count": 384, "retweet_count": 707}, "text": "Watch Falcon 9 launch 27 @Starlink satellites to orbit from California https://t.co/mqBCvjX0bi", "url": "https://x.com/SpaceX/status/2113761872264712327"}, {"author_id": "17217640", "created_at": "2026-10-23T21:40:00.000Z", "edit_history_tweet_ids": ["2113747293023478196"], "entities": {"urls": [{"description": "Watch live coverage as SpaceX launches a Falcon 9 rocket from Calif...", "display_url": "youtube.com/watch?v=hANSUk…", "end": 270, "expanded_url": "https://www.youtube.com/watch?v=hANSUkrKDwQ", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2113747297037402112/MbXkLWWZ?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113747297037402112/MbXkLWWZ?format=jpg&name=150x150", "width": 150}], "start": 247, "status": 200, "title": "SpaceX Falcon 9 rocket launches from California with 27 Starlink satellites", "unwound_url": "https://www.youtube.com/watch?v=hANSUkrKDwQ", "url": "https://t.co/NcN9jHlwhl"}]}, "id": "2113747293023478196", "public_metrics": {"bookmark_count": 0, "impression_count": 8966, "like_count": 41, "quote_count": 1, "reply_count": 2, "retweet_count": 7}, "text": "SpaceX will try for a 4th time this week to launch the Starlink 15-15 mission from Vandenberg. Liftoff of the Falcon 9 rocket is scheduled for 3:48 p.m. PDT (6:48 p.m. EDT / 2248 UTC). Our coverage begins 30 minutes prior to liftoff.\n\nWatch live: https://t.co/NcN9jHlwhl", "url": "https://x.com/SpaceflightNow/status/2113747293023478196"}, {"author_id": "626660983", "created_at": "2026-10-23T21:30:52.000Z", "edit_history_tweet_ids": ["2113744992921624943"], "entities": {"urls": [{"display_url": "x.com/osinttechnical…", "end": 62, "expanded_url": "https://twitter.com/osinttechnical/status/2113741468275712302", "start": 39, "url": "https://t.co/zgrB6rgs0G"}]}, "id": "2113744992921624943", "public_metrics": {"bookmark_count": 0, "impression_count": 1970, "like_count": 29, "quote_count": 0, "reply_count": 3, "retweet_count": 1}, "referenced_tweets": [{"id": "2113741468275712302", "type": "quoted"}], "text": "After the Iran war\n\nSo\n\nLike\n\nIn 2033? https://t.co/zgrB6rgs0G", "url": "https://x.com/lymanstoneky/status/2113744992921624943"}, {"attachments": {"media_keys": ["3_2113743521643401216"]}, "author_id": "46648807", "created_at": "2026-10-23T21:25:02.000Z", "edit_history_tweet_ids": ["2113743526324306235"], "entities": {"urls": [{"display_url": "pic.x.com/mOn0sJXAu4", "end": 51, "expanded_url": "https://x.com/NIST/status/2113743526324306235/photo/1", "media_key": "3_2113743521643401216", "start": 28, "url": "https://t.co/mOn0sJXAu4"}]}, "id": "2113743526324306235", "public_metrics": {"bookmark_count": 3, "impression_count": 3049, "like_count": 52, "quote_count": 0, "reply_count": 2, "retweet_count": 12}, "text": "Holy mole-y, it’s Mole Day! https://t.co/mOn0sJXAu4", "url": "https://x.com/NIST/status/2113743526324306235"}, {"attachments": {"media_keys": ["3_2113699546211463168"]}, "author_id": "19355829", "created_at": "2026-10-23T18:30:19.000Z", "edit_history_tweet_ids": ["2113699557020217528"], "entities": {"urls": [{"display_url": "pic.x.com/Qf4DI8PNX3", "end": 303, "expanded_url": "https://x.com/planet4589/status/2113699557020217528/photo/1", "media_key": "3_2113699546211463168", "start": 280, "url": "https://t.co/Qf4DI8PNX3"}]}, "id": "2113699557020217528", "public_metrics": {"bookmark_count": 6, "impression_count": 11122, "like_count": 110, "quote_count": 1, "reply_count": 6, "retweet_count": 14}, "text": "Back from France, catching up on analysis. The object  found in Borneo on Oct 19 is indeed likely to be from the upper stage of  ZQ-2E Y4, launched on Oct 14 and reentered on Oct 18. The ground track  (using the final Space-Track TLE) passed near the debris site at 1036  UTC Oct https://t.co/Qf4DI8PNX3", "url": "https://x.com/planet4589/status/2113699557020217528"}, {"author_id": "11348282", "created_at": "2026-10-23T18:05:54.000Z", "edit_history_tweet_ids": ["2113693409772761305"], "entities": {"mentions": [{"end": 16, "id": "2000593641480605696", "start": 6, "username": "NASAAdmin"}], "urls": [{"description": "Artemis Acceleration", "display_url": "x.com/i/broadcasts/1…", "end": 196, "expanded_url": "https://x.com/i/broadcasts/1RJZzBdZYQgJB", "images": [{"height": 2160, "url": "https://pbs.twimg.com/news_img/2113693333960933376/xGXLZi3m?format=jpg&name=orig", "width": 3840}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113693333960933376/xGXLZi3m?format=jpg&name=150x150", "width": 150}], "start": 173, "status": 200, "title": "NASA", "unwo