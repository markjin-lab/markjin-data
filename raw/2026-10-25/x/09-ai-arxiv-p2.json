count": 0, "retweet_count": 0}, "text": "hybridagent combines standard text with internal vector reasoning to create agents for math, search, and medical tasks. it delivers 1.8x-2.6x speedup and reduces costs by up to 3.7x. paper:\nhttps://t.co/SfUo2wtvHk https://t.co/zQS3Khpxay", "url": "https://x.com/kumard_3/status/2113390102735093986"}], "includes": {"media": [{"media_key": "3_2113404487058460672", "type": "photo"}, {"media_key": "3_2113399116256477185", "type": "photo"}, {"media_key": "3_2113386531432067073", "type": "photo"}, {"media_key": "3_2113386558162436096", "type": "photo"}, {"media_key": "3_2113386561253539840", "type": "photo"}, {"media_key": "3_2113386564382515200", "type": "photo"}, {"media_key": "13_2113384418018725888", "type": "video"}, {"media_key": "3_2113396831354773504", "type": "photo"}, {"media_key": "3_2113389310103740416", "type": "photo"}, {"media_key": "3_2113390075488964608", "type": "photo"}], "users": [{"id": "135746708", "name": "Software Engineering Papers", "username": "ComputerPapers"}, {"id": "22146921", "name": "fly51fly", "username": "fly51fly"}, {"id": "1692398763396997120", "name": "Go Big or Go Home", "username": "AmericaGetBig"}, {"id": "212412903", "name": "Cryptography and Security Papers", "username": "FSFG"}, {"id": "565118338", "name": "Machine Learning (ML) Papers", "username": "Memoirs"}, {"id": "1318849414002143233", "name": "Kumar Deepanshu", "username": "kumard_3"}]}, "meta": {"newest_id": "2113404489189204156", "next_token": "b26v89c19zqg8o3juzlwtp2krzcbvtida5bffrod1fgcd", "oldest_id": "2113384463258558546", "result_count": 7}}
