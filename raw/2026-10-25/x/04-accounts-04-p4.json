r_id": "32372834", "created_at": "2026-10-23T12:00:11.000Z", "edit_history_tweet_ids": ["2113601375946801229"], "entities": {"hashtags": [{"end": 86, "start": 57, "tag": "ScienceTranslationalMedicine"}], "urls": [{"display_url": "pic.x.com/Fgk5F7xrzU", "end": 305, "expanded_url": "https://x.com/ScienceMagazine/status/2113601375946801229/photo/1", "media_key": "3_2113601373199618048", "start": 282, "url": "https://t.co/Fgk5F7xrzU"}]}, "id": "2113601375946801229", "public_metrics": {"bookmark_count": 1, "impression_count": 12016, "like_count": 21, "quote_count": 0, "reply_count": 2, "retweet_count": 4}, "text": "Last chance: Apply for the BioInnovation Institute &amp; #ScienceTranslationalMedicine Prize for Innovations in Women’s Health\n\nThis prize recognizes researchers who have developed innovative advances with translational potential to impact women’s health globally.\n\nThe Grand Prize https://t.co/Fgk5F7xrzU", "url": "https://x.com/ScienceMagazine/status/2113601375946801229"}, {"author_id": "3290364847", "created_at": "2026-10-23T11:52:26.000Z", "edit_history_tweet_ids": ["2113599426019099091"], "entities": {"urls": [{"description": "What state officials scrambling to implement Medicaid work requirements shared behind closed doors at the National Association of Medicaid Directors conference.", "display_url": "trib.al/f2G1d3P", "end": 184, "expanded_url": "https://trib.al/f2G1d3P", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2113599431106850816/KiwseUSn?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113599431106850816/KiwseUSn?format=jpg&name=150x150", "width": 150}], "start": 161, "status": 200, "title": "State officials scrambling to implement Medicaid work requirements meet up to swap notes", "unwound_url": "https://www.statnews.com/2026/10/23/state-medicaid-officials-prepare-for-new-work-requirements/?utm_campaign=twitter_organic&utm_source=twitter&utm_medium=social", "url": "https://t.co/UFUEBFmapp"}]}, "id": "2113599426019099091", "public_metrics": {"bookmark_count": 1, "impression_count": 1831, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "What state officials scrambling to implement Medicaid work requirements shared behind closed doors at the National Association of Medicaid Directors conference. https://t.co/UFUEBFmapp", "url": "https://x.com/statnews/status/2113599426019099091"}, {"author_id": "15862891", "created_at": "2026-10-23T11:51:22.000Z", "edit_history_tweet_ids": ["2113599158850314344"], "entities": {"urls": [{"description": "Nature - Long-awaited results from phase III trial show a huge benefit in treating treatment-resistant melanoma.", "display_url": "go.nature.com/4izbJnE", "end": 203, "expanded_url": "https://go.nature.com/4izbJnE", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2113599164374278144/HNRfOuoy?format=jpg&name=orig", "width": 1066}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113599164374278144/HNRfOuoy?format=jpg&name=150x150", "width": 150}], "start": 180, "status": 200, "title": "Moderna mRNA vaccine almost halves the risk of skin cancer returning", "unwound_url": "https://www.nature.com/articles/d41586-026-03417-0?utm_source=x&utm_medium=social&utm_campaign=nature&linkId=64211417&error=cookies_not_supported&code=f9829c7c-6ce8-43d8-ae6f-3f968a087898", "url": "https://t.co/Fz7yaxstFQ"}]}, "id": "2113599158850314344", "public_metrics": {"bookmark_count": 73, "impression_count": 50091, "like_count": 344, "quote_count": 11, "reply_count": 18, "retweet_count": 91}, "text": "A more than 40% risk reduction “would send many researchers over the Moon”. This personalised mRNA vaccine reduced the risk of skin cancer returning or the recipient dying by 42%\n\nhttps://t.co/Fz7yaxstFQ", "url": "https://x.com/Nature/status/2113599158850314344"}, {"attachments": {"media_keys": ["3_2113587827565051904"]}, "author_id": "26832834", "created_at": "2026-10-23T11:06:21.000Z", "edit_history_tweet_ids": ["2113587830106796051"], "entities": {"hashtags": [{"end": 11, "start": 4, "tag": "ESMO26"}], "urls": [{"display_url": "pic.x.com/DXQylHc5my", "end": 295, "expanded_url": "https://x.com/NatureMedicine/status/2113587830106796051/photo/1", "media_key": "3_2113587827565051904", "start": 272, "url": "https://t.co/DXQylHc5my"}]}, "id": "2113587830106796051", "public_metrics": {"bookmark_count": 2, "impression_count": 4180, "like_count": 12, "quote_count": 1, "reply_count": 0, "retweet_count": 6}, "text": "Now #ESMO26: In a phase 2 trial evaluating an off-the-shelf peptide vaccine in patients with mKRAS PDAC, the 1ry endpoint of DFS was not met but prespecified analyses showed that significant DFS was seen in the vaccine arm in patients with ctDNA- disease. dlvr.​it/TW27M9 https://t.co/DXQylHc5my", "url": "https://x.com/NatureMedicine/status/2113587830106796051"}, {"attachments": {"media_keys": ["3_2113586634876977152"]}, "author_id": "26832834", "created_at": "2026-10-23T11:01:38.000Z", "edit_history_tweet_ids": ["2113586641826930791"], "entities": {"hashtags": [{"end": 23, "start": 16, "tag": "ESMO26"}], "urls": [{"display_url": "pic.x.com/nL8pOgJFv7", "end": 289, "expanded_url": "https://x.com/NatureMedicine/status/2113586641826930791/photo/1", "media_key": "3_2113586634876977152", "start": 266, "url": "https://t.co/nL8pOgJFv7"}]}, "id": "2113586641826930791", "public_metrics": {"bookmark_count": 1, "impression_count": 3057, "like_count": 13, "quote_count": 0, "reply_count": 0, "retweet_count": 4}, "text": "As presented at #ESMO26: In a phase 1/2 trial in patients with solid tumors, a first-in-class bispecific antibody targeting the Vβ6/Vβ10 T cell subsets was well tolerated and showed preliminary efficacy signals in immunologically hot and cold tumors dlvr.​it/TW276w https://t.co/nL8pOgJFv7", "url": "https://x.com/NatureMedicine/status/2113586641826930791"}, {"author_id": "3290364847", "created_at": "2026-10-23T10:56:20.000Z", "edit_h