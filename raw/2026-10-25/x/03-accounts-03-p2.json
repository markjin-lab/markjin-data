{"data": [{"author_id": "14096763", "created_at": "2026-10-23T19:29:55.000Z", "edit_history_tweet_ids": ["2113714554777870464"], "id": "2113714554777870464", "public_metrics": {"bookmark_count": 68, "impression_count": 62658, "like_count": 505, "quote_count": 8, "reply_count": 57, "retweet_count": 14}, "text": "I’m really curious how big the market will actually be for true “frontier” intelligence. \n\nWhat does it say, for example, that there are brilliant physics PhDs for whom a tenure-track position at Calgary A&amp;M is actually a good career outcome?", "url": "https://x.com/TheStalwart/status/2113714554777870464"}, {"author_id": "14096763", "created_at": "2026-10-23T19:10:17.000Z", "edit_history_tweet_ids": ["2113709614239998022"], "entities": {"urls": [{"display_url": "x.com/kramnotmark/st…", "end": 60, "expanded_url": "https://twitter.com/kramnotmark/status/2113668179788534255", "start": 37, "url": "https://t.co/jnGX2taie9"}]}, "id": "2113709614239998022", "public_metrics": {"bookmark_count": 545, "impression_count": 200743, "like_count": 873, "quote_count": 2, "reply_count": 42, "retweet_count": 14}, "referenced_tweets": [{"id": "2113668179788534255", "type": "quoted"}], "text": "At least we’re in the best quadrant! https://t.co/jnGX2taie9", "url": "https://x.com/TheStalwart/status/2113709614239998022"}, {"author_id": "14096763", "created_at": "2026-10-23T19:06:29.000Z", "edit_history_tweet_ids": ["2113708659939188961"], "entities": {"urls": [{"display_url": "x.com/panamcd/status…", "end": 27, "expanded_url": "https://twitter.com/panamcd/status/2113587998893961637", "start": 4, "url": "https://t.co/Z3kOjXU46e"}]}, "id": "2113708659939188961", "public_metrics": {"bookmark_count": 0, "impression_count": 13900, "like_count": 59, "quote_count": 0, "reply_count": 2, "retweet_count": 1}, "referenced_tweets": [{"id": "2113587998893961637", "type": "quoted"}], "text": "Me: https://t.co/Z3kOjXU46e", "url": "https://x.com/TheStalwart/status/2113708659939188961"}, {"au