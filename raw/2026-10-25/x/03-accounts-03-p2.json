t=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113589014712467456/HNHdtOD6?format=jpg&name=150x150", "width": 150}], "start": 76, "status": 200, "title": "Citigroup gets Beijing’s approval for wholly owned securities firm in China", "unwound_url": "https://www.scmp.com/business/markets/article/3371911/citigroup-gets-beijings-approval-wholly-owned-securities-firm-china", "url": "https://t.co/GHMhnVHugo"}]}, "id": "2113702220411625840", "public_metrics": {"bookmark_count": 0, "impression_count": 1583, "like_count": 5, "quote_count": 0, "reply_count": 0, "retweet_count": 3}, "text": "Citigroup gets Beijing’s approval for wholly owned securities firm in China\nhttps://t.co/GHMhnVHugo", "url": "https://x.com/ChinaBeigeBook/status/2113702220411625840"}, {"attachments": {"media_keys": ["3_2113698732084547584", "3_2113698752590454784", "3_2113698773020893184"]}, "author_id": "14096763", "created_at": "2026-10-23T18:28:06.000Z", "edit_history_tweet_ids": ["2113698997345177876"], "entities": {"mentions": [{"end": 199, "id": "1478820195586084864", "start": 184, "username": "ahall_research"}], "urls": [{"display_url": "pic.x.com/djboGYFQHZ", "end": 302, "expanded_url": "https://x.com/TheStalwart/status/2113698997345177876/photo/1", "media_key": "3_2113698732084547584", "start": 279, "url": "https://t.co/djboGYFQHZ"}, {"display_url": "pic.x.com/djboGYFQHZ", "end": 302, "expanded_url": "https://x.com/TheStalwart/status/2113698997345177876/photo/1", "media_key": "3_2113698752590454784", "start": 279, "url": "https://t.co/djboGYFQHZ"}, {"display_url": "pic.x.com/djboGYFQHZ", "end": 302, "expanded_url": "https://x.com/TheStalwart/status/2113698997345177876/photo/1", "media_key": "3_2113698773020893184", "start": 279, "url": "https://t.co/djboGYFQHZ"}]}, "id": "2113698997345177876", "public_metrics": {"bookmark_count": 621, "impression_count": 145824, "like_count": 871, "quote_count": 30, "reply_count": 55, "retweet_count": 88}, "text": "Some centrists fantasize that because all LLMs have the ideology of Ezra Klein, that we may be on the doorstep of a great political moderation.\n\nI wrote about a fascinating paper from @ahall_research and Sho Miyazaki that, to my mind, opens the door to a very different outcome. https://t.co/djboGYFQHZ", "url": "https://x.com/TheStalwart/status/2113698997345177876"}, {"attachments": {"media_keys": ["3_2113691881783873536"]}, "author_id": "702235316812275712", "created_at": "2026-10-23T18:00:03.000Z", "edit_history_tweet_ids": ["2113691938289524997"], "entities": {"urls": [{"display_url": "pic.x.com/JLdh3EShEW", "end": 291, "expanded_url": "https://x.com/EconBerger/status/2113691938289524997/photo/1", "media_key": "3_2113691881783873536", "start": 268, "url": "https://t.co/JLdh3EShEW"}]}, "id": "2113691938289524997", "public_metrics": {"bookmark_count": 1, "impression_count": 2525, "like_count": 11, "quote_count": 0, "reply_count": 3, "retweet_count": 2}, "text": "1/ We get the Q1 2026 business employment dynamics data next Wednesday.\n\nWe talk a lot about the \"frozen\", low turnover market, as measured by JOLTS &amp; similar data.\n\nBUT: turnover induced by establishment openings/closings is actually up relative to pre-pandemic. https://t.co/JLdh3EShEW", "url": "https://x.com/EconBerger/status/2113691938289524997"}, {"attachments": {"media_keys": ["3_2113686645857800193"]}, "author_id": "3039504459", "created_at": "2026-10-23T17:39:02.000Z", "edit_history_tweet_ids": ["2113686648286327048"], "entities": {"urls": [{"description": "The discovery of directional and robust wave manipulation has become a crucial goal in the field of science and technology. Topological pump, as an efficient form of directed energy transport protected by nontrivial topology, has been intensively studied in condensed matter and materials physics. Conventional topological pump schemes are mainly related to topological boundary/defect states in conventional lattices. In this Letter, we introduce the concept of topological pump in moir\\'e superlattices for acoustic waves. Acoustic moir\\'e superlattices support localized bulk states protected by a constant band gap throughout the modulation. Based on topological pump of localized bulk states, compact and nearly independent multi-channel topological sound transport is directly observed by spatial scanning of the sound fields, and its topological robustness is observed in the paths with defects. Modulated by topological transport channels, anomalous refraction, splitting, and helicity transp", "display_url": "go.aps.org/3W5TWM7", "end": 270, "expanded_url": "https://go.aps.org/3W5TWM7", "start": 247, "status": 200, "title": "Directional Transport by Topological Pump of Localized Moir\\'e Bulk States", "unwound_url": "https://journals.aps.org/prl/abstract/10.1103/cxsy-gshw", "url": "https://t.co/ULjofzZ6V5"}, {"display_url": "pic.x.com/UdfA5NbQlR", "end": 294, "expanded_url": "https://x.com/PhysRevLett/status/2113686648286327048/photo/1", "media_key": "3_2113686645857800193", "start": 271, "url": "https://t.co/UdfA5NbQlR"}]}, "id": "2113686648286327048", "public_metrics": {"bookmark_count": 27, "impression_count": 2836, "like_count": 72, "quote_count": 1, "reply_count": 1, "retweet_count": 9}, "text": "Researchers created a new material that traps and “pumps” sound waves between layers of slightly mismatched one-dimensional moiré lattices. This can allow signals to be routed without loss for communication and information processing.\n\nRead more: https://t.co/ULjofzZ6V5 https://t.co/UdfA5NbQlR", "url": "https://x.com/PhysRevLett/status/2113686648286327048"}, {"attachments": {"media_keys": ["3_2113661860398379008"]}, "author_id": "2961589380", "created_at": "2026-10-23T16:00:32.000Z", "edit_history_tweet_ids": ["2113661863082758520"], "entities": {"mentions": [{"end": 226, "id": "338875694", "start": 214, "username": "SPGlobalPMI"}], "urls": [{"display_url": "pic.x.com/eFFsV4azp1", "end": 250, "expanded_url": "https://x.com/LizAnnSonders/status/2113661863082758520/photo/1", "media_key": "3_2113661860398379008", "start": 227, "url": "https://t.co/eFFsV4azp1"}]}, "id": "2113661863082758520", "public_metrics": {"bookmark_count": 4, "impression_count": 18051, "like_count": 131, "quote_count": 28, "reply_count": 21, "retweet_count": 14}, "text": "October preliminary S&amp;P Global US Composite PMI down to 56 vs. 55.5 est. &amp; 55.9 prior … selling prices remained elevated while demand was firm and employment expanded … continues to suggest firm GDP growth\n@SPGlobalPMI https://t.co/eFFsV4azp1", "url": "https://x.com/LizAnnSonders/status/2113661863082758520"}, {"attachments": {"media_keys": ["3_2113661749085782016"]}, "author_id": "2961589380", "created_at": "2026-10-23T16:00:06.000Z", "edit_history_tweet_ids": ["2113661752567374180"], "entities": {"urls": [{"display_url": "pic.x.com/2bEBXc16CW", "end": 258, "expanded_url": "https://x.com/LizAnnSonders/status/2113661752567374180/photo/1", "media_key": "3_2113661749085782016", "start": 235, "url": "https://t.co/2bEBXc16CW"}]}, "id": "2113661752567374180", "public_metrics": {"bookmark_count": 2, "impression_count": 15942, "like_count": 99, "quote_count": 0, "reply_count": 9, "retweet_count": 9}, "text": "October Kansas City Fed Services Index up to +10 vs. +1 est. &amp; 0 prior … revenue much stronger at +16 vs. +6 prior; employment up to +2 vs. -10 prior; both selling and input prices still high but a bit softer relative to September https://t.co/2bEBXc16CW", "url": "https://x.com/LizAnnSonders/status/2113661752567374180"}, {"author_id": "2961589380", "created_at": "2026-10-23T15:58:36.000Z", "edit_history_tweet_ids": ["2113661376673481016"], "entities": {"hashtags": [{"end": 23, "start": 11, "tag": "OnInvesting"}], "mentions": [{"end": 77, "id": "342855809", "start": 62, "username": "CollinMartinCS"}]}, "id": "2113661376673481016", "public_metrics": {"bookmark_count": 4, "impression_count": 13334, "like_count": 19, "quote_count": 0, "reply_count": 4, "retweet_count": 1}, "text": "Our latest #OnInvesting podcast episode has dropped, on which @CollinMartinCS and I examine Treasury yields’ sharp swings, what stubborn inflation could mean for Fed policy, and why bonds can still provide income and diversification even as rates remain elevated … we also dig", "url": "https://x.com/LizAnnSonders/status/2113661376673481016"}, {"author_id": "14096763", "created_at": "2026-10-23T15:57:45.000Z", "edit_history_tweet_ids": ["2113661163389042958"], "entities": {"mentions": [{"end": 27, "id": "35002876", "start": 15, "username": "BloombergTV"}]}, "id": "2113661163389042958", "public_metrics": {"bookmark_count": 1, "impression_count": 14305, "like_count": 103, "quote_count": 1, "reply_count": 12, "retweet_count": 0}, "text": "About to go on @BloombergTV!", "url": "https://x.com/TheStalwart/status/2113661163389042958"}, {"author_id": "702235316812275712", "created_at": "2026-10-23T15:56:34.000Z", "edit_history_tweet_ids": ["2113660862162763835"], "entities": {"urls": [{"display_url": "x.com/scaramucci/sta…", "end": 135, "expanded_url": "https://twitter.com/scaramucci/status/2113314564834275596", "start": 112, "url": "https://t.co/z0vMDGLiwk"}]}, "id": "2113660862162763835", "public_metrics": {"bookmark_count": 2, "impression_count": 4866, "like_count": 44, "quote_count": 0, "reply_count": 14, "retweet_count": 0}, "referenced_tweets": [{"id": "2113314564834275596", "type": "quoted"}], "text": "Something I don’t get about the “in gold price terms” mannerisms… why not use S&amp;P 500 total returns instead https://t.co/z0vMDGLiwk", "url": "https://x.com/EconBerger/status/2113660862162763835"}, {"author_id": "3512101", "created_at": "2026-10-23T15:50:20.000Z", "edit_history_tweet_ids": ["2113659295514669300"], "entities": {"urls": [{"display_url": "x.com/scmpnews/statu…", "end": 149, "expanded_url": "https://twitter.com/scmpnews/status/2113647900492259582", "start": 126, "url": "https://t.co/n8zL3DvzuT"}]}, "id": "2113659295514669300", "public_metrics": {"bookmark_count": 1, "impression_count": 4582, "like_count": 6, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2113647900492259582", "type": "quoted"}], "text": "Pieces of a landspace zhuque-2e land in US. Can the landowner leverage America’s “lawyerly society” and sue the rocket maker? https://t.co/n8zL3DvzuT", "url": "https://x.com/niubi/status/2113659295514669300"}, {"attachments": {"media_keys": ["3_2113658262490841088"]}, "author_id": "3039504459", "created_at": "2026-10-23T15:46:14.000Z", "edit_history_tweet_ids": ["2113658265066217523"], "entities": {"urls": [{"description": "Terahertz magneto-optics is established as a direct probe of helical vortex-core excitations, providing dynamical evidence for multiband CdGM states in iron-based superconductors.", "display_url": "go.aps.org/4i9N7R6", "end": 255, "expanded_url": "https://go.aps.org/4i9N7R6", "images": [{"height": 200, "url": "https://pbs.twimg.com/news_img/2113658268056768513/oarJpnMS?format=png&name=orig", "width": 200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113658268056768513/oarJpnMS?format=png&name=150x150", "width": 150}], "start": 232, "status": 200, "title": "Chirality-Resolved Spectroscopy of Caroli--de Gennes--Matricon States in Multiband ${\\mathrm{FeTe}}_{1\\ensuremath{-}x}{\\mathrm{Se}}_{x}$ Superconductors", "unwound_url": "https://journals.aps.org/prl/abstract/10.1103/wrds-99zb", "url": "https://t.co/OtCiLVdyfx"}, {"display_url": "pic.x.com/BOkkX2nzIB", "end": 279, "expanded_url": "https://x.com/PhysRevLett/status/2113658265066217523/photo/1", "media_key": "3_2113658262490841088", "start": 256, "url": "https://t.co/BOkkX2nzIB"}]}, "id": "2113658265066217523", "public_metrics": {"bookmark_count": 14, "impression_count": 2401, "like_count": 31, "quote_count": 1, "reply_count": 1, "retweet_count": 5}, "text": "A spectroscopy study of Caroli-de Gennes-Matricon (CdGM) states shows the u