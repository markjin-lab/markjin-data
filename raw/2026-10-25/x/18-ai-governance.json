lais/status/2113481464566210599"}, {"attachments": {"media_keys": ["3_2113795908051554304"]}, "author_id": "2035731288968290304", "created_at": "2026-10-24T00:53:13.000Z", "edit_history_tweet_ids": ["2113795914326282749"], "id": "2113795914326282749", "public_metrics": {"bookmark_count": 0, "impression_count": 62, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Frontier AI training was already resumed on October 1st, according to the latest statement from OpenAI. \n\n&gt; Additionally, a substantial amount of compute will be consistently allocated to red teaming.\n\nThis is a very important part as the cost of aligned frontier AI development https://t.co/9o3Wu0u1nc", "url": "https://x.com/Policifyai/status/2113795914326282749"}, {"author_id": "1609642251746942982", "created_at": "2026-10-24T15:18:45.000Z", "edit_history_tweet_ids": ["2114013733525602729"], "id": "2114013733525602729", "public_metrics": {"bookmark_count": 0, "impression_count": 524, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2113710752741892476", "type": "quoted"}], "text": "Moonshot is the PingCAP of frontier AI. https://t.co/0g9KYtfSZb", "url": "https://x.com/thedealdirector/status/2114013733525602729"}, {"attachments": {"media_keys": ["3_2113997634864128000"]}, "author_id": "1952446767200714753", "created_at": "2026-10-24T14:14:48.000Z", "edit_history_tweet_ids": ["2113997642036641897"], "id": "2113997642036641897", "public_metrics": {"bookmark_count": 0, "impression_count": 256, "like_count": 6, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "The current state of frontier AI. https://t.co/fjFyqY3doR", "url": "https://x.com/AgataAndDrift/status/2113997642036641897"}, {"author_id": "2067443257194536960", "created_at": "2026-10-24T07:35:03.000Z", "edit_history_tweet_ids": ["2113897042841915868"], "id": "2113897042841915868", "public_metrics": {"bookmark_count": 0, "impression_count": 4, 