dth": 150}], "start": 252, "status": 200, "title": "27th Jacques Polak Annual Research Conference: Towards a Multipolar World – Technology and Geopolitics", "unwound_url": "https://www.imf.org/en/news/seminars/conferences/2026/11/12/2026-jacques-polak-annual-research-conference", "url": "https://t.co/s73ER7j6MC"}, {"display_url": "pic.x.com/NeOE8UaoTm", "end": 299, "expanded_url": "https://x.com/IMFNews/status/2117383773306442128/photo/1", "media_key": "3_2117383757011550208", "start": 276, "url": "https://t.co/NeOE8UaoTm"}]}, "id": "2117383773306442128", "public_metrics": {"bookmark_count": 19, "impression_count": 21567, "like_count": 123, "quote_count": 7, "reply_count": 10, "retweet_count": 39}, "text": "📅 SAVE THE DATE: How will digital money and geopolitical shifts reshape the international monetary system? Join IMF’s @KGeorgieva, Chief Economist @STenreyroIMF &amp; leading researchers Nov 12–13 for the 27th Jacques Polak Annual Research Conference. https://t.co/s73ER7j6MC https://t.co/NeOE8UaoTm", "url": "https://x.com/IMFNews/status/2117383773306442128"}, {"author_id": "39125788", "created_at": "2026-11-02T21:45:13.000Z", "edit_history_tweet_ids": ["2117372481191239762"], "entities": {"urls": [{"display_url": "pic.x.com/EdBVhzpGqg", "end": 151, "expanded_url": "https://x.com/emollick/status/2117372481191239762/photo/1", "media_key": "3_2117372212650856448", "start": 128, "url": "https://t.co/EdBVhzpGqg"}]}, "id": "2117372481191239762", "public_metrics": {"bookmark_count": 168, "impression_count": 78177, "like_count": 499, "quote_count": 14, "reply_count": 96, "retweet_count": 23}, "text": "Opus 5.5: \"Give me 10 brilliant ideas for a science fiction short short story, pick the most brilliant and execute it terribly\" https://t.co/EdBVhzpGqg", "url": "https://x.com/emollick/status/2117372481191239762"}, {"author_id": "332617373", "created_at": "2026-11-02T21:42:30.000Z", "edit_history_tweet_ids": ["2117371797674885139"], "entities": {"hashtags": [{"end": 263, "start": 255, "tag": "economy"}, {"end": 272, "start": 264, "tag": "markets"}, {"end": 279, "start": 273, "tag": "bonds"}], "urls": [{"display_url": "pic.x.com/v7lrTWbejy", "end": 303, "expanded_url": "https://x.com/elerianm/status/2117371797674885139/photo/1", "media_key": "3_2117371642309390337", "start": 280, "url": "https://t.co/v7lrTWbejy"}]}, "id": "2117371797674885139", "public_metrics": {"bookmark_count": 45, "impression_count": 84548, "like_count": 756, "quote_count": 13, "reply_count": 84, "retweet_count": 68}, "text": "I don't know about you, but I find it notable that the yield on 10-year US Treasuries barely moved lower on the day, closing at 4.91%, notwithstanding an 8% drop in oil prices and an intraday turnaround that saw the Nasdaq lose steam and close down 1.1%.\n#economy #markets #bonds https://t.co/v7lrTWbejy", "url": "https://x.com/elerianm/status/2117371797674885139"}, {"author_id": "279036722", "created_at": "2026-11-02T21:13:52.000Z", "edit_history_tweet_ids": ["2117364592309313626"], "id": "2117364592309313626", "public_metrics": {"bookmark_count": 30, "impression_count": 21193, "like_count": 67, "quote_count": 0, "reply_count": 7, "retweet_count": 4}, "text": "The definitive answers to how much the CA wealth tax would raise, read it before you vote!\n\nA great, transparent and useful use of AI-based policy analysis, you can choose your own assumptions and crosswalk the competing estimates from Fernando Hoces de la Guardia.", "url": "https://x.com/jasonfurman/status/2117364592309313626"}], "includes": {"users": [{"id": "83466368", "name": "European Central Bank", "username": "ecb"}, {"id": "39125788", "name": "Ethan Mollick", "username": "emollick"}, {"id": "1214528593", "name": "Miles Brundage", "username": "Miles_Brundage"}, {"id": "279036722", "name": "Jason Furman", "username": "jasonfurman"}, {"id": "612896910", "name": "BLS-Labor Statistics", "username": "BLS_gov"}, {"id": "25098482", "name": "IMF", "username": "IMFNews"}, {"id": "332617373", "name": "Mohamed A. El-Erian", "username": "elerianm"}]}, "meta": {"newest_id": "2117542803001512138", "next_token": "b26v89c19zqg8o3juzlyibhqvct0odnpdou67t0cwphml", "oldest_id": "2117364592309313626", "result_count": 13}}
