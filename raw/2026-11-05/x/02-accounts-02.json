{"data": [{"author_id": "332617373", "created_at": "2026-11-04T20:37:46.000Z", "edit_history_tweet_ids": ["2118080282536583318"], "id": "2118080282536583318", "public_metrics": {"bookmark_count": 3, "impression_count": 9390, "like_count": 37, "quote_count": 0, "reply_count": 13, "retweet_count": 8}, "text": "A big day across markets benefiting both Wall Street and Main Street.\nWall Street:\n• Major US equity indices up 2–3%\n• Gold &amp; Bitcoin surging 3%\n• Corporate bond spreads tightening\nMain Street:\n• Oil sliding 8%\n• 10-year Treasury yield down 6 bps, easing borrowing costs.", "url": "https://x.com/elerianm/status/2118080282536583318"}, {"author_id": "1214528593", "created_at": "2026-11-04T17:49:39.000Z", "edit_history_tweet_ids": ["2118037976878047460"], "id": "2118037976878047460", "public_metrics": {"bookmark_count": 19, "impression_count": 6335, "like_count": 51, "quote_count": 1, "reply_count": 16, "retweet_count": 3}, "text": "Who’s working on good takes re: datacenter implications?", "url": "https://x.com/Miles_Brundage/status/2118037976878047460"}, {"author_id": "1214528593", "created_at": "2026-11-04T17:41:08.000Z", "edit_history_tweet_ids": ["2118035832703799503"], "entities": {"urls": [{"display_url": "pic.x.com/ULVAXksSb3", "end": 55, "expanded_url": "https://x.com/pleometric/status/2103082510607610023/video/1?s=46", "media_key": "13_2103081744408657920", "start": 32, "url": "https://t.co/ULVAXksSb3"}]}, "id": "2118035832703799503", "public_metrics": {"bookmark_count": 16, "impression_count": 3050, "like_count": 58, "quote_count": 0, "reply_count": 3, "retweet_count": 1}, "text": "This is the national anthem now https://t.co/ULVAXksSb3", "url": "https://x.com/Miles_Brundage/status/2118035832703799503"}, {"author_id": "15072071", "created_at": "2026-11-04T17:09:03.000Z", "edit_history_tweet_ids": ["2118027758487978055"], "entities": {"urls": [{"display_url": "pic.x.com/xcCJLBFRqx", "end": 299, "expanded_url": "https://x.com/NewYorkFed/status/21