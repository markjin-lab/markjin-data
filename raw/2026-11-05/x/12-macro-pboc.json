url": "https://x.com/WeRide_ai/status/2117437051562004834"}, {"author_id": "1689525816634314752", "created_at": "2026-11-03T21:40:16.000Z", "edit_history_tweet_ids": ["2117733625437241507"], "entities": {"hashtags": [{"end": 174, "start": 169, "tag": "Śrem"}], "urls": [{"display_url": "pic.x.com/PT4w5fJ7UT", "end": 198, "expanded_url": "https://x.com/tenpoznan/status/2117733625437241507/photo/1", "media_key": "3_2117733623176548352", "start": 175, "url": "https://t.co/PT4w5fJ7UT"}]}, "id": "2117733625437241507", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Kolizja ciężarówki i auta w Dolsku 3 listopada o 7.30. Jeden z poszkodowanych został wydostany z wraku przez strażaków i przetransportowany śmigłowcem LPR do szpitala.\n\n#Śrem https://t.co/PT4w5fJ7UT", "url": "https://x.com/tenpoznan/status/2117733625437241507"}, {"author_id": "2955112201", "created_at": "2026-11-04T03:20:30.000Z", "edit_history_tweet_ids": ["2117819246768251388"], "id": "2117819246768251388", "public_metrics": {"bookmark_count": 0, "impression_count": 52, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "LPR 8000超えた🔥\nまだミスあるからもう少し伸ばせそう", "url": "https://x.com/KiByzmcDC6Rw0o3/status/2117819246768251388"}, {"author_id": "1418922643311443971", "created_at": "2026-11-03T13:35:33.000Z", "edit_history_tweet_ids": ["2117611641965863166"], "entities": {"urls": [{"display_url": "x.com/aston_lv/statu…", "end": 44, "expanded_url": "https://twitter.com/aston_lv/status/2117603389932712402", "start": 21, "url": "https://t.co/ml3Ojud7IC"}]}, "id": "2117611641965863166", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117603389932712402", "type": "quoted"}], "text": "Dek klo lpr mkn nasi https://t.co/ml3Ojud7IC", "url": "https://x.com/aaanakhilang/status/21176