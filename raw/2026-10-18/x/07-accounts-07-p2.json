s":["2110838188503617935"],"id":"2110838188503617935","public_metrics":{"bookmark_count":1,"impression_count":1319,"like_count":9,"quote_count":0,"reply_count":1,"retweet_count":1},"text":"To ensure the safety and efficacy of new drugs, pharmaceutical companies need to know which isomer they are producing. NIST and @harvardmed have developed a novel way to identify the enzymes that act upon compounds to create specific isomers. \n\nLearn more: https://t.co/fhg5JcyLLN https://t.co/u5cFF5GTkp","url":"https://x.com/NIST/status/2110838188503617935"}],"includes":{"media":[{"media_key":"3_2110884157618376704","type":"photo"},{"media_key":"13_2110883883948314624","type":"video"},{"media_key":"3_2110875392894517248","type":"photo"},{"media_key":"3_2110871278739390464","type":"photo"},{"media_key":"3_2110838184355549184","type":"photo"}],"users":[{"id":"17217640","name":"Spaceflight Now","username":"SpaceflightNow"},{"id":"34743251","name":"SpaceX","username":"SpaceX"},{"id":"19355829","name":"Jonathan McDowell","username":"planet4589"},{"id":"626660983","name":"Lyman Stone 石來民 🦬🦬🦬","username":"lymanstoneky"},{"id":"46648807","name":"National Institute of Standards and Technology","username":"NIST"}]},"meta":{"newest_id":"2110884183568527540","next_token":"b26v89c19zqg8o3juzlvkiuvze4k73oz3znueilz7yid9","oldest_id":"2110838188503617935","result_count":8}}