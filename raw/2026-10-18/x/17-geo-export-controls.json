{"data":[{"author_id":"1616303851","created_at":"2026-10-17T18:40:00.000Z","edit_history_tweet_ids":["2111527665920573795"],"entities":{"mentions":[{"end":96,"id":"18949452","start":93,"username":"FT"}],"urls":[{"description":"Expanded restrictions highlight Beijing’s determination to prevent transfer of most advanced technology overseas","display_url":"ft.com/content/e0a129…","end":88,"expanded_url":"https://www.ft.com/content/e0a1295c-4492-4fdd-aaf5-55678a9ef9bf","images":[{"height":394,"url":"https://pbs.twimg.com/news_img/2111087021506912256/Yu6dLkoO?format=jpg&name=orig","width":700},{"height":150,"url":"https://pbs.twimg.com/news_img/2111087021506912256/Yu6dLkoO?format=jpg&name=150x150","width":150}],"start":65,"status":200,"title":"China unveils draft export controls on AI technologies and chips","unwound_url":"https://www.ft.com/content/e0a1295c-4492-4fdd-aaf5-55678a9ef9bf","url":"https://t.co/BDztdkHxlx"}]},"id":"2111527665920573795","public_metrics":{"bookmark_count":0,"impression_count":7,"like_count":0,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"China unveils draft export controls on AI technologies and chips https://t.co/BDztdkHxlx via @ft","url":"https://x.com/OnlyOneMichele/status/2111527665920573795"},{"author_id":"22876458","created_at":"2026-10-17T16:05:44.000Z","edit_history_tweet_ids":["2111488841429467311"],"id":"2111488841429467311","public_metrics":{"bookmark_count":0,"impression_count":10,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"china just drafted export controls on 23 ai technologies, including its biggest models. the us blocked chips, china blocked brains. the ai cold war just got its own export list","url":"https://x.com/amohar/status/2111488841429467311"},{"author_id":"1815764618729705473","created_at":"2026-10-17T11:39:48.000Z","edit_history_tweet_ids":["2111421917655707908"],"id":"2111421917655707908","public_metrics":{"bookmark_count":1,"impression_count":7,"like_count":1,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"AI is becoming more than a technology race. It's becoming a geopolitical one.\n\nChina has proposed new export controls on advanced AI technologies and chips.\n\nWho will control the future of AI?","url":"https://x.com/MohammadHas17/status/2111421917655707908"},{"author_id":"1388133094197063682","created_at":"2026-10-17T10:03:00.000Z","edit_history_tweet_ids":["2111397557922373759"],"id":"2111397557922373759","public_metrics":{"bookmark_count":0,"impression_count":288,"like_count":18,"quote_count":0,"reply_count":12,"retweet_count":3},"text":"AI is becoming a tool of statecraft. \n\nIn June, U.S. export controls briefly cut off access to two frontier AI models before being lifted weeks later. \n\nChips and code are the new chokepoints.","url":"https://x.com/HemantS42019742/status/2111397557922373759"},{"author_id":"2107443817184116736","created_at":"2026-10-17T16:00:22.000Z","edit_history_tweet_ids":["2111487493015323028"],"id":"2111487493015323028","public_metrics":{"bookmark_count":0,"impression_count":19,"like_count":0,"quote_count":0,"reply_count":1,"retweet_count":0},"text":"ByteDance is in advanced talks to buy custom AI chips from MediaTek, per Bloomberg. Barred from Nvidia's best GPUs, it's spreading bets — Qualcomm earlier this year, now MediaTek ASICs. Export controls are redrawing the chip map.","url":"https://x.com/TechOutrider/status/2111487493015323028"},{"author_id":"1597133500515229696","created_at":"2026-10-17T10:10:00.000Z","edit_history_tweet_ids":["2111399319668682869"],"entities":{"hashtags":[{"end":225,"start":202,"tag":"ArtificialIntelligence"},{"end":238,"start":226,"tag":"Geopolitics"},{"end":249,"start":239,"tag":"17octobre"}]},"id":"2111399319668682869","public_metrics":{"bookmark_count":0,"impression_count":327,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"AI is no longer just technology; it is becoming a new battleground for global power. China’s proposed AI export controls show how chips, data, and AI models are becoming strategic geopolitical assets.\n\n#ArtificialIntelligence #Geopolitics\n#17octobre","url":"https://x.com/UmarMubashirT/status/2111399319668682869"},{"author_id":"10977192","created_at":"2026-10-16T13:31:36.000Z","edit_history_tweet_ids":["2111087666837999761"],"entities":{"urls":[{"description":"Expanded restrictions highlight Beijing’s determination to prevent transfer of most advanced technology overseas","display_url":"ft.trib.al/AW3XWdr","end":88,"expanded_url":"https://ft.trib.al/AW3XWdr","images":[{"height":394,"url":"https://pbs.twimg.com/news_img/2111081286118887424/cm0kcskp?format=jpg&name=orig","width":700},{"height":150,"url":"https://pbs.twimg.com/news_img/2111081286118887424/cm0kcskp?format=jpg&name=150x150","width":150}],"start":65,"status":200,"title":"China unveils draft export controls on AI technologies and chips","unwound_url":"https://www.ft.com/content/e0a1295c-4492-4fdd-aaf5-55678a9ef9bf?syn-25a6b1a6=1","url":"https://t.co/uDZc6Ubpkp"}]},"id":"2111087666837999761","public_metrics":{"bookmark_count":0,"impression_count":924,"like_count":3,"quote_count":2,"reply_count":0,"retweet_count":1},"text":"China unveils draft export controls on AI technologies and chips https://t.co/uDZc6Ubpkp","url":"https://x.com/fttechnews/status/2111087666837999761"},{"author_id":"875356066552442883","created_at":"2026-10-16T14:02:37.000Z","edit_history_tweet_ids":["2111095473129824467"],"entities":{"urls":[{"description":"Expanded restrictions highlight Beijing’s determination to prevent transfer of most advanced technology overseas","display_url":"ft.trib.al/FyZFGBW","end":88,"expanded_url":"https://ft.trib.al/FyZFGBW","images":[{"height":394,"url":"https://pbs.twimg.com/news_img/2111081286118887424/cm0kcskp?format=jpg&name=orig","width":700},{"height":150,"url":"https://pbs.twimg.com/news_img/2111081286118887424/cm0kcskp?format=jpg&name=150x150","width":150}],"start":65,"status":200,"title":"China unveils draf