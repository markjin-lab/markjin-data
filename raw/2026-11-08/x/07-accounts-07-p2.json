{"data": [{"author_id": "11348282", "created_at": "2026-11-06T23:00:04.000Z", "edit_history_tweet_ids": ["2118840871932358819", "2118841460791644434"], "entities": {"mentions": [{"end": 154, "id": "16580226", "start": 142, "username": "NASAKennedy"}], "urls": [{"description": "The live stream could not be reached. The broadcast may be offline. White House Wire WH Wire Orange County Public Schools’ 8,000-student enrollment drop included 5,000 immigrants, data shows ◆ WATCH: President Trump Announces $8 Billion in Relief to Help Farmers with Diesel Costs ◆ Drill, baby drill! Americans want energy independence from foreign countries: poll ◆ 28 Charged In Noncitizen Voting Bust Hours After Leslie Stahl Says It’s Not An Issue ◆ Cleveland-Cliffs posts ‘strongest’ quarter in three", "display_url": "whitehouse.gov/live/", "end": 179, "expanded_url": "https://www.whitehouse.gov/live/", "images": [{"height": 628, "url": "https://pbs.twimg.com/news_img/2116909404872130560/PIpzioVh?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116909404872130560/PIpzioVh?format=jpg&name=150x150", "width": 150}], "start": 156, "status": 200, "title": "Live News", "unwound_url": "https://www.whitehouse.gov/live/", "url": "https://t.co/iX2v6vtTdQ"}, {"display_url": "pic.x.com/LXxtyZrtMR", "end": 203, "expanded_url": "https://x.com/NASA/status/2118840871932358819/photo/1", "media_key": "3_2118828185613692928", "start": 180, "url": "https://t.co/LXxtyZrtMR"}]}, "id": "2118840871932358819", "public_metrics": {"bookmark_count": 1, "impression_count": 53831, "like_count": 23, "quote_count": 0, "reply_count": 1, "retweet_count": 3}, "text": "LIVE: President Donald J. Trump provides remarks to kick off MAX POWER—  America’s newest aerospace expo and air show, taking place Nov. 7-8  @NASAKennedy: https://t.co/iX2v6vtTdQ https://t.co/LXxtyZrtMR", "url": "https://x.com/NASA/status/2118840871932358819"}, {"author_id": "46648807", "created_at": "2026-11-06T20:58:01.000Z", "edit_history_tweet_ids": ["2118810157161271616"], "entities": {"urls": [{"display_url": "whitehouse.gov/wp-content/upl…", "end": 239, "expanded_url": "https://www.whitehouse.gov/wp-content/uploads/2026/11/NSTM-6-NASS-Policy.pdf", "start": 216, "status": 200, "unwound_url": "https://www.whitehouse.gov/wp-content/uploads/2026/11/NSTM-6-NASS-Policy.pdf", "url": "https://t.co/eGHWr3Yr0b"}]}, "id": "2118810157161271616", "public_metrics": {"bookmark_count": 0, "impression_count": 987, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "To advance biotechnology while strengthening biosecurity, NIST is developing standards to verify synthetic genetic material screening under the new National Policy for Nucleic Acid Synthesis Screening. \n\nLearn more: https://t.co/eGHWr3Yr0b", "url": "https://x.com/NIST/status/2118810157161271616"}, {"author_id": "19355829", "created_at": "2026-11-06T20:29:26.000Z", "edit_history_tweet_ids": ["2118802963598631337"], "id": "2118802963598631337", "public_metrics": {"bookmark_count": 0, "impression_count": 5702, "like_count": 58, "quote_count": 0, "reply_count": 3, "retweet_count": 2}, "text": "Unpacking continues to consume me, so posts will continue to be sparse, but GCAT is still being updated every few days.", "url": "https://x.com/planet4589/status/2118802963598631337"}, {"author_id": "19355829", "created_at": "2026-11-06T20:29:11.000Z", "edit_history_tweet_ids": ["2118802899895812565"], "id": "2118802899895812565", "public_metrics": {"bookmark_count": 0, "impression_count": 5295, "like_count": 34, "quote_count": 0, "reply_count": 1, "retweet_count": 2}, "text": "Launches: Nov 2 at 1641 UTC, Electron from Mahia with QPS-SAR-20 radar sat. Nov  3 at 0015 UTC, Lijian-2 from Jiuquan with Qianfan group 21 internet sats Nov 5 at 1558 UTC, CZ-2C from Xichang with three Yaogan 51 sigint sats", "url": "https://x.com/planet4589/status/2118802899895812565"}, {"author_id": "626660983", "created_at": "2026-