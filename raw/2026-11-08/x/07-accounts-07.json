{"data": [{"author_id": "626660983", "created_at": "2026-11-07T20:07:05.000Z", "edit_history_tweet_ids": ["2119159725887545804"], "id": "2119159725887545804", "public_metrics": {"bookmark_count": 0, "impression_count": 1095, "like_count": 23, "quote_count": 0, "reply_count": 2, "retweet_count": 2}, "referenced_tweets": [{"id": "2119139916428743075", "type": "quoted"}], "text": "🤡🤡🤡🤡 https://t.co/uWKcU90ZyQ", "url": "https://x.com/lymanstoneky/status/2119159725887545804"}, {"author_id": "11348282", "created_at": "2026-11-07T18:35:13.000Z", "edit_history_tweet_ids": ["2119136607009734978"], "id": "2119136607009734978", "public_metrics": {"bookmark_count": 114, "impression_count": 168811, "like_count": 982, "quote_count": 44, "reply_count": 114, "retweet_count": 209}, "text": "Do you want to be an astronaut?\n\nApplications are now open to join NASA's astronaut corps. Join us as we expand the frontiers of discovery in low Earth orbit, on the Moon, and beyond — apply by Dec. 3: https://t.co/laY2ExWiGO https://t.co/GzZl3yRy0i", "url": "https://x.com/NASA/status/2119136607009734978"}, {"author_id": "610659001", "created_at": "2026-11-07T16:19:57.000Z", "edit_history_tweet_ids": ["2119102564390072440"], "id": "2119102564390072440", "public_metrics": {"bookmark_count": 61, "impression_count": 20016, "like_count": 391, "quote_count": 19, "reply_count": 5, "retweet_count": 109}, "text": "Pretty much all the growth in global coal use since the late 1980s has come from China. https://t.co/0gSqeFLuPM", "url": "https://x.com/MaxCRoser/status/2119102564390072440"}, {"author_id": "626660983", "created_at": "2026-11-07T16:11:14.000Z", "edit_history_tweet_ids": ["2119100371201327448"], "id": "2119100371201327448", "public_metrics": {"bookmark_count": 0, "impression_count": 945, "like_count": 3, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2119094720668537100", "type": "quoted"}], "text": "Also handed the Papists their comeuppance at Breitenfeld, with one of the most masterful infantry field maneuvers in history, enabled by the personal valor of Moritz Pensen von Caldenbach. The history of Protestantism rests on one cavalry officer’s grief and sacrifice. https://t.co/kWnrUGVrAH", "url": "https://x.com/lymanstoneky/status/2119100371201327448"}, {"author_id": "6374602", "created_at": "2026-11-07T15:52:56.000Z", "edit_history_tweet_ids": ["2119095767759757517"], "id": "2119095767759757517", "public_metrics": {"bookmark_count": 10, "impression_count": 6002, "like_count": 191, "quote_count": 1, "reply_count": 3, "retweet_count": 23}, "referenced_tweets": [{"id": "2119093662957060389", "type": "quoted"}], "text": "\"Starship’s initial return to launch site mission is expected to orbit the Earth at an altitude of ~275 km and complete approximately 14 orbits around the planet over the course of a more than 22-hour flight.\" https://t.co/24uQ1pulzw", "url": "https://x.com/jeff_foust/status/2119095767759757517"}, {"author_id": "34743251", "created_at": "2026-11-07T15:44:34.000Z", "edit_history_tweet_ids": ["2119093662957060389"], "id": "2119093662957060389", "public_metrics": {"bookmark_count": 1055, "impression_count": 1155587, "like_count": 13754, "quote_count": 477, "reply_count": 617, "retweet_count": 2031}, "text": "Starship is preparing for catch\n \nFlight 15 is targeting to launch as early as Friday, November 13, pending regulatory approval → https://t.co/K5XRci6bnw https://t.co/WS2xGLjVsx", "url": "https://x.com/SpaceX/status/2119093662957060389"}, {"author_id": "11348282", "created_at": "2026-11-07T15:28:15.000Z", "edit_history_tweet_ids": ["2119089554837979631"], "id": "2119089554837979631", "public_metrics": {"bookmark_count": 13, "impression_count": 225838, "like_count": 663, "quote_count": 11, "reply_count": 69, "retweet_count": 100}, "text": "Good morning from MAX POWER @NASAKennedy!✈️\n\nThe tech toys are on display, aircraft are fueled up, and NASA experts are ready to meet you! \n\nFollow along on @NASA_Events for updates and more views from our aerospace expo and air show. https://t.co/FdJwvXxuNx", "url": "https://x.com/NASA/status/2119089554837979631"}, {"author_id": "11348282", "created_at": "2026-11-07T15:03:55.000Z", "edit_history_tweet_ids": ["2119083432835764635"], "id": "2119083432835764635", "public_metrics": {"bookmark_count": 123, "impression_count": 470162, "like_count": 2616, "quote_count": 78, "reply_count": 555, "retweet_count": 393}, "text": "American ambition. Maximum power.\n\nWe didn’t reach for the stars to stop pushing farther. Under @POTUS’ leadership, we’re going back to the Moon. This time, to stay. 🇺🇸 https://t.co/yo4W1hK5Yn", "url": "https://x.com/NASA/status/2119083432835764635"}, {"author_id": "626660983", "created_at": "2026-11-07T14:43:52.000Z", "edit_history_tweet_ids": ["2119078386454737024"], "id": "2119078386454737024", "public_metrics": {"bookmark_count": 1, "impression_count": 1686, "like_count": 29, "quote_count": 0, "reply_count": 0, "retweet_count": 2}, "referenced_tweets": [{"id": "2118794330693374364", "type": "quoted"}], "text": "Kennedy calling for himself to be fired https://t.co/6vzVE9QQeV", "url": "https://x.com/lymanstoneky/status/2119078386454737024"}, {"author_id": "626660983", "created_at": "2026-11-07T14:14:42.000Z", "edit_history_tweet_ids": ["2119071045437280350"], "id": "2119071045437280350", "public_metrics": {"bookmark_count": 2, "impression_count": 1540, "like_count": 46, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2118903597924540445", "type": "quoted"}], "text": "He was literally in bed with the Chinese Communist Party https://t.co/Ta5MSlaaPr", "url": "https://x.com/lymanstoneky/status/2119071045437280350"}, {"author_id": "626660983", "created_at": "2026-11-07T14:13:33.000Z", "edit_history_tweet_ids": ["2119070756026159361"], "id": "2119070756026159361", "public_metrics": {"bookmark_count": 16, "impression_count": 6956, "like_count": 78, "quote_count": 0, "reply_count": 5, "retweet_count": 3}, "referenced_tweets": [{"id": "2118907457749533098", "type": "quoted"}], "text": "Traitors https://t.co/qRBokdKUkt", "url": "https://x.com/lymanstoneky/status/2119070756026159361"}, {"author_id": "34743251", "created_at": "2026-11-07T06:28:46.000Z", "edit_history_tweet_ids": ["2118953789357281607"], "id": "2118953789357281607", "public_metrics": {"bookmark_count": 111, "impression_count": 361970, "like_count": 4493, "quote_count": 66, "reply_count": 230, "retweet_count": 469}, "text": "Falcon 9 launches USSF-432 to orbit from pad 4E in California https://t.co/aEMgy2wy1f", "url": "https://x.com/SpaceX/status/2118953789357281607"}, {"author_id": "626660983", "created_at": "2026-11-07T02:02:48.000Z", "edit_history_tweet_ids": ["2118886855600943438"], "id": "2118886855600943438", "public_metrics": {"bookmark_count": 4, "impression_count": 8421, "like_count": 59, "quote_count": 0, "reply_count": 5, "retweet_count": 0}, "referenced_tweets": [{"id": "2118843850919964958", "type": "quoted"}], "text": "I feel about EAs the way I feel about Ron Paul fans\n\nI went through that phase at a past point in my life\n\nIt was a phase that shaped me in a wholesome way\n\nGrowing out of it was a good thing\n\nI want that for them too https://t.co/VTpmx05jRF", "url": "https://x.com/lymanstoneky/status/2118886855600943438"}, {"author_id": "626660983", "created_at": "2026-11-07T01:54:31.000Z", "edit_history_tweet_ids": ["2118884772575596619"], "id": "2118884772575596619", "public_metrics": {"bookmark_count": 1, "impression_count": 3143, "like_count": 44, "quote_count": 0, "reply_count": 1, "retweet_count": 2}, "referenced_tweets": [{"id": "561618368848203776", "type": "quoted"}], "text": "OMG https://t.co/AdqrCxANIu", "url": "https://x.com/lymanstoneky/status/2118884772575596619"}, {"author_id": "19355829", "created_at": "2026-11-07T01:40:43.000Z", "edit_history_tweet_ids": ["2118881301432512912"], "id": "2118881301432512912", "public_metrics": {"bookmark_count": 1, "impression_count": 5549, "like_count": 46, "quote_count": 0, "reply_count": 2, "retweet_count": 6}, "text": "LAUNCH at 0048 UTC Nov 7 of a Falcon 9 from Vandenberg with the US Space Force SBST R-4 group of satellites (mission USSF-432)", "url": "https://x.com/planet4589/status/2118881301432512912"}, {"author_id": "34743251", "created_at": "2026-11-07T00:59:04.000Z", "edit_history_tweet_ids": ["2118870818021097862"], "id": "2118870818021097862", "public_metrics": {"bookmark_count": 232, "impression_count": 1661753, "like_count": 6838, "quote_count": 103, "reply_count": 337, "retweet_count": 647}, "text": "Falcon 9’s first stage lands on the Of Course I Still Love You droneship https://t.co/u5WQblzJlB", "url": "https://x.com/SpaceX/status/2118870818021097862"}, {"author_id": "17217640", "created_at": "2026-11-07T00:50:33.000Z", "edit_history_tweet_ids": ["2118868578564801014", "2118868673796452737"], "id": "2118868673796452737", "public_metrics": {"bookmark_count": 1, "impression_count": 5896, "like_count": 54, "quote_count": 0, "reply_count": 2, "retweet_count": 11}, "text": "Liftoff of the USSF-432 mission from pad 4E at Vandenberg Space Force Base at 4:48 pm PST (7:48 pm EST / 0048 UTC).\n\nWatch live: https://t.co/48ke3sbjc9 https://t.co/Jz1Dd983lP", "url": "https://x.com/SpaceflightNow/status/2118868673796452737"}, {"author_id": "17217640", "created_at": "2026-11-07T00:50:10.000Z", "edit_history_tweet_ids": ["2118868578564801014", "2118868673796452737"], "id": "2118868578564801014", "public_metrics": {"bookmark_count": 0, "impression_count": 1818, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Liftoff of the USSF-432 mission from pad 4E at Vandenberg Space Force Base at 4:48 pm EST (7:48 pm EST / 0048 UTC).\n\nWatch live: https://t.co/48ke3sbjc9 https://t.co/8UMLlmegoo", "url": "https://x.com/SpaceflightNow/status/2118868578564801014"}, {"author_id": "34743251", "created_at": "2026-11-07T00:49:44.000Z", "edit_history_tweet_ids": ["2118868469655433435"], "id": "2118868469655433435", "public_metrics": {"bookmark_count": 330, "impression_count": 1201368, "like_count": 11782, "quote_count": 118, "reply_count": 309, "retweet_count": 1050}, "text": "Liftoff! https://t.co/v8mmRp00fG", "url": "https://x.com/SpaceX/status/2118868469655433435"}, {"author_id": "34743251", "created_at": "2026-11-07T00:35:56.000Z", "edit_history_tweet_ids": ["2118864998407852102"], "id": "2118864998407852102", "public_metrics": {"bookmark_count": 788, "impression_count": 661313, "like_count": 11911, "quote_count": 124, "reply_count": 650, "retweet_count": 1584}, "text": "Watch Falcon 9 launch the USSF-432 mission from pad 4E in California https://t.co/mAKgbT1mxx", "url": "https://x.com/SpaceX/status/2118864998407852102"}, {"author_id": "19355829", "created_at": "2026-11-07T00:32:34.000Z", "edit_history_tweet_ids": ["2118864151032271202"], "id": "2118864151032271202", "public_metrics": {"bookmark_count": 2, "impression_count": 5056, "like_count": 47, "quote_count": 0, "reply_count": 3, "retweet_count": 5}, "text": "The Gushenxing-2 (Ceres-2) carried the Yunyao-1-28 sat with a GNSS-RO  meteo payload, the Juntian-1-06A radar sat, the Zhongbe Daxue 1 optical  imaging sat for North Univ of China, and Guanlan Shiyan. The owner and  mission for Guanlan Shiyan is unknown so far.", "url": "https://x.com/planet4589/status/2118864151032271202"}, {"author_id": "19355829", "created_at": "2026-11-07T00:32:20.000Z", "edit_history_tweet_ids": ["2118864092064632920"], "id": "2118864092064632920", "public_metrics": {"bookmark_count": 1, "impression_count": 5052, "like_count": 43, "quote_count": 0, "reply_count": 2, "retweet_count": 4}, "text": "LAUNCH at 2337 UTC Nov 6 of the Gushenxing-2 rocket from Jiuquan on its second launch, reaching orbit successfully for the first time.", "url": "https://x.com/planet4589/status/2118864092064632920"}, {"author_id": "17217640", "created_at": "2026-11-07T00:23:05.000Z", "edit_history_tweet_ids": ["2118861761386516786"], "id": "2118861761386516786", "public_metrics": {"bookmark_count": 0, "impression_count": 9538, "like_count": 45, "quote_count": 0, "reply_count": 5, "retweet_count": 7}, "text": "SpaceX will deploy another batch of satellites for a clandestine U.S. Space Force program on a Falcon 9 rocket launch from California. Liftoff is scheduled for 4:48 p.m. PST (7:48 p.m. EST / 0048 UTC). Watch live coverage: https://t.co/DmJWIoyBX8", "url": "https://x.com/SpaceflightNow/status/2118861761386516786"}, {"author_id": "34743251", "created_at": "2026-11-07T00:06:48.000Z", "edit_history_tweet_ids": ["2118857663106707757"], "id": "2118857663106707757", "public_metrics": {"bookmark_count": 107, "impression_count": 632216, "like_count": 4564, "quote_count": 33, "reply_count": 224, "retweet_count": 512}, "text": "All systems are looking good, and weather is favorable for liftoff. Propellant load is about to begin for Falcon 9’s launch of the USSF-432 mission from California → https://t.co/71Loda4Pvi https://t.co/aV6LN3ET3N", "url": "https://x.com/SpaceX/status/2118857663106707757"}, {"author_id": "11348282", "created_at": "2026-11-06T23:02:25.000Z", "edit_history_tweet_ids": ["2118840871932358819", "2118841460791644434"], "id": "2118841460791644434", "public_metrics": {"bookmark_count": 32, "impression_count": 332382, "like_count": 694, "quote_count": 15, "reply_count": 85, "retweet_count": 92}, "text": "LIVE: President Donald J. Trump provides remarks to kick off MAX POWER—America’s newest aerospace expo and air show, taking place Nov. 7-8 @NASAKennedy: https://t.co/iX2v6vtTdQ https://t.co/VsbruOeJ9d", "url": "https://x.com/NASA/status/2118841460791644434"}], "includes": {"users": [{"id": "626660983", "name": "Lyman Stone 石來民 🦬🦬🦬", "username": "lymanstoneky"}, {"id": "11348282", "name": "NASA", "username": "NASA"}, {"id": "610659001", "name": "Max Roser", "username": "MaxCRoser"}, {"id": "6374602", "name": "Jeff Foust", "username": "jeff_foust"}, {"id": "34743251", "name": "SpaceX", "username": "SpaceX"}, {"id": "19355829", "name": "Jonathan McDowell", "username": "planet4589"}, {"id": "17217640", "name": "Spaceflight Now", "username": "SpaceflightNow"}]}, "meta": {"newest_id": "2119159725887545804", "next_token": "b26v89c19zqg8o3juzlyxrqptnryt4b2w590vejoqt75p", "oldest_id": "2118841460791644434", "result_count": 25}}
