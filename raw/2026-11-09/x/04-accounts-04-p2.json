18916358100381707"], "entities": {"hashtags": [{"end": 217, "start": 206, "tag": "immunology"}], "mentions": [{"end": 229, "id": "137777298", "start": 219, "username": "scisignal"}], "urls": [{"description": "Rational design enables human cells to produce an inflammatory cytokine that may not be made naturally.", "display_url": "scim.ag/48vIWKO", "end": 253, "expanded_url": "https://scim.ag/48vIWKO", "images": [{"height": 550, "url": "https://pbs.twimg.com/news_img/2118010502752174080/_c_MEQWl?format=jpg&name=orig", "width": 715}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2118010502752174080/_c_MEQWl?format=jpg&name=150x150", "width": 150}], "start": 230, "status": 200, "title": "Subunit engineering enables the generation of human interleukin-39 as a proinflammatory cytokine", "unwound_url": "https://www.science.org/doi/10.1126/scisignal.adw9746?utm_campaign=ScienceMagazine&utm_medium=ownedSocial&utm_source=twitter", "url": "https://t.co/Uu74SL9bnT"}, {"display_url": "pic.x.com/iAHlHmehg7", "end": 277, "expanded_url": "https://x.com/ScienceMagazine/status/2118916358100381707/photo/1", "media_key": "3_2118916356158398464", "start": 254, "url": "https://t.co/iAHlHmehg7"}]}, "id": "2118916358100381707", "public_metrics": {"bookmark_count": 8, "impression_count": 17132, "like_count": 90, "quote_count": 0, "reply_count": 6, "retweet_count": 13}, "text": "New experiments present a rational cytokine-engineering strategy to activate immune signaling networks and provide clues about whether the cytokine IL-39 is found in the human body—a longstanding debate in #immunology. @SciSignal https://t.co/Uu74SL9bnT https://t.co/iAHlHmehg7", "url": "https://x.com/ScienceMagazine/status/2118916358100381707"}, {"author_id": "86626845", "created_at": "2026-11-07T02:37:57.000Z", "edit_history_tweet_ids": ["2118895704940880331"], "entities": {"urls": [{"display_url": "x.com/ahascience/sta…", "end": 168, "expanded_url": "https://twitter.com/ahascience/status/211887840061384332