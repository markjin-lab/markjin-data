{"data": [{"author_id": "332617373", "created_at": "2026-11-08T20:30:33.000Z", "edit_history_tweet_ids": ["2119528017751871917"], "id": "2119528017751871917", "public_metrics": {"bookmark_count": 0, "impression_count": 10958, "like_count": 48, "quote_count": 0, "reply_count": 13, "retweet_count": 0}, "text": "Nothing but pain being a Jets fan!\nFully expected the Jets to lose today against the Chiefs, am getting exactly what I expected, and it still hurts a lot!\nSwitching over to the Giants’ game in an effort to salvage yet another Sunday.\n@nyjets @Chiefs #jets @Giants #jets @NFL", "url": "https://x.com/elerianm/status/2119528017751871917"}, {"author_id": "39125788", "created_at": "2026-11-08T17:33:46.000Z", "edit_history_tweet_ids": ["2119483529591504896"], "id": "2119483529591504896", "public_metrics": {"bookmark_count": 35, "impression_count": 13072, "like_count": 117, "quote_count": 2, "reply_count": 53, "retweet_count": 3}, "referenced_tweets": [{"id": "2118880329490637049", "type": "quoted"}], "text": "https://t.co/Wlgm5dVeoX https://t.co/QzPwSxGn8B", "url": "https://x.com/emollick/status/2119483529591504896"}, {"author_id": "1007413134", "created_at": "2026-11-08T15:42:15.000Z", "edit_history_tweet_ids": ["2119455465910542552"], "id": "2119455465910542552", "public_metrics": {"bookmark_count": 52, "impression_count": 25168, "like_count": 461, "quote_count": 6, "reply_count": 54, "retweet_count": 29}, "referenced_tweets": [{"id": "2119116338765685094", "type": "quoted"}], "text": "Real robot. Real time. Uncut shot. Autonomous.\n\nTomorrow. https://t.co/YKakg3Pud9", "url": "https://x.com/DrJimFan/status/2119455465910542552"}, {"author_id": "59603406", "created_at": "2026-11-08T15:10:00.000Z", "edit_history_tweet_ids": ["2119447351316128055"], "id": "2119447351316128055", "public_metrics": {"bookmark_count": 16, "impression_count": 43764, "like_count": 122, "quote_count": 5, "reply_count": 9, "retweet_count": 27}, "referenced_tweets": [{"id": "2118095659936915860", "type": "quoted"}], "text": "Whether Kevin Warsh would have had a say in Trump's next Fed picks is now a moot question if a Democratic Senate won't confirm any. Past chairs leaned on lieutenants they helped choose. Warsh may have to work with the board he inherited.\n\nhttps://t.co/mKoDkGTrMo https://t.co/zdExQV0eSK", "url": "https://x.com/NickTimiraos/status/2119447351316128055"}, {"author_id": "25098482", "created_at": "2026-11-08T14:41:30.000Z", "edit_history_tweet_ids": ["2119440178301554867"], "id": "2119440178301554867", "public_metrics": {"bookmark_count": 2, "impression_count": 14424, "like_count": 37, "quote_count": 1, "reply_count": 6, "retweet_count": 10}, "text": "Growth in the MENAP region is projected to contract by 1.3% in 2026, nearly 3 percentage points below April's forecast. If the Middle East war subsides &amp; trade normalizes, growth could rebound to 6.6% in 2027, supported by a recovery in Gulf oil exporters. https://t.co/5Jkk0COhsO https://t.co/j4Rrh4xbvu", "url": "https://x.com/IMFNews/status/2119440178301554867"}, {"author_id": "83466368", "created_at": "2026-11-08T08:49:41.000Z", "edit_history_tweet_ids": ["2119351638922068473"], "id": "2119351638922068473", "public_metrics": {"bookmark_count": 20, "impression_count": 45973, "like_count": 427, "quote_count": 5, "reply_count": 39, "retweet_count": 62}, "text": "🇵🇱🇪🇺 Today, we remember the victims of the horrific attack in Kraków yesterday. Our thoughts are with all those affected. There can be no place for such violence in our society. \n\nTo express our condolences, we join other European institutions in flying our flags at half-mast. https://t.co/md4aTZ12Ib", "url": "https://x.com/ecb/status/2119351638922068473"}, {"author_id": "1214528593", "created_at": "2026-11-08T05:24:30.000Z", "edit_history_tweet_ids": ["2119300002749317371"], "id": "2119300002749317371", "public_metrics": {"bookmark_count": 5, "impression_count": 2353, "like_count": 29, "quote_count": 0, "reply_count": 4, "retweet_count": 2}, "referenced_tweets": [{"id": "2119232818421125259", "type": "quoted"}], "text": "Interview with the amazing @lfschiavo starting on page 4 of the latest Delvetown Shovel: https://t.co/AsyFup6dIk https://t.co/S3uFJ9tS6P", "url": "https://x.com/Miles_Brundage/status/2119300002749317371"}, {"author_id": "1214528593", "created_at": "2026-11-08T01:45:45.000Z", "edit_history_tweet_ids": ["2119244955181023547"], "id": "2119244955181023547", "public_metrics": {"bookmark_count": 2, "impression_count": 2509, "like_count": 21, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "AI podcast called By the Same Token", "url": "https://x.com/Miles_Brundage/status/2119244955181023547"}, {"author_id": "1214528593", "created_at": "2026-11-08T00:58:07.000Z", "edit_history_tweet_ids": ["2119232965591134559"], "id": "2119232965591134559", "public_metrics": {"bookmark_count": 0, "impression_count": 3823, "like_count": 36, "quote_count": 0, "reply_count": 7, "retweet_count": 0}, "text": "Think I’ve been too hard on provolone", "url": "https://x.com/Miles_Brundage/status/2119232965591134559"}, {"author_id": "1214528593", "created_at": "2026-11-08T00:27:35.000Z", "edit_history_tweet_ids": ["2119225284235075906"], "id": "2119225284235075906", "public_metrics": {"bookmark_count": 0, "impression_count": 2289, "like_count": 48, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "BRUDDERS https://t.co/vlNEEmhiGW", "url": "https://x.com/Miles_Brundage/status/2119225284235075906"}, {"author_id": "332617373", "created_at": "2026-11-07T23:03:29.000Z", "edit_history_tweet_ids": ["2119204117952233795"], "id": "2119204117952233795", "public_metrics": {"bookmark_count": 14, "impression_count": 33616, "like_count": 193, "quote_count": 4, "reply_count": 37, "retweet_count": 26}, "text": "Bloomberg re “mentions” on S&amp;P 500 corporate earnings calls:\n“…mentions of “inflation” or “inflationary” climbed to 820 on the earnings calls of S&amp;P 500 companies in October, the highest monthly figure since February 2024.”\n#economy #markets #inflation https://t.co/wG4nDYZz7D", "url": "https://x.com/elerianm/status/2119204117952233795"}, {"author_id": "68746721", "created_at": "2026-11-07T22:52:26.000Z", "edit_history_tweet_ids": ["2119201339020648849"], "id": "2119201339020648849", "public_metrics": {"bookmark_count": 170, "impression_count": 41035, "like_count": 726, "quote_count": 9, "reply_count": 108, "retweet_count": 77}, "referenced_tweets": [{"id": "2119142310894334262", "type": "quoted"}], "text": "Data scaling and compute scaling are *multipliers* for the generalization power of an approach. Trillions of dollars in investment can make very inefficient, low-generalization approaches look adequate, but that doesn't make them the ultimate end-all-be-all of AI.\n\nYou should https://t.co/kPtFXleYw1", "url": "https://x.com/fchollet/status/2119201339020648849"}, {"author_id": "279036722", "created_at": "2026-11-07T22:44:20.000Z", "edit_history_tweet_ids": ["2119199301066694758"], "id": "2119199301066694758", "public_metrics": {"bookmark_count": 30, "impression_count": 28808, "like_count": 179, "quote_count": 0, "reply_count": 12, "retweet_count": 11}, "text": "In 2000 Bush won the electoral college but lost the popular vote.\n\n2004 could have been the reverse: Kerry came closer to winning the electoral college than the popular vote.\n\nIf that had happened the perception around electoral college advantages would be very different today. https://t.co/xccHcvahb8", "url": "https://x.com/jasonfurman/status/2119199301066694758"}, {"author_id": "332617373", "created_at": "2026-11-07T22:42:23.000Z", "edit_history_tweet_ids": ["2119198809544630523"], "id": "2119198809544630523", "public_metrics": {"bookmark_count": 23, "impression_count": 32193, "like_count": 211, "quote_count": 3, "reply_count": 32, "retweet_count": 29}, "text": "While tech stock volatility grabbed most of the headlines this past week, the energy sector suffered bigger losses, as shown in this WSJ chart.\n#economy #markets #stocks #tech #energy #ArtificialIntelligence #ai @WSJ https://t.co/863JEvdGoj", "url": "https://x.com/elerianm/status/2119198809544630523"}, {"author_id": "1214528593", "created_at": "2026-11-07T22:40:46.000Z", "edit_history_tweet_ids": ["2119198403620139365"], "id": "2119198403620139365", "public_metrics": {"bookmark_count": 3, "impression_count": 4169, "like_count": 89, "quote_count": 0, "reply_count": 5, "retweet_count": 9}, "text": "You better start learning bipartisanship, buddy\n\nIf we’re gonna make it through the next few years, Ds and Rs, industry and gov’t, etc. are gonna have to work together, at the federal level at least\n\n*ducks*", "url": "https://x.com/Miles_Brundage/status/2119198403620139365"}, {"author_id": "25098482", "created_at": "2026-11-07T22:30:00.000Z", "edit_history_tweet_ids": ["2119195692828864986"], "id": "2119195692828864986", "public_metrics": {"bookmark_count": 12, "impression_count": 21375, "like_count": 91, "quote_count": 1, "reply_count": 19, "retweet_count": 27}, "text": "How can big data and AI improve economic measurement while preserving quality, transparency, and trust? Join us at the 14th IMF Statistical Forum on November 18-19 in Washington D.C. and online. \n\nRegistration is now open.   https://t.co/D14MS64q3c https://t.co/SquyIZ3Q0s", "url": "https://x.com/IMFNews/status/2119195692828864986"}, {"author_id": "1214528593", "created_at": "2026-11-07T21:48:50.000Z", "edit_history_tweet_ids": ["2119185331056718140"], "id": "2119185331056718140", "public_metrics": {"bookmark_count": 1, "impression_count": 2128, "like_count": 42, "quote_count": 0, "reply_count": 4, "retweet_count": 0}, "text": "Peter https://t.co/pS7Tv6OyzH", "url": "https://x.com/Miles_Brundage/status/2119185331056718140"}, {"author_id": "1214528593", "created_at": "2026-11-07T20:48:38.000Z", "edit_history_tweet_ids": ["2119170183780835350"], "id": "2119170183780835350", "public_metrics": {"bookmark_count": 8, "impression_count": 6535, "like_count": 26, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "referenced_tweets": [{"id": "2118396958289346810", "type": "quoted"}], "text": "! https://t.co/3XI1GkqRR6", "url": "https://x.com/Miles_Brundage/status/2119170183780835350"}, {"author_id": "332617373", "created_at": "2026-11-07T20:45:46.000Z", "edit_history_tweet_ids": ["2119169460783169620"], "id": "2119169460783169620", "public_metrics": {"bookmark_count": 12, "impression_count": 34131, "like_count": 126, "quote_count": 1, "reply_count": 23, "retweet_count": 18}, "text": "Markets sought to navigate a wild week that included a dramatic US political realignment, AI jitters, and robust data. While tech stocks and oil had a violent re-pricing, broader credit held firm as did analyst confidence in the economic outlook. \nAnd all this as market now face https://t.co/4wyAnQ4vea", "url": "https://x.com/elerianm/status/2119169460783169620"}, {"author_id": "39125788", "created_at": "2026-11-07T20:03:45.000Z", "edit_history_tweet_ids": ["2119158887060283552"], "id": "2119158887060283552", "public_metrics": {"bookmark_count": 21, "impression_count": 29304, "like_count": 237, "quote_count": 1, "reply_count": 66, "retweet_count": 10}, "text": "New test of which organizations have low AI capability: you haven’t updated your apps for the iPhone Duo yet.", "url": "https://x.com/emollick/status/2119158887060283552"}, {"author_id": "279036722", "created_at": "2026-11-07T19:54:15.000Z", "edit_history_tweet_ids": ["2119156497661702290"], "id": "2119156497661702290", "public_metrics": {"bookmark_count": 34, "impression_count": 21069, "like_count": 211, "quote_count": 1, "reply_count": 14, "retweet_count": 19}, "referenced_tweets": [{"id": "2119140502746308674", "type": "quoted"}], "text": "At this point anything by a human should contain the disclaimer, “Written by a fallible human, may contain mistakes” https://t.co/1Zjl0uHd3V", "url": "https://x.com/jasonfurman/status/2119156497661702290"}, {"author_id": "39125788", "created_at": "2026-11-07T18:50:42.000Z", "edit_history_tweet_ids": ["2119140502746308674"], "id": "2119140502746308674", "public_metrics": {"bookmark_count": 713, "impression_count": 101920, "like_count": 1464, "quote_count": 69, "reply_count": 277, "retweet_count": 200}, "text": "I think there is way too much concern expressed about verification of AI output in everyday work due to a risk of factual errors.\n\nIt used to be true, but data on more recent models suggest they beat human experts, including PhD specialists, in finding facts and checking claims. https://t.co/OVlzW3S17n", "url": "https://x.com/emollick/status/2119140502746308674"}, {"author_id": "1007413134", "created_at": "2026-11-07T17:14:41.000Z", "edit_history_tweet_ids": ["2119116338765685094"], "id": "2119116338765685094", "public_metrics": {"bookmark_count": 192, "impression_count": 132717, "like_count": 1122, "quote_count": 55, "reply_count": 70, "retweet_count": 103}, "text": "CoRL Keynote. Hilton Austin. Monday Nov 9, 1:45 pm. 2 days countdown.\n\nSomething extraordinary. https://t.co/GsxrP3asUa", "url": "https://x.com/DrJimFan/status/2119116338765685094"}], "includes": {"users": [{"id": "332617373", "name": "Mohamed A. El-Erian", "username": "elerianm"}, {"id": "39125788", "name": "Ethan Mollick", "username": "emollick"}, {"id": "1007413134", "name": "Jim Fan", "username": "DrJimFan"}, {"id": "59603406", "name": "Nick Timiraos", "username": "NickTimiraos"}, {"id": "25098482", "name": "IMF", "username": "IMFNews"}, {"id": "83466368", "name": "European Central Bank", "username": "ecb"}, {"id": "1214528593", "name": "Miles Brundage", "username": "Miles_Brundage"}, {"id": "68746721", "name": "François Chollet", "username": "fchollet"}, {"id": "279036722", "name": "Jason Furman", "username": "jasonfurman"}]}, "meta": {"newest_id": "2119528017751871917", "next_token": "b26v89c19zqg8o3juzlzcieojotlefyl87tr5ocfrdunx", "oldest_id": "2119116338765685094", "re