/2110502503154606146"},{"author_id":"482552168","created_at":"2026-10-15T01:01:40.000Z","edit_history_tweet_ids":["2110536549809205267"],"id":"2110536549809205267","public_metrics":{"bookmark_count":0,"impression_count":3,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"早评：美股芯片重挫!A股今天怎么走？","url":"https://x.com/ThiagoGilberto2/status/2110536549809205267"}],"includes":{"media":[{"media_key":"3_2110635024404168704","type":"photo"},{"media_key":"3_2110635032499179520","type":"photo"},{"media_key":"3_2110635040761839616","type":"photo"}],"users":[{"id":"2108191189019381760","name":"2030FY","username":"2030FY_X"},{"id":"997722661844287488","name":"🇨🇳 大策复盘","username":"dacefupan"},{"id":"967721109851385856","name":"大曦","username":"ansonze20181"},{"id":"857945237104111618","name":"财哥","username":"xuyuinfo5"},{"id":"1813570093181194240","name":"大猫调研信息","username":"dmjk001"},{"id":"73251735","name":"Nolan（互关版）","username":"Blympie"},{"id":"1896761185938345984","name":"土三哥观察分享","username":"haotianche21370"},{"id":"1972218614473543685","name":"ChangLiu","username":"hdl48"},{"id":"2035018650965745664","name":"策研社","username":"wolf200131313"},{"id":"1128198342859563008","name":"小明","username":"ming69621583"},{"id":"1685620377941364736","name":"万倍基哥","username":"zhishuzengzhang"},{"id":"1502253517737586691","name":"大道至简｜全球资产配置","username":"aystxdlzfhj"},{"id":"1484783062772695040","name":"笔飞","username":"MartynZheng"},{"id":"1999693479178567681","name":"FortuneGirl-7Inch","username":"ZoXinkun2O26"},{"id":"1609897027709861888","name":"小鱼儿股票财经","username":"SYU77996"},{"id":"1913965111045398528","name":"郭","username":"m0sHown5gS16742"},{"id":"137332930","name":"华尔街观察 Xtrader","username":"cnfinancewatch"},{"id":"556658912","name":"股市小能手","username":"sezinzelik"},{"id":"1860822023280410624","name":"clark@可转债","username":"clark_overseas"},{"id":"482552168","name":"大A侠客","username":"ThiagoGilberto2"}]},"meta":{"newest_id":"2110708683097411906","next_token":"b26v8