{"data": [{"author_id": "626660983", "created_at": "2026-10-28T20:28:47.000Z", "edit_history_tweet_ids": ["2115541310530531485"], "entities": {"urls": [{"display_url": "pic.x.com/bknVcbJM3r", "end": 93, "expanded_url": "https://x.com/lymanstoneky/status/2115541310530531485/photo/1", "media_key": "3_2115541303735767041", "start": 70, "url": "https://t.co/bknVcbJM3r"}, {"display_url": "x.com/DanTabin/statu…", "end": 117, "expanded_url": "https://twitter.com/DanTabin/status/2115513728493875587", "start": 94, "url": "https://t.co/rBk6lTapgO"}]}, "id": "2115541310530531485", "public_metrics": {"bookmark_count": 1, "impression_count": 1089, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2115513728493875587", "type": "quoted"}], "text": "oh wow. incredible cool to actually find this in real HG populations! https://t.co/bknVcbJM3r https://t.co/rBk6lTapgO", "url": "https://x.com/lymanstoneky/status/2115541310530531485"}, {"author_id": "626660983", "created_at": "2026-10-28T20:24:04.000Z", "edit_history_tweet_ids": ["2115540122959552932"], "entities": {"urls": [{"display_url": "x.com/emmma_camp_/st…", "end": 44, "expanded_url": "https://twitter.com/emmma_camp_/status/2115500892765982768", "start": 21, "url": "https://t.co/QkPk54565g"}]}, "id": "2115540122959552932", "public_metrics": {"bookmark_count": 1, "impression_count": 1565, "like_count": 44, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2115500892765982768", "type": "quoted"}], "text": "exterminate the bugs https://t.co/QkPk54565g", "url": "https://x.com/lymanstoneky/status/2115540122959552932"}, {"author_id": "11348282", "created_at": "2026-10-28T20:19:24.000Z", "edit_history_tweet_ids": ["2115538945844850813"], "entities": {"urls": [{"description": "On episode 442, the CHAPEA 2 crew shares final reflections from inside their simulated Mars mission, and principal investigator Grace Douglas discusses the study as its conclusion approaches.", "display_url": "go.nasa.gov/4e2TBA1", "end": 184, "expanded_url": "https://go.nasa.gov/4e2TBA1", "images": [{"height": 1080, "url": "https://pbs.twimg.com/news_img/2115538964593491968/rQU1YDdF?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115538964593491968/rQU1YDdF?format=jpg&name=150x150", "width": 150}], "start": 161, "status": 200, "title": "CHAPEA 2: Audio Log 4 - NASA", "unwound_url": "https://www.nasa.gov/podcasts/houston-we-have-a-podcast/chapea-2-audio-log-4/?utm_source=TWITTER&utm_medium=NASA&utm_campaign=NASASocial&linkId=1028559623", "url": "https://t.co/BAgJK9NMRk"}, {"display_url": "pic.x.com/KKAfpg5QYf", "end": 208, "expanded_url": "https://x.com/NASA/status/2115538945844850813/photo/1", "media_key": "3_2115538943156334592", "start": 185, "url": "https://t.co/KKAfpg5QYf"}]}, "id": "2115538945844850813", "public_metrics": {"bookmark_count": 81, "impression_count": 842299, "like_count": 1304, "quote_count": 19, "reply_count": 175, "retweet_count": 263}, "text": "What would it be like to live on Mars?\n\nThe CHAPEA 2 crew share their final thoughts before their yearlong simulation mission ends on Houston We Have a Podcast: https://t.co/BAgJK9NMRk https://t.co/KKAfpg5QYf", "url": "https://x.com/NASA/status/2115538945844850813"}, {"author_id": "895332160130891776", "created_at": "2026-10-28T20:02:06.000Z", "edit_history_tweet_ids": ["2115534593147187397"], "id": "2115534593147187397", "public_metrics": {"bookmark_count": 556, "impression_count": 1052049, "like_count": 9546, "quote_count": 191, "reply_count": 283, "retweet_count": 998}, "text": "Early Neuralink speech restoration data:\n\nWe are enabling speech to text and voice at conversational rates in participants with ALS. One participant achieved 75 WPM at 5.8% WER on a 125k-word vocabulary in their first week.", "url": "https://x.com/neuralink/status/2115534593147187397"}, {"author_id": "626660983", "created_at": "2026-10-28T19:54:04.000Z", "edit_history_tweet_ids": ["2115532570494419392"], "entities": {"mentions": [{"end": 25, "id": "1041044330092195840", "start": 10, "username": "RichardHanania"}], "urls": [{"display_url": "pic.x.com/D0a7ekPMpY", "end": 301, "expanded_url": "https://x.com/lymanstoneky/status/2115532570494419392/photo/1", "media_key": "3_2115532018876346368", "start": 278, "url": "https://t.co/D0a7ekPMpY"}, {"display_url": "pic.x.com/D0a7ekPMpY", "end": 301, "expanded_url": "https://x.com/lymanstoneky/status/2115532570494419392/photo/1", "media_key": "3_2115532211805974528", "start": 278, "url": "https://t.co/D0a7ekPMpY"}, {"display_url": "pic.x.com/D0a7ekPMpY", "end": 301, "expanded_url": "https://x.com/lymanstoneky/status/2115532570494419392/photo/1", "media_key": "3_2115532310485303296", "start": 278, "url": "https://t.co/D0a7ekPMpY"}, {"display_url": "x.com/RichardHanania…", "end": 325, "expanded_url": "https://twitter.com/RichardHanania/status/2115510936471842919", "start": 302, "url": "https://t.co/CSwievuEtF"}]}, "id": "2115532570494419392", "public_metrics": {"bookmark_count": 10, "impression_count": 4565, "like_count": 42, "quote_count": 1, "reply_count": 3, "retweet_count": 2}, "referenced_tweets": [{"id": "2115510936471842919", "type": "quoted"}], "text": "Actually, @RichardHanania is wrong here. The evidence that frozen embryo transfers are mildly carcinogenic for the children born is real, and getting stronger.\n\nDon't believe me? Here was my prompt to Claude Opus 5.5 and Grok, then their responses.\n\nMany of the anti-IVF health https://t.co/D0a7ekPMpY https://t.co/CSwievuEtF", "url": "https://x.com/lymanstoneky/status/2115532570494419392"}, {"author_id": "626660983", "created_at": "2026-10-28T19:32:30.000Z", "edit_history_tweet_ids": ["2115527143627391032"], "entities": {"urls": [{"display_url": "x.com/lefineder/stat…", "end": 178, "expanded_url": "https://twitter.com/lefineder/status/2115520859288789433", "start": 155, "url": "https://t.co/0hQq9K4sx7"}]}, "id": "2115527143627391032", "public_metrics": {"bookmark_count": 42, "impression_count": 5358, "like_count": 169, "quote_count": 2, "reply_count": 11, "retweet_count": 14}, "referenced_tweets": [{"id": "2115520859288789433", "type": "quoted"}], "text": "Additional evidence that the prosperity of the ancient world went into serious decline essentially as soon as Rome became an Empire instead of a Republic. https://t.co/0hQq9K4sx7", "url": "https://x.com/lymanstoneky/status/2115527143627391032"}, {"author_id": "626660983", "created_at": "2026-10-28T19:07:03.000Z", "edit_history_tweet_ids": ["2115520739369521593"], "entities": {"urls": [{"display_url": "pic.x.com/X1D2LZsgI6", "end": 301, "expanded_url": "https://x.com/lymanstoneky/status/2115520739369521593/photo/1", "media_key": "3_2115520342005301248", "start": 278, "url": "https://t.co/X1D2LZsgI6"}, {"display_url": "x.com/lymanstoneky/s…", "end": 325, "expanded_url": "https://twitter.com/lymanstoneky/status/2115421183365787816", "start": 302, "url": "https://t.co/1diObJ1Y5g"}]}, "id": "2115520739369521593", "public_metrics": {"bookmark_count": 10, "impression_count": 3278, "like_count": 41, "quote_count": 0, "reply_count": 2, "retweet_count": 2}, "referenced_tweets": [{"id": "2115421183365787816", "type": "quoted"}], "text": "For those curious, here are various ways of estimating leisure time for married moms and dads, by what share of household income is earned by the dad.\n\nYou hear a lot about how non-breadwinner-dads help out less at home than one would expect, and that's clearly true.\n\nYou hear https://t.co/X1D2LZsgI6 https://t.co/1diObJ1Y5g", "url": "https://x.com/lymanstoneky/status/2115520739369521593"}, {"author_id": "6374602", "created_at": "2026-10-28T18:18:49.000Z", "edit_history_tweet_ids": ["2115508603255759245"], "id": "2115508603255759245", "public_metrics": {"bookmark_count": 8, "impression_count": 4571, "like_count": 26, "quote_count": 0, "reply_count": 0, "retweet_count": 4}, "text": "Taylor Jordan, head of the Office of Space Commerce, says at the Economist's space summit today that his office received more than 40 responses to a call for interest in testing the new Space Commerce Certification framework. The office is now reviewing them to select a few to go", "url": "https://x.com/jeff_foust/status/2115508603255759245"}, {"author_id": "626660983", "created_at": "2026-10-28T17:48:07.000Z", "edit_history_tweet_ids": ["2115500875691020775"], "entities": {"urls": [{"display_url": "x.com/niah_x03/statu…", "end": 282, "expanded_url": "https://twitter.com/niah_x03/status/2115452369043652617", "start": 259, "url": "https://t.co/wOdSOiiohW"}]}, "id": "2115500875691020775", "public_metrics": {"bookmark_count": 22, "impression_count": 17290, "like_count": 651, "quote_count": 1, "reply_count": 18, "retweet_count": 23}, "referenced_tweets": [{"id": "2115452369043652617", "type": "quoted"}], "text": "Yeah as I have learned more details I’ve shifted a bit from “this is crazy reckless of the mom” to “okay I actually get where she was coming from.” Is it ideal? No. But knowing her situation arresting her and handing the kids to their abusive dad seems nuts. https://t.co/wOdSOiiohW", "url": "https://x.com/lymanstoneky/status/2115500875691020775"}, {"author_id": "626660983", "created_at": "2026-10-28T16:47:48.000Z", "edit_history_tweet_ids": ["2115485695594660068"], "entities": {"urls": [{"display_url": "x.com/rsanti97/statu…", "end": 303, "expanded_url": "https://twitter.com/rsanti97/status/2115480258728341609", "start": 280, "url": "https://t.co/rLzTCbh4i6"}]}, "id": "2115485695594660068", "public_metrics": {"bookmark_count": 4, "impression_count": 2187, "like_count": 20, "quote_count": 0, "reply_count": 1, "retweet_count": 2}, "referenced_tweets": [{"id": "2115480258728341609", "type": "quoted"}], "text": "Key to realize the problem here is mostly the self-deception, not the suggestion.\n\nWhen a human junior colleague makes a suggestion, I usually take it too. Most decisions are low stakes and one option is as good as another. Letting the entity doing the work get its say in how to https://t.co/rLzTCbh4i6", "url": "https://x.com/lymanstoneky/status/2115485695594660068"}, {"author_id": "626660983", "created_at": "2026-10-28T16:41:56.000Z", "edit_history_tweet_ids": ["2115484217949745534"], "entities": {"urls": [{"display_url": "x.com/joshuabarzon/s…", "end": 112, "expanded_url": "https://twitter.com/joshuabarzon/status/2115256607542010206", "start": 89, "url": "https://t.co/TYl6pXWKWF"}]}, "id": "2115484217949745534", "public_metrics": {"bookmark_count": 17, "impression_count": 9206, "like_count": 115, "quote_count": 2, "reply_count": 14, "retweet_count": 5}, "referenced_tweets": [{"id": "2115256607542010206", "type": "quoted"}], "text": "It’s just remarkable how many of the 9+ month places are alas also totally dysfunctional https://t.co/TYl6pXWKWF", "url": "https://x.com/lymanstoneky/status/2115484217949745534"}, {"author_id": "34743251", "created_at": "2026-10-28T16:10:27.000Z", "edit_history_tweet_ids": ["2115476295169814978"], "entities": {"urls": [{"display_url": "pic.x.com/I7Ip89Bmey", "end": 202, "expanded_url": "https://x.com/SpaceX/status/2115476295169814978/video/1", "media_key": "13_2115475875122569216", "start": 179, "url": "https://t.co/I7Ip89Bmey"}, {"display_url": "pic.x.com/I7Ip89Bmey", "end": 202, "expanded_url": "https://x.com/SpaceX/status/2115476295169814978/video/1", "media_key": "13_2115475945687535617", "start": 179, "url": "https://t.co/I7Ip89Bmey"}]}, "id": "2115476295169814978", "public_metrics": {"bookmark_count": 917, "impression_count": 2409324, "like_count": 19899, "quote_count": 437, "reply_count": 799, "retweet_count": 2367}, "text": "Ship 42 static fires complete. The Starship preparing for Flight 15 performed a full duration, six-engine static fire, and fired a single Raptor engine to simulate a deorbit burn https://t.co/I7Ip89Bmey", "url": "https://x.com/SpaceX/status/2115476295169814978"}, {"author_id": "626660983", "created_at": "2026-10-28T12:31:27.000Z", "edit_history_tweet_ids": ["2115421183365787816"], "entities": {"urls": [{"display_url": "x.com/momspostingls/…", "end": 200, "expanded_url": "https://twitter.com/momspostingls/status/2112905147776901262", "start": 177, "url": "https://t.co/M6XrNty1uz"}]}, "id": "2115421183365787816", "public_metrics": {"bookmark_count": 26, "impression_count": 26151, "like_count": 368, "quote_count": 3, "reply_count": 9, "retweet_count": 14}, "referenced_tweets": [{"id": "2112905147776901262", "type": "quoted"}], "text": "Regular reminder that stay at home moms in fact report *more leisure* time than their breadwinner husbands, especially if their kids are &gt;4 years old and enrolled in school. https://t.co/M6XrNty1uz", "url": "https://x.com/lymanstoneky/status/2115421183365787816"}, {"author_id": "626660983", "created_at": "2026-10-27T21:10:50.000Z", "edit_history_tweet_ids": ["2115189504126451848"], "entities": {"urls": [{"display_url": "x.com/RAVerBruggen/s…", "end": 259, "expanded_url": "https://twitter.com/RAVerBruggen/status/2115184857391505458", "start": 236, "url": "https://t.co/N3EfoEWEBo"}]}, "id": "2115189504126451848", "public_metrics": {"bookmark_count": 65, "impression_count": 62609, "like_count": 1295, "quote_count": 5, "reply_count": 11, "retweet_count": 13}, "referenced_tweets": [{"id": "2115184857391505458", "type": "quoted"}], "text": "also worth noting the reason it came to authorities' attention is the 9 year old got a dumbell dropped on his head so the 14 year old called 911 and the kid was taken to the hospital and the first responders were like \"uh, wait, what?\" https://t.co/N3EfoEWEBo", "url": "https://x.com/lymanstoneky/status/2115189504126451848"}, {"author_id": "626660983", "created_at": "2026-10-27T21:07:25.000Z", "edit_history_tweet_ids": ["2115188642331107799"], "id": "2115188642331107799", "public_metrics": {"bookmark_count": 0, "impression_count": 1606, "like_count": 7, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "i resent that locally running a stable diffusion model make laptop go slow", "url": "https://x.com/lymanstoneky/status/2115188642331107799"}, {"author_id": "626660983", "created_at": "2026-10-27T21:04:04.000Z", "edit_history_tweet_ids": ["2115187801524162778"], "entities": {"urls": [{"display_url": "x.com/RichardHanania…", "end": 270, "expanded_url": "https://twitter.com/RichardHanania/status/2115177198680477911", "start": 247, "url": "https://t.co/yChwnJnA75"}]}, "id": "2115187801524162778", "public_metrics": {"bookmark_count": 31, "impression_count": 26139, "like_count": 354, "quote_count": 6, "reply_count": 26, "retweet_count": 20}, "referenced_tweets": [{"id": "2115177198680477911", "type": "quoted"}], "text": "the reason Caesar brought legions across the Rubicon is that imprisonment (and worse) of defeated political rivals had become normal\n\nnow, we can question the choices that led to Caesar rising-- but cycles of judicial retaliation end only one way https://t.co/yChwnJnA75", "url": "https://x.com/lymanstoneky/status/2115187801524162778"}], "includes": {"users": [{"id": "626660983", "name": "Lyman Stone 石來民 🦬🦬🦬", "username": "lymanstoneky"}, {"id": "11348282", "name": "NASA", "username": "NASA"}, {"id": "895332160130891776", "name": "Neuralink", "username": "neuralink"}, {"id": "6374602", "name": "Jeff Foust", "username": "jeff_foust"}, {"id": "34743251", "name": "SpaceX", "username": "SpaceX"}]}, "meta": {"newest_id": "2115541310530531485", "next_token": "b26v89c19zqg8o3juzlxnw10g04vkwi8h9ui1w70mz1bx", "oldest_id": "2115187801524162778", "result_count": 16}}
