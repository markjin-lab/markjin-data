{"data": [{"author_id": "26538229", "created_at": "2026-10-29T20:32:57.000Z", "edit_history_tweet_ids": ["2115904746666053883"], "entities": {"urls": [{"description": "The Federal Reserve Board on Thursday announced its approval of the application by The Bank of Nova Scotia, of Toronto, Canada, to become a bank holding compan", "display_url": "federalreserve.gov/newsevents/pre…", "end": 75, "expanded_url": "https://www.federalreserve.gov/newsevents/pressreleases/orders20261029a.htm", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2115904747186126848/FTNH4BVN?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115904747186126848/FTNH4BVN?format=jpg&name=150x150", "width": 150}], "start": 52, "status": 200, "title": "Federal Reserve Board announces approval of application by The Bank of Nova Scotia", "unwound_url": "https://www.federalreserve.gov/newsevents/pressreleases/orders20261029a.htm", "url": "https://t.co/RTW11jrYJS"}]}, "id": "2115904746666053883", "public_metrics": {"bookmark_count": 1, "impression_count": 11118, "like_count": 16, "quote_count": 1, "reply_count": 1, "retweet_count": 4}, "text": "Approval of application by The Bank of Nova Scotia: https://t.co/RTW11jrYJS", "url": "https://x.com/federalreserve/status/2115904746666053883"}, {"author_id": "26538229", "created_at": "2026-10-29T20:32:10.000Z", "edit_history_tweet_ids": ["2115904547545551289"], "entities": {"hashtags": [{"end": 45, "start": 32, "tag": "BalanceSheet"}, {"end": 86, "start": 78, "tag": "FedData"}], "urls": [{"description": "The Federal Reserve Board of Governors in Washington DC.", "display_url": "federalreserve.gov/monetarypolicy…", "end": 77, "expanded_url": "https://www.federalreserve.gov/monetarypolicy/bst_fedsbalancesheet.htm", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2115904590667239424/HFzy-AU2?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115904590667239424/HFzy-AU2?format=jpg&name=150x150", "width": 150}], "start": 54, "status": 200, "title": "Fed's balance sheet", "unwound_url": "https://www.federalreserve.gov/monetarypolicy/bst_fedsbalancesheet.htm", "url": "https://t.co/75xiVY33QW"}]}, "id": "2115904547545551289", "public_metrics": {"bookmark_count": 1, "impression_count": 9596, "like_count": 7, "quote_count": 0, "reply_count": 2, "retweet_count": 1}, "text": "Interactive guide to our weekly #BalanceSheet report: https://t.co/75xiVY33QW #FedData", "url": "https://x.com/federalreserve/status/2115904547545551289"}, {"author_id": "26538229", "created_at": "2026-10-29T20:31:44.000Z", "edit_history_tweet_ids": ["2115904440452665744"], "entities": {"hashtags": [{"end": 24, "start": 11, "tag": "BalanceSheet"}, {"end": 65, "start": 57, "tag": "FedData"}], "urls": [{"description": "The Federal Reserve Board of Governors in Washington DC.", "display_url": "federalreserve.gov/releases/h41/c…", "end": 56, "expanded_url": "https://www.federalreserve.gov/releases/h41/current/h41.htm", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2113691375678210048/uOfK3-gX?format=jpg&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113691375678210048/uOfK3-gX?format=jpg&name=150x150", "width": 150}], "start": 33, "status": 200, "title": "Lock", "unwound_url": "https://www.federalreserve.gov/releases/h41/current/h41.htm", "url": "https://t.co/LjSvhf6hRz"}]}, "id": "2115904440452665744", "public_metrics": {"bookmark_count": 0, "impression_count": 9691, "like_count": 9, "quote_count": 1, "reply_count": 1, "retweet_count": 1}, "text": "Our weekly #BalanceSheet update: https://t.co/LjSvhf6hRz #FedData", "url": "https://x.com/federalreserve/status/2115904440452665744"}, {"author_id": "279036722", "created_at": "2026-10-29T19:12:22.000Z", "edit_history_tweet_ids": ["2115884464148824495"], "entities": {"urls": [{"display_url": "pic.x.com/SGew2KsXz4", "end": 196, "expanded_url": "https://x.com/jasonfurman/status/2115884464148824495/photo/1", "media_key": "3_2115883342109282304", "start": 173, "url": "https://t.co/SGew2KsXz4"}]}, "id": "2115884464148824495", "public_metrics": {"bookmark_count": 6, "impression_count": 5072, "like_count": 13, "quote_count": 2, "reply_count": 1, "retweet_count": 3}, "text": "Most policy issues don't actually depend on the question of whether the top 1% share of income is rising, falling or staying the same.\n\nAs I shared with my class on Monday. https://t.co/SGew2KsXz4", "url": "https://x.com/jasonfurman/status/2115884464148824495"}, {"author_id": "39125788", "created_at": "2026-10-29T18:37:30.000Z", "edit_history_tweet_ids": ["2115875693120676157"], "entities": {"urls": [{"display_url": "x.com/addyosmani/sta…", "end": 308, "expanded_url": "https://twitter.com/addyosmani/status/2115688494865465370", "start": 285, "url": "https://t.co/FZnFqhF3t4"}]}, "id": "2115875693120676157", "public_metrics": {"bookmark_count": 226, "impression_count": 20330, "like_count": 276, "quote_count": 4, "reply_count": 104, "retweet_count": 13}, "referenced_tweets": [{"id": "2115688494865465370", "type": "quoted"}], "text": "This is good advice for now to think about working with models like Opus 5.5.\n\nBut it is often best to build in checkpoints where the model reports back to you with interim ideas or prototypes so you can guide &amp; give feedback on the process, rather than one-shotting on your goal. https://t.co/FZnFqhF3t4", "url": "https://x.com/emollick/status/2115875693120676157"}, {"author_id": "59603406", "created_at": "2026-10-29T18:30:53.000Z", "edit_history_tweet_ids": ["2115874026513989787"], "entities": {"urls": [{"display_url": "pic.x.com/AaSFYBJ5IK", "end": 267, "expanded_url": "https://x.com/NickTimiraos/status/2115874026513989787/video/1", "media_key": "13_2115873807000907777", "start": 244, "url": "https://t.co/AaSFYBJ5IK"}]}, "id": "2115874026513989787", "public_metrics": {"bookmark_count": 35, "impression_count": 28664, "like_count": 166, "quote_count": 2, "reply_count": 23, "retweet_count": 23}, "text": "A strong economy. Inflation making no progress toward the Fed's 2% target. Financial conditions that aren't tight. So why did the Fed hold? \n\nThree things that stood out from the October FOMC meeting and Chairman Kevin Warsh’s press conference https://t.co/AaSFYBJ5IK", "url": "https://x.com/NickTimiraos/status/2115874026513989787"}, {"author_id": "1214528593", "created_at": "2026-10-29T17:30:29.000Z", "edit_history_tweet_ids": ["2115858827275055232"], "entities": {"urls": [{"display_url": "pic.x.com/OuBjgMJgRK", "end": 54, "expanded_url": "https://x.com/Miles_Brundage/status/2115858827275055232/photo/1", "media_key": "3_2115858824766906368", "start": 31, "url": "https://t.co/OuBjgMJgRK"}]}, "id": "2115858827275055232", "public_metrics": {"bookmark_count": 0, "impression_count": 1168, "like_count": 6, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "We must bring back Emeril Live https://t.co/OuBjgMJgRK", "url": "https://x.com/Miles_Brundage/status/2115858827275055232"}, {"author_id": "1214528593", "created_at": "2026-10-29T17:13:25.000Z", "edit_history_tweet_ids": ["2115854530311233674"], "entities": {"urls": [{"display_url": "x.com/semafor/status…", "end": 65, "expanded_url": "https://twitter.com/semafor/status/2115845386191458506", "start": 42, "url": "https://t.co/R39Miz5fGF"}]}, "id": "2115854530311233674", "public_metrics": {"bookmark_count": 2, "impression_count": 1359, "like_count": 27, "quote_count": 0, "reply_count": 3, "retweet_count": 1}, "referenced_tweets": [{"id": "2115845386191458506", "type": "quoted"}], "text": "You’re telling me this for the first time https://t.co/R39Miz5fGF", "url": "https://x.com/Miles_Brundage/status/2115854530311233674"}, {"author_id": "83466368", "created_at": "2026-10-29T17:05:00.000Z", "edit_history_tweet_ids": ["2115852412170768751"], "entities": {"mentions": [{"end": 101, "id": "304909941", "start": 93, "username": "Lagarde"}], "urls": [{"description": "Webcasts of ECB press conferences", "display_url": "link.europa.eu/KByWRW", "end": 223, "expanded_url": "https://link.europa.eu/KByWRW", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115566473896992768/rcMpWujs?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115566473896992768/rcMpWujs?format=jpg&name=150x150", "width": 150}], "start": 200, "status": 200, "title": "Webcasts: ECB monetary policy decisions", "unwound_url": "https://www.ecb.europa.eu/press/press_conference/html/index.en.html", "url": "https://t.co/GaO1SUSKBo"}, {"display_url": "pic.x.com/9cL8dH27p0", "end": 247, "expanded_url": "https://x.com/ecb/status/2115852412170768751/video/1", "media_key": "13_2115849790252597248", "start": 224, "url": "https://t.co/9cL8dH27p0"}]}, "id": "2115852412170768751", "public_metrics": {"bookmark_count": 3, "impression_count": 7421, "like_count": 58, "quote_count": 2, "reply_count": 15, "retweet_count": 13}, "text": "The institution is solid, strong, like a rock, and it will continue to be so, says President @Lagarde.\n\nRest assured that the ECB is going to carry on with perfect continuity of business.\n\nWatch here https://t.co/GaO1SUSKBo https://t.co/9cL8dH27p0", "url": "https://x.com/ecb/status/2115852412170768751"}, {"author_id": "1214528593", "created_at": "2026-10-29T16:54:13.000Z", "edit_history_tweet_ids": ["2115849697307070628"], "id": "2115849697307070628", "public_metrics": {"bookmark_count": 13, "impression_count": 4201, "like_count": 93, "quote_count": 0, "reply_count": 12, "retweet_count": 1}, "text": "Bay Area AGI pilled people can only think about one book or book series at one time\n\nThere was the Making of the Atomic Bomb era, the Three Body Problem series era, the Seeing Like a State era, the Caro/LBJ era….\n\nMaybe we won’t get another era, just more essays and podcasts", "url": "https://x.com/Miles_Brundage/status/2115849697307070628"}, {"author_id": "83466368", "created_at": "2026-10-29T16:52:16.000Z", "edit_history_tweet_ids": ["2115849208494178428"], "entities": {"mentions": [{"end": 149, "id": "304909941", "start": 141, "username": "Lagarde"}], "urls": [{"description": "Webcasts of ECB press conferences", "display_url": "link.europa.eu/KByWRW", "end": 186, "expanded_url": "https://link.europa.eu/KByWRW", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115566473896992768/rcMpWujs?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115566473896992768/rcMpWujs?format=jpg&name=150x150", "width": 150}], "start": 163, "status": 200, "title": "Webcasts: ECB monetary policy decisions", "unwound_url": "https://www.ecb.europa.eu/press/press_conference/html/index.en.html", "url": "https://t.co/GaO1SUSKBo"}, {"display_url": "pic.x.com/oZSfYnRHj5", "end": 210, "expanded_url": "https://x.com/ecb/status/2115849208494178428/video/1", "media_key": "13_2115849158632353792", "start": 187, "url": "https://t.co/oZSfYnRHj5"}]}, "id": "2115849208494178428", "public_metrics": {"bookmark_count": 4, "impression_count": 6185, "like_count": 43, "quote_count": 2, "reply_count": 13, "retweet_count": 9}, "text": "The Governing Council decided to keep interest rates unchanged.\n\nWe are committed to ensuring that inflation stabilises at 2% says President @Lagarde.\n\nWatch here https://t.co/GaO1SUSKBo https://t.co/oZSfYnRHj5", "url": "https://x.com/ecb/status/2115849208494178428"}, {"author_id": "279036722", "created_at": "2026-10-29T16:43:30.000Z", "edit_history_tweet_ids": ["2115847000344416386"], "id": "2115847000344416386", "public_metrics": {"bookmark_count": 15, "impression_count": 14054, "like_count": 110, "quote_count": 2, "reply_count": 6, "retweet_count": 17}, "text": "1. AI should play a large role before we see anything from anyone so it comes out right in the first place.\n\n2. AI should play a big role in retrospective replications.\n\n3. Piketty-Saez-Zucman work has many flaws that all go one direction.\n\nSpreading slop hurts all three causes.", "url": "https://x.com/jasonfurman/status/2115847000344416386"}, {"author_id": "279036722", "created_at": "2026-10-29T16:39:38.000Z", "edit_history_tweet_ids": ["2115846030080258145"], "entities": {"urls": [{"display_url": "x.com/carney/status/…", "end": 85, "expanded_url": "https://twitter.com/carney/status/2115825327444259300", "start": 62, "url": "https://t.co/xCcQB3rBRP"}]}, "id": "2115846030080258145", "public_metrics": {"bookmark_count": 5, "impression_count": 8101, "like_count": 48, "quote_count": 0, "reply_count": 2, "retweet_count": 2}, "referenced_tweets": [{"id": "2115825327444259300", "type": "quoted"}], "text": "Did no one check any of this before launching the Revolution? https://t.co/xCcQB3rBRP", "url": "https://x.com/jasonfurman/status/2115846030080258145"}, {"author_id": "39125788", "created_at": "2026-10-29T16:32:06.000Z", "edit_history_tweet_ids": ["2115843942532968800", "2115844131985494092"], "id": "2115844131985494092", "public_metrics": {"bookmark_count": 50, "impression_count": 21133, "like_count": 379, "quote_count": 18, "reply_count": 169, "retweet_count": 16}, "text": "I think “sell picks and shovels” is the wrong lesson for AI startups.\n\nThe Gold Rush analogy is weaker than the Industrial Revolution. Gold is a single pile that runs out. Machines keep making everything cheaper. Far more people got rich using the new machines than building them.", "url": "https://x.com/emollick/status/2115844131985494092"}, {"author_id": "39125788", "created_at": "2026-10-29T16:31:21.000Z", "edit_history_tweet_ids": ["2115843942532968800", "2115844131985494092"], "id": "2115843942532968800", "public_metrics": {"bookmark_count": 0, "impression_count": 3188, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "I think“sell picks and shovels” is the wrong lesson for AI startups.\n\nThe Gold Rush analogy is weaker than the Industrial Revolution. Gold is a single pile that runs out. Machines keep making everything cheaper. Far more people got rich using the new machines than building them.", "url": "https://x.com/emollick/status/2115843942532968800"}, {"author_id": "83466368", "created_at": "2026-10-29T16:04:54.000Z", "edit_history_tweet_ids": ["2115837286491554003"], "entities": {"mentions": [{"end": 209, "id": "304909941", "start": 201, "username": "Lagarde"}], "urls": [{"description": "Listen to President Lagarde presents the latest monetary policy decisions – 29 October 2026 from Euro Matters – the European Central Bank Podcast wherever you get your podcasts!", "display_url": "pod.link/ecbpodcast/epi…", "end": 279, "expanded_url": "https://pod.link/ecbpodcast/episode/dGFnOnNvdW5kY2xvdWQsMjAxMDp0cmFja3MvMjQyODM0MTA1Nw", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2115837300555067392/45zIRiO8?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115837300555067392/45zIRiO8?format=jpg&name=150x150", "width": 150}], "start": 256, "status": 200, "title": "President Lagarde presents the latest monetary policy decisions – 29 October 2026", "unwound_url": "https://pod.link/ecbpodcast/episode/dGFnOnNvdW5kY2xvdWQsMjAxMDp0cmFja3MvMjQyODM0MTA1Nw", "url": "https://t.co/0PSRYNfog2"}, {"display_url": "pic.x.com/Zox4sqjaUl", "end": 303, "expanded_url": "https://x.com/ecb/status/2115837286491554003/photo/1", "media_key": "3_2115837278807355392", "start": 280, "url": "https://t.co/Zox4sqjaUl"}]}, "id": "2115837286491554003", "public_metrics": {"bookmark_count": 2, "impression_count": 8159, "like_count": 25, "quote_count": 0, "reply_count": 7, "retweet_count": 5}, "text": "We’ve just taken our latest monetary policy decisions, determined to ensure that inflation stabilises at our two percent target in the medium term.\n\nTune in to Euro Matters to hear President Christine @Lagarde present the decisions in our press conference https://t.co/0PSRYNfog2 https://t.co/Zox4sqjaUl", "url": "https://x.com/ecb/status/2115837286491554003"}, {"author_id": "1214528593", "created_at": "2026-10-29T16:03:51.000Z", "edit_history_tweet_ids": ["2115837025857442250"], "id": "2115837025857442250", "public_metrics": {"bookmark_count": 5, "impression_count": 3543, "like_count": 40, "quote_count": 0, "reply_count": 15, "retweet_count": 0}, "text": "Claude Duet being a separate app is not ideal", "url": "https://x.com/Miles_Brundage/status/2115837025857442250"}, {"author_id": "83466368", "created_at": "2026-10-29T15:52:50.000Z", "edit_history_tweet_ids": ["2115834253326086305"], "entities": {"urls": [{"description": "The European Central Bank (ECB) is the central bank of the European Union countries which have adopted the euro. Our main task is to maintain price stability in the euro area and so preserve the purchasing power of the single currency.", "display_url": "link.europa.eu/fDQKJn", "end": 280, "expanded_url": "https://link.europa.eu/fDQKJn", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115834261635051520/FwjRtaaj?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115834261635051520/FwjRtaaj?format=jpg&name=150x150", "width": 150}], "start": 257, "status": 200, "title": "Next-day securities settlement, tokenisation and the transformation of Europe’s financial infrastructure", "unwound_url": "https://www.ecb.europa.eu/press/key/date/2026/html/ecb.sp261029~e9b57c3495.en.html", "url": "https://t.co/7bGSoSfVsd"}, {"display_url": "pic.x.com/JamtLaKrAD", "end": 304, "expanded_url": "https://x.com/ecb/status/2115834253326086305/photo/1", "media_key": "3_2115832160598798337", "start": 281, "url": "https://t.co/JamtLaKrAD"}]}, "id": "2115834253326086305", "public_metrics": {"bookmark_count": 0, "impression_count": 5429, "like_count": 13, "quote_count": 2, "reply_count": 4, "retweet_count": 1}, "text": "Next-day securities settlement is a key step towards making financial markets more competitive, says Executive Board member Piero Cipollone.\nIt is part of a broader push to make Europe’s financial and payment system safer, more efficient and more resilient https://t.co/7bGSoSfVsd https://t.co/JamtLaKrAD", "url": "https://x.com/ecb/status/2115834253326086305"}, {"author_id": "612896910", "created_at": "2026-10-29T15:48:09.000Z", "edit_history_tweet_ids": ["2115833071811572061"], "entities": {"hashtags": [{"end": 95, "start": 87, "tag": "BLSdata"}], "urls": [{"description": "The .gov means it's official. Federal government websites often end in .gov or .mil. Before sharing sensitive information, make sure you're on a federal government site. The site is secure. The https:// ensures that you are connecting to the official website and that any information you provide is encrypted and transmitted securely. Teams from Milwaukee and Tampa slugged it out this week in baseball’s championship series. It was Milwaukee’s first trip to the series since 1982, while Tampa’s last visit", "display_url": "bls.gov/opub/ted/2026/…", "end": 86, "expanded_url": "https://www.bls.gov/opub/ted/2026/baseballs-championship-series-ran-through-milwaukee-and-tampa.htm", "images": [{"height": 126, "url": "https://pbs.twimg.com/news_img/2115833079730425856/vDxRgTLh?format=png&name=orig", "width": 228}, {"height": 126, "url": "https://pbs.twimg.com/news_img/2115833079730425856/vDxRgTLh?format=png&name=150x150", "width": 126}], "start": 63, "status": 200, "title": "Baseball's championship series ran through Milwaukee and Tampa : The Economics Daily : U.S. Bureau of Labor Statistics", "unwound_url": "https://www.bls.gov/opub/ted/2026/baseballs-championship-series-ran-through-milwaukee-and-tampa.htm", "url": "https://t.co/h2rKXmymle"}, {"display_url": "pic.x.com/bSwo60c2KL", "end": 119, "expanded_url": "https://x.com/BLS_gov/status/2115833071811572061/photo/1", "media_key": "3_2115832663659401216", "start": 96, "url": "https://t.co/bSwo60c2KL"}]}, "id": "2115833071811572061", "public_metrics": {"bookmark_count": 0, "impression_count": 1886, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Baseball's championship series ran through Milwaukee and Tampa https://t.co/h2rKXmymle #BLSdata https://t.co/bSwo60c2KL", "url": "https://x.com/BLS_gov/status/2115833071811572061"}, {"author_id": "83466368", "created_at": "2026-10-29T14:58:44.000Z", "edit_history_tweet_ids": ["2115820635666501742"], "entities": {"urls": [{"description": "We take decisions on monetary policy every six weeks determining what should be done to keep inflation under control. Our visual statement explains this in short and easy-to-understand language.", "display_url": "ecb.europa.eu/press/press_co…", "end": 265, "expanded_url": "https://www.ecb.europa.eu/press/press_conference/visual-mps/2026/html/mopo_statement_explained_october.en.html", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115820644629639168/cLX2RJGC?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115820644629639168/cLX2RJGC?format=jpg&name=150x150", "width": 150}], "start": 242, "status": 200, "title": "Our monetary policy statement at a glance - October 2026", "unwound_url": "https://www.ecb.europa.eu/press/press_conference/visual-mps/2026/html/mopo_statement_explained_october.en.html", "url": "https://t.co/stTMdnXmke"}, {"display_url": "pic.x.com/rsPJX7wjRl", "end": 289, "expanded_url": "https://x.com/ecb/status/2115820635666501742/photo/1", "media_key": "3_2115815188255404032", "start": 266, "url": "https://t.co/rsPJX7wjRl"}]}, "id": "2115820635666501742", "public_metrics": {"bookmark_count": 2, "impression_count": 9016, "like_count": 24, "quote_count": 1, "reply_count": 3, "retweet_count": 10}, "text": "Today we kept our key interest rates at their current levels.\n\nWe are well positioned to deal with the very uncertain economic situation.\n\nInflation has gone up again, but the economy keeps growing despite headwinds and many people have jobs https://t.co/stTMdnXmke https://t.co/rsPJX7wjRl", "url": "https://x.com/ecb/status/2115820635666501742"}, {"author_id": "279036722", "created_at": "2026-10-29T14:50:54.000Z", "edit_history_tweet_ids": ["2115818666918862861"], "entities": {"urls": [{"display_url": "x.com/jasoncrawford/…", "end": 61, "expanded_url": "https://twitter.com/jasoncrawford/status/2115530552464044181", "start": 38, "url": "https://t.co/KBcQcGuOJD"}]}, "id": "2115818666918862861", "public_metrics": {"bookmark_count": 27, "impression_count": 12988, "like_count": 50, "quote_count": 0, "reply_count": 5, "retweet_count": 4}, "referenced_tweets": [{"id": "2115530552464044181", "type": "quoted"}], "text": "Best roundup on this issue I've seen: https://t.co/KBcQcGuOJD", "url": "https://x.com/jasonfurman/status/2115818666918862861"}, {"author_id": "321536046", "created_at": "2026-10-29T14:40:52.000Z", "edit_history_tweet_ids": ["2115816139225739316"], "entities": {"urls": [{"display_url": "bea.gov/news/schedule/…", "end": 124, "expanded_url": "https://www.bea.gov/news/schedule/next-year", "start": 101, "status": 200, "title": "Release Schedule | U.S. Bureau of Economic Analysis (BEA)", "unwound_url": "https://www.bea.gov/news/schedule/next-year", "url": "https://t.co/dg4RLWg6vZ"}, {"display_url": "pic.x.com/YNzkIQPZCX", "end": 148, "expanded_url": "https://x.com/BEA_News/status/2115816139225739316/photo/1", "media_key": "3_2115816128911986688", "start": 125, "url": "https://t.co/YNzkIQPZCX"}]}, "id": "2115816139225739316", "public_metrics": {"bookmark_count": 0, "impression_count": 648, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "Mark your calendars! The 2027 economic release schedule is now available. Check out what’s coming at https://t.co/dg4RLWg6vZ https://t.co/YNzkIQPZCX", "url": "https://x.com/BEA_News/status/2115816139225739316"}, {"author_id": "279036722", "created_at": "2026-10-29T14:35:10.000Z", "edit_history_