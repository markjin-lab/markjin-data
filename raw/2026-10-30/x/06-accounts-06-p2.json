, "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115490539072045056/ShuJ4rle?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115490539072045056/ShuJ4rle?format=jpg&name=150x150", "width": 150}], "start": 259, "status": 200, "title": "Heat Pump Monitor 2026 - IEA", "unwound_url": "https://www.iea.org/reports/heat-pump-monitor-2026?utm_content=bufferd3557&utm_medium=social&utm_source=twitter.com&utm_campaign=buffer", "url": "https://t.co/SAJoPeH3M0"}, {"display_url": "pic.x.com/Q1NGOGd8AD", "end": 306, "expanded_url": "https://x.com/IEA/status/2115490478443401461/photo/1", "media_key": "3_2115490476107190272", "start": 283, "url": "https://t.co/Q1NGOGd8AD"}]}, "id": "2115490478443401461", "public_metrics": {"bookmark_count": 4, "impression_count": 3064, "like_count": 13, "quote_count": 1, "reply_count": 2, "retweet_count": 5}, "text": "Heat pumps can play an important role in delivering secure, affordable &amp; sustainable heating around the world\n\nOur Heat Pump Monitor includes 20 interactive dashboards allowing users to explore the latest market trends, regional insights &amp; policies 👉 https://t.co/SAJoPeH3M0 https://t.co/Q1NGOGd8AD", "url": "https://x.com/IEA/status/2115490478443401461"}, {"author_id": "19386622", "created_at": "2026-10-28T17:00:01.000Z", "edit_history_tweet_ids": ["2115488769990131978"], "entities": {"hashtags": [{"end": 202, "start": 194, "tag": "Nuclear"}, {"end": 267, "start": 250, "tag": "PoweredbyNuclear"}], "urls": [{"description": "Nuclear power is increasingly recognized as a reliable low-carbon source of energy that can support long-term national development and enhance energy security. Today, 31 countries operate 413 nuclear power reactors with a combined capacity of around 377 gigawatts, providing a significant share of the world's low-carbon emission electricity. In addition, more than 60 countries are embarking on or considering the introduction of nuclear power.", "display_url": "atoms.iaea.org/3W5mEgd", "end": 249, "expanded_url": "https://atoms.iaea.org/3W5mEgd", "start": 226, "status": 200, "title": "International Ministerial Conference on Nuclear Power | IAEA", "unwound_url": "https://www.iaea.org/events/ministerial-nuclear-power-conference-2026", "url": "https://t.co/q8lgBlR18h"}, {"display_url": "pic.x.com/9KcFD5tkJj", "end": 291, "expanded_url": "https://x.com/iaeaorg/status/2115488769990131978/photo/1", "media_key": "3_2115459539055063041", "start": 268, "url": "https://t.co/9KcFD5tkJj"}, {"display_url": "pic.x.com/9KcFD5tkJj", "end": 291, "expanded_url": "https://x.com/iaeaorg/status/2115488769990131978/photo/1", "media_key": "3_2115459567047901185", "start": 268, "url": "https://t.co/9KcFD5tkJj"}]}, "id": "2115488769990131978", "public_metrics": {"bookmark_count": 2, "impression_count": 3404, "like_count": 14, "quote_count": 0, "reply_count": 3, "retweet_count": 3}, "text": "Join us for Day 3 of the IAEA 2026 Ministerial Conference on Nuclear Power in 🇰🇷!\n\nThe final sessions feature expert-led panel discussions on creating opportunities and emerging applications in #Nuclear\n\nWatch the livestream: https://t.co/q8lgBlR18h\n#PoweredbyNuclear https://t.co/9KcFD5tkJj", "url": "https://x.com/iaeaorg/status/2115488769990131978"}, {"author_id": "166252256", "created_at": "2026-10-28T16:36:59.000Z", "edit_history_tweet_ids": ["2115482972526653779"], "entities": {"urls": [{"display_url": "pic.x.com/QuV74OhX06", "end": 270, "expanded_url": "https://x.com/ENERGY/status/2115482972526653779/photo/1", "media_key": "3_2115482962309353472", "start": 247, "url": "https://t.co/QuV74OhX06"}]}, "id": "2115482972526653779", "public_metrics": {"bookmark_count": 17, "impression_count": 23804, "like_count": 286, "quote_count": 9, "reply_count": 23, "retweet_count": 59}, "text": "🚨TODAY: The Energy Department announced MAJOR investments in new natural gas generation, battery energy storage systems, and LNG storage for Iowa and Wisconsin.\n\nThis will help deliver lower costs and add more power to our nation’s electric grid. https://t.co/QuV74OhX06", "url": "https://x.com/ENERGY/status/2115482972526653779"}, {"author_id": "325581008", "created_at": "2026-10-28T16:30:21.000Z", "edit_history_tweet_ids": ["2115481305123107122"], "entities": {"urls": [{"description": "The U.S. Nuclear Regulatory Commission (NRC) has issued a final environmental impact statement (EIS) regarding a license application from Global Laser Enrichment, LLC (GLE) to construct and operate the Paducah Laser Enrichment Facility. The EIS evaluates the environmental impacts of the proposed...", "display_url": "federalregister.gov/d/2026-21996", "end": 217, "expanded_url": "https://www.federalregister.gov/d/2026-21996", "images": [{"height": 200, "url": "https://pbs.twimg.com/news_img/2115481306041593857/6v5kmBaJ?format=png&name=orig", "width": 832}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115481306041593857/6v5kmBaJ?format=png&name=150x150", "width": 150}], "start": 194, "status": 200, "title": "Global Laser Enrichment, LLC; Paducah Laser Enrichment Facility; Final Environmental Impact Statement", "unwound_url": "https://www.federalregister.gov/documents/2026/10/28/2026-21996/global-laser-enrichment-llc-paducah-laser-enrichment-facility-final-environmental-impact-statement", "url": "https://t.co/Xeum9cmo3k"}, {"display_url": "pic.x.com/CghJfOiGr6", "end": 241, "expanded_url": "https://x.com/NRCgov/status/2115481305123107122/photo/1", "media_key": "3_2115481301025271808", "start": 218, "url": "https://t.co/CghJfOiGr6"}]}, "id": "2115481305123107122", "public_metrics": {"bookmark_count": 2, "impression_count": 2437, "like_count": 28, "quote_count": 0, "reply_count": 2, "retweet_count": 4}, "text": "Focused on what matters most to safety: we completed our final environmental impact study for Global Laser Enrichment's Paducah facility in 15 months, a month early, meeting NEPA requirements.  https://t.co/Xeum9cmo3k https: