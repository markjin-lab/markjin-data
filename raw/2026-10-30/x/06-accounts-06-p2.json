": 265, "expanded_url": "https://x.com/broadinstitute/status/2115467428922859609/photo/1", "media_key": "3_2115467117281632256", "start": 242, "url": "https://t.co/BmZyqgzCU5"}]}, "id": "2115467428922859609", "public_metrics": {"bookmark_count": 3, "impression_count": 2887, "like_count": 21, "quote_count": 1, "reply_count": 2, "retweet_count": 4}, "text": "Broad scientists discover that mechanism underlying Huntington’s disease in striatum is also present in the neocortex, suggesting that new drugs under development could potentially protect multiple parts of the brain. https://t.co/A3Vi2ZCn54 https://t.co/BmZyqgzCU5", "url": "https://x.com/broadinstitute/status/2115467428922859609"}, {"author_id": "84679163", "created_at": "2026-10-28T15:31:21.000Z", "edit_history_tweet_ids": ["2115466458012545246"], "entities": {"urls": [{"description": "Since the start of its full-scale invasion of Ukraine, Russia has b...", "display_url": "iea.li/4hsqwyI", "end": 276, "expanded_url": "https://iea.li/4hsqwyI", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2113620403104997376/7qElEl_N?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113620403104997376/7qElEl_N?format=jpg&name=150x150", "width": 150}], "start": 253, "status": 200, "title": "How Ukraine is decentralising its energy system to improve energy security", "unwound_url": "https://www.youtube.com/watch?app=desktop&v=Zd9CdXdyRao&utm_content=buffer48161&utm_medium=social&utm_source=twitter.com&utm_campaign=buffer", "url": "https://t.co/2h6DolYzSD"}, {"display_url": "pic.x.com/kUjKrmMswo", "end": 300, "expanded_url": "https://x.com/IEA/status/2115466458012545246/video/1", "media_key": "7_2115466417617149952", "start": 277, "url": "https://t.co/kUjKrmMswo"}]}, "id": "2115466458012545246", "public_metrics": {"bookmark_count": 3, "impression_count": 3174, "like_count": 14, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "Since Russia's full-scale invasion in 2022, Ukraine's power output has been cut in half.\n\nOur new short documentary explores how decentralised energy solutions are helping communities cope today while strengthening 🇺🇦's energy security for the future 👉 https://t.co/2h6DolYzSD https://t.co/kUjKrmMswo", "url": "https://x.com/IEA/status/2115466458012545246"}, {"author_id": "19386622", "created_at": "2026-10-28T15:09:38.000Z", "edit_history_tweet_ids": ["2115460991618036076"], "entities": {"urls": [{"display_url": "pic.x.com/HlKS6UUcIA", "end": 298, "expanded_url": "https://x.com/iaeaorg/status/2115460991618036076/photo/1", "media_key": "3_2115460954750115840", "start": 275, "url": "https://t.co/HlKS6UUcIA"}]}, "id": "2115460991618036076", "public_metrics": {"bookmark_count": 5, "impression_count": 15902, "like_count": 76, "quote_count": 1, "reply_count": 2, "retweet_count": 20}, "text": "The IAEA today published a new report confirming the consistency of independent analyses of marine samples collected near Japan’s Fukushima Daiichi Nuclear Power Station (FDNPS) under the IAEA Additional Measures related to the discharge of Advanced Liquid Processing System https://t.co/HlKS6UUcIA", "url": "https://x.com/iaeaorg/status/2115460991618036076"}, {"author_id": "19386622", "created_at": "2026-10-28T14:19:43.000Z", "edit_history_tweet_ids": ["2115448429463949636"], "entities": {"hashtags": [{"end": 245, "start": 227, "tag": "NuclearNeedsWomen"}, {"end": 261, "start": 246, "tag": "WomeninScience"}], "urls": [{"description": "The application period is now open and will close on 31 October 2026. Apply here →", "display_url": "atoms.iaea.org/3UA7bDZ", "end": 224, "expanded_url": "https://atoms.iaea.org/3UA7bDZ", "start": 201, "status": 200, "title": "Information for applicants | IAEA", "unwound_url": "https://www.iaea.org/services/key-programmes/iaea-marie-sklodowska-curie-fellowship-programme/information-for-applicants", "url": "https://t.co/ttdUoljP7Z"}, {"display_url": "pic.x.com/r1PzNesVWr", "end": 