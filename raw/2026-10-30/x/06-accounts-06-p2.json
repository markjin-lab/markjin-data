"], "entities": {"urls": [{"display_url": "x.com/i/article/2115…", "end": 23, "expanded_url": "https://x.com/i/article/2115440242660458496", "start": 0, "status": 404, "unwound_url": "https://x.com/i/article/2115440242660458496", "url": "https://t.co/9eoNPz4JI6"}]}, "id": "2115440776129781918", "public_metrics": {"bookmark_count": 21, "impression_count": 15068, "like_count": 162, "quote_count": 2, "reply_count": 9, "retweet_count": 34}, "text": "https://t.co/9eoNPz4JI6", "url": "https://x.com/ENERGY/status/2115440776129781918"}, {"author_id": "17468569", "created_at": "2026-10-28T12:47:14.000Z", "edit_history_tweet_ids": ["2115425155879260599"], "entities": {"urls": [{"display_url": "x.com/TaylorLorenz/s…", "end": 212, "expanded_url": "https://twitter.com/TaylorLorenz/status/2115270914338390073", "start": 189, "url": "https://t.co/LL37Ate2LJ"}]}, "id": "2115425155879260599", "public_metrics": {"bookmark_count": 58, "impression_count": 104424, "like_count": 866, "quote_count": 4, "reply_count": 80, "retweet_count": 10}, "referenced_tweets": [{"id": "2115270914338390073", "type": "quoted"}], "text": "The lights pointing at the stage were blasting my eyeballs with blue light which makes it harder to fall asleep and fragments sleep. \n\nSo we hung out in the dark and it was so much better. https://t.co/LL37Ate2LJ", "url": "https://x.com/bryan_johnson/status/2115425155879260599"}, {"author_id": "84679163", "created_at": "2026-10-28T11:15:11.000Z", "edit_history_tweet_ids": ["2115401991799074834"], "entities": {"urls": [{"description": "You are connecting via IP recognition from. If you wish to proceed, click on Connect. If you prefer to log into your personal account, please sign in below. Create a free IEA account to download our reports or subcribe to a paid service. Thank you for subscribing. You can unsubscribe at any time by clicking the link at the bottom of any IEA newsletter.", "display_url": "iea.li/4diDUnc", "end": 192, "expanded_url": "https://iea.li/4diDUnc",