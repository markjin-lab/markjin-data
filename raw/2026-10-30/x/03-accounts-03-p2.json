{"data": [{"author_id": "14096763", "created_at": "2026-10-29T15:52:18.000Z", "edit_history_tweet_ids": ["2115834119175409708"], "entities": {"urls": [{"display_url": "x.com/conorsen/statu…", "end": 61, "expanded_url": "https://twitter.com/conorsen/status/2115833927009280108", "start": 38, "url": "https://t.co/v6s66OLIhR"}]}, "id": "2115834119175409708", "public_metrics": {"bookmark_count": 26, "impression_count": 86093, "like_count": 1089, "quote_count": 2, "reply_count": 19, "retweet_count": 26}, "referenced_tweets": [{"id": "2115833927009280108", "type": "quoted"}], "text": "They're selling dollars for 50 cents! https://t.co/v6s66OLIhR", "url": "https://x.com/TheStalwart/status/2115834119175409708"}, {"author_id": "702235316812275712", "created_at": "2026-10-29T15:48:34.000Z", "edit_history_tweet_ids": ["2115833176220475447"], "id": "2115833176220475447", "public_metrics": {"bookmark_count": 1, "impression_count": 2586, "like_count": 21, "quote_count": 1, "reply_count": 1, "retweet_count": 0}, "text": "My general take on yesterday’s “AI slop-audit of an econ paper” discourse is that AI is capable of very high quality reviews but in reality we’re going to be inundated with low quality slop reviews", "url": "https://x.com/EconBerger/status/2115833176220475447"}, {"author_id": "2961589380", "created_at": "2026-10-29T15:45:53.000Z", "edit_history_tweet_ids": ["2115832503852568881"], "entities": {"hashtags": [{"end": 126, "start": 115, "tag": "IMPACT2026"}], "mentions": [{"end": 36, "id": "18036280", "start": 27, "username": "timsteno"}, {"end": 53, "id": "160948300", "start": 41, "username": "carolmassar"}, {"end": 72, "id": "57675435", "start": 57, "username": "BloombergRadio"}]}, "id": "2115832503852568881", "public_metrics": {"bookmark_count": 0, "impression_count": 10314, "like_count": 13, "quote_count": 1, "reply_count": 6, "retweet_count": 0}, "text": "Looking forward to joining @timsteno and @carolmassar on @BloombergRadio around 4:20pm ET today live from Schwab’s #IMPACT2026 conference", "url": "https://x.com/LizAnnSonders/status/2115832503852568881"}, {"author_id": "14096763", "created_at": "2026-10-29T15:40:18.000Z", "edit_history_tweet_ids": ["2115831097049116710"], "entities": {"mentions": [{"end": 31, "id": "53348301", "start": 19, "username": "PEWilliams_"}, {"end": 225, "id": "1826103617310367744", "start": 214, "username": "neslusajme"}], "urls": [{"display_url": "pic.x.com/LLYpVzX0vc", "end": 251, "expanded_url": "https://x.com/TheStalwart/status/2115831097049116710/photo/1", "media_key": "3_2115830931743240192", "start": 228, "url": "https://t.co/LLYpVzX0vc"}]}, "id": "2115831097049116710", "public_metrics": {"bookmark_count": 2, "impression_count": 13959, "like_count": 148, "quote_count": 0, "reply_count": 15, "retweet_count": 3}, "text": "I was stunned when @PEWilliams_ busted out the harmonica last night, because normally he forgets it. Also man, Lucinda's really does have the best lighting of any bar we've played in. All the photos look cool (via @neslusajme ) https://t.co/LLYpVzX0vc", "url": "https://x.com/TheStalwart/status/2115831097049116710"}, {"author_id": "733647469305864195", "created_at": "2026-10-29T15:06:42.000Z", "edit_history_tweet_ids": ["2115822641949069669"], "entities": {"urls": [{"display_url": "pic.x.com/UTi8SAC6L7", "end": 196, "expanded_url": "https://x.com/Brad_Setser/status/2115822641949069669/photo/1", "media_key": "3_2115822587456692224", "start": 173, "url": "https://t.co/UTi8SAC6L7"}]}, "id": "2115822641949069669", "public_metrics": {"bookmark_count": 9, "impression_count": 6418, "like_count": 47, "quote_count": 0, "reply_count": 6, "retweet_count": 8}, "text": "Guess it is a bit ironic that an Administration opposed to trade (and imports) is presiding over one of the more rapid increases in (real) imports in recent history ...\n\n1/ https://t.co/UTi8SAC6L7", "url": "https://x.com/Brad_Setser/status/2115822641949069669"}, {"author_id": "14096763", "created_at": "2026-10-29T14:39: