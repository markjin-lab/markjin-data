{"data": [{"author_id": "2961589380", "created_at": "2026-10-29T11:06:41.000Z", "edit_history_tweet_ids": ["2115762239491981414"], "entities": {"urls": [{"display_url": "pic.x.com/D49P6MH2Ff", "end": 184, "expanded_url": "https://x.com/LizAnnSonders/status/2115762239491981414/photo/1", "media_key": "3_2115762235981045760", "start": 161, "url": "https://t.co/D49P6MH2Ff"}]}, "id": "2115762239491981414", "public_metrics": {"bookmark_count": 4, "impression_count": 11552, "like_count": 42, "quote_count": 0, "reply_count": 12, "retweet_count": 10}, "text": "Imports of capital goods, fueled by the AI investment boom, surged +7.5% m/m in September and were a primary driver behind the deteriorating goods trade deficit https://t.co/D49P6MH2Ff", "url": "https://x.com/LizAnnSonders/status/2115762239491981414"}, {"author_id": "2961589380", "created_at": "2026-10-29T11:06:08.000Z", "edit_history_tweet_ids": ["2115762100509594079"], "entities": {"mentions": [{"end": 163, "id": "58530623", "start": 151, "username": "MBAMortgage"}], "urls": [{"display_url": "pic.x.com/UwFDxrbwfp", "end": 187, "expanded_url": "https://x.com/LizAnnSonders/status/2115762100509594079/photo/1", "media_key": "3_2115762096709193728", "start": 164, "url": "https://t.co/UwFDxrbwfp"}]}, "id": "2115762100509594079", "public_metrics": {"bookmark_count": 3, "impression_count": 12634, "like_count": 24, "quote_count": 3, "reply_count": 6, "retweet_count": 6}, "text": "Adjustable-rate mortgage (ARM) share of loan activity at its highest level in more than a year, as borrowers seek relief from elevated mortgage rates \n@MBAmortgage https://t.co/UwFDxrbwfp", "url": "https://x.com/LizAnnSonders/status/2115762100509594079"}, {"author_id": "188369814", "created_at": "2026-10-29T10:57:11.000Z", "edit_history_tweet_ids": ["2115759849640177687"], "entities": {"mentions": [{"end": 21, "id": "1015241814", "start": 13, "username": "FerroTV"}], "urls": [{"display_url": "x.com/juliettejdi/st…", "end": 295, "expanded_url": "http