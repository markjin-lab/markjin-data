T12:42:22.000Z", "edit_history_tweet_ids": ["2115786319532274082"], "entities": {"urls": [{"display_url": "pic.x.com/WdRZWUU4v9", "end": 272, "expanded_url": "https://x.com/EconBerger/status/2115786319532274082/photo/1", "media_key": "3_2115786072508792832", "start": 249, "url": "https://t.co/WdRZWUU4v9"}]}, "id": "2115786319532274082", "public_metrics": {"bookmark_count": 1, "impression_count": 1895, "like_count": 13, "quote_count": 1, "reply_count": 6, "retweet_count": 2}, "text": "Claims:\n\n1/ Initial claims (and layoffs) are really low.  They may even be falling further from those really low levels, though it's a little hard to tell.\n\n(And would buck the slightly more pessimistic tone of other very recent labor market data.) https://t.co/WdRZWUU4v9", "url": "https://x.com/EconBerger/status/2115786319532274082"}, {"author_id": "14096763", "created_at": "2026-10-29T12:39:53.000Z", "edit_history_tweet_ids": ["2115785694886965678"], "entities": {"cashtags": [{"end": 4, "start": 0, "tag": "CAT"}]}, "id": "2115785694886965678", "public_metrics": {"bookmark_count": 10, "impression_count": 23392, "like_count": 122, "quote_count": 4, "reply_count": 8, "retweet_count": 6}, "text": "$CAT plunging 11.7%", "url": "https://x.com/TheStalwart/status/2115785694886965678"}, {"author_id": "14096763", "created_at": "2026-10-29T12:14:08.000Z", "edit_history_tweet_ids": ["2115779214758523117"], "entities": {"urls": [{"display_url": "x.com/thestalwart/st…", "end": 282, "expanded_url": "https://twitter.com/thestalwart/status/2115768728163922265", "start": 259, "url": "https://t.co/wQNbTaDgsn"}]}, "id": "2115779214758523117", "public_metrics": {"bookmark_count": 20, "impression_count": 17319, "like_count": 83, "quote_count": 0, "reply_count": 6, "retweet_count": 4}, "referenced_tweets": [{"id": "2115768728163922265", "type": "quoted"}], "text": "I don’t think we’ve found anyone who can speak as fluent Wall Street and SF as well as Alty. Really has a great handle on what’s trading and