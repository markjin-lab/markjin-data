{"data": [{"author_id": "11348282", "created_at": "2026-10-29T20:15:05.000Z", "edit_history_tweet_ids": ["2115900247230537920"], "entities": {"urls": [{"display_url": "go.nasa.gov/dragonfly-names", "end": 256, "expanded_url": "https://go.nasa.gov/dragonfly-names", "start": 233, "status": 200, "title": "NASA Events", "unwound_url": "https://my.nasa.gov/specialevents/s/send-your-name-with-dragonfly", "url": "https://t.co/iinCnJaqIP"}, {"display_url": "pic.x.com/FQZvfBGUZo", "end": 280, "expanded_url": "https://x.com/NASA/status/2115900247230537920/photo/1", "media_key": "3_2115900236535042049", "start": 257, "url": "https://t.co/FQZvfBGUZo"}]}, "id": "2115900247230537920", "public_metrics": {"bookmark_count": 104, "impression_count": 152912, "like_count": 619, "quote_count": 21, "reply_count": 72, "retweet_count": 130}, "text": "Your name could fly on Saturn’s largest moon.\n\nNASA’s Dragonfly mission will launch in 2028 to explore the dunes, lakes, and rivers of Saturn’s moon, Titan, and your name can come along! Join the voyage and claim your boarding pass: https://t.co/iinCnJaqIP https://t.co/FQZvfBGUZo", "url": "https://x.com/NASA/status/2115900247230537920"}, {"author_id": "626660983", "created_at": "2026-10-29T20:04:17.000Z", "edit_history_tweet_ids": ["2115897530701561925"], "entities": {"urls": [{"display_url": "pic.x.com/h1hE6LAUA1", "end": 102, "expanded_url": "https://x.com/lymanstoneky/status/2115897530701561925/photo/1", "media_key": "3_2115897525064339456", "start": 79, "url": "https://t.co/h1hE6LAUA1"}]}, "id": "2115897530701561925", "public_metrics": {"bookmark_count": 0, "impression_count": 803, "like_count": 8, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "tfw all your projects are gonna wrap up just under both wires at the same time https://t.co/h1hE6LAUA1", "url": "https://x.com/lymanstoneky/status/2115897530701561925"}, {"author_id": "626660983", "created_at": "2026-10-29T19:54:31.000Z", "edit_history_tweet_ids": ["2115895073712005325"], "entities": {"urls": [{"display_url": "pic.x.com/lDORMlookI", "end": 229, "expanded_url": "https://x.com/lymanstoneky/status/2115895073712005325/photo/1", "media_key": "3_2115894842811101184", "start": 206, "url": "https://t.co/lDORMlookI"}, {"display_url": "pic.x.com/lDORMlookI", "end": 229, "expanded_url": "https://x.com/lymanstoneky/status/2115895073712005325/photo/1", "media_key": "3_2115895066975719424", "start": 206, "url": "https://t.co/lDORMlookI"}]}, "id": "2115895073712005325", "public_metrics": {"bookmark_count": 8, "impression_count": 1709, "like_count": 47, "quote_count": 0, "reply_count": 2, "retweet_count": 4}, "text": "not to put too blunt a point on it, but the rise of secularism in america really does seem to have stopped (for now?), maybe even reversed a bit, and younger Americans *do* seem to be getting more devout ? https://t.co/lDORMlookI", "url": "https://x.com/lymanstoneky/status/2115895073712005325"}, {"author_id": "626660983", "created_at": "2026-10-29T19:26:31.000Z", "edit_history_tweet_ids": ["2115888025536225415"], "entities": {"urls": [{"display_url": "x.com/AmoneyResists/…", "end": 302, "expanded_url": "https://twitter.com/AmoneyResists/status/2115527073628340303", "start": 279, "url": "https://t.co/4SPcRFkQjo"}]}, "id": "2115888025536225415", "public_metrics": {"bookmark_count": 4, "impression_count": 3514, "like_count": 32, "quote_count": 0, "reply_count": 9, "retweet_count": 2}, "referenced_tweets": [{"id": "2115527073628340303", "type": "quoted"}], "text": "this doesn't sound cognitively not there? this a speech with an obvious throughline, lots of recalled details, and consistent with the speaker's expertise and preoccupations from the last 60 years?\n\nthat it's an annoying way of speaking on a sort of smallball topic doesn't make https://t.co/4SPcRFkQjo", "url": "https://x.com/lymanstoneky/status/2115888025536225415"}, {"author_id": "895332160130891776", "created_at": "2026-10-29T18:48:20.000Z", "edit_history_tweet_ids": ["2115878416423784939"], "entities": {"urls": [{"display_url": "pic.x.com/Lk0UyRHitQ", "end": 300, "expanded_url": "https://x.com/neuralink/status/2115878416423784939/video/1", "media_key": "13_2115873705230249984", "start": 277, "url": "https://t.co/Lk0UyRHitQ"}]}, "id": "2115878416423784939", "public_metrics": {"bookmark_count": 142, "impression_count": 48151, "like_count": 1349, "quote_count": 42, "reply_count": 54, "retweet_count": 163}, "text": "Our engineers recently visited one of our speech restoration study participants for a 72-hour hackathon.\n\nThe goal: rapidly prototype as many features as possible to enhance the experience of using Neuralink to communicate with thought.\n\nHere are some of the things we built 🧵 https://t.co/Lk0UyRHitQ", "url": "https://x.com/neuralink/status/2115878416423784939"}, {"author_id": "626660983", "created_at": "2026-10-29T16:46:04.000Z", "edit_history_tweet_ids": ["2115847648452207018"], "entities": {"urls": [{"display_url": "x.com/GarnettGenuis/…", "end": 27, "expanded_url": "https://twitter.com/GarnettGenuis/status/2115097262179205573", "start": 4, "url": "https://t.co/b4NUQqcn6x"}]}, "id": "2115847648452207018", "public_metrics": {"bookmark_count": 2, "impression_count": 1947, "like_count": 22, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2115097262179205573", "type": "quoted"}], "text": "🤡🤡🤡 https://t.co/b4NUQqcn6x", "url": "https://x.com/lymanstoneky/status/2115847648452207018"}, {"author_id": "17217640", "created_at": "2026-10-29T16:35:16.000Z", "edit_history_tweet_ids": ["2115844930962903551"], "entities": {"urls": [{"description": "The best source for space news: launch coverage, mission reports and the launch schedule.", "display_url": "spaceflightnow.com/live/", "end": 262, "expanded_url": "https://spaceflightnow.com/live/", "images": [{"height": 864, "url": "https://pbs.twimg.com/news_img/2115799608894844928/NvfiBqh8?format=png&name=orig", "width": 864}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115799608894844928/NvfiBqh8?format=png&name=150x150", "width": 150}], "start": 239, "status": 200, "title": "SFN Live — Spaceflight Now", "unwound_url": "https://spaceflightnow.com/live/", "url": "https://t.co/pCb2MxbZdI"}, {"display_url": "pic.x.com/uApy47Xt7a", "end": 286, "expanded_url": "https://x.com/SpaceflightNow/status/2115844930962903551/video/1", "media_key": "13_2115844010258411520", "start": 263, "url": "https://t.co/uApy47Xt7a"}]}, "id": "2115844930962903551", "public_metrics": {"bookmark_count": 6, "impression_count": 10605, "like_count": 95, "quote_count": 2, "reply_count": 7, "retweet_count": 16}, "text": "The International Space Station Roll-Out Solar Array, or IROSA, starts to unroll during today's spacewalk by NASA's Anil Menon and Canadian Space Agency astronaut Joshua Kutryk to upgrade the orbiting outpost's power supply. Live updates: https://t.co/pCb2MxbZdI https://t.co/uApy47Xt7a", "url": "https://x.com/SpaceflightNow/status/2115844930962903551"}, {"author_id": "626660983", "created_at": "2026-10-29T16:29:59.000Z", "edit_history_tweet_ids": ["2115843601070510391"], "entities": {"mentions": [{"end": 18, "id": "41742794", "start": 3, "username": "MarketUrbanism"}, {"end": 32, "id": "252123610", "start": 21, "username": "salimfurth"}], "urls": [{"display_url": "pic.x.com/e7uBcSUUuu", "end": 294, "expanded_url": "https://x.com/lymanstoneky/status/2115843601070510391/photo/1", "media_key": "3_2115840361096421376", "start": 271, "url": "https://t.co/e7uBcSUUuu"}, {"display_url": "pic.x.com/e7uBcSUUuu", "end": 294, "expanded_url": "https://x.com/lymanstoneky/status/2115843601070510391/photo/1", "media_key": "3_2115840361062907904", "start": 271, "url": "https://t.co/e7uBcSUUuu"}, {"display_url": "pic.x.com/e7uBcSUUuu", "end": 294, "expanded_url": "https://x.com/lymanstoneky/status/2115843601070510391/photo/1", "media_key": "3_2115840361062957056", "start": 271, "url": "https://t.co/e7uBcSUUuu"}, {"display_url": "pic.x.com/e7uBcSUUuu", "end": 294, "expanded_url": "https://x.com/lymanstoneky/status/2115843601070510391/photo/1", "media_key": "3_2115840361092325376", "start": 271, "url": "https://t.co/e7uBcSUUuu"}]}, "id": "2115843601070510391", "public_metrics": {"bookmark_count": 1, "impression_count": 978, "like_count": 13, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "At @MarketUrbanism , @salimfurth comments on the disappointing fade of the English New Homes Bonus program.\n\nI had never heard of this program until I was working on something else, asked Claude to recommend me some literature, and it recommended me something on the NHB https://t.co/e7uBcSUUuu", "url": "https://x.com/lymanstoneky/status/2115843601070510391"}, {"author_id": "626660983", "created_at": "2026-10-29T14:17:41.000Z", "edit_history_tweet_ids": ["2115810308044284378"], "entities": {"urls": [{"display_url": "x.com/lymanstoneky/s…", "end": 258, "expanded_url": "https://twitter.com/lymanstoneky/status/2115808999945736701", "start": 235, "url": "https://t.co/NGIovOH9Ns"}]}, "id": "2115810308044284378", "public_metrics": {"bookmark_count": 1, "impression_count": 1605, "like_count": 32, "quote_count": 0, "reply_count": 4, "retweet_count": 0}, "referenced_tweets": [{"id": "2115808999945736701", "type": "quoted"}], "text": "the best argument for why car passenger mortality declined is not specific carseat interventions, but improved general culture of safety, leading to widespread adoption of numerous of road and car design features that reduced fatality https://t.co/NGIovOH9Ns", "url": "https://x.com/lymanstoneky/status/2115810308044284378"}, {"author_id": "626660983", "created_at": "2026-10-29T14:12:30.000Z", "edit_history_tweet_ids": ["2115808999945736701"], "entities": {"urls": [{"display_url": "pic.x.com/9Bz09ZB7sY", "end": 289, "expanded_url": "https://x.com/lymanstoneky/status/2115808999945736701/photo/1", "media_key": "3_2115808743749292032", "start": 266, "url": "https://t.co/9Bz09ZB7sY"}, {"display_url": "x.com/lymanstoneky/s…", "end": 313, "expanded_url": "https://twitter.com/lymanstoneky/status/2115796060966715493", "start": 290, "url": "https://t.co/TZnALGmyav"}]}, "id": "2115808999945736701", "public_metrics": {"bookmark_count": 46, "impression_count": 16881, "like_count": 234, "quote_count": 8, "reply_count": 12, "retweet_count": 29}, "referenced_tweets": [{"id": "2115796060966715493", "type": "quoted"}], "text": "here's you regular reminder that carseats have probably saved very few lives in aggregate vs. general improvements in road and care safety\n\ndespite massive increases in carseats for 0 &amp; 3 year olds since 1959, their mortality declines have been entirely typical https://t.co/9Bz09ZB7sY https://t.co/TZnALGmyav", "url": "https://x.com/lymanstoneky/status/2115808999945736701"}, {"author_id": "626660983", "created_at": "2026-10-29T13:46:09.000Z", "edit_history_tweet_ids": ["2115802371104313664"], "id": "2115802371104313664", "public_metrics": {"bookmark_count": 5, "impression_count": 3823, "like_count": 171, "quote_count": 0, "reply_count": 8, "retweet_count": 2}, "text": "the kids (3, 5, 6) cooked their own food over the campfire last night then slept outside in a tent without adult supervision. cooked their eggs in the campfire ashes this AM.\n\nwent great, going for round 2 tonight.\n\nyour kids can just do things.", "url": "https://x.com/lymanstoneky/status/2115802371104313664"}, {"author_id": "626660983", "created_at": "2026-10-29T13:21:05.000Z", "edit_history_tweet_ids": ["2115796060966715493"], "entities": {"urls": [{"display_url": "x.com/Philip_DT/stat…", "end": 119, "expanded_url": "https://twitter.com/Philip_DT/status/2115772691193938179", "start": 96, "url": "https://t.co/CUQxMcANWD"}]}, "id": "2115796060966715493", "public_metrics": {"bookmark_count": 11, "impression_count": 36404, "like_count": 579, "quote_count": 1, "reply_count": 20, "retweet_count": 6}, "referenced_tweets": [{"id": "2115772691193938179", "type": "quoted"}], "text": "i'm extremely confident a decline in car accident deaths of 19 year olds is not due to carseats https://t.co/CUQxMcANWD", "url": "https://x.com/lymanstoneky/status/2115796060966715493"}, {"author_id": "17217640", "created_at": "2026-10-29T11:48:42.000Z", "edit_history_tweet_ids": ["2115772815206912327"], "entities": {"urls": [{"display_url": "spaceflightnow.com/2026/10/28/nas…", "end": 271, "expanded_url": "https://spaceflightnow.com/2026/10/28/nasa-nears-end-of-space-station-solar-array-upgrade-with-oct-29-and-nov-5-spacewalks/", "images": [{"height": 452, "url": "https://pbs.twimg.com/news_img/2115611474089345026/Jqey8bdv?format=jpg&name=orig", "width": 678}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115611474089345026/Jqey8bdv?format=jpg&name=150x150", "width": 150}], "start": 248, "status": 200, "title": "NASA nears end of space station solar array upgrade with Oct. 29 and Nov. 5 spacewalks – Spaceflight Now", "unwound_url": "https://spaceflightnow.com/2026/10/28/nasa-nears-end-of-space-station-solar-array-upgrade-with-oct-29-and-nov-5-spacewalks/", "url": "https://t.co/eXvklIsd23"}, {"display_url": "pic.x.com/09PBJK1Qfi", "end": 295, "expanded_url": "https://x.com/SpaceflightNow/status/2115772815206912327/photo/1", "media_key": "3_2115772307582918656", "start": 272, "url": "https://t.co/09PBJK1Qfi"}]}, "id": "2115772815206912327", "public_metrics": {"bookmark_count": 0, "impression_count": 5602, "like_count": 54, "quote_count": 0, "reply_count": 5, "retweet_count": 9}, "text": "A spacewalk is about to get underway at the International Space Station. NASA astronaut Anil Menon and Canadian Space Agency astronaut Joshua Kutryk will install and unfurl the 7th of 8 International Space Station Roll-Out Solar Arrays, or IROSAs. https://t.co/eXvklIsd23 https://t.co/09PBJK1Qfi", "url": "https://x.com/SpaceflightNow/status/2115772815206912327"}, {"author_id": "21436960", "created_at": "2026-10-29T11:21:06.000Z", "edit_history_tweet_ids": ["2115765869196251319"], "entities": {"urls": [{"description": "On 27 October at Spaceport Norway in Oslo, the European Space Agency (ESA) signed new contracts with three Norwegian companies under ESA’s Navigation Innovation and Support Program (NAVISP). The projects follow a call for projects via NAVISP funding by the Norwegian Space Agency to support the development of resilient positioning, navigation and timing (PNT) solutions. ", "display_url": "esa.int/Applications/S…", "end": 257, "expanded_url": "https://esa.int/Applications/Satellite_navigation/NAVISP/ESA_and_Norway_pen_projects_for_resilient_satellite_navigation", "images": [{"height": 1282, "url": "https://pbs.twimg.com/news_img/2115765873579290624/7ZvhYt2H?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115765873579290624/7ZvhYt2H?format=jpg&name=150x150", "width": 150}], "start": 234, "status": 200, "title": "ESA and Norway pen projects for resilient satellite navigation", "unwound_url": "https://www.esa.int/Applications/Satellite_navigation/NAVISP/ESA_and_Norway_pen_projects_for_resilient_satellite_navigation", "url": "https://t.co/ul22HvYZAr"}, {"display_url": "pic.x.com/NqseR2KU42", "end": 281, "expanded_url": "https://x.com/esa/status/2115765869196251319/photo/1", "media_key": "3_2115730269596430337", "start": 258, "url": "https://t.co/NqseR2KU42"}]}, "id": "2115765869196251319", "public_metrics": {"bookmark_count": 7, "impression_count": 10651, "like_count": 83, "quote_count": 1, "reply_count": 17, "retweet_count": 15}, "text": "We’ve signed three new contracts in Norway to strengthen the resilience of satellite navigation. 🛰️🇳🇴\n\nThe projects focus on GNSS interference testing, maritime navigation and drones operating in challenging environments.\n\nRead more: https://t.co/ul22HvYZAr https://t.co/NqseR2KU42", "url": "https://x.com/esa/status/2115765869196251319"}, {"author_id": "11348282", "created_at": "2026-10-29T10:31:18.000Z", "edit_history_tweet_ids": ["2115753332958433574"], "entities": {"mentions": [{"end": 36, "id": "93714983", "start": 28, "username": "csa_asc"}, {"end": 112, "id": "1451773004", "start": 98, "username": "Space_Station"}], "urls": [{"description": "U.S. Spacewalk 100", "display_url": "x.com/i/broadcasts/1…", "end": 242, "expanded_url": "https://x.com/i/broadcasts/1rxmqpBDDpWxy", "images": [{"height": 2160, "url": "https://pbs.twimg.com/news_img/2115753252994326528/irLgEfig?format=jpg&name=orig", "width": 3840}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115753252994326528/irLgEfig?format=jpg&name=150x150", "width": 150}], "start": 219, "status": 200, "title": "NASA", "unwound_url": "https://x.com/i/broadcasts/1rxmqpBDDpWxy", "url": "https://t.co/xoJPYWty9Z"}]}, "id": "2115753332958433574", "public_metrics": {"bookmark_count": 166, "impression_count": 974007, "like_count": 2934, "quote_count": 79, "reply_count": 213, "retweet_count": 536}, "text": "LIVE: NASA's Anil Menon and @csa_asc's Joshua Kutryk are setting up a new solar array outside the @Space_Station. Today's spacewalk is scheduled to start around 8am ET (1200 UTC) and run for about six and a half hours. https://t.co/xoJPYWty9Z", "url": "https://x.com/NASA/status/2115753332958433574"}, {"author_id": "610659001", "created_at": "2026-10-29T09:53:17.000Z", "edit_history_tweet_ids": ["2115743768510886379"], "entities": {"urls": [{"display_url": "pic.x.com/BaAp2k3TXA", "end": 144, "expanded_url": "https://x.com/MaxCRoser/status/2115743768510886379/photo/1", "media_key": "3_2115741650773225472", "start": 121, "url": "https://t.co/BaAp2k3TXA"}]}, "id": "2115743768510886379", "public_metrics": {"bookmark_count": 579, "impression_count": 116930, "like_count": 1461, "quote_count": 89, "reply_count": 56, "retweet_count": 383}, "text": "What is life like at different levels of GDP per capita?\n\nIn this new chart I visualised it for 12 different dimensions. https://t.co/BaAp2k3TXA", "url": "https://x.com/MaxCRoser/