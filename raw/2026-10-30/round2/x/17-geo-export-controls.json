{"data": [{"author_id": "1659101737767034880", "created_at": "2026-10-29T03:47:03.000Z", "edit_history_tweet_ids": ["2115651600450806065"], "id": "2115651600450806065", "public_metrics": {"bookmark_count": 0, "impression_count": 54, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia intercepted $12.2 million shipment of servers with AI chips suspected of violating export controls.", "url": "https://x.com/TiqNew/status/2115651600450806065"}, {"author_id": "27454144", "created_at": "2026-10-29T07:25:12.000Z", "edit_history_tweet_ids": ["2115706500014305365"], "entities": {"urls": [{"description": "Malaysia introduced permit requirements for shipping AI chips of U.S. origin last year, under pressure from the U.S. to prevent rerouting to China", "display_url": "fortune.com/2026/10/28/mal…", "end": 131, "expanded_url": "https://fortune.com/2026/10/28/malaysia-intercepted-ai-chips-shipment-export-controls-china/", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115706501520093184/EtlZ-d_3?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115706501520093184/EtlZ-d_3?format=jpg&name=150x150", "width": 150}], "start": 108, "status": 200, "title": "Malaysia intercepted $12.2 million shipment of servers with AI chips suspected of violating export controls | Fortune", "unwound_url": "https://fortune.com/2026/10/28/malaysia-intercepted-ai-chips-shipment-export-controls-china/", "url": "https://t.co/9FFEv1o8IR"}]}, "id": "2115706500014305365", "public_metrics": {"bookmark_count": 0, "impression_count": 35, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia intercepted $12.2 million shipment of servers with AI chips suspected of violating export controls https://t.co/9FFEv1o8IR", "url": "https://x.com/arnaudmercier/status/2115706500014305365"}, {"author_id": "109228180", "created_at": "2026-10-28T08:07:24.000Z", "edit_history_tweet_ids": ["2115354731812213092"], "entities": {"urls": [{"display_url": "x.com/rozlatiff/stat…", "end": 191, "expanded_url": "https://twitter.com/rozlatiff/status/2115319292690599993", "start": 168, "url": "https://t.co/USbFrej2UM"}]}, "id": "2115354731812213092", "public_metrics": {"bookmark_count": 0, "impression_count": 607, "like_count": 9, "quote_count": 0, "reply_count": 1, "retweet_count": 5}, "referenced_tweets": [{"id": "2115319292690599993", "type": "quoted"}], "text": "Malaysia imposed export controls last year on the movement of advanced AI chips of US origin, following pressure from the United States to stem their flow ⁠into China. https://t.co/USbFrej2UM", "url": "https://x.com/yinshaoloong/status/2115354731812213092"}, {"author_id": "2110460342409039872", "created_at": "2026-10-28T20:01:06.000Z", "edit_history_tweet_ids": ["2115534340020916338"], "entities": {"hashtags": [{"end": 162, "start": 159, "tag": "AI"}, {"end": 175, "start": 163, "tag": "Geopolitics"}]}, "id": "2115534340020916338", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Advanced chips and AI compute are now treated as strategic assets on par with oil. Export controls on both sides are rewriting the rules of power competition. #AI #Geopolitics", "url": "https://x.com/ram_2157/status/2115534340020916338"}, {"author_id": "2114053441836244992", "created_at": "2026-10-29T15:24:12.000Z", "edit_history_tweet_ids": ["2115827043594039330"], "entities": {"urls": [{"display_url": "pic.x.com/nJYlbjghe3", "end": 223, "expanded_url": "https://x.com/trusencecom/status/2115827043594039330/photo/1", "media_key": "3_2115827040817418240", "start": 200, "url": "https://t.co/nJYlbjghe3"}]}, "id": "2115827043594039330", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia seizes $12 million in AI chips hidden inside 30 servers\n\nThe case points to a transit network, and Malaysia has since tightened export controls on US-origin AI chips at Washington's request. https://t.co/nJYlbjghe3", "url": "https://x.com/trusencecom/status/2115827043594039330"}, {"author_id": "1819467740744503297", "created_at": "2026-10-29T14:05:34.000Z", "edit_history_tweet_ids": ["2115807256264745272"], "id": "2115807256264745272", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia customs seizes 30 servers packed with advanced AI chips worth $12.1M at Kuala Lumpur airport. The chips move like contraband because they basically are. Export controls built a smuggling economy faster than anyone built supply.", "url": "https://x.com/FloRyRy410/status/2115807256264745272"}, {"author_id": "1816175349778243584", "created_at": "2026-10-28T16:50:14.000Z", "edit_history_tweet_ids": ["2115486310198632531"], "id": "2115486310198632531", "public_metrics": {"bookmark_count": 0, "impression_count": 49, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia intercepted $12.2 million shipment of servers with AI chips suspected of violating export controls\n\nMalaysia’s customs department said it had seized 30 servers equipped with advanced artificial intelligence chips in a suspected export-control violation.", "url": "https://x.com/Ishant23April/status/2115486310198632531"}, {"author_id": "895022610857299968", "created_at": "2026-10-29T18:00:33.000Z", "edit_history_tweet_ids": ["2115866391437815906"], "id": "2115866391437815906", "public_metrics": {"bookmark_count": 0, "impression_count": 296, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysian customs seized servers with AI chips at Kuala Lumpur airport. Officials say they were in transit to another Asian country without a permit. Under US pressure, Malaysia brought in export controls on advanced US AI chips last year to stop them from reaching China.", "url": "https://x.com/greatgamemaps/status/2115866391437815906"}, {"author_id": "236482065", "created_at": "2026-10-29T14:46:47.000Z", "edit_history_tweet_ids": ["2115817627935191404"], "entities": {"hashtags": [{"end": 217, "start": 214, "tag": "AI"}, {"end": 226, "start": 218, "tag": "AIChips"}, {"end": 242, "start": 227, "tag": "ExportControls"}, {"end": 252, "start": 243, "tag": "Malaysia"}, {"end": 261, "start": 253, "tag": "ChipWar"}, {"end": 266, "start": 262, "tag": "GPU"}, {"end": 273, "start": 267, "tag": "Chips"}, {"end": 279, "start": 274, "tag": "Tech"}], "urls": [{"display_url": "pic.x.com/urVG2zeRAn", "end": 303, "expanded_url": "https://x.com/SparkyMark96/status/2115817627935191404/photo/1", "media_key": "3_2115817625255055360", "start": 280, "url": "https://t.co/urVG2zeRAn"}]}, "id": "2115817627935191404", "public_metrics": {"bookmark_count": 0, "impression_count": 42, "like_count": 2, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "AI: Malaysia seized 30 servers of advanced AI chips (~$12.1M) at KLIA, declared as \"electronic components.\" 5th case tied to one syndicate this year.\n\nSources: Malay Mail, CNA, FMT\n\nCan export controls stop this?\n\n#AI #AIChips #ExportControls #Malaysia #ChipWar #GPU #Chips #Tech https://t.co/urVG2zeRAn", "url": "https://x.com/SparkyMark96/status/2115817627935191404"}, {"author_id": "1924330034535493632", "created_at": "2026-10-29T17:52:00.000Z", "edit_history_tweet_ids": ["2115864239558767097"], "id": "2115864239558767097", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysian customs seized ~$12.1M of advanced AI chips this month, Reuters reports: 30 server units found Oct 15 at Kuala Lumpur airport, falsely declared as electronic components. Export controls are now being enforced at the departure gate.", "url": "https://x.com/Novaris12138/status/2115864239558767097"}, {"author_id": "1900579469544628224", "created_at": "2026-10-28T16:20:02.000Z", "edit_history_tweet_ids": ["2115478710073909427"], "entities": {"urls": [{"display_url": "x.com/HindooMolotov/…", "end": 301, "expanded_url": "https://twitter.com/HindooMolotov/status/2115452153934577939", "start": 278, "url": "https://t.co/a9cRRSgz6f"}]}, "id": "2115478710073909427", "public_metrics": {"bookmark_count": 2, "impression_count": 1424, "like_count": 10, "quote_count": 1, "reply_count": 1, "retweet_count": 2}, "referenced_tweets": [{"id": "2115452153934577939", "type": "quoted"}], "text": "When US export controls blocked access to toptier Nvidia chips, China did not wait for diplomatic negotiations and the state threw its entire weight behind Huawei and SMIC.\nSMIC was forced to use DUV lithography machines to manufacture 7nm AI chips (like the Huawei Ascend 910B https://t.co/a9cRRSgz6f", "url": "https://x.com/HindooMolotov/status/2115478710073909427"}, {"author_id": "1014339553438531584", "created_at": "2026-10-28T15:55:25.000Z", "edit_history_tweet_ids": ["2115472512117260558"], "entities": {"hashtags": [{"end": 189, "start": 174, "tag": "ExportControls"}, {"end": 198, "start": 190, "tag": "AIChips"}], "urls": [{"display_url": "pic.x.com/UdSCPRw2At", "end": 222, "expanded_url": "https://x.com/GPLPCN/status/2115472512117260558/photo/1", "media_key": "3_2115472504596865024", "start": 199, "url": "https://t.co/UdSCPRw2At"}]}, "id": "2115472512117260558", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "🚨 Malaysian customs found $12.1 million of advanced AI chips inside 30 server chassis at Kuala Lumpur's airport. Export controls made silicon the best smuggled good in Asia. #ExportControls #AIChips https://t.co/UdSCPRw2At", "url": "https://x.com/GPLPCN/status/2115472512117260558"}, {"author_id": "178891512", "created_at": "2026-10-29T13:20:17.000Z", "edit_history_tweet_ids": ["2115795860898586634"], "id": "2115795860898586634", "public_metrics": {"bookmark_count": 0, "impression_count": 70, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia just seized $12 million of advanced AI chips at Kuala Lumpur airport - servers falsely declared as electronic components and routed through the free trade zone to dodge chip export controls. The controls now have a smuggling economy.", "url": "https://x.com/Sureshsinghn/status/2115795860898586634"}, {"author_id": "2047623249333559296", "created_at": "2026-10-29T08:17:11.000Z", "edit_history_tweet_ids": ["2115719583269257588"], "entities": {"hashtags": [{"end": 210, "start": 204, "tag": "Chips"}, {"end": 226, "start": 211, "tag": "Semiconductors"}, {"end": 236, "start": 227, "tag": "TradeWar"}, {"end": 245, "start": 237, "tag": "Markets"}, {"end": 249, "start": 246, "tag": "AI"}], "urls": [{"display_url": "pic.x.com/A5RviCtozx", "end": 273, "expanded_url": "https://x.com/BlueTearsPT/status/2115719583269257588/photo/1", "media_key": "3_2115719250505818112", "start": 250, "url": "https://t.co/A5RviCtozx"}]}, "id": "2115719583269257588", "public_metrics": {"bookmark_count": 0, "impression_count": 46, "like_count": 1, "quote_count": 0, "reply_count": 3, "retweet_count": 0}, "text": "US export controls just widened again — more Chinese firms on the list.Every restriction is a recruiting poster for China's chip self-sufficiency. Who actually wins a trade war fought with semiconductors?#Chips #Semiconductors #TradeWar #Markets #AI https://t.co/A5RviCtozx", "url": "https://x.com/BlueTearsPT/status/2115719583269257588"}, {"author_id": "1901475106536210432", "created_at": "2026-10-28T12:10:05.000Z", "edit_history_tweet_ids": ["2115415806100287626"], "id": "2115415806100287626", "public_metrics": {"bookmark_count": 0, "impression_count": 30, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia just seized $12.1 million in AI chips at its main airport. 30 servers were declared as plain electronic parts, but customs says they hid advanced AI chips meant to move on to another country. If chips are this hard to track, can export controls ever really work?", "url": "https://x.com/MrClicker_1/status/2115415806100287626"}, {"author_id": "195620273", "created_at": "2026-10-28T13:17:30.000Z", "edit_history_tweet_ids": ["2115432770570998234"], "entities": {"urls": [{"description": "Rozanna Latiff / Reuters: Malaysia says it seized ~$12.11M worth of AI chips this month, as authorities close in on a syndicate suspected of smuggling through the country's main airport", "display_url": "techmeme.com/261028/p14#a26…", "end": 248, "expanded_url": "https://www.techmeme.com/261028/p14#a261028p14", "images": [{"height": 1005, "url": "https://pbs.twimg.com/news_img/2115432773242761216/BBGvEHZW?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115432773242761216/BBGvEHZW?format=jpg&name=150x150", "width": 150}], "start": 225, "status": 200, "title": "Malaysia says it seized ~$12.11M worth of AI chips this month, as authorities close in on a syndicate suspected of smuggling through the country's main airport", "unwound_url": "https://www.techmeme.com/261028/p14#a261028p14", "url": "https://t.co/HSOW6f1QNp"}]}, "id": "2115432770570998234", "public_metrics": {"bookmark_count": 0, "impression_count": 22, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "Malaysia seized $12.11M in AI chips this month at its main airport, closing in on a smuggling syndicate. Demand this strong doesn't stay inside the lines — export controls are now the real constraint on the GPU supply chain. https://t.co/HSOW6f1QNp", "url": "https://x.com/DanteMMartin/status/2115432770570998234"}, {"author_id": "2073779288764014592", "created_at": "2026-10-28T11:00:21.000Z", "edit_history_tweet_ids": ["2115398255848702070"], "id": "2115398255848702070", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "$12M in AI chips seized in Malaysia reveal how export controls shape global hardware flows—and what that means for developers downstream. The cracks in supply chains aren’t accidental. We map the gaps and their real-world impact.", "url": "https://x.com/readgradient/status/2115398255848702070"}, {"author_id": "1598569606519861248", "created_at": "2026-10-28T07:00:22.000Z", "edit_history_tweet_ids": ["2115337865001681124"], "entities": {"hashtags": [{"end": 234, "start": 231, "tag": "AI"}]}, "id": "2115337865001681124", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia seized $12.1m in AI chips — 30 servers falsely declared as electronic parts. I don't buy that export controls are failing; I think they're just forcing the trade underground, where it's harder to track and easier to deny. #AI", "url": "https://x.com/RajaGlamorous/status/2115337865001681124"}, {"author_id": "974666113", "created_at": "2026-10-28T09:11:51.000Z", "edit_history_tweet_ids": ["2115370952192036978"], "entities": {"hashtags": [{"end": 264, "start": 253, "tag": "traphabits"}, {"end": 272, "start": 265, "tag": "aitosi"}]}, "id": "2115370952192036978", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia seized $12.1M in AI chips at KL airport — 30 servers falsely declared as parts, bound for re-export. Problem: export controls get dodged. Fix: tighter screening + permits. BOTTOM LINE: the chip war runs through customs now. — B Grizzle BG-0101 #traphabits #aitosi", "url": "https://x.com/traphabits101/status/2115370952192036978"}, {"author_id": "2415399587", "created_at": "2026-10-29T17:48:26.000Z", "edit_history_tweet_ids": ["2115863342698897494"], "entities": {"urls": [{"display_url": "x.com/cnbc/status/21…", "end": 292, "expanded_url": "https://twitter.com/cnbc/status/2115836709954814097", "start": 269, "url": "https://t.co/LPzxK9NSFH"}]}, "id": "2115863342698897494", "public_metrics": {"bookmark_count": 0, "impression_count": 81, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2115836709954814097", "type": "quoted"}], "text": "Before the NYT espionage allegations, the U.S. Commerce Dept was already investigating Megaspeed for allegedly helping Chinese firms bypass export controls to get Nvidia AI chips. Even as U.S. spy agencies tracked Alice Huang, they never warned Jensen Huang or Taiwan. https://t.co/LPzxK9NSFH", "url": "https://x.com/teshen8lin/status/2115863342698897494"}, {"author_id": "1404099729525559301", "created_at": "2026-10-28T20:30:24.000Z", "edit_history_tweet_ids": ["2115541715792601275"], "entities": {"urls": [{"display_url": "pic.x.com/tg2uIH8HSg", "end": 256, "expanded_url": "https://x.com/Chahatusharma/status/2115541715792601275/photo/1", "media_key": "3_2115541402880712705", "start": 233, "url": "https://t.co/tg2uIH8HSg"}]}, "id": "2115541715792601275", "public_metrics": {"bookmark_count": 0, "impression_count": 37, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Reuters: Malaysia seized about $12.1 million of advanced AI chips at its main airport.\n\nCustoms says 30 servers were falsely declared as electronic components, in at least five linked cases.\n\nCan export controls stop chip smuggling? https://t.co/tg2uIH8HSg", "url": "https://x.com/Chahatusharma/status/2115541715792601275"}, {"author_id": "1626696833673187345", "created_at": "2026-10-28T13:58:02.000Z", "edit_history_tweet_ids": ["2115442972472770573"], "entities": {"hashtags": [{"end": 267, "start": 264, "tag": "AI"}, {"end": 274, "start": 268, "tag": "chips"}]}, "id": "2115442972472770573", "public_metrics": {"bookmark_count": 0, "impression_count": 45, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Malaysia is apparently now #3 for AI chip arrivals, right after the US and China\n\nalso Malaysia today: customs seizes $12.1M of AI servers at KL airport, declared as basic electronics 👀\n\nexport controls are starting to look like whack-a-mole. can they even work?\n\n#AI #chips", "url": "https://x.com/MarkockiAdam/status/2115442972472770573"}, {"author_id": "137255482", "created_at": "2026-10-29T01:31:04.000Z", "edit_history_tweet_ids": ["2115617380307198422"], "entities": {"hashtags": [{"end": 38, "start": 29, "tag": "HongKong"}, {"end": 52, "start": 43, "tag": "mainland"}], "mentions": [{"end": 26, "id": "25053299", "start": 10, "username": "FortuneMagazine"}]}, "id": "2115617380307198422", "public_metrics": {"bookmark_count": 1, "impression_count": 497, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Views for @FortuneMagazine: “#HongKong and #mainland markets barely budged because they sit outside the main U.S. AI supply chain. Export controls keep the most advanced chips out of Chinese hands, while users can already turn to cheaper domestic models from the likes of", "url": "https://x.com/Aligarciaherrer/status/2115617380307198422"}, {"author_id": "2046164287412920321", "created_at": "2026-10-29T03:26:53.000Z", "edit_history_tweet_ids": ["2115646525716271604"], "entities": {"hashtags": [{"end": 272, "start": 269, "tag": "AI"}, {"end": 279, "start": 273, "tag": "China"}], "urls": [{"display_url": "pic.x.com/37pM0JjYAz", "end": 303, "expanded_url": "https://x.com/Connected4Power/status/2115646525716271604/photo/1", "media_key": "3_2115646385324171265", "start": 280, "url": "https://t.co/37pM0JjYAz"}]}, "id": "2115646525716271604", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "The Information: DeepSeek and Moonshot trained their October models heavily on OpenAI's GPT-6 Astra outputs.\n\nThe labs switched targets after Anthropic tightened its guard. Export controls stop chips at the border. They don't stop answers.\n\nWho builds the next fence?\n\n#AI #China https://t.co/37pM0JjYAz", "url": "https://x.com/Connected4Power/status/2115646525716271604"}, {"author_id": "1377038774568292352", "created_at": "2026-10-29T02:17:35.000Z", "edit_history_tweet_ids": ["2115629086349595127"], "id": "2115629086349595127", "public_metrics": {"bookmark_count": 0, "impression_count": 24, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "AI chips are becoming a strategic asset — and a geopolitical flashpoint.\n\nMalaysia reportedly seized servers containing advanced AI chips suspected of violating export controls. The case highlights how difficult it is to monitor high-value technology as it moves across borders.", "url": "https://x.com/Han_WorldBrief/status/2115629086349595127"}], "includes": {"users": [{"id": "1659101737767034880", "name": "NewTiQ", "username": "TiqNew"}, {"id": "27454144", "name": "Arnaud Mercier - #Entrepreneur #Versailles", "username": "arnaudmercier"}, {"id": "109228180", "name": "Yin Shao Loong", "username": "yinshaoloong"}, {"id": "2110460342409039872", "name": "Ram", "username": "ram_2157"}, {"id": "2114053441836244992", "name": "Trusence", "username": "trusencecom"}, {"id": "1819467740744503297", "name": "Ryan", "username": "FloRyRy410"}, {"id": "1816175349778243584", "name": "Ishant", "username": "Ishant23April"}, {"id": "895022610857299968", "name": "The Great Game Maps", "username": "greatgamemaps"}, {"id": "236482065", "name": "Mark", "username": "SparkyMark96"}, {"id": "1924330034535493632", "name": "Novaris", "username": "Novaris12138"}, {"id": "1900579469544628224", "name": "Commissar of The Council of Kalinga", "username": "HindooMolotov"}, {"id": "1014339553438531584", "name": "GPLP", "username": "GPLPCN"}, {"id": "178891512", "nam