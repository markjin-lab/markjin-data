, "public_metrics": {"bookmark_count": 5, "impression_count": 17425, "like_count": 68, "quote_count": 0, "reply_count": 4, "retweet_count": 3}, "text": "Congrats to @Emily_Sundberg on 4 incredible years at Feed Me and also thank you for spotlighting our fight to save the workout bars at Tompkins Square https://t.co/HP2X7ZfJJm https://t.co/dlv1rTbs33", "url": "https://x.com/TheStalwart/status/2114816037531074764"}, {"author_id": "30034124", "created_at": "2026-10-26T20:10:25.000Z", "edit_history_tweet_ids": ["2114811909518016560"], "entities": {"urls": [{"display_url": "pic.x.com/20dQRTbtln", "end": 224, "expanded_url": "https://x.com/Fermilab/status/2114811909518016560/video/1", "media_key": "7_2114811814567366656", "start": 201, "url": "https://t.co/20dQRTbtln"}]}, "id": "2114811909518016560", "public_metrics": {"bookmark_count": 5, "impression_count": 1692, "like_count": 33, "quote_count": 0, "reply_count": 1, "retweet_count": 8}, "text": "Fermilab is leveraging super intelligence, also known as AI, to accelerate chip design. These efforts drive innovation in industries such as space exploration, medical imaging and autonomous vehicles. https://t.co/20dQRTbtln", "url": "https://x.com/Fermilab/status/2114811909518016560"}, {"author_id": "702235316812275712", "created_at": "2026-10-26T19:44:27.000Z", "edit_history_tweet_ids": ["2114805377158246588"], "entities": {"mentions": [{"end": 15, "id": "2323172244", "start": 7, "username": "tmahedy"}], "urls": [{"description": "Wednesday, 10/28, 1:00 pm Pacific. Guy & Tim discuss the October FOMC decision, where inflation is heading, and whether the Fed is poised for a mistake.", "display_url": "accessmacro.substack.com/p/livestream-e…", "end": 111, "expanded_url": "https://accessmacro.substack.com/p/livestream-event-oct-26-fomc-drilling?r=2wn1yx&utm_campaign=post-expanded-share&utm_medium=web", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2114805379406471168/8D737TKc?format=jpg&name=orig", "width": 1600