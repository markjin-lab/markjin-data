s": {"bookmark_count": 0, "impression_count": 2536, "like_count": 21, "quote_count": 1, "reply_count": 2, "retweet_count": 4}, "referenced_tweets": [{"id": "2114756932061774234", "type": "quoted"}], "text": "BREAKING $AMD | $TSM CoWoS advanced packaging prices are reportedly set to rise by up to 20% amid tight capacity driven by surging AI demand.\n\nZhang Jiarui in Taiwan’s Commercial Times, reports that TSMC is preparing another round of CoWoS (Chip-on-Wafer-on-Substrate) price https://t.co/zK6NIHdibc https://t.co/xDsZskcFk3", "url": "https://x.com/MikeLongTerm/status/2114862712672882949"}, {"author_id": "2112143643108671488", "created_at": "2026-10-27T09:15:55.000Z", "edit_history_tweet_ids": ["2115009587652743398"], "entities": {"cashtags": [{"end": 119, "start": 114, "tag": "NVDA"}, {"end": 204, "start": 199, "tag": "SNPS"}, {"end": 214, "start": 209, "tag": "CDNS"}], "urls": [{"display_url": "pic.x.com/F5JL0phriN", "end": 294, "expanded_url": "https://x.com/OrangeOpHq/status/2115009587652743398/photo/1", "media_key": "3_2115009521764442112", "start": 271, "url": "https://t.co/F5JL0phriN"}]}, "id": "2115009587652743398", "public_metrics": {"bookmark_count": 0, "impression_count": 74, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "The AI chip supply chain has 8 layers. Each one below is tied to a company's own filing or page.\n\n1. Chip design: $NVDA says it is fabless and uses partners for manufacturing.\n2. Design tools (EDA): $SNPS and $CDNS sell software, hardware and IP used to design chips.\n3. https://t.co/F5JL0phriN", "url": "https://x.com/OrangeOpHq/status/2115009587652743398"}, {"author_id": "785856172209373184", "created_at": "2026-10-27T07:53:08.000Z", "edit_history_tweet_ids": ["2114988753416515725"], "entities": {"urls": [{"display_url": "pic.x.com/Iz19Ui0CUe", "end": 299, "expanded_url": "https://x.com/Rutowi_/status/2114988753416515725/photo/1", "media_key": "3_2114988750128193536", "start": 276, "url": "https: