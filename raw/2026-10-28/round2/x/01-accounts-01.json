uthor_id": "1745106082790318080", "created_at": "2026-10-27T00:07:52.000Z", "edit_history_tweet_ids": ["2114871665825857735"], "entities": {"urls": [{"display_url": "pic.x.com/0lTjbWyUcw", "end": 302, "expanded_url": "https://x.com/SemiAnalysis_/status/2114871665825857735/photo/1", "media_key": "3_2114871663657402368", "start": 279, "url": "https://t.co/0lTjbWyUcw"}]}, "id": "2114871665825857735", "public_metrics": {"bookmark_count": 15, "impression_count": 29347, "like_count": 71, "quote_count": 6, "reply_count": 21, "retweet_count": 4}, "text": "Alibaba's Panjiu 128 is not a true rack scale up. Panjiu 128 is made up of two 64 scale up size systems with ALink switch cartridges in the back. Alibaba's own architecture write-up says a single 128 domain would need 128-port switch chips, and the ICN Switch 1.0 is a 25.6 Tbps https://t.co/0lTjbWyUcw", "url": "https://x.com/SemiAnalysis_/status/2114871665825857735"}, {"author_id": "1745106082790318080", "created_at": "2026-10-26T18:48:43.000Z", "edit_history_tweet_ids": ["2114791350461710835"], "entities": {"urls": [{"display_url": "pic.x.com/OkNUnaCZCm", "end": 23, "expanded_url": "https://x.com/SemiAnalysis_/status/2114791350461710835/photo/1", "media_key": "3_2114791347693465601", "start": 0, "url": "https://t.co/OkNUnaCZCm"}]}, "id": "2114791350461710835", "public_metrics": {"bookmark_count": 181, "impression_count": 113730, "like_count": 2580, "quote_count": 14, "reply_count": 36, "retweet_count": 86}, "text": "https://t.co/OkNUnaCZCm", "url": "https://x.com/SemiAnalysis_/status/2114791350461710835"}, {"author_id": "4398626122", "created_at": "2026-10-26T18:06:27.000Z", "edit_history_tweet_ids": ["2114780711664398349"], "entities": {"urls": [{"display_url": "pic.x.com/8JTN1yonmV", "end": 280, "expanded_url": "https://x.com/OpenAI/status/2114780711664398349/video/1", "media_key": "13_2114778494395678720", "start": 257, "url": "https://t.co/8JTN1yonmV"}]}, "id": "2114780711664398349", "public_metrics": {"bookmark_count": 4153, "impression_count": 5368973, "like_count": 26863, "quote_count": 2141, "reply_count": 1526, "retweet_count": 2370}, "text": "GPT-6.1 Terra: delivering fast and capable computer use at a lower price.\n\nGPT-6.1 Terra understands what’s on screen, takes action across apps, writes naturally, and is a more capable model for your whole workday with the efficiency to take on more of it. https://t.co/8JTN1yonmV", "url": "https://x.com/OpenAI/status/2114780711664398349"}, {"author_id": "1745106082790318080", "created_at": "2026-10-26T18:01:02.000Z", "edit_history_tweet_ids": ["2114779348838338719"], "entities": {"urls": [{"display_url": "pic.x.com/G9liiKmGvh", "end": 190, "expanded_url": "https://x.com/SemiAnalysis_/status/2114779348838338719/photo/1", "media_key": "3_2114779345944293376", "start": 167, "url": "https://t.co/G9liiKmGvh"}]}, "id": "2114779348838338719", "public_metrics": {"bookmark_count": 43, "impression_count": 32909, "like_count": 102, "quote_count": 1, "reply_count": 11, "retweet_count": 7}, "text": "Congrats to the SGLang and RadixArk team for their amazing work on MegaKernel + PD, improving both high concurrency throughput and low-latency serving as well! (1/2)🧵 https://t.co/G9liiKmGvh", "url": "https://x.com/SemiAnalysis_/status/2114779348838338719"}, {"author_id": "2939913921", "created_at": "2026-10-26T17:50:21.000Z", "edit_history_tweet_ids": ["2114776660344246735"], "id": "2114776660344246735", "public_metrics": {"bookmark_count": 125, "impression_count": 48545, "like_count": 904, "quote_count": 7, "reply_count": 53, "retweet_count": 50}, "text": "This weird qwen behavior is going to go viral because no one has read traces from mid-tier open models and realized they're almost all super janky.", "url": "https://x.com/natolambert/status/2114776660344246735"}, {"author_id": "2939913921", "created_at": "2026-10-26T17:27:06.000Z", "edit_history_tweet_ids": ["2114770812058186077"], "entities": {"urls": [{"display_url": "x.com/cohere/status/…", "