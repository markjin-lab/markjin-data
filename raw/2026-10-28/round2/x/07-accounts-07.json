{"data": [{"author_id": "626660983", "created_at": "2026-10-27T21:10:50.000Z", "edit_history_tweet_ids": ["2115189504126451848"], "id": "2115189504126451848", "public_metrics": {"bookmark_count": 0, "impression_count": 1101, "like_count": 15, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2115184857391505458", "type": "quoted"}], "text": "also worth noting the reason it came to authorities' attention is the 9 year old got a dumbell dropped on his head so the 14 year old called 911 and the kid was taken to the hospital and the first responders were like \"uh, wait, what?\" https://t.co/N3EfoEWEBo", "url": "https://x.com/lymanstoneky/status/2115189504126451848"}, {"author_id": "626660983", "created_at": "2026-10-27T21:07:25.000Z", "edit_history_tweet_ids": ["2115188642331107799"], "id": "2115188642331107799", "public_metrics": {"bookmark_count": 0, "impression_count": 617, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "i resent that locally running a stable diffusion model make laptop go slow", "url": "https://x.com/lymanstoneky/status/2115188642331107799"}, {"author_id": "626660983", "created_at": "2026-10-27T21:04:04.000Z", "edit_history_tweet_ids": ["2115187801524162778"], "id": "2115187801524162778", "public_metrics": {"bookmark_count": 4, "impression_count": 1887, "like_count": 49, "quote_count": 1, "reply_count": 3, "retweet_count": 2}, "referenced_tweets": [{"id": "2115177198680477911", "type": "quoted"}], "text": "the reason Caesar brought legions across the Rubicon is that imprisonment (and worse) of defeated political rivals had become normal\n\nnow, we can question the choices that led to Caesar rising-- but cycles of judicial retaliation end only one way https://t.co/yChwnJnA75", "url": "https://x.com/lymanstoneky/status/2115187801524162778"}, {"author_id": "626660983", "created_at": "2026-10-27T20:44:42.000Z", "edit_history_tweet_ids": ["2115182927890026759"], "id": "2115182927890026759", "public_metrics": {"bookmark_count": 0, "impression_count": 897, "like_count": 14, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "referenced_tweets": [{"id": "2115177224651276687", "type": "quoted"}], "text": "*chef kiss* https://t.co/V9vK9pMVNA", "url": "https://x.com/lymanstoneky/status/2115182927890026759"}, {"author_id": "626660983", "created_at": "2026-10-27T20:26:18.000Z", "edit_history_tweet_ids": ["2115178294408782178"], "id": "2115178294408782178", "public_metrics": {"bookmark_count": 0, "impression_count": 1249, "like_count": 29, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2115156552067723373", "type": "quoted"}], "text": "all right i'm ready to say it\n\nputin is clearly a Paradox mapgamer\n\nprove me wrong https://t.co/mTpUJ4mma1", "url": "https://x.com/lymanstoneky/status/2115178294408782178"}, {"author_id": "626660983", "created_at": "2026-10-27T19:47:11.000Z", "edit_history_tweet_ids": ["2115168450133766324"], "id": "2115168450133766324", "public_metrics": {"bookmark_count": 0, "impression_count": 938, "like_count": 7, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2115166754855096407", "type": "quoted"}], "text": "FIVE HUNDRED NEW EASTERN MED SAMPLES!!! https://t.co/nL6wHKPleV", "url": "https://x.com/lymanstoneky/status/2115168450133766324"}, {"author_id": "626660983", "created_at": "2026-10-27T19:14:27.000Z", "edit_history_tweet_ids": ["2115160214102016475"], "id": "2115160214102016475", "public_metrics": {"bookmark_count": 0, "impression_count": 2065, "like_count": 27, "quote_count": 0, "reply_count": 6, "retweet_count": 0}, "referenced_tweets": [{"id": "2115156475374895315", "type": "quoted"}], "text": "IT'S A WONDERFUL RESTAURANT https://t.co/M6FYlCHnvQ", "url": "https://x.com/lymanstoneky/status/2115160214102016475"}, {"author_id": "626660983", "created_at": "2026-10-27T18:46:17.000Z", "edit_history_tweet_ids": ["2115153124361171058"], "id": "2115153124361171058", "public_metrics": {"bookmark_count": 3, "impression_count": 1429, "like_count": 14, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2114922564527206570", "type": "quoted"}], "text": "yeah but neolocality and weakened kinship were not actually that important parts of why Europe got rich nor why, extremely suddenly in the 19th and 20th centuries, representative democracy won the upper hand\n\nit's just a made up story https://t.co/TKRqoe9SbY", "url": "https://x.com/lymanstoneky/status/2115153124361171058"}, {"author_id": "46648807", "created_at": "2026-10-27T18:45:04.000Z", "edit_history_tweet_ids": ["2115152818864529861"], "id": "2115152818864529861", "public_metrics": {"bookmark_count": 1, "impression_count": 1036, "like_count": 12, "quote_count": 0, "reply_count": 0, "retweet_count": 3}, "text": "NIST’s new PQC migration guidelines can help organizations transition to post-quantum cryptography standards. This report outlines the timelines and activities for federal agencies and serves as a resource for organizations navigating the transition. \n🔗 https://t.co/aKPAjfVGDZ https://t.co/do17lOkxAA", "url": "https://x.com/NIST/status/2115152818864529861"}, {"author_id": "11348282", "created_at": "2026-10-27T17:12:07.000Z", "edit_history_tweet_ids": ["2115129428158087498"], "id": "2115129428158087498", "public_metrics": {"bookmark_count": 39, "impression_count": 357353, "like_count": 1036, "quote_count": 9, "reply_count": 99, "retweet_count": 136}, "text": "Are you stepping into a spacesuit this week? So are @astro_anil and @astro_kutryk — but not for Halloween!\n\nTune in here on Oct. 29 at 6:30am ET (1030 UTC) to watch these two astronauts deploy a new solar array on the @Space_Station. https://t.co/T33BGuaR8Y", "url": "https://x.com/NASA/status/2115129428158087498"}, {"author_id": "626660983", "created_at": "2026-10-27T16:53:13.000Z", "edit_history_tweet_ids": ["2115124671448240232"], "id": "2115124671448240232", "public_metrics": {"bookmark_count": 1, "impression_count": 1563, "like_count": 17, "quote_count": 0, "reply_count": 1, "retweet_count": 2}, "referenced_tweets": [{"id": "2115124112687313406", "type": "quoted"}], "text": "we can just know things https://t.co/4QY7HnFHoi", "url": "https://x.com/lymanstoneky/status/2115124671448240232"}, {"author_id": "17217640", "created_at": "2026-10-27T14:27:51.000Z", "edit_history_tweet_ids": ["2115088090637193477"], "id": "2115088090637193477", "public_metrics": {"bookmark_count": 6, "impression_count": 7504, "like_count": 39, "quote_count": 0, "reply_count": 5, "retweet_count": 5}, "text": "Back again for the second day of the @astrosociety von Braun Space Exploration Symposium. The first panel of the day is focusing on how to provide power for the Moon Base. Follow this thread for updates. 🧵1/n\n\n📸: @w_robinsonsmith https://t.co/lN1Rldik1b", "url": "https://x.com/SpaceflightNow/status/2115088090637193477"}, {"author_id": "21436960", "created_at": "2026-10-27T14:21:15.000Z", "edit_history_tweet_ids": ["2115084984339874209", "2115086429067850212"], "id": "2115086429067850212", "public_metrics": {"bookmark_count": 24, "impression_count": 20340, "like_count": 378, "quote_count": 11, "reply_count": 21, "retweet_count": 77}, "text": "Our Hera spacecraft can now see Didymos and Dimorphos as two separate asteroids! \n\nComing closer, it will study the effects of NASA's 2022 DART impact and help advance asteroid deflection as a planetary defence technique.\n\nThe first detailed images of Dimorphos are expected on 25 https://t.co/lHA0jU04jT", "url": "https://x.com/esa/status/2115086429067850212"}, {"author_id": "21436960", "created_at": "2026-10-27T14:15:31.000Z", "edit_history_tweet_ids": ["2115084984339874209", "2115086429067850212"], "id": "2115084984339874209", "public_metrics": {"bookmark_count": 0, "impression_count": 3428, "like_count": 19, "quote_count": 1, "reply_count": 1, "retweet_count": 1}, "text": "Our Hera spacecraft can now see Didymos and Dimorphos as two separate asteroids! \n\nComing closer, it will study the effects of NASA's 2022 DART impact and help advance asteroid deflection as a planetary defence technique.\n\nThe first detailed images of Dimorphos are expected on 25 https://t.co/Fu0tYHImDt", "url": "https://x.com/esa/status/2115084984339874209"}, {"author_id": "626660983", "created_at": "2026-10-27T14:08:45.000Z", "edit_history_tweet_ids": ["2115083281968321005"], "id": "2115083281968321005", "public_metrics": {"bookmark_count": 1, "impression_count": 2736, "like_count": 45, "quote_count": 0, "reply_count": 8, "retweet_count": 1}, "referenced_tweets": [{"id": "2115074006680515007", "type": "quoted"}], "text": "if you've spent any time in a care facility, you realize that \"make the workers even more robotic\" is, in fact, very much not a solution https://t.co/SoBN6zBN5U", "url": "https://x.com/lymanstoneky/status/2115083281968321005"}, {"author_id": "626660983", "created_at": "2026-10-27T14:07:30.000Z", "edit_history_tweet_ids": ["2115082965902401680"], "id": "2115082965902401680", "public_metrics": {"bookmark_count": 33, "impression_count": 19670, "like_count": 225, "quote_count": 11, "reply_count": 31, "retweet_count": 31}, "text": "this is really striking.\n\namericans aren't losing faith in just *leaders*\n\nthey're losing faith in *the people itself*\n\nthat is the real threat to the republican form of government. https://t.co/0QJbs5RkyE", "url": "https://x.com/lymanstoneky/status/2115082965902401680"}, {"author_id": "626660983", "created_at": "2026-10-27T14:02:10.000Z", "edit_history_tweet_ids": ["2115081626741002606"], "id": "2115081626741002606", "public_metrics": {"bookmark_count": 0, "impression_count": 1897, "like_count": 31, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2115048293868707919", "type": "quoted"}], "text": "situation in brazil seems great https://t.co/aWAhUs0gTn", "url": "https://x.com/lymanstoneky/status/2115081626741002606"}, {"author_id": "626660983", "created_at": "2026-10-27T13:34:57.000Z", "edit_history_tweet_ids": ["2115074775244530033"], "id": "2115074775244530033", "public_metrics": {"bookmark_count": 2, "impression_count": 3136, "like_count": 53, "quote_count": 2, "reply_count": 6, "retweet_count": 0}, "referenced_tweets": [{"id": "2076425782897918411", "type": "quoted"}], "text": "I maintain that everything in Canada west of Quebec is a mistake. https://t.co/AHlPplcfFa", "url": "https://x.com/lymanstoneky/status/2115074775244530033"}, {"author_id": "626660983", "created_at": "2026-10-27T13:23:35.000Z", "edit_history_tweet_ids": ["2115071916654633223"], "id": "2115071916654633223", "public_metrics": {"bookmark_count": 27, "impression_count": 16209, "like_count": 536, "quote_count": 0, "reply_count": 37, "retweet_count": 27}, "referenced_tweets": [{"id": "2114710506111975890", "type": "quoted"}], "text": "It’s not affordable.\n\nThere’s no way to make it affordable.\n\nWestern culture may revolt at the notion, but the primary caretakers for the old will always be… their kids https://t.co/X2Vk5Vunjm", "url": "https://x.com/lymanstoneky/status/2115071916654633223"}, {"author_id": "21436960", "created_at": "2026-10-27T10:47:56.000Z", "edit_history_tweet_ids": ["2115032746716487737"], "id": "2115032746716487737", "public_metrics": {"bookmark_count": 12, "impression_count": 14826, "like_count": 256, "quote_count": 4, "reply_count": 22, "retweet_count": 51}, "text": "New Galileo Second Generation satellites are set to join the fleet, bringing the total to 16.\n\nThese additional satellites will support the long-term continuity and resilience of Europe’s satellite navigation services.\n\n🔗https://t.co/8qxcdz97qI https://t.co/hKDIA4iqzj", "url": "https://x.com/esa/status/2115032746716487737"}, {"author_id": "34743251", "created_at": "2026-10-27T08:57:03.000Z", "edit_history_tweet_ids": ["2115004840321659292"], "id": "2115004840321659292", "public_metrics": {"bookmark_count": 87, "impression_count": 993988, "like_count": 4337, "quote_count": 61, "reply_count": 237, "retweet_count": 497}, "text": "Falcon 9 launches 27 @Starlink satellites from California https://t.co/zqjiRb3K1m", "url": "https://x.com/SpaceX/status/2115004840321659292"}, {"author_id": "19355829", "created_at": "2026-10-27T08:55:25.000Z", "edit_history_tweet_ids": ["2115004430244335970"], "id": "2115004430244335970", "public_metrics": {"bookmark_count": 15, "impression_count": 14685, "like_count": 189, "quote_count": 2, "reply_count": 10, "retweet_count": 18}, "text": "Update on Rassvet-3 orbit raising. Two failed R3s will reentered in the next day or two. Most of the rest are stable at 500 km https://t.co/uBsr77KFv1", "url": "https://x.com/planet4589/status/2115004430244335970"}, {"author_id": "19355829", "created_at": "2026-10-27T08:44:54.000Z", "edit_history_tweet_ids": ["2115001782069833925"], "id": "2115001782069833925", "public_metrics": {"bookmark_count": 0, "impression_count": 5423, "like_count": 51, "quote_count": 0, "reply_count": 2, "retweet_count": 2}, "text": "LAUNCH at 0725 UTC Oct 27 of Starlink group 15-16 from Vandenberg", "url": "https://x.com/planet4589/status/2115001782069833925"}, {"author_id": "34743251", "created_at": "2026-10-27T08:29:53.000Z", "edit_history_tweet_ids": ["2114998002129440995"], "id": "2114998002129440995", "public_metrics": {"bookmark_count": 64, "impression_count": 1077919, "like_count": 6686, "quote_count": 36, "reply_count": 206, "retweet_count": 364}, "text": "Deployment of 27 @Starlink satellites confirmed", "url": "https://x.com/SpaceX/status/2114998002129440995"}, {"author_id": "17217640", "created_at": "2026-10-27T07:27:29.000Z", "edit_history_tweet_ids": ["2114982298764583325"], "id": "2114982298764583325", "public_metrics": {"bookmark_count": 1, "impression_count": 7249, "like_count": 55, "quote_count": 1, "reply_count": 3, "retweet_count": 11}, "text": "Liftoff! A post-midnight takeoff of SpaceX's Falcon 9 rocket from Vandenberg Space Force Base. Liftoff of the Starlink 15-16 mission at 12:25 am PT (3:25 am ET / 0725 UTC).\n\nWatch live: https://t.co/Jz9aPk02wI https://t.co/TD8m0t3VpN", "url": "https://x.com/SpaceflightNow/status/2114982298764583325"}], "includes": {"users": [{"id": "626660983", "name": "Lyman Stone 石來民 🦬🦬🦬", "username": "lymanstoneky"}, {"id": "46648807", "name": "National Institute of Standards and Technology", "username": "NIST"}, {"id": "11348282", "name": "NASA", "username": "NASA"}, {"id": "17217640", "name": "Spaceflight Now", "username": "SpaceflightNow"}, {"id": "21436960", "name": "European Space Agency", "username": "esa"}, {"id": "34743251", "name": "SpaceX", "username": "SpaceX"}, {"id": "19355829", "name": "Jonathan McDowell", "username": "planet4589"}]}, "meta": {"newest_id": "2115189504126451848", "next_token": "b26v89c19zqg8o3juzlx97gvhzfrt6uvxad5mnt8vgvwd", "oldest_id": "2114982298764583325", "result_count": 25}}
