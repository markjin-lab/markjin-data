{"data": [{"author_id": "57111966", "created_at": "2026-10-27T12:28:28.000Z", "edit_history_tweet_ids": ["2115058047164838343"], "entities": {"urls": [{"description": "Gasoline and diesel fuel prices released weekly.", "display_url": "eia.gov/petroleum/gasd…", "end": 25, "expanded_url": "https://www.eia.gov/petroleum/gasdiesel/", "start": 2, "status": 200, "title": "Gasoline and Diesel Fuel Update", "unwound_url": "https://www.eia.gov/petroleum/gasdiesel/", "url": "https://t.co/ca3E8ZLEfO"}, {"display_url": "pic.x.com/V41xzqghh2", "end": 129, "expanded_url": "https://x.com/EIAgov/status/2115058047164838343/video/1", "media_key": "13_2115058028181405696", "start": 106, "url": "https://t.co/V41xzqghh2"}]}, "id": "2115058047164838343", "public_metrics": {"bookmark_count": 0, "impression_count": 2813, "like_count": 7, "quote_count": 2, "reply_count": 3, "retweet_count": 0}, "text": "💻 https://t.co/ca3E8ZLEfO\n⛽ Our Gasoline and Diesel Fuel Update posts new prices every Tuesday afternoon. https://t.co/V41xzqghh2", "url": "https://x.com/EIAgov/status/2115058047164838343"}, {"author_id": "80513844", "created_at": "2026-10-27T11:00:01.000Z", "edit_history_tweet_ids": ["2115035784939962443"], "entities": {"urls": [{"display_url": "pic.x.com/EL1Lzwfnp1", "end": 269, "expanded_url": "https://x.com/ASMLcompany/status/2115035784939962443/video/1", "media_key": "13_2114725849463205888", "start": 246, "url": "https://t.co/EL1Lzwfnp1"}]}, "id": "2115035784939962443", "public_metrics": {"bookmark_count": 29, "impression_count": 7500, "like_count": 247, "quote_count": 3, "reply_count": 5, "retweet_count": 22}, "text": "Computational lithography predicts how a chip pattern will print before it reaches a wafer. Using physical models and advanced algorithms, we optimize the reticle design, illumination and imaging conditions so patterns print exactly as intended. https://t.co/EL1Lzwfnp1", "url": "https://x.com/ASMLcompany/status/2115035784939962443"}, {"author_id": "19386622", "created_