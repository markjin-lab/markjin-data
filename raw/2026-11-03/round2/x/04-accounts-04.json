{"data": [{"author_id": "3290364847", "created_at": "2026-11-02T21:50:12.000Z", "edit_history_tweet_ids": ["2117373738182128111"], "entities": {"urls": [{"description": "No matter what happens on Election Day, the midterms will have sweeping implications for American health care. More than two dozen experts on what could come next.", "display_url": "bit.ly/4iEgefM", "end": 248, "expanded_url": "https://bit.ly/4iEgefM", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2116488396705054722/vAuj1oDr?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116488396705054722/vAuj1oDr?format=jpg&name=150x150", "width": 150}], "start": 225, "status": 200, "title": "What are the health stakes of the midterms? Policymakers, lobbyists, and experts weigh in", "unwound_url": "https://www.statnews.com/2026/10/31/midterm-election-tipping-point-healthcare-policy/", "url": "https://t.co/HCePaq0ShE"}]}, "id": "2117373738182128111", "public_metrics": {"bookmark_count": 0, "impression_count": 508, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Over the last several weeks, STAT interviewed more than two dozen government and private sector leaders, consultants, lobbyists, and staffers. Here are some of the top ways Tuesday’s vote could impact the U.S. health system. https://t.co/HCePaq0ShE", "url": "https://x.com/statnews/status/2117373738182128111"}, {"author_id": "86626845", "created_at": "2026-11-02T21:32:42.000Z", "edit_history_tweet_ids": ["2117369332858814822"], "entities": {"urls": [{"display_url": "pic.x.com/Lvz8YSjNki", "end": 299, "expanded_url": "https://x.com/EricTopol/status/2117369332858814822/photo/1", "media_key": "3_2117368299600429056", "start": 276, "url": "https://t.co/Lvz8YSjNki"}]}, "id": "2117369332858814822", "public_metrics": {"bookmark_count": 7, "impression_count": 4207, "like_count": 12, "quote_count": 1, "reply_count": 5, "retweet_count": 2}, "text": "Cancer therapy ha