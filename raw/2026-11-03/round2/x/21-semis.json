{"data": [{"author_id": "2117237637459189760", "created_at": "2026-11-02T21:56:42.000Z", "edit_history_tweet_ids": ["2117375373239296397"], "entities": {"hashtags": [{"end": 255, "start": 250, "tag": "ASML"}, {"end": 271, "start": 256, "tag": "Semiconductors"}], "urls": [{"display_url": "pic.x.com/RzIycQprJF", "end": 295, "expanded_url": "https://x.com/theAISignalAI/status/2117375373239296397/photo/1", "media_key": "3_2117375345829494784", "start": 272, "url": "https://t.co/RzIycQprJF"}]}, "id": "2117375373239296397", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "🔬 STOCK X-RAY #003 | ASML\nBefore NVIDIA's chips reach AI data centers, advanced lithography helps make them possible.\n\nASML is the sole commercial supplier of EUV lithography systems.\n\nIs this one of the most critical bottlenecks in the AI economy?\n\n#ASML #Semiconductors https://t.co/RzIycQprJF", "url": "https://x.com/theAISignalAI/status/2117375373239296397"}, {"author_id": "1373569238061912069", "created_at": "2026-11-02T21:14:08.000Z", "edit_history_tweet_ids": ["2117364661284909304"], "id": "2117364661284909304", "public_metrics": {"bookmark_count": 0, "impression_count": 747, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "AIトレンドニュース要点（CTEE記事）\n詳細は該当するCTEE抽出記事Noを参照のこと\n\nI．AI需要は続くが、部材不足と資金負担が成長速度を左右\n\n今回の記事群では、\nAI関連の受注・増産計画が続く一方、\n\n　メモリーや基板の不足によって\n　　生産・納品が制約される状況が中心となっている。", "url": "https://x.com/Nikola_pn2501/status/2117364661284909304"}, {"author_id": "2117237637459189760", "created_at": "2026-11-02T21:50:07.000Z", "edit_history_tweet_ids": ["2117373716212637993"], "entities": {"hashtags": [{"end": 239, "start": 234, "tag": "TSMC"}, {"end": 243, "start": 240, "tag": "AI"}], "urls": [{"display_url": "pic.x.com/RBwKZdEleQ", "end": 267, "expanded_url": "https://x.com/theAISignalAI/status/2117373716212637993/photo/1", "media_key": "3_2117373662437220352", "star