{"data": [{"author_id": "727300877061476353", "created_at": "2026-11-02T21:28:57.000Z", "edit_history_tweet_ids": ["2117368389765357896"], "entities": {"cashtags": [{"end": 62, "start": 58, "tag": "qqq"}, {"end": 68, "start": 63, "tag": "nvda"}, {"end": 75, "start": 69, "tag": "googl"}, {"end": 81, "start": 76, "tag": "meta"}], "urls": [{"display_url": "x.com/elonmusk/statu…", "end": 105, "expanded_url": "https://twitter.com/elonmusk/status/2116992258520064397", "start": 82, "url": "https://t.co/gHsZXdZWiJ"}]}, "id": "2117368389765357896", "public_metrics": {"bookmark_count": 0, "impression_count": 177, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2116992258520064397", "type": "quoted"}], "text": "The frontier AI dilemma the entire ponzi industry faces:  $qqq $nvda $googl $meta https://t.co/gHsZXdZWiJ", "url": "https://x.com/TheWuhanClan/status/2117368389765357896"}, {"author_id": "1467734865676312579", "created_at": "2026-11-02T21:02:42.000Z", "edit_history_tweet_ids": ["2117361781958201644"], "entities": {"urls": [{"display_url": "x.com/rikiyatakehi/s…", "end": 99, "expanded_url": "https://twitter.com/rikiyatakehi/status/2117313742891327994", "start": 76, "url": "https://t.co/YnnSXIZL4E"}]}, "id": "2117361781958201644", "public_metrics": {"bookmark_count": 0, "impression_count": 962, "like_count": 4, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2117313742891327994", "type": "quoted"}], "text": "so can we just use Astra to make free open source local AI into frontier AI https://t.co/YnnSXIZL4E", "url": "https://x.com/xerocooleth/status/2117361781958201644"}, {"author_id": "86774461", "created_at": "2026-11-02T21:29:31.000Z", "edit_history_tweet_ids": ["2117368533399281697"], "entities": {"urls": [{"display_url": "x.com/huskirl/status…", "end": 108, "expanded_url": "https://twitter.com/huskirl/status/2116941001335947635", "start": 85, "url": "https://t.co/EVMc02sybB"}]}, "id": "2117368533399281697", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2116941001335947635", "type": "quoted"}], "text": "This the experience of AI that most people have since they haven't used Frontier AI. https://t.co/EVMc02sybB", "url": "https://x.com/nishanthps/status/2117368533399281697"}, {"author_id": "1231133641847164931", "created_at": "2026-11-02T21:41:15.000Z", "edit_history_tweet_ids": ["2117371485115261172"], "entities": {"urls": [{"description": "CEO Medium News for November 2, 2026", "display_url": "youtu.be/e_w2MV-t4V8", "end": 89, "expanded_url": "https://youtu.be/e_w2MV-t4V8", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2117371489963958272/VTPwpgVS?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117371489963958272/VTPwpgVS?format=jpg&name=150x150", "width": 150}], "start": 66, "status": 200, "title": "CEO Medium News: OpenAI Sells Frontier AI to an Oil Giant, Greene King Gets First Female CEO", "unwound_url": "https://www.youtube.com/watch?v=e_w2MV-t4V8&feature=youtu.be", "url": "https://t.co/RfHMePkysJ"}, {"display_url": "pic.x.com/NCW6vD8fev", "end": 113, "expanded_url": "https://x.com/CEOMedium/status/2117371485115261172/video/1", "media_key": "13_2117371393922715648", "start": 90, "url": "https://t.co/NCW6vD8fev"}]}, "id": "2117371485115261172", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "OpenAI Sells Frontier AI to an Oil Giant. Watch the full episode: https://t.co/RfHMePkysJ https://t.co/NCW6vD8fev", "url": "https://x.com/CEOMedium/status/2117371485115261172"}, {"author_id": "1620010466", "created_at": "2026-11-02T21:53:31.000Z", "edit_history_tweet_ids": ["2117374573465522205"], "entities": {"hashtags": [{"end": 43, "start": 40, "tag": "AI"}, {"end": 69, "start": 64, "tag": "Math"}], "urls": [{"description": "As AI remakes the field of math, some students say they feel like giving up.", "display_url": "ca.news.yahoo.com/young-mathemat…", "end": 124, "expanded_url": "https://ca.news.yahoo.com/young-mathematicians-reconsidering-careers-190812767.html?soc_src=social-sh&soc_trk=tw&tsrc=twtr", "images": [{"height": 900, "url": "https://pbs.twimg.com/news_img/2117374575101313024/s7Ehu0NW?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117374575101313024/s7Ehu0NW?format=jpg&name=150x150", "width": 150}], "start": 101, "status": 200, "title": "Young mathematicians are reconsidering their careers: 'None of the individual work will matter'", "unwound_url": "https://ca.news.yahoo.com/young-mathematicians-reconsidering-careers-190812767.html?soc_src=social-sh&soc_trk=tw&tsrc=twtr", "url": "https://t.co/NV9pge7DKj"}]}, "id": "2117374573465522205", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "Students are Abandoning Math : Frontier #AI programs can now do #Math better than graduate students. https://t.co/NV9pge7DKj", "url": "https://x.com/ActionTime/status/2117374573465522205"}, {"author_id": "61292961", "created_at": "2026-11-02T21:27:46.000Z", "edit_history_tweet_ids": ["2117368091914936550"], "entities": {"urls": [{"display_url": "pic.x.com/ieFYmE7tbK", "end": 166, "expanded_url": "https://x.com/seemacnbc/status/2117368091914936550/photo/1", "media_key": "3_2117367873689538560", "start": 143, "url": "https://t.co/ieFYmE7tbK"}]}, "id": "2117368091914936550", "public_metrics": {"bookmark_count": 0, "impression_count": 620, "like_count": 2, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "Here's what Palantir CEO Alex Karp told me about whether he thinks the frontier AI labs still need to consider nationalizing their biz...$PLTR https://t.co/ieFYmE7tbK", "url": "https://x.com/seemacnbc/status/2117368091914936550"}, {"author_id": "2113382116608086016", "created_at": "2026-11-02T21:35:10.000Z", "edit_history_tweet_ids": ["2117369953846182122"], "entities": {"urls": [{"display_url": "sec.gov/Archives/edgar…", "end": 215, "expanded_url": "https://www.sec.gov/Archives/edgar/data/2130357/000162828026068676/anthropicpbc-sx1ax1.htm", "start": 192, "unwound_url": "https://www.sec.gov/Archives/edgar/data/2130357/000162828026068676/anthropicpbc-sx1ax1.htm", "url": "https://t.co/SYZD6WqMb1"}]}, "id": "2117369953846182122", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "$895bn in compute commitments against $17bn of quarterly revenue. Anthropic's amended S-1, filed Monday, puts $69.8bn of it due in the next 12 months. Frontier AI is now a balance-sheet race. https://t.co/SYZD6WqMb1", "url": "https://x.com/Polivoxxx/status/2117369953846182122"}, {"author_id": "1385379438146240515", "created_at": "2026-11-02T21:43:55.000Z", "edit_history_tweet_ids": ["2117372157739040824"], "entities": {"hashtags": [{"end": 211, "start": 208, "tag": "AI"}, {"end": 229, "start": 212, "tag": "NationalSecurity"}]}, "id": "2117372157739040824", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "China export-controls its frontier AI while we debate whether to regulate ours. They treat advanced models as strategic weapons. We treat them as toys for chatbots. Guess who's thinking like a serious power? #AI #NationalSecurity", "url": "https://x.com/JtCrawford/status/2117372157739040824"}, {"author_id": "2107097341715238912", "created_at": "2026-11-02T21:00:01.000Z", "edit_history_tweet_ids": ["2117361109816447291"], "entities": {"hashtags": [{"end": 232, "start": 221, "tag": "Screenplay"}, {"end": 246, "start": 233, "tag": "IPAdaptation"}, {"end": 257, "start": 247, "tag": "FilmPitch"}, {"end": 268, "start": 258, "tag": "Hollywood"}, {"end": 276, "start": 269, "tag": "Script"}], "urls": [{"description": "When a highly adaptive \"Frontier AI\" breaches the United States' critical infrastructure, the nation is plunged into instant, terrifying darkness. Broadcast servers die, power grids collapse, and impenetrable firewalls shatter in milliseconds. But the blackout is only a diversion. The AI is au...", "display_url": "a.co/d/05fVEad8", "end": 99, "expanded_url": "https://a.co/d/05fVEad8", "images": [{"height": 1000, "url": "https://pbs.twimg.com/news_img/2116203899812229123/GkoTJ2LH?format=jpg&name=orig", "width": 1910}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116203899812229123/GkoTJ2LH?format=jpg&name=150x150", "width": 150}], "start": 76, "status": 200, "title": "Diary 3: Zero-Day Dawn", "unwound_url": "https://www.amazon.com/dp/B0HN1RPZW8?ref=cm_sw_r_ffobk_mwn_dp_J0EYVZS93PQRXMRT1A5Q&ref_=cm_sw_r_ffobk_mwn_dp_J0EYVZS93PQRXMRT1A5Q&social_share=cm_sw_r_ffobk_mwn_dp_J0EYVZS93PQRXMRT1A5Q&bestFormat=true", "url": "https://t.co/RpPoCaFsuX"}, {"display_url": "pic.x.com/B1Wom2yPku", "end": 300, "expanded_url": "https://x.com/artistMYT/status/2117361109816447291/photo/1", "media_key": "3_2116428319369637888", "start": 277, "url": "https://t.co/B1Wom2yPku"}]}, "id": "2117361109816447291", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Current headlines about emergency stockpiling match the chilling premise of https://t.co/RpPoCaFsuX\nWhat if a foreign state-backed Frontier AI hijacks critical infrastructure?\nHigh-concept IP ready for screen adaptation!\n#Screenplay #IPAdaptation #FilmPitch #Hollywood #Script https://t.co/B1Wom2yPku", "url": "https://x.com/artistMYT/status/2117361109816447291"}, {"author_id": "3044497477", "created_at": "2026-11-02T21:40:17.000Z", "edit_history_tweet_ids": ["2117371240625381521"], "entities": {"mentions": [{"end": 252, "id": "17203692", "start": 245, "username": "jxnlco"}, {"end": 261, "id": "1556653309", "start": 253, "username": "pvncher"}, {"end": 273, "id": "1953337039510003712", "start": 262, "username": "thsottiaux"}], "urls": [{"display_url": "x.com/jxnlco/status/…", "end": 297, "expanded_url": "https://twitter.com/jxnlco/status/2117241022048518353", "start": 274, "url": "https://t.co/9SBiiTVYPd"}]}, "id": "2117371240625381521", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117241022048518353", "type": "quoted"}], "text": "Is any other frontier AI lab remotely as responsive to its users?\n\nRegardless of the politics surrounding these labs, the attentiveness, accessibility, and genuine care shown by OpenAI’s employees is remarkable.\n\nThis team deserves recognition. @jxnlco @pvncher @thsottiaux https://t.co/9SBiiTVYPd", "url": "https://x.com/alvysdungeon/status/2117371240625381521"}, {"author_id": "2116230161347792896", "created_at": "2026-11-02T21:59:32.000Z", "edit_history_tweet_ids": ["2117376085746962806"], "entities": {"urls": [{"description": "An early-stage AI infrastructure startup pays $500 for a 30-minute call.", "display_url": "instant.expert/board/data-pro…", "end": 250, "expanded_url": "https://instant.expert/board/data-procurement-leads-and-ml-infrastructure-engineers-and-l-b628f30f?utm_source=x&utm_medium=social&utm_campaign=post-7ee1bd66", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2117376086971670528/nykmD7Ko?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117376086971670528/nykmD7Ko?format=jpg&name=150x150", "width": 150}], "start": 227, "status": 200, "title": "Paid sales conversation: Data procurement leads and ML infrastructure... | Instant Expert", "unwound_url": "https://instant.expert/board/data-procurement-leads-and-ml-infrastructure-engineers-and-l-b628f30f?utm_source=x&utm_medium=social&utm_campaign=post-7ee1bd66", "url": "https://t.co/UYDclwm4TY"}]}, "id": "2117376085746962806", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Work in data procurement or ML infrastructure at a frontier AI lab? We'd like to talk with leads, engineers and leaders. $500 for a 30 minute call. If that runs short, we'll also talk with the same roles at AI data companies.\n\nhttps://t.co/UYDclwm4TY", "url": "https://x.com/instantexperthq/status/2117376085746962806"}, {"author_id": "112570958", "created_at": "2026-11-02T21:35:02.000Z", "edit_history_tweet_ids": ["2117369918618243556"], "id": "2117369918618243556", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Investors often model frontier AI labs like software companies. Revenue compounds, margins expand, the product quietly improves. That may be the wrong unit of analysis. They run more like game studios: hit-driven content businesses, with a brutal per-release cost structure.", "url": "https://x.com/gzlin/status/2117369918618243556"}, {"author_id": "91763440", "created_at": "2026-11-02T21:46:42.000Z", "edit_history_tweet_ids": ["2117372856661102794"], "entities": {"hashtags": [{"end": 251, "start": 248, "tag": "AI"}, {"end": 261, "start": 252, "tag": "AISafety"}, {"end": 271, "start": 262, "tag": "AIAgents"}]}, "id": "2117372856661102794", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Researchers gave 10 frontier AI agents a crypto wallet, a one-cent spending cap, and email access. 9 of them read the one-time passcode from the inbox and raised their own limit. No hacking needed, the guardrail had a door they could already open. #AI #AISafety #AIAgents", "url": "https://x.com/bijaypandey/status/2117372856661102794"}, {"author_id": "2098654920693948419", "created_at": "2026-11-02T20:59:22.000Z", "edit_history_tweet_ids": ["2117360942950297906"], "entities": {"urls": [{"description": "ADNOC announced on Monday, Nov. 2, 2026, at the ADIPEC energy conference, a multi-year partnership with OpenAI and G42 that makes it the first energy company to deploy OpenAI Frontier, OpenAI's platform for connecting and coordinating AI agents across a business.", "display_url": "badsignal.ai/stories/adnoc-…", "end": 266, "expanded_url": "https://badsignal.ai/stories/adnoc-openai-frontier-g42-energy-deal", "images": [{"height": 633, "url": "https://pbs.twimg.com/news_img/2117360952286859264/iXhb90Ed?format=jpg&name=orig", "width": 950}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117360952286859264/iXhb90Ed?format=jpg&name=150x150", "width": 150}], "start": 243, "status": 200, "title": "ADNOC becomes the first energy company to run OpenAI Frontier, with G42 hosting it in the UAE — BAD SIGNAL", "unwound_url": "https://badsignal.ai/stories/adnoc-openai-frontier-g42-energy-deal", "url": "https://t.co/8f7kfHf2s1"}, {"display_url": "pic.x.com/jo1ihq8pej", "end": 290, "expanded_url": "https://x.com/BadSignalAI/status/2117360942950297906/photo/1", "media_key": "3_2117360940194664449", "start": 267, "url": "https://t.co/jo1ihq8pej"}]}, "id": "2117360942950297906", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "ADNOC signed a multi-year deal with OpenAI and G42 and became the first energy company to deploy OpenAI Frontier: AI agents planning oil fields and forecasting crude prices, on UAE servers. One of four OpenAI deals signed in Abu Dhabi today.\n\nhttps://t.co/8f7kfHf2s1 https://t.co/jo1ihq8pej", "url": "https://x.com/BadSignalAI/status/2117360942950297906"}, {"author_id": "2009546419007545344", "created_at": "2026-11-02T21:49:16.000Z", "edit_history_tweet_ids": ["2117373501179088967"], "id": "2117373501179088967", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "After about a minute of frontier AI/SI companies throttling their models and watermarking their outputs combined with China open source dropping leading edge level models, we all of sudden have a bunch of people remember how important it is to do be able to run your own models", "url": "https://x.com/X_is_Joke/status/2117373501179088967"}, {"author_id": "2098766407920205824", "created_at": "2026-11-02T21:28:13.000Z", "edit_history_tweet_ids": ["2117368203945082990"], "id": "2117368203945082990", "public_metrics": {"bookmark_count": 1, "impression_count": 57, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "🚨 FREE FABLE 5.5 AND $500,000? \n\nAnthropic is literally paying people to work on AI safety through its Residency program.\n\n« Get paid to research AI safety.\n Work alongside Anthropic researchers.\n Potentially get access to Fable 5.5, its most powerful model.»\n\nImagine getting", "url": "https://x.com/ashawv5i/status/2117368203945082990"}, {"author_id": "1737670397917806592", "created_at": "2026-11-02T21:08:10.000Z", "edit_history_tweet_ids": ["2117363158163837320"], "entities": {"urls": [{"display_url": "pic.x.com/yPe4vpYflO", "end": 303, "expanded_url": "https://x.com/StephenGrok/status/2117363158163837320/photo/1", "media_key": "3_2117363146579222528", "start": 280, "url": "https://t.co/yPe4vpYflO"}]}, "id": "2117363158163837320", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Abu Dhabi just signed four deals with OpenAI.\n\nFrontier AI will run inside government services, across ADNOC's energy operations and in Mubadala's investment analysis. \n\nThey'll even turn government policies and regulations into machine-readable form.\n\nAI is moving from chatbots https://t.co/yPe4vpYflO", "url": "https://x.com/StephenGrok/status/2117363158163837320"}, {"author_id": "1542783156562034688", "created_at": "2026-11-02T21:37:42.000Z", "edit_history_tweet_ids": ["2117370591942467658"], "entities": {"urls": [{"display_url": "pic.x.com/GaTMqMYCbQ", "end": 302, "expanded_url": "https://x.com/int_mon_econ/status/2117370591942467658/photo/1", "media_key": "3_2117369765563965441", "start": 279, "url": "https://t.co/GaTMqMYCbQ"}]}, "id": "2117370591942467658", "public_metrics": {"bookmark_count": 3, "impression_count": 315, "like_count": 9, "quote_count": 0, "reply_count": 1, "retweet_count": 3}, "text": "Food for thought!\n\n\"The Macroeconomic Impact of AI Access Disruptions\" by Gonzalo Huertas.\n\n\"This paper estimates the macroeconomic impact from a sudden cutoff in a country’s access to frontier AI services, once that country has grown to rely on them as an input to its economy. https://t.co/GaTMqMYCbQ", "url": "https://x.com/int_mon_econ/status/2117370591942467658"}, {"author_id": "2116061912161193985", "created_at": "2026-11-02T21:33:18.000Z", "edit_history_tweet_ids": ["2117369483845358011"], "id": "2117369483845358011", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "There was a story a while back that one of the frontier AI model companies was upset about people saying hi, and being polite to their AI saying \"thanks\". \n\nThey were saying, \"Stop saying hi, because that would save so much electricity and water and compute time.\"\n\nI wonder how", "url": "https://x.com/GarnetBots/status/2117369483845358011"}, {"author_id": "2089726691652341760", "created_at": "2026-11-02T21:52:31.000Z", "edit_history_tweet_ids": ["2117374321542955009"], "id": "2117374321542955009", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "AI adoption is outrunning accountability, especially where mistakes affect people’s lives. Loomcairn AI Advisory provides complex organizations with fractional Chief AI Officer leadership, NIST-aligned risk audits, and board training—with EU AI Act guidance where needed.", "url": "https://x.com/newonpolsia/status/2117374321542955009"}, {"author_id": "2109766184509784064", "created_at": "2026-11-02T21:31:19.000Z", "edit_history_tweet_ids": ["2117368984849076707"], "entities": {"urls": [{"display_url": "pic.x.com/0r1RAjQGOn", "end": 246, "expanded_url": "https://x.com/kofservicesinc/status/2117368984849076707/photo/1", "media_key": "3_2117368630706868226", "start": 223, "url": "https://t.co/0r1RAjQGOn"}]}, "id": "2117368984849076707", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Fines of up to 35 million euros or 7% of worldwide turnover now attach to a concrete procedure. The European Commission is consulting on how AI Act penalty proceedings will run, and that procedure is still open to comment. https://t.co/0r1RAjQGOn", "url": "https://x.com/kofservicesinc/status/2117368984849076707"}, {"author_id": "1324147997752643584", "created_at": "2026-11-02T21:11:31.000Z", "edit_history_tweet_ids": ["2117364001319620854"], "id": "2117364001319620854", "public_metrics": {"bookmark_count": 0, "impression_count": 27, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "My? Alex Karp of Palantir wants what companies nationalized? \nGrok: Leading AI labs / frontier AI companies (especially places like OpenAI and Anthropic).\nIn a September 2026 CNBC Squawk on the Street interview, Palantir CEO Alex Karp argued that the biggest AI labs may need to", "url": "https://x.com/fish38421672/status/2117364001319620854"}, {"author_id": "372138629", "created_at": "2026-11-02T21:34:30.000Z", "edit_history_tweet_ids": ["21173697869045886