{"data": [{"author_id": "1828694705506500608", "created_at": "2026-11-01T20:11:53.000Z", "edit_history_tweet_ids": ["2116986605609300473"], "entities": {"urls": [{"display_url": "pic.x.com/UoKXys2BH5", "end": 303, "expanded_url": "https://x.com/JSCC2020Lee/status/2116986605609300473/photo/1", "media_key": "3_2116986598672023552", "start": 280, "url": "https://t.co/UoKXys2BH5"}]}, "id": "2116986605609300473", "public_metrics": {"bookmark_count": 1, "impression_count": 246, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Intel EMIB silicon-bridge embed yield collapses to just 25-30% while TSMC CoWoS holds near 98%, locking packaging as the AI accelerator chokepoint.\n1/ Key Numbers &amp; Facts: • SK hynix 3Q26 revenue ₩104.6155T (~$78B), operating profit ₩83.3338T (~$62B), record 80% margin • HBM https://t.co/UoKXys2BH5", "url": "https://x.com/JSCC2020Lee/status/2116986605609300473"}, {"author_id": "2108191189019381760", "created_at": "2026-11-01T13:29:06.000Z", "edit_history_tweet_ids": ["2116885242447642825"], "id": "2116885242447642825", "public_metrics": {"bookmark_count": 0, "impression_count": 482, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Morgan Stanley — Greater China Semiconductors: AI Semi...\nMorgan Stanley — Greater China Semiconductors: AI Semiconductor Supply Chain, Memory, CPO, Quantum Security\nCore conclusion: APAC semiconductor sector view — Attractive. The AI semiconductor demand outlook is strong, but", "url": "https://x.com/2030FY_X/status/2116885242447642825"}, {"article": {"title": "EMIB Bridge Yields Below 30%? Intel May Have to Pay the Bill"}, "author_id": "2094661944410247168", "created_at": "2026-11-01T12:03:44.000Z", "edit_history_tweet_ids": ["2116863761424470234"], "entities": {"urls": [{"display_url": "x.com/i/article/2116…", "end": 234, "expanded_url": "https://x.com/i/article/2116862697610588160", "start": 211, "status": 404, "unwound_url": "https://x.com/i/art