96/76,444\n4H：下跌段未破，绿柱缩近零轴\n多：收上77,731回踩不破77,615看78,776\n空：收破77,396看77,060，破76,329看75,680\n倾向：8h震荡，24h中性\n不构成投资建议 #缠论 #比特币 https://t.co/Iuhet6SIfW", "url": "https://x.com/Chanlun_G/status/2116654145004556592"}], "includes": {"users": [{"id": "2114884465671712769", "name": "Chan Theory BTC", "username": "Chanlun_G"}, {"id": "1501183366414356484", "name": "Bob Shao", "username": "BobShao8"}, {"id": "2795277015", "name": "Frank Yin", "username": "jidifeng"}, {"id": "1473747944704667648", "name": "萌音大酋长", "username": "mengyinbeiyong"}, {"id": "2115413014899838977", "name": "Valen", "username": "WalkingWithin"}, {"id": "1706245213411557376", "name": "万波Coder｜变现观察", "username": "JDveif"}, {"id": "1906674253489168384", "name": "Lonely_梓榆", "username": "LonelyZiyu"}, {"id": "2116865870702301184", "name": "缠论Index", "username": "tvzhibiao"}, {"id": "1521086568194211842", "name": "大嘴和尚", "username": "SonicAIWizard"}, {"id": "1592938896161001472", "name": "Crypto以缠解势", "username": "yycl_gaoshan"}, {"id": "1401854181288329223", "name": "李月粤", "username": "Liyueyuea"}, {"id": "1841511194307481601", "name": "Justin Justin", "username": "JustinJ7974556"}]}, "meta": {"newest_id": "2117248180886946225", "next_token": "b26v89c19zqg8o3juzly3c9oluggc3vixttlez6gl7vr1", "oldest_id": "2116654145004556592", "result_count": 24}}
