tags": [{"end": 195, "start": 179, "tag": "Alpha1Awareness"}, {"end": 207, "start": 196, "tag": "LungHealth"}, {"end": 220, "start": 208, "tag": "LiverHealth"}, {"end": 233, "start": 221, "tag": "RareDisease"}, {"end": 239, "start": 234, "tag": "AATD"}, {"end": 247, "start": 240, "tag": "Alpha1"}, {"end": 260, "start": 248, "tag": "GeneTherapy"}], "urls": [{"display_url": "pic.x.com/RrjMuAWIPW", "end": 297, "expanded_url": "https://x.com/TheEduPatient/status/2116894027890950354/photo/1", "media_key": "3_2116894025433145344", "start": 274, "url": "https://t.co/RrjMuAWIPW"}]}, "id": "2116894027890950354", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Could AATD one day be treated at its root cause? An early trial of a one-time base-editing therapy restored working AAT protein in people with severe AATD. Here’s what to know. \n\n#Alpha1Awareness #LungHealth #LiverHealth #RareDisease #AATD #Alpha1 #GeneTherapy\n\nLearn more: https://t.co/RrjMuAWIPW", "url": "https://x.com/TheEduPatient/status/2116894027890950354"}, {"author_id": "423181746", "created_at": "2026-11-01T22:16:00.000Z", "edit_history_tweet_ids": ["2117017842323173696"], "entities": {"cashtags": [{"end": 60, "start": 55, "tag": "CLLS"}]}, "id": "2117017842323173696", "public_metrics": {"bookmark_count": 0, "impression_count": 189, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "One base editing shot cut triglycerides 75%. In mice.\n\n$CLLS's .HEAL-101 (ESGCT): ~65% editing of human APOC3 in humanized liver mice, liver only, no double strand break.\n\nPreclinical. First human data 2H27 from a China investigator trial. Can one edit replace repeat APOC3 shots?", "url": "https://x.com/RazorSharpDNA/status/2117017842323173696"}, {"author_id": "64375648", "created_at": "2026-11-01T07:12:00.000Z", "edit_history_tweet_ids": ["2116790341864947930"], "entities": {"hashtags": [{"end": 192, "start": 177, "tag": "WilsonsDisease"}, {"end": 207, "start": 193, "tag": "GenomeEditing"}, {"end": 214, "start": 208, "tag": "Genes"}, {"end": 219, "start": 215, "tag": "DNA"}, {"end": 235, "start": 220, "tag": "GeneticDisease"}, {"end": 243, "start": 236, "tag": "Genome"}, {"end": 258, "start": 244, "tag": "ClinicalTrial"}], "mentions": [{"end": 17, "id": "1191016766669021184", "start": 3, "username": "DanH_Jacobson"}], "urls": [{"description": "The first patient has received an experimental prime-editing therapy in a clinical trial for Wilson's disease.", "display_url": "progress.org.uk/first-patient-…", "end": 176, "expanded_url": "https://www.progress.org.uk/first-patient-receives-prime-editing-therapy-for-wilsons-disease/", "images": [{"height": 1280, "url": "https://pbs.twimg.com/news_img/2116790389600333824/S63xCSKe?format=jpg&name=orig", "width": 1920}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116790389600333824/S63xCSKe?format=jpg&name=150x150", "width": 150}], "start": 153, "status": 200, "title": "First patient receives prime editing therapy for Wilson's disease | PET", "unwound_url": "https://www.progress.org.uk/first-patient-receives-prime-editing-therapy-for-wilsons-disease/", "url": "https://t.co/fS0jvfYVP8"}, {"display_url": "pic.x.com/El5rgkMCKn", "end": 282, "expanded_url": "https://x.com/PET_BioNews/status/2116790341864947930/video/1", "media_key": "13_2116684677759000576", "start": 259, "url": "https://t.co/El5rgkMCKn"}]}, "id": "2116790341864947930", "public_metrics": {"bookmark_count": 0, "impression_count": 72, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Dr @DanH_Jacobson explains that prime editing is a type of genome editing which is ‘used to alter DNA directly inside a person’s body’ \nRead in BioNews: https://t.co/fS0jvfYVP8\n#WilsonsDisease #GenomeEditing #Genes #DNA #GeneticDisease #Genome #ClinicalTrial https://t.co/El5rgkMCKn", "url": "https://x.com/PET_BioNews/status/2116790341864947930"}, {"author_id": "2035340237858320384", "created_at": "2026-11-01T17:06:04.000Z", "edit_history_tweet_ids": ["2116939845335498987"], "id": "2116939845335498987", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "A Wuhan University team modified every region of the prime editing guide RNA, not just the ends. At 1 mg/kg in mice, editing at Pcsk9 reached about 51% against 0.6% for end-modified pegRNA, and serum Pcsk9 fell 96%. Published in Nature Biomedical Engineering.", "url": "https://x.com/EarnestPen/status/2116939845335498987"}, {"author_id": "2057503590995099655", "created_at": "2026-11-01T04:21:19.000Z", "edit_history_tweet_ids": ["2116747388366795185"], "entities": {"urls": [{"display_url": "pic.x.com/4kxkZ3JL8Q", "end": 300, "expanded_url": "https://x.com/CliffS58597/status/2116747388366795185/photo/1", "media_key": "3_2116747350441967616", "start": 277, "url": "https://t.co/4kxkZ3JL8Q"}]}, "id": "2116747388366795185", "public_metrics": {"bookmark_count": 0, "impression_count": 123, "like_count": 0, "quote_count": 1, "reply_count": 1, "retweet_count": 1}, "text": "A lot of news overnight. Check out what's been going on. NEWS songs are made with the assistance of the Grok a.i. devils. \n\nThe last 24 hours (roughly Oct 30–31, 2026) have been dominated by the ongoing US-Israel war with Iran (around Day 244), Houthi strikes on Saudi Arabia, https://t.co/4kxkZ3JL8Q", "url": "https://x.com/CliffS58597/status/2116747388366795185"}, {"author_id": "2110437865809174528", "created_at": "2026-11-02T17:40:59.000Z", "edit_history_tweet_ids": ["2117311020377280811"], "entities": {"hashtags": [{"end": 152, "start": 139, "tag": "PrimeEditing"}, {"end": 165, "start": 153, "tag": "GeneEditing"}], "urls": [{"description": "Can rewriting DNA change the future for families living with rare g...", "display_url": "youtu.be/bsjvU2BFTxo", "end": 219, "expanded_url": "https://youtu.be/bsjvU2BFTxo", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2116571689635270656/QNblELZ9?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116571689635270656/QNblELZ9?format=jpg&name=150x150", "width": 150}], "start": 196, "status": 200, "title": "David Liu: Gene Editing to Treat Rare Disease", "unwound_url": "https://www.youtube.com/watch?v=bsjvU2BFTxo&feature=youtu.be", "url": "https://t.co/r1ZeMwYDyo"}, {"display_url": "pic.x.com/N6RYZ1YjMT", "end": 243, "expanded_url": "https://x.com/GENErationHopee/status/2117311020377280811/video/1", "media_key": "13_2117310922171482112", "start": 220, "url": "https://t.co/N6RYZ1YjMT"}]}, "id": "2117311020377280811", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Search and replace for your DNA: Dr. David R. Liu on how prime editing can correct almost any small mutation that causes genetic disease.\n\n#PrimeEditing #GeneEditing\n\nWatch the full conversation: https://t.co/r1ZeMwYDyo https://t.co/N6RYZ1YjMT", "url": "https://x.com/GENErationHopee/status/2117311020377280811"}, {"author_id": "124450678", "created_at": "2026-11-02T19:42:01.000Z", "edit_history_tweet_ids": ["2117341479689482568"], "entities": {"urls": [{"description": "The first patient received a dose of the high-precision gene editor in a new clinical trial for Wilson disease. Researchers hope it's a one-and-done fix.", "display_url": "singularityhub.com/2026/10/29/cri…", "end": 250, "expanded_url": "https://singularityhub.com/2026/10/29/crispr-prime-editing-rewrites-dna-in-the-human-body-for-the-first-time/", "images": [{"height": 929, "url": "https://pbs.twimg.com/news_img/2115907556568657920/RZWWJ-TD?format=jpg&name=orig", "width": 1300}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115907556568657920/RZWWJ-TD?format=jpg&name=150x150", "width": 150}], "start": 227, "status": 200, "title": "CRISPR Prime Editing Rewrites DNA in the Human Body for the First Time", "unwound_url": "https://singularityhub.com/2026/10/29/crispr-prime-editing-rewrites-dna-in-the-human-body-for-the-first-time/", "url": "https://t.co/JSHhor9CAs"}]}, "id": "2117341479689482568", "public_metrics": {"bookmark_count": 0, "impression_count": 39, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "For the first time, a gene editor was infused into a living human body to rewrite a mutation where it sits.\n\nNo cells removed, no lab step. One IV drip, Wilson disease.\n\nPrime editing just left the bench. Results next year. \n\n https://t.co/JSHhor9CAs", "url": "https://x.com/FedeWeill/status/2117341479689482568"}, {"author_id": "25950355", "created_at": "2026-11-01T18:00:27.000Z", "edit_history_tweet_ids": ["2116953529193578788"], "entities": {"urls": [{"display_url": "pic.x.com/H9mzuFtVB6", "end": 303, "expanded_url": "https://x.com/NEJM/status/2116953529193578788/video/1", "media_key": "13_2116953450369916928", "start": 280, "url": "https://t.co/H9mzuFtVB6"}]}, "id": "2116953529193578788", "public_metrics": {"bookmark_count": 5, "impression_count": 8754, "like_count": 17, "quote_count": 0, "reply_count": 1, "retweet_count": 6}, "text": "A Brief Report published in May of 2025 describes a lipid nanoparticle–delivered base-editing therapy that was custom designed for an infant with a urea-cycle disorder. A Clinical Implications of Basic Research published in April 2026 reviews another approach to genetic therapy: https://t.co/H9mzuFtVB6", "url": "https://x.com/NEJM/status/2116953529193578788"}, {"author_id": "1360769400182341641", "created_at": "2026-11-01T18:29:57.000Z", "edit_history_tweet_ids": ["2116960954378600657"], "entities": {"cashtags": [{"end": 61, "start": 56, "tag": "ARKG"}, {"end": 88, "start": 83, "tag": "PRME"}, {"end": 148, "start": 143, "tag": "TWST"}, {"end": 224, "start": 220, "tag": "TEM"}], "urls": [{"display_url": "pic.x.com/