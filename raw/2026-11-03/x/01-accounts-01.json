height": 150, "url": "https://pbs.twimg.com/news_img/2116907919065145346/jkNj1sLN?format=jpg&name=150x150", "width": 150}], "start": 92, "status": 200, "title": "Open Models Dashboard", "unwound_url": "https://dashboard.interconnects.ai/", "url": "https://t.co/h2XSTTId7e"}]}, "id": "2116908567571955756", "public_metrics": {"bookmark_count": 265, "impression_count": 27756, "like_count": 288, "quote_count": 4, "reply_count": 9, "retweet_count": 15}, "text": "I give an incredible amount of alpha away for free at this website with my open models data https://t.co/h2XSTTId7e", "url": "https://x.com/natolambert/status/2116908567571955756"}, {"author_id": "1745106082790318080", "created_at": "2026-11-01T02:15:25.000Z", "edit_history_tweet_ids": ["2116715704829223411"], "entities": {"urls": [{"display_url": "pic.x.com/mc17LyAV6N", "end": 302, "expanded_url": "https://x.com/SemiAnalysis_/status/2116715704829223411/video/1", "media_key": "7_2116715608683237376", "start": 279, "url": "https://t.co/mc17LyAV6N"}]}, "id": "2116715704829223411", "public_metrics": {"bookmark_count": 81, "impression_count": 44075, "like_count": 256, "quote_count": 7, "reply_count": 38, "retweet_count": 28}, "text": "Anthropic’s IPO is the moment datacenter developers have been waiting for.\n\n“Anthropic has the biggest compute demand of anyone, alongside OpenAI. They’re on par with hyperscalers, but they can’t deal directly with the folks building the datacenters. You can’t fund a datacenter https://t.co/mc17LyAV6N", "url": "https://x.com/SemiAnalysis_/status/2116715704829223411"}, {"author_id": "1745106082790318080", "created_at": "2026-10-31T23:00:11.000Z", "edit_history_tweet_ids": ["2116666571728863431"], "entities": {"mentions": [{"end": 203, "id": "1516059175910092803", "start": 196, "username": "mgoin_"}], "urls": [{"display_url": "pic.x.com/BzefjxrTi5", "end": 304, "expanded_url": "https://x.com/SemiAnalysis_/status/2116666571728863431/photo/1", "media_key": "3_2116666569040285696", "start":