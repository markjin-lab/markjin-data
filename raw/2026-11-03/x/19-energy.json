{"data": [{"author_id": "1425552859181895683", "created_at": "2026-11-02T11:05:16.000Z", "edit_history_tweet_ids": ["2117211435646218478"], "id": "2117211435646218478", "public_metrics": {"bookmark_count": 0, "impression_count": 321, "like_count": 3, "quote_count": 0, "reply_count": 2, "retweet_count": 1}, "text": "China will exempt sodium-ion batteries from consumption tax through Dec 31, 2028; lithium-ion batteries face 2% from Sept 1, 2026.\nThat gives sodium-ion a tax advantage for commercial EVs.\nWill fleets shift to sodium-ion trucks? https://t.co/s7MUCQ1nx1", "url": "https://x.com/theevking/status/2117211435646218478"}, {"author_id": "794541866968616960", "created_at": "2026-11-02T09:29:18.000Z", "edit_history_tweet_ids": ["2117187281836716288"], "id": "2117187281836716288", "public_metrics": {"bookmark_count": 0, "impression_count": 36, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Could sodium-ion batteries unlock a new wave of mass-market EV adoption, particularly in cost-sensitive markets? \nSodium-ion batteries in 2026\nhttps://t.co/txmKc6pRVn https://t.co/yKIdzuCIQ9", "url": "https://x.com/ret_consulting/status/2117187281836716288"}, {"author_id": "2109543784153333760", "created_at": "2026-11-02T07:06:29.000Z", "edit_history_tweet_ids": ["2117151341332337018"], "id": "2117151341332337018", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Sodium-ion isn't a lab story for us.\nFour sodium-ion systems are now running on real sites — cold climates, weak grids, microgrids.\nStart small, earn field data, skip the hype. DM your site conditions. https://t.co/Uw6gAExSkL", "url": "https://x.com/Pcenersys/status/2117151341332337018"}, {"author_id": "1998122460584230912", "created_at": "2026-11-01T19:15:00.000Z", "edit_history_tweet_ids": ["2116972290751484070"], "id": "2116972290751484070", "public_metrics": {"bookmark_count": 0, "