{"data": [{"author_id": "917683048782503937", "created_at": "2026-11-05T06:18:25.000Z", "edit_history_tweet_ids": ["2118226408711631270"], "entities": {"urls": [{"description": "South Korea’s current-account surplus jumped to a record in September, fueled by booming semiconductor exports as global investment in artificial intelligence continues to stoke demand for the country’s technology products.", "display_url": "bloomberg.com/news/articles/…", "end": 265, "expanded_url": "https://www.bloomberg.com/news/articles/2026-11-05/south-korea-s-current-account-surplus-hits-record-on-chip-boom?utm_source=website&utm_medium=share&utm_campaign=twitter", "images": [{"height": 800, "url": "https://pbs.twimg.com/news_img/2118162576974520320/_ICavnA4?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2118162576974520320/_ICavnA4?format=jpg&name=150x150", "width": 150}], "start": 242, "status": 200, "title": "South Korea’s Current Account Surplus Hits Record on Chip Boom", "unwound_url": "https://www.bloomberg.com/news/articles/2026-11-05/south-korea-s-current-account-surplus-hits-record-on-chip-boom?utm_source=website&utm_medium=share&utm_campaign=twitter", "url": "https://t.co/5QTEHoFY3U"}]}, "id": "2118226408711631270", "public_metrics": {"bookmark_count": 9, "impression_count": 8973, "like_count": 69, "quote_count": 0, "reply_count": 4, "retweet_count": 18}, "text": "Bloomberg: \"South Korea’s current-account surplus widened to $61.5 billion from $46.1 billion in August. The figure surpassed the previous record of $49.7 billion set in June, marking the first time the monthly surplus exceeded $60 billion.\"\nhttps://t.co/5QTEHoFY3U", "url": "https://x.com/michaelxpettis/status/2118226408711631270"}, {"author_id": "917683048782503937", "created_at": "2026-11-05T05:55:52.000Z", "edit_history_tweet_ids": ["2118220736976347181"], "id": "2118220736976347181", "public_metrics": {"bookmark_count": 0, "impression_count": 8092, "like_count": 27, "quote_count": 0, "reply_count": 1, "retweet_count": 4}, "text": "SCMP: \"The PBOC's intervention to raise the foreign exchange reserve requirement ratio amid the yuan’s sustained rally has delivered a reprieve for China’s broader export sector, as the measure is expected to partly ease appreciation momentum driven by the country’s enormous", "url": "https://x.com/michaelxpettis/status/2118220736976347181"}, {"author_id": "917683048782503937", "created_at": "2026-11-05T05:52:35.000Z", "edit_history_tweet_ids": ["2118219906671866266"], "id": "2118219906671866266", "public_metrics": {"bookmark_count": 5, "impression_count": 11761, "like_count": 72, "quote_count": 3, "reply_count": 5, "retweet_count": 10}, "text": "SCMP: \"Consumers across China are holding back on spending during the annual Singles Day shopping extravaganza as a stock market slump and a prolonged decline in property values erode household wealth, with many families making debt reduction and deleveraging greater priorities.\"", "url": "https://x.com/michaelxpettis/status/2118219906671866266"}, {"author_id": "917683048782503937", "created_at": "2026-11-05T05:49:34.000Z", "edit_history_tweet_ids": ["2118219150774452726"], "id": "2118219150774452726", "public_metrics": {"bookmark_count": 37, "impression_count": 12637, "like_count": 160, "quote_count": 3, "reply_count": 10, "retweet_count": 29}, "text": "Caixin: \"Berlin was once one of the strongest opponents of EU tariffs on Chinese EVs and had voted against most of the bloc’s tougher trade measures targeting China. In the fall of 2026, Germany abruptly changed course. German media reports have identified pressure from the", "url": "https://x.com/michaelxpettis/status/2118219150774452726"}, {"author_id": "917683048782503937", "created_at": "2026-11-05T05:43:15.000Z", "edit_history_tweet_ids": ["2118217558092296474"], "entities": {"urls": [{"description": "(Yicai) Nov. 4 -- Central banks’ gold purchases and inflows into gold exchange-traded funds were the main drivers of gold demand in the third quarter, according to the latest report by the World Gold Council. Central banks increased their gold reserves by 42 percent to 321 tons in the three months ended Sept. 30 from a year earlier, the highest since the fourth quarter of 2024, mainly for reserve diversification and risk management. In the first three quarters, their gold reserves expanded 6 percent to", "display_url": "yicaiglobal.com/news/central-b…", "end": 219, "expanded_url": "https://www.yicaiglobal.com/news/central-banks-gold-purchases-gold-etf-inflows-support-global-gold-demand-in-third-quarter-wgc-report-shows", "images": [{"height": 510, "url": "https://pbs.twimg.com/news_img/2117902059160637440/Puk0Lt_p?format=jpg&name=orig", "width": 770}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117902059160637440/Puk0Lt_p?format=jpg&name=150x150", "width": 150}], "start": 196, "status": 200, "title": "Central Banks’ Gold Purchases, Gold ETF Inflows Support Global Gold Demand in Third Quarter, WGC Report Shows", "unwound_url": "https://www.yicaiglobal.com/news/central-banks-gold-purchases-gold-etf-inflows-support-global-gold-demand-in-third-quarter-wgc-report-shows", "url": "https://t.co/kIRHbaJp7X"}]}, "id": "2118217558092296474", "public_metrics": {"bookmark_count": 8, "impression_count": 7282, "like_count": 60, "quote_count": 0, "reply_count": 2, "retweet_count": 7}, "text": "Yicai: \"Global demand for gold bars and coins plunged 19 percent to 268 tons in the third quarter from a year earlier. The Chinese market was an exception, with bar and coin demand up 7 percent.\"\nhttps://t.co/kIRHbaJp7X", "url": "https://x.com/michaelxpettis/status/2118217558092296474"}, {"author_id": "14096763", "created_at": "2026-11-05T03:06:58.000Z", "edit_history_tweet_ids": ["2118178229940851114"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "CRWV"}]}, "id": "2118178229940851114", "public_metrics": {"bookmark_count": 6, "impression_count": 31055, "like_count": 113, "quote_count": 2, "reply_count": 24, "retweet_count": 7}, "text": "$CRWV fell nearly 10% today", "url": "https://x.com/TheStalwart/status/2118178229940851114"}, {"author_id": "14096763", "created_at": "2026-11-05T02:43:17.000Z", "edit_history_tweet_ids": ["2118172271814525368"], "entities": {"urls": [{"display_url": "pic.x.com/4XFurTmAhL", "end": 23, "expanded_url": "https://x.com/TheStalwart/status/2118172271814525368/photo/1", "media_key": "3_2118172266978594816", "start": 0, "url": "https://t.co/4XFurTmAhL"}, {"display_url": "x.com/cd_hooks/statu…", "end": 47, "expanded_url": "https://twitter.com/cd_hooks/status/2117847334788714691", "start": 24, "url": "https://t.co/1mYWZ1jaTz"}]}, "id": "2118172271814525368", "public_metrics": {"bookmark_count": 48, "impression_count": 42619, "like_count": 281, "quote_count": 1, "reply_count": 8, "retweet_count": 15}, "referenced_tweets": [{"id": "2117847334788714691", "type": "quoted"}], "text": "https://t.co/4XFurTmAhL https://t.co/1mYWZ1jaTz", "url": "https://x.com/TheStalwart/status/2118172271814525368"}, {"author_id": "733647469305864195", "created_at": "2026-11-05T02:37:46.000Z", "edit_history_tweet_ids": ["2118170880983359898"], "entities": {"urls": [{"display_url": "pic.x.com/1K7nEsKHhN", "end": 257, "expanded_url": "https://x.com/Brad_Setser/status/2118170880983359898/photo/1", "media_key": "3_2118170812188418048", "start": 234, "url": "https://t.co/1K7nEsKHhN"}]}, "id": "2118170880983359898", "public_metrics": {"bookmark_count": 14, "impression_count": 10807, "like_count": 72, "quote_count": 0, "reply_count": 7, "retweet_count": 21}, "text": "Korea's September current account surplus was $60 billion and the q3 surplus was $150b ($600b annualized/ close to 30% of GDP) so the hockey sticky ~$400b surplus over the last 12ms isn't going to be the peak surplus by any means\n\n1/ https://t.co/1K7nEsKHhN", "url": "https://x.com/Brad_Setser/status/2118170880983359898"}, {"author_id": "14096763", "created_at": "2026-11-05T02:18:42.000Z", "edit_history_tweet_ids": ["2118166084998287460"], "entities": {"urls": [{"display_url": "x.com/howdymary/stat…", "end": 67, "expanded_url": "https://twitter.com/howdymary/status/2118165745351991483", "start": 44, "url": "https://t.co/0x4mffgnyL"}]}, "id": "2118166084998287460", "public_metrics": {"bookmark_count": 45, "impression_count": 60514, "like_count": 376, "quote_count": 9, "reply_count": 27, "retweet_count": 17}, "referenced_tweets": [{"id": "2118165745351991483", "type": "quoted"}], "text": "Been saying this for years. Visit Malaysia. https://t.co/0x4mffgnyL", "url": "https://x.com/TheStalwart/status/2118166084998287460"}, {"author_id": "702235316812275712", "created_at": "2026-11-05T01:51:18.000Z", "edit_history_tweet_ids": ["2118159188929257571"], "entities": {"urls": [{"display_url": "x.com/MattGlassman31…", "end": 25, "expanded_url": "https://twitter.com/MattGlassman312/status/2118008929976270882", "start": 2, "url": "https://t.co/1sIun6DWM9"}]}, "id": "2118159188929257571", "public_metrics": {"bookmark_count": 0, "impression_count": 3280, "like_count": 4, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "referenced_tweets": [{"id": "2118008929976270882", "type": "quoted"}], "text": "😬 https://t.co/1sIun6DWM9", "url": "https://x.com/EconBerger/status/2118159188929257571"}, {"author_id": "702235316812275712", "created_at": "2026-11-05T00:43:20.000Z", "edit_history_tweet_ids": ["2118142085392195980"], "entities": {"urls": [{"display_url": "pic.x.com/3mptiWnMba", "end": 297, "expanded_url": "https://x.com/EconBerger/status/2118142085392195980/photo/1", "media_key": "3_2118141482192510976", "start": 274, "url": "https://t.co/3mptiWnMba"}, {"display_url": "pic.x.com/3mptiWnMba", "end": 297, "expanded_url": "https://x.com/EconBerger/status/2118142085392195980/photo/1", "media_key": "3_2118141482133843968", "start": 274, "url": "https://t.co/3mptiWnMba"}]}, "id": "2118142085392195980", "public_metrics": {"bookmark_count": 3, "impression_count": 3574, "like_count": 45, "quote_count": 0, "reply_count": 2, "retweet_count": 5}, "text": "OK, here's a non-partisan politics take.\n\nWe've exited the low-unemployment-and-inflation macro near-utopia of the late 2010s.\n\nIf we're lucky, we're back in the late 1980s / early 1990s environment of mild macro policy tradeoffs.\n\nIf unlucky, the tradeoffs are more severe https://t.co/3mptiWnMba", "url": "https://x.com/EconBerger/status/2118142085392195980"}, {"author_id": "733647469305864195", "created_at": "2026-11-05T00:36:53.000Z", "edit_history_tweet_ids": ["2118140461856772268"], "entities": {"urls": [{"display_url": "x.com/stephenfgordon…", "end": 291, "expanded_url": "https://twitter.com/stephenfgordon/status/2118095986233139246", "start": 268, "url": "https://t.co/Ji4bjvEkQ0"}]}, "id": "2118140461856772268", "public_metrics": {"bookmark_count": 9, "impression_count": 9154, "like_count": 39, "quote_count": 0, "reply_count": 1, "retweet_count": 3}, "referenced_tweets": [{"id": "2118095986233139246", "type": "quoted"}], "text": "Not entirely true. The China 301 tariffs stayed generally speaking.  But the steel and aluminum partially rolled back with tariff rate quotas for USMCA countries and allies.  And for the other trade disputes where Trump 1 was primed for new tariffs (Vietnam currency, https://t.co/Ji4bjvEkQ0", "url": "https://x.com/Brad_Setser/status/2118140461856772268"}, {"author_id": "961132338", "created_at": "2026-11-04T22:57:53.000Z", "edit_history_tweet_ids": ["2118115547238048088"], "entities": {"urls": [{"display_url": "pic.x.com/dOgx22umQz", "end": 60, "expanded_url": "https://x.com/M_C_Klein/status/2118115547238048088/photo/1", "media_key": "3_2118115335148883968", "start": 37, "url": "https://t.co/dOgx22umQz"}, {"display_url": "pic.x.com/dOgx22umQz", "end": 60, "expanded_url": "https://x.com/M_C_Klein/status/2118115547238048088/photo/1", "media_key": "3_2118115474731139072", "start": 37, "url": "https://t.co/dOgx22umQz"}]}, "id": "2118115547238048088", "public_metrics": {"bookmark_count": 0, "impression_count": 2337, "like_count": 8, "quote_count": 0, "reply_count": 2, "retweet_count": 1}, "text": "Seems like it worked out in the end? https://t.co/dOgx22umQz", "url": "https://x.com/M_C_Klein/status/2118115547238048088"}, {"author_id": "14096763", "created_at": "2026-11-04T22:49:13.000Z", "edit_history_tweet_ids": ["2118113364002107587"], "entities": {"urls": [{"description": "NYC Parks offered to remove the calisthenics park from the scope of its project. Please attend the CB3 meeting and support this option.", "display_url": "savetsp.github.io", "end": 114, "expanded_url": "https://savetsp.github.io/", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2118113409111920640/-JTkS_q_?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2118113409111920640/-JTkS_q_?format=jpg&name=150x150", "width": 150}], "start": 91, "status": 200, "title": "Save the Bars", "unwound_url": "https://savetsp.github.io/", "url": "https://t.co/JP5clX8vf1"}]}, "id": "2118113364002107587", "public_metrics": {"bookmark_count": 3, "impression_count": 13628, "like_count": 40, "quote_count": 0, "reply_count": 5, "retweet_count": 1}, "text": "Want to learn more about the Tompkins Square exercise bars? Updated information page here. https://t.co/JP5clX8vf1", "url": "https://x.com/TheStalwart/status/2118113364002107587"}, {"author_id": "14096763", "created_at": "2026-11-04T22:20:31.000Z", "edit_history_tweet_ids": ["2118106141440012796"], "entities": {"mentions": [{"end": 28, "id": "4188045073", "start": 18, "username": "jordihays"}], "urls": [{"display_url": "pic.x.com/wzma1oMJW9", "end": 237, "expanded_url": "https://x.com/TheStalwart/status/2118106141440012796/photo/1", "media_key": "3_2118106133176930304", "start": 214, "url": "https://t.co/wzma1oMJW9"}, {"display_url": "x.com/jukan05/status…", "end": 261, "expanded_url": "https://twitter.com/jukan05/status/2117636820272062972", "start": 238, "url": "https://t.co/HCn7nGiwgl"}]}, "id": "2118106141440012796", "public_metrics": {"bookmark_count": 93, "impression_count": 41990, "like_count": 210, "quote_count": 4, "reply_count": 27, "retweet_count": 12}, "referenced_tweets": [{"id": "2117636820272062972", "type": "quoted"}], "text": "Interesting post. @jordihays was also talking about this, whether there has to some new thing beyond coding. Intuitively maybe personal assistant bots, but as Elon said, the the Grok Bot hasn’t had good economics. https://t.co/wzma1oMJW9 https://t.co/HCn7nGiwgl", "url": "https://x.com/TheStalwart/status/2118106141440012796"}, {"author_id": "14096763", "created_at": "2026-11-04T22:18:07.000Z", "edit_history_tweet_ids": ["2118105538625957941"], "id": "2118105538625957941", "public_metrics": {"bookmark_count": 41, "impression_count": 41338, "like_count": 909, "quote_count": 1, "reply_count": 47, "retweet_count": 21}, "text": "Now that the GOP literally has to start over, I wonder if social conservatives will try to establish a role again. \n\nMaybe they’d have done better if the party weren’t associated with gambling apps, a President fixated on male bodies, big donors with multiple divorces etc.", "url": "https://x.com/TheStalwart/status/2118105538625957941"}, {"author_id": "14096763", "created_at": "2026-11-04T22:01:24.000Z", "edit_history_tweet_ids": ["2118101333437739215"], "entities": {"mentions": [{"end": 38, "id": "20263710", "start": 31, "username": "rabois"}], "urls": [{"display_url": "pic.x.com/21LboKlsPi", "end": 62, "expanded_url": "https://x.com/TheStalwart/status/2118101333437739215/photo/1", "media_key": "3_2118101327179845634", "start": 39, "url": "https://t.co/21LboKlsPi"}]}, "id": "2118101333437739215", "public_metrics": {"bookmark_count": 27, "impression_count": 55998, "like_count": 1420, "quote_count": 3, "reply_count": 48, "retweet_count": 46}, "text": "Totally forgot about this from @rabois https://t.co/21LboKlsPi", "url": "https://x.com/TheStalwart/status/2118101333437739215"}, {"author_id": "702235316812275712", "created_at": "2026-11-04T21:34:01.000Z", "edit_history_tweet_ids": ["2118094439822623024"], "entities": {"urls": [{"display_url": "x.com/brivael/status…", "end": 294, "expanded_url": "https://twitter.com/brivael/status/2117917230394376467", "start": 271, "url": "https://t.co/Cb1ZbezdUO"}]}, "id": "2118094439822623024", "public_metrics": {"bookmark_count": 0, "impression_count": 5729, "like_count": 87, "quote_count": 0, "reply_count": 8, "retweet_count": 3}, "referenced_tweets": [{"id": "2117917230394376467", "type": "quoted"}], "text": "It's not easy or politically costless, and am open to the possibility that it's harder than in the past, but the claim that \"the government can't fix its own deficit\" is flatly belied by the historical record which includes plenty of successful deficit reduction efforts https://t.co/Cb1ZbezdUO", "url": "https://x.com/EconBerger/status/2118094439822623024"}, {"author_id": "733647469305864195", "created_at": "2026-11-04T21:12:13.000Z", "edit_history_tweet_ids": ["2118088953924325614"], "entities": {"urls": [{"display_url": "pic.x.com/MFK75XdbYJ", "end": 279, "expanded_url": "https://x.com/Brad_Setser/status/2118088953924325614/photo/1", "media_key": "3_2118088831953973249", "start": 256, "url": "https://t.co/MFK75XdbYJ"}]}, "id": "2118088953924325614", "public_metrics": {"bookmark_count": 5, "impression_count": 8004, "like_count": 49, "quote_count": 0, "reply_count": 3, "retweet_count": 8}, "text": "For those interested in the simple effective tariff rate (tariffs collected divided by imports, so this misses the impact of a prohibitive tariff), see the chart below\n\nThe effective tariff on China is now down to around 20%, + 10% in the second term\n\n1/2 https://t.co/MFK75XdbYJ", "url": "https://x.com/Brad_Setser/status/2118088953924325614"}, {"author_id": "702235316812275712", "created_at": "2026-11-04T20:57:23.000Z", "edit_history_tweet_ids": ["2118085220230643764"], "entities": {"urls": [{"display_url": "pic.x.com/lPLL0t2wnt", "end": 230, "expanded_url": "https://x.com/EconBerger/status/2118085220230643764/photo/1", "media_key": "3_2118085206129487872", "start": 207, "url": "https://t.co/lPLL0t2wnt"}]}, "id": "2118085220230643764", "public_metrics": {"bookmark_count": 8, "impression_count": 3370, "like_count": 29, "quote_count": 0, "reply_count": 5, "retweet_count": 4}, "text": "Indeed job postings update:\n\n1/ Software postings still zooming... at recent growth rates, less than a year away from returning to their pre-pandemic level.  (Obviously the post-pandemic peak is eons away.) https://t.co/lPLL0t2wnt", "url": "https://x.com/EconBerger/status/2118085220230643764"}, {"author_id": "733647469305864195", "created_at": "2026-11-04T20:50:19.000Z", "edit_history_tweet_ids": ["2118083443519361059"], "entities": {"urls": [{"display_url": "pic.x.com/rOqS2SxW9d", "end": 272, "expanded_url": "https://x.com/Brad_Setser/status/2118083443519361059/photo/1", "media_key": "3_2118083436191657984", "start": 249, "url": "https://t.co/rOqS2SxW9d"}]}, "id": "2118083443519361059", "public_metrics": {"bookmark_count": 12, "impression_count": 9233, "like_count": 37, "quote_count": 1, "reply_count": 6, "retweet_count": 8}, "text": "The amount of volatility in the US trade deficit (and specifically the non-petrol deficit) in the last 7 years has been kind of crazy -- COVID, the surge in goods imports during the lockdown, tariff front running, and now the crazy AI spend ...\n\n1/ https://t.co/rOqS2SxW9d", "url": "https://x.com/Brad_Setser/status/2118083443519361059"}, {"author_id": "733647469305864195", "created_at": "2026-11-04T20:38:54.000Z", "edit_history_tweet_ids": ["2118080567891615887"], "entities": {"urls": [{"display_url": "x.com/ChorzempaMarti…", "end": 120, "expanded_url": "https://twitter.com/ChorzempaMartin/status/2117995262375526706", "start": 97, "url": "https://t.co/pqHGCZhNCL"}]}, "id": "2118080567891615887",