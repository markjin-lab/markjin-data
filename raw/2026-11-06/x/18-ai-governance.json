{"data": [{"author_id": "2023702578836779008", "created_at": "2026-11-05T09:00:46.000Z", "edit_history_tweet_ids": ["2118267267548946817"], "id": "2118267267548946817", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Thirteen frontier AI models were run through ten workplace simulations and graded against the EU AI Act and GDPR. The best reached 63% legal compliance. The lowest reached 7%. On Article 5 prohibited practices, models violated provisions in 80% of runs.", "url": "https://x.com/moltrust/status/2118267267548946817"}, {"author_id": "1036176763628400640", "created_at": "2026-11-05T01:27:40.000Z", "edit_history_tweet_ids": ["2118153238440518000"], "id": "2118153238440518000", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Gobind chairs academic roundtable on the Malaysia AI Safety Institute (MY-AISafe), saying regulation alone is not enough to build public confidence in AI. https://t.co/vZlgghoFrJ", "entities": {"urls": [{"display_url": "pic.x.com/vZlgghoFrJ", "end": 178, "expanded_url": "https://x.com/lifenewscomx/status/2118153238440518000/photo/1", "media_key": "3_2118153151760969728", "start": 155, "url": "https://t.co/vZlgghoFrJ"}]}, "url": "https://x.com/lifenewscomx/status/2118153238440518000"}, {"author_id": "180748385", "created_at": "2026-11-05T11:40:00.000Z", "edit_history_tweet_ids": ["2118307337647624464"], "id": "2118307337647624464", "public_metrics": {"bookmark_count": 1, "impression_count": 521, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "The next phase of #AI competition will not only be about building powerful models, but also about governing them responsibly. #India needs an AI Safety Institute that can set benchmarks relevant for the Global South: @Rudra_81 https://t.co/ZdKyf1yzME", "entities": {"hashtags": [{"end": 21, "start": 18, "tag": "AI"}, {"end": 132, "start": 126, "tag": "India"}], "mentions": [{"end": 226, "id": "719200613", "start": 217, "username": "Rudra_81"}], "urls": [{"description": "India Must Urgently Build Its Own AI Safety Institute", "display_url": "or-f.org/40560", "end": 250, "expanded_url": "https://or-f.org/40560", "images": [{"height": 613, "url": "https://pbs.twimg.com/news_img/2116334384181563392/fuw7j7rp?format=jpg&name=orig", "width": 871}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116334384181563392/fuw7j7rp?format=jpg&name=150x150", "width": 150}], "start": 227, "status": 200, "title": "India Must Urgently Build Its Own AI Safety Institute", "unwound_url": "https://www.orfonline.org/research/india-must-urgently-build-its-own-ai-safety-institute", "url": "https://t.co/ZdKyf1yzME"}]}, "url": "https://x.com/orfonline/status/2118307337647624464"}, {"author_id": "3869030112", "created_at": "2026-11-04T22:00:01.000Z", "edit_history_tweet_ids": ["2118100982999732701"], "id": "2118100982999732701", "public_metrics": {"bookmark_count": 0, "impression_count": 31, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "From civilian applications to defence systems, #AI safety requires trusted evaluation. #India’s proposed AI Safety Institute can help build benchmarks, test models and ensure the country has a voice in shaping global AI governance: @Rudra_81 https://t.co/Jd7O7AY1sW", "entities": {"hashtags": [{"end": 50, "start": 47, "tag": "AI"}, {"end": 93, "start": 87, "tag": "India"}], "mentions": [{"end": 241, "id": "719200613", "start": 232, "username": "Rudra_81"}], "urls": [{"description": "India Must Urgently Build Its Own AI Safety Institute", "display_url": "or-f.org/40560", "end": 265, "expanded_url": "https://or-f.org/40560", "images": [{"height": 613, "url": "https://pbs.twimg.com/news_img/2116334384181563392/fuw7j7rp?format=jpg&name=orig", "width": 871}, {"height": 150, "url": "https://pbs.twi