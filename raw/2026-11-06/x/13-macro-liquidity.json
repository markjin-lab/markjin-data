nt": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Are you paying attention to the Reverse Repo?\n\nhttps://t.co/k8zLJLZP8Z\n\n$NQ $ES $GC https://t.co/JwKG1rG32x", "entities": {"cashtags": [{"end": 75, "start": 72, "tag": "NQ"}, {"end": 79, "start": 76, "tag": "ES"}, {"end": 83, "start": 80, "tag": "GC"}], "urls": [{"description": "Overnight Reverse Repurchase Agreements: Treasury Securities Sold by the Federal Reserve in the Temporary Open Market Operations", "display_url": "fred.stlouisfed.org/series/RRPONTS…", "end": 70, "expanded_url": "https://fred.stlouisfed.org/series/RRPONTSYD", "start": 47, "status": 200, "title": "FRED Economic Data", "unwound_url": "https://fred.stlouisfed.org/series/RRPONTSYD", "url": "https://t.co/k8zLJLZP8Z"}, {"display_url": "pic.x.com/JwKG1rG32x", "end": 107, "expanded_url": "https://x.com/livefreeordie_t/status/2117803235792859551/photo/1", "media_key": "3_2117803140728999936", "start": 84, "url": "https://t.co/JwKG1rG32x"}]}, "url": "https://x.com/livefreeordie_t/status/2117803235792859551"}, {"author_id": "2109736399247171584", "created_at": "2026-11-05T13:00:07.000Z", "edit_history_tweet_ids": ["2118327499163685020"], "id": "2118327499163685020", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Between 2021 and 2023, over $2.5 trillion of cash sat overnight at the Fed's reverse repo facility. Then it started to leave. https://t.co/VGxFqjKUXa", "entities": {"urls": [{"display_url": "pic.x.com/VGxFqjKUXa", "end": 149, "expanded_url": "https://x.com/nyquist_hq/status/2118327499163685020/photo/1", "media_key": "3_2118327496315715584", "start": 126, "url": "https://t.co/VGxFqjKUXa"}]}, "url": "https://x.com/nyquist_hq/status/2118327499163685020"}, {"author_id": "1352962329642721280", "created_at": "2026-11-04T16:28:51.000Z", "edit_history_tweet_ids": ["2118017641025568834"], "id": "2118017641025568834", "public_metr