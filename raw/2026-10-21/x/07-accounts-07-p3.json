{"data":[{"author_id":"626660983","created_at":"2026-10-20T12:43:45.000Z","edit_history_tweet_ids":["2112525176151896199"],"id":"2112525176151896199","public_metrics":{"bookmark_count":0,"impression_count":4006,"like_count":13,"quote_count":0,"reply_count":1,"retweet_count":0},"referenced_tweets":[{"id":"2112364168997154993","type":"quoted"}],"text":"I FOR SURE was running a fever on Sunday, but the gun said “you’re fine.” Then huge sweats yesterday afternoon as the fever CLEARLY broke; the whole time the gun said “no fever.” https://t.co/okG49G5Prq","url":"https://x.com/lymanstoneky/status/2112525176151896199"},{"author_id":"626660983","created_at":"2026-10-20T12:39:00.000Z","edit_history_tweet_ids":["2112523980980842985"],"id":"2112523980980842985","public_metrics":{"bookmark_count":1,"impression_count":857,"like_count":8,"quote_count":0,"reply_count":1,"retweet_count":1},"referenced_tweets":[{"id":"2112514435374055488","type":"quoted"}],"text":"When I told the survey company, “yes, we need the survey translated into three different Chinese language standards” they really did look at me funny https://t.co/jijfbaKkNb","url":"https://x.com/lymanstoneky/status/2112523980980842985"},{"attachments":{"media_keys":["3_2112519158415908864"]},"author_id":"21436960","created_at":"2026-10-20T12:26:57.000Z","edit_history_tweet_ids":["2112520947643343162"],"id":"2112520947643343162","public_metrics":{"bookmark_count":8,"impression_count":10756,"like_count":79,"quote_count":4,"reply_count":1,"retweet_count":18},"text":"Join us live on 22 October at 14:00 CEST for a media briefing on the main outcomes of the 350th ESA Council, taking place this week at ESA Headquarters in Paris.\n\nWatch live: https://t.co/E4aFrlSLJm https://t.co/UmW46PgP2H","url":"https://x.com/esa/status/2112520947643343162"},{"attachments":{"media_keys":["3_2112515189815775232"]},"author_id":"21436960","created_at":"2026-10-20T12:07:06.000Z","edit_history_tweet_ids":["2112515951249768470"],"id":"2112515951249768470","public_metrics":{"bookmark_count":4,"impression_count":9911,"like_count":177,"quote_count":1,"reply_count":6,"retweet_count":27},"text":"Galileo Second Generation is taking shape. 🛰️\n\nA new signal generation module, designed to be reprogrammed in orbit, will bring greater flexibility, accuracy and resilience to Europe’s satellite navigation system.\n\nRead more: https://t.co/PV1VUbo2Rj\n\n@EU_Commission | @EU4Space | https://t.co/R2lHmLEtEp","url":"https://x.com/esa/status/2112515951249768470"},{"attachments":{"media_keys":["3_2112515220706856962"]},"author_id":"17217640","created_at":"2026-10-20T12:04:14.000Z","edit_history_tweet_ids":["2112515232710934677"],"id":"2112515232710934677","public_metrics":{"bookmark_count":2,"impression_count":5797,"like_count":50,"quote_count":0,"reply_count":0,"retweet_count":5},"text":"The deployment sequence for the Bandwagon-5 mission is underway.\n\nWatch live: https://t.co/mrIX3WHzCR https://t.co/B0f9lWKLmK","url":"https://x.com/SpaceflightNow/status/2112515232710934677"},{"author_id":"34743251","created_at":"2026-10-20T12:01:50.000Z","edit_history_tweet_ids":["2112514626256884044"],"id":"2112514626256884044","public_metrics":{"bookmark_count":66,"impression_count":964318,"like_count":4910,"quote_count":16,"reply_count":121,"retweet_count":261},"text":"Rideshare deployment sequence has started","url":"https://x.com/SpaceX/status/2112514626256884044"},{"attachments":{"media_keys":["13_2112502454084313088"]},"author_id":"34743251","created_at":"2026-10-20T11:13:49.000Z","edit_history_tweet_ids":["2112502543947325773"],"id":"2112502543947325773","public_metrics":{"bookmark_count":145,"impression_count":712499,"like_count":7134,"quote_count":99,"reply_count":339,"retweet_count":777},"text":"Falcon 9’s first stage has landed on the A Shortfall of Gravitas droneship https://t.co/2sNXK5qRQZ","url":"https://x.com/SpaceX/status/2112502543947325773"},{"attachments":{"media_keys":["3_2112500414713110528"]},"author_id":"17217640","created_at":"2026-10-20T11:05:30.000Z","edit_history_tweet_ids":["2112500451665154193"],"id":"2112500451665154193","public_metrics":{"bookmark_count":1,"impression_count":6567,"like_count":68,"quote_count":1,"reply_count":2,"retweet_count":8},"text":"Liftoff of Bandwagon-5!\n\n32 payloads lifted off on a Falcon 9 rocket from Cape Canaveral Space Force Station at 7:04 a.m. EDT (1104 UTC).\n\nWatch live: https://t.co/mrIX3WI7sp https://t.co/xRNUS79OPu","url":"https://x.com/SpaceflightNow/status/2112500451665154193"},{"attachments":{"media_keys":["13_2112500212237312001"]},"author_id":"34743251","created_at":"2026-10-20T11:04:46.000Z","edit_history_tweet_ids":["2112500266289213814"],"id":"2112500266289213814","public_metrics":{"bookmark_count":333,"impression_count":818423,"like_count":13646,"quote_count":159,"reply_count":430,"retweet_count":1331},"text":"Liftoff! https://t.co/283VxZH6Yc","url":"https://x.com/SpaceX/status/2112500266289213814"},{"attachments":{"media_keys":["3_2112498345184735232"]},"author_id":"34743251","created_at":"2026-10-20T10:58:47.000Z","edit_history_tweet_ids":["2112498759854661751"],"id":"2112498759854661751","public_metrics":{"bookmark_count":302,"impression_count":432799,"like_count":7364,"quote_count":62,"reply_count":204,"retweet_count":554},"text":"Starfall enables affordable, routine access to a microgravity environment, providing unique opportunities for on-orbit manufacturing, scientific research, and testing https://t.co/y8kJg3QDor","url":"https://x.com/SpaceX/status/2112498759854661751"},{"author_id":"34743251","created_at":"2026-10-20T10:53:57.000Z","edit_history_tweet_ids":["2112497542114214023"],"id":"2112497542114214023","public_metrics":{"bookmark_count":742,"impression_count":531280,"like_count":11172,"quote_count":178,"reply_count":612,"retweet_count":1443},"text":"Watch Falcon 9 launch the Bandwagon-5 mission to orbit https://t.co/LWGBC2Lzi4","url":"https://x.com/SpaceX/status/2112497542114214023"},{"attachments":{"media_keys":["3_2112495815268700160"]},"author_id":"17217640","created_at":"2026-10-20T10:47:08.000Z","edit_history_tweet_ids":["2112495828829102295"],"id":"2112495828829102295","public_metrics":{"bookmark_count":0,"impression_count":6756,"like_count":25,"quote_count":1,"reply_count":2,"retweet_count":4},"text":"The big vent is underway as SpaceX prepares to load liquid oxygen on the Falcon 9 rocket's second stage. Liftoff of the Bandwagon-5 mission is set for 7:04 a.m. EDT (1104 UTC).\n\nWatch live: https://t.co/mrIX3WI7sp https://t.co/ta6zibKSKz","url":"https://x.com/SpaceflightNow/status/2112495828829102295"},{"attachments":{"media_keys":["3_2112488892045611008"]},"author_id":"34743251","created_at":"2026-10-20T10:19:43.000Z","edit_history_tweet_ids":["2112488927101661622"],"id":"2112488927101661622","public_metrics":{"bookmark_count":96,"impression_count":457526,"like_count":4175,"quote_count":46,"reply_count":211,"retweet_count":451},"text":"T-45 minutes until today’s Falcon 9 launch of the Bandwagon-5 rideshare mission from pad 40 in Florida. Liftoff is targeted for 7:04 a.m. ET, and weather is 95% favorable https://t.co/q4vYQLWEfg","url":"https://x.com/SpaceX/status/2112488927101661622"},{"author_id":"17217640","created_at":"2026-10-20T10:00:15.000Z","edit_history_tweet_ids":["2112484028230099301"],"id":"2112484028230099301","public_metrics":{"bookmark_count":1,"impression_count":11886,"like_count":35,"quote_count":1,"reply_count":0,"retweet_count":10},"text":"SpaceX is flying 31 payloads to orbit this morning along with its own Starfall reentry capsule. Liftoff of the Bandwagon-5 mission from pad 40 at Cape Canaveral Space Force Station is scheduled for 7:04 a.m. EDT (1104 UTC).\n\nWatch live: https://t.co/mrIX3WHzCR","url":"https://x.com/SpaceflightNow/status/2112484028230099301"},{"attachments":{"media_keys":["3_2112477629035028480"]},"author_id":"17217640","created_at":"2026-10-20T09:34:59.000Z","edit_history_tweet_ids":["2112477670047142328"],"id":"2112477670047142328","public_metrics":{"bookmark_count":3,"impression_count":10396,"like_count":49,"quote_count":3,"reply_count":0,"retweet_count":9},"text":"SpaceX shifted the T-0 liftoff time for the Bandwagon-5 rideshare mission. Launch of the Falcon 9 rocket from pad 40 at Cape Canaveral Space Force Station is now scheduled for 7:04 a.m. EDT (1104 UTC).\n\nBackground: https://t.co/TB6HQIYoPa https://t.co/twMSYjCuIK","url":"https://x.com/SpaceflightNow/status/2112477670047142328"},{"author_id":"626660983","created_at":"2026-10-20T01:07:41.000Z","edit_history_tweet_ids":["2112350007328477550"],"id":"2112350007328477550","public_metrics":{"bookmark_count":13,"impression_count":21449,"like_count":193,"quote_count":3,"reply_count":17,"retweet_count":2},"referenced_tweets":[{"id":"2112318687906570699","type":"quoted"}],"text":"I’m very anti night nurse. The midnight wake ups are part of bonding. https://t.co/2RLYbk5G2c","url":"https://x.com/lymanstoneky/status/2112350007328477550"},{"author_id":"626660983","created_at":"2026-10-20T00:50:12.000Z","edit_history_tweet_ids":["2112345607067082810"],"id":"2112345607067082810","public_metrics":{"bookmark_count":4,"impression_count":7464,"like_count":179,"quote_count":0,"reply_count":3,"retweet_count":10},"referenced_tweets":[{"id":"2112281035946000814","type":"quoted"}],"text":"Tells you all you need to know about Trump and the party https://t.co/AJd90d1kno","url":"https://x.com/lymanstoneky/status/2112345607067082810"},{"author_id":"626660983","created_at":"2026-10-19T23:47:46.000Z","edit_history_tweet_ids":["2112329892083728813"],"id":"2112329892083728813","public_metrics":{"bookmark_count":4,"impression_count":1808,"like_count":18,"quote_count":0,"reply_count":0,"retweet_count":0},"referenced_tweets":[{"id":"2112188619519656395","type":"quoted"}],"text":"Actually this data is wrong.\n\nFor the entire later 20th century and into the 21st, having 3+ kids was U shaped with income, and it did not decline 1995-2025!\n\nhttps://t.co/iaxi5aCPJa https://t.co/EEtAwr2pGU","url":"https://x.com/lymanstoneky/status/2112329892083728813"},{"author_id":"626660983","created_at":"2026-10-19T21:56:35.000Z","edit_history_tweet_ids":["2112301914184429940"],"id":"2112301914184429940","public_metrics":{"bookmark_count":2,"impression_count":2558,"like_count":6,"quote_count":0,"reply_count":5,"retweet_count":0},"referenced_tweets":[{"id":"2112180695481352347","type":"quoted"}],"text":"So, @mtkonczal is basically right that big families are a luxury good-- but he's not right about there being a decline in big families!\n\nI replicate and extend here: https://t.co/91D5cH2cSP\n\nAlso kudos @mtkonczal ; my Claude appreciated his LLM's method sheet. https://t.co/bHJWzsfzqH","url":"https://x.com/lymanstoneky/status/2112301914184429940"},{"author_id":"626660983","created_at":"2026-10-19T21:52:22.000Z","edit_history_tweet_ids":["2112300853927592329"],"id":"2112300853927592329","public_metrics":{"bookmark_count":33,"impression_count":11555,"like_count":134,"quote_count":1,"reply_count":2,"retweet_count":12},"referenced_tweets":[{"id":"2112296734856446264","type":"quoted"}],"text":"This is honestly delightful. Great way to show skeptical boomers how the math works! https://t.co/jIj0kzbb3i","url":"https://x.com/lymanstoneky/status/2112300853927592329"},{"author_id":"626660983","created_at":"2026-10-19T21:50:28.000Z","edit_history_tweet_ids":["2112300372375072903"],"id":"2112300372375072903","public_metrics":{"bookmark_count":13,"impression_count":4300,"like_count":15,"quote_count":0,"reply_count":0,"retweet_count":0},"referenced_tweets":[{"id":"2112296734856446264","type":"quoted"}],"text":"this is fantastic https://t.co/jIj0kzaDdK","url":"https://x.com/lymanstoneky/status/2112300372375072903"},{"author_id":"19355829","created_at":"2026-10-19T20:55:41.000Z","edit_history_tweet_ids":["2112286585584779768"],"id":"2112286585584779768","public_metrics":{"bookmark_count":4,"impression_count":9897,"like_count":235,"quote_count":1,"reply_count":3,"retweet_count":19},"text":"SECO-2, spacecraft separation: MMX and the H3 second stage are on an Earth escape hyperbola with C3=9.97 km2/s2","url":"https://x.com/planet4589/status/2112286585584779768"},{"author_id":"19355829","created_at":"2026-10-19T19:59:40.000Z","edit_history_tweet_ids":["2112272489095282937"],"id":"2112272489095282937","public_metrics":{"bookmark_count":11,"impression_count":9042,"like_count":136,"quote_count":1,"reply_count":4,"retweet_count":10},"text":"Finally on the launch webcast a clearer explanation of the mission profile: the PM is jettisoned into Mars orbit before arrival at Phobos; the EM is jettisoned into Mars orbit prior to RM's Mars orbit departure (but I suspect after Deimos encounter?)","url":"https://x.com/planet4589/status/2112272489095282937"},{"author_id":"626660983","created_at":"2026-10-19T19:50:09.000Z","edit_history_tweet_ids":["2112270095804149822"],"id":"2112270095804149822","public_metrics":{"bookmark_count":0,"impression_count":1246,"like_count":15,"quote_count":0,"reply_count":0,"retweet_count":1},"text":"the ominous build music you hear playing is the leadup to @FamStudies droppin' heat in a new fertility report tomorrow so stay tuned people","url":"https://x.com/lymanstoneky/status/2112270095804149822"},{"attachments":{"media_keys":["13_2112269646258728960"]},"author_id":"17217640","created_at":"2026-10-19T19:48:46.000Z","edit_history_tweet_ids":["2112269747941425455"],"id":"2112269747941425455","public_metrics":{"bookmark_count":28,"impression_count":25287,"like_count":437,"quote_count":13,"reply_count":9,"retweet_count":97},"text":"Liftoff of JAXA’s Martian Moons eXploration (MMX) at 4:41 am JST (3:41 pm ET / 1941 UTC). Separation of the spacecraft is expected about an hour and 11 minutes after liftoff. https://t.co/w3ouwtP2z2","url":"https://x.com/SpaceflightNow/status/2112269747941425455"}],"includes":{"media":[{"media_key":"3_2112519158415908864","type":"photo"},{"media_key":"3_2112515189815775232"