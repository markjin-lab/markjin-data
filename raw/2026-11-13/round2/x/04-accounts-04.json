{"data": [{"author_id": "860158302", "created_at": "2026-11-12T21:50:03.000Z", "edit_history_tweet_ids": ["2120997578061824348"], "entities": {"urls": [{"description": "A new radiation-based mechanism adds to the ways that amino acids could have been made in space and brought to the young Earth.", "display_url": "quantamagazine.org/inside-ancient…", "end": 116, "expanded_url": "https://www.quantamagazine.org/inside-ancient-asteroids-gamma-rays-made-building-blocks-of-life-20230104/", "start": 93, "status": 200, "title": "Inside Ancient Asteroids, Gamma Rays Made Building Blocks of Life | Quanta Magazine", "unwound_url": "https://www.quantamagazine.org/inside-ancient-asteroids-gamma-rays-made-building-blocks-of-life-20230104/", "url": "https://t.co/MG7DggOeYO"}, {"display_url": "pic.x.com/k5eEx6SNW8", "end": 159, "expanded_url": "https://x.com/QuantaMagazine/status/2120997578061824348/photo/1", "media_key": "3_2120997574270177280", "start": 136, "url": "https://t.co/k5eEx6SNW8"}]}, "id": "2120997578061824348", "public_metrics": {"bookmark_count": 1, "impression_count": 1019, "like_count": 5, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "Amino acids are an essential part of life’s chemistry. How do they show up inside asteroids? https://t.co/MG7DggOeYO (From the archive) https://t.co/k5eEx6SNW8", "url": "https://x.com/QuantaMagazine/status/2120997578061824348"}, {"author_id": "860158302", "created_at": "2026-11-12T21:50:02.000Z", "edit_history_tweet_ids": ["2120997574274338861"], "entities": {"urls": [{"description": "Wherever astronomers look, they see life’s raw materials.", "display_url": "quantamagazine.org/the-cosmos-tee…", "end": 168, "expanded_url": "https://www.quantamagazine.org/the-cosmos-teems-with-complex-organic-molecules-20241113/", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2119859114754887680/AyQdtmB2?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2119859114754887680/AyQdtmB2?format=jpg&name=150x150", "width": 150}], "start": 145, "status": 200, "title": "The Cosmos Teems with Complex Organic Molecules | Quanta Magazine", "unwound_url": "https://www.quantamagazine.org/the-cosmos-teems-with-complex-organic-molecules-20241113/", "url": "https://t.co/ql6NLz9v2q"}]}, "id": "2120997574274338861", "public_metrics": {"bookmark_count": 0, "impression_count": 861, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 2}, "text": "Dying stars, frigid clouds and newly forming star systems all may be incubation sites for the complex organic compounds that pervade the cosmos. https://t.co/ql6NLz9v2q (From the archive)", "url": "https://x.com/QuantaMagazine/status/2120997574274338861"}, {"author_id": "860158302", "created_at": "2026-11-12T21:46:52.000Z", "edit_history_tweet_ids": ["2120996777432416599"], "entities": {"mentions": [{"end": 69, "id": "579299426", "start": 54, "username": "stevenstrogatz"}], "urls": [{"description": "Podcast Episode · The Joy of Why · November 12 · 51m", "display_url": "podcasts.apple.com/us/podcast/can…", "end": 252, "expanded_url": "https://podcasts.apple.com/us/podcast/can-network-science-transform-health-and-nutrition/id1608948873?i=1000801499080", "images": [{"height": 1200, "url": "https://pbs.twimg.com/news_img/2120996783577047040/XokINJrU?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120996783577047040/XokINJrU?format=jpg&name=150x150", "width": 150}], "start": 229, "status": 200, "title": "Can Network Science Transform Health and Nutrition?", "unwound_url": "https://podcasts.apple.com/us/podcast/can-network-science-transform-health-and-nutrition/id1608948873?i=1000801499080", "url": "https://t.co/Tq3JMHvQqX"}]}, "id": "2120996777432416599", "public_metrics": {"bookmark_count": 0, "impression_count": 1048, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "On the latest episode of The Joy of Why podcast, host @stevenstrogatz is joined by Albert-László Barabási to discuss network science — and how mapping the networks inside our bodies could change how we treat disease. Listen now: https://t.co/Tq3JMHvQqX", "url": "https://x.com/QuantaMagazine/status/2120996777432416599"}, {"author_id": "28164923", "created_at": "2026-11-12T21:44:50.000Z", "edit_history_tweet_ids": ["2120996264317771903"], "entities": {"urls": [{"description": "Nvidia’s crisis divides the AI trade between companies dependent on Huang’s patronage, and those that didn’t need his chips or financing deals.", "display_url": "on.wsj.com/4iV6RZ3", "end": 180, "expanded_url": "https://on.wsj.com/4iV6RZ3", "images": [{"height": 640, "url": "https://pbs.twimg.com/news_img/2120996267010494464/IADhnpet?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120996267010494464/IADhnpet?format=jpg&name=150x150", "width": 150}], "start": 157, "status": 200, "title": "Jensen Huang’s Exit Will Test AI’s Stocks, and Great-Man Theory", "unwound_url": "https://www.wsj.com/finance/stocks/jensen-huangs-exit-will-test-ais-stocks-and-great-man-theory-3c4cd404?reflink=e2twmkts", "url": "https://t.co/uLJcCy1uTd"}]}, "id": "2120996264317771903", "public_metrics": {"bookmark_count": 1, "impression_count": 2496, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Wall Street once believed the AI boom revolved around Nvidia’s Jensen Huang as planets orbit the sun. The question now is what happens when a star implodes. https://t.co/uLJcCy1uTd", "url": "https://x.com/WSJmarkets/status/2120996264317771903"}, {"author_id": "14499829", "created_at": "2026-11-12T21:30:13.000Z", "edit_history_tweet_ids": ["2120992586705879524"], "entities": {"urls": [{"display_url": "pic.x.com/vsHvDzBczO", "end": 277, "expanded_url": "https://x.com/WHO/status/2120992586705879524/photo/1", "media_key": "3_2120992584201859072", "start": 254, "url": "https://t.co/vsHvDzBczO"}]}, "id": "21