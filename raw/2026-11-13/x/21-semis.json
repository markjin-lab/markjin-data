twimg.com/news_img/2120502031085670400/NWEHJkeL?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120502031085670400/NWEHJkeL?format=jpg&name=150x150", "width": 150}], "start": 80, "status": 200, "title": "【テック分解 No.5】CoWoS（先端パッケージング）とは？ AI半導体が足りない理由は「チップを包む工程」にもあった｜分解テック🌵さぼてん", "unwound_url": "https://note.com/saboten99/n/n04b3262a1cd3", "url": "https://t.co/ikB9uzPuzH"}, {"display_url": "pic.x.com/RZv8UYoLXc", "end": 127, "expanded_url": "https://x.com/bunkai_tech/status/2120502030414549229/photo/1", "media_key": "3_2120502021833068544", "start": 104, "url": "https://t.co/RZv8UYoLXc"}]}, "id": "2120502030414549229", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "【テック分解 No.5】CoWoSとは？ AI半導体が足りない、HBMはどうGPUとつながる、なぜ「包む」工程が主役に。3つの疑問を、6つの図で分解しました。 https://t.co/ikB9uzPuzH https://t.co/RZv8UYoLXc", "url": "https://x.com/bunkai_tech/status/2120502030414549229"}, {"author_id": "2098424533820887040", "created_at": "2026-11-11T12:15:08.000Z", "edit_history_tweet_ids": ["2120490508208472364"], "entities": {"mentions": [{"end": 72, "id": "1720665183188922368", "start": 67, "username": "grok"}], "urls": [{"display_url": "pic.x.com/DW074hkLWd", "end": 246, "expanded_url": "https://x.com/davidsun6366043/status/2120490508208472364/photo/1", "media_key": "3_2120490492391796737", "start": 223, "url": "https://t.co/DW074hkLWd"}]}, "id": "2120490508208472364", "public_metrics": {"bookmark_count": 0, "impression_count": 122, "like_count": 3, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "2026年11月8日腾讯新闻说台积电CoWoS产能紧张、英伟达出资帮日月光扩先进封装。封装环节被写进供应链风险清单，为什么是这一环？ @grok\n\nTencent News on 8 November 2026 said TSMC CoWoS was tight and Nvidia was funding ASE packaging expansion. Packaging joined the supply-risk list, why https://t.co/DW074hkLWd", "url": "https://x.com/davidsun6366043/status/2120490508208472364"}, {"author_id": "200054976697