{"data": [{"author_id": "3290364847", "created_at": "2026-11-12T16:16:42.000Z", "edit_history_tweet_ids": ["2120913687540011465"], "entities": {"urls": [{"description": "The American Cancer Society recommended routine PSA screening for prostate cancer, changing guidelines in place since 2010.", "display_url": "bit.ly/4iWONho", "end": 265, "expanded_url": "https://bit.ly/4iWONho", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2120854640195465216/jN27fPMY?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120854640195465216/jN27fPMY?format=jpg&name=150x150", "width": 150}], "start": 242, "status": 200, "title": "American Cancer Society revises guidelines, urges routine PSA screening for prostate cancer", "unwound_url": "https://www.statnews.com/2026/11/12/prostate-cancer-screening-guidelines-updated-acs/", "url": "https://t.co/gTWiX8pNZn"}]}, "id": "2120913687540011465", "public_metrics": {"bookmark_count": 0, "impression_count": 2719, "like_count": 3, "quote_count": 1, "reply_count": 2, "retweet_count": 1}, "text": "In a major change to screening guidelines, the American Cancer Society recommended that American men between ages 50 and 69 at an average risk of prostate cancer should test their prostate-specific antigen (PSA) blood levels every two years. https://t.co/gTWiX8pNZn", "url": "https://x.com/statnews/status/2120913687540011465"}, {"author_id": "86626845", "created_at": "2026-11-12T16:12:06.000Z", "edit_history_tweet_ids": ["2120912532152213542"], "entities": {"mentions": [{"end": 164, "id": "65134016", "start": 150, "username": "CellCellPress"}], "urls": [{"description": "Liquid biopsies provide a noninvasive way to screen for disease. This review explains how AI-powered multimodal foundation models will help to identify robust tumor signals from liquid biopsies at scale, but clinical and infrastructural hurdles will need to be addressed to deliver their promise to the clinic.", "display_url": "cell.com/cell/fulltext/…", "end": 189, "expanded_url": "https://www.cell.com/cell/fulltext/S0092-8674(26)01274-2", "images": [{"height": 512, "url": "https://pbs.twimg.com/news_img/2120912537025941504/AWotLODp?format=jpg&name=orig", "width": 753}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120912537025941504/AWotLODp?format=jpg&name=150x150", "width": 150}], "start": 166, "status": 200, "title": "Deploying liquid intelligence in cancer: Finding answers in our blood", "unwound_url": "https://www.cell.com/cell/fulltext/S0092-8674(26)01274-2", "url": "https://t.co/PoDyz9S3S6"}, {"display_url": "pic.x.com/ekhEKF0PlH", "end": 213, "expanded_url": "https://x.com/EricTopol/status/2120912532152213542/photo/1", "media_key": "3_2120912367613808640", "start": 190, "url": "https://t.co/ekhEKF0PlH"}]}, "id": "2120912532152213542", "public_metrics": {"bookmark_count": 53, "impression_count": 9950, "like_count": 84, "quote_count": 1, "reply_count": 5, "retweet_count": 24}, "text": "How multimodal AI, combined with blood test omics via \"liquid biopsies,\" will transform cancer monitoring and enable earliest detection. \nopen-access @CellCellPress \nhttps://t.co/PoDyz9S3S6 https://t.co/ekhEKF0PlH", "url": "https://x.com/EricTopol/status/2120912532152213542"}, {"author_id": "3290364847", "created_at": "2026-11-12T16:05:31.000Z", "edit_history_tweet_ids": ["2120910871434027295"], "entities": {"urls": [{"description": "Does Heidi Overton have the votes ? And how will Dems take on RFK Jr.?", "display_url": "trib.al/CYYVdMb", "end": 94, "expanded_url": "https://trib.al/CYYVdMb", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2120910876198727681/r99d71IX?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120910876198727681/r99d71IX?format=jpg&name=150x150", "width": 150}], "start": 71, "status": 200, "title": "Will Heidi Overton get to run the FDA?", "unwound_url": "https://www.statnews.com/2026/11/12/will-heidi-