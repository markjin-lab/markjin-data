{"data": [{"author_id": "1809212258574323712", "created_at": "2026-11-11T21:34:58.000Z", "edit_history_tweet_ids": ["2120631395970392290"], "entities": {"urls": [{"display_url": "pic.x.com/8vATWuoTPY", "end": 302, "expanded_url": "https://x.com/EmberAITech/status/2120631395970392290/photo/1", "media_key": "3_2120631388277727232", "start": 279, "url": "https://t.co/8vATWuoTPY"}]}, "id": "2120631395970392290", "public_metrics": {"bookmark_count": 2, "impression_count": 82, "like_count": 5, "quote_count": 0, "reply_count": 1, "retweet_count": 3}, "text": "Running LLM inference on a unified GPU cluster is an architectural waste.\n\nLLM serving has two fundamentally different compute phases: Prefill and Decode. \n\nPrefill processes the input prompt in parallel. It is compute-bound, demanding massive raw TFLOPS to process thousands of https://t.co/8vATWuoTPY", "url": "https://x.com/EmberAITech/status/2120631395970392290"}, {"author_id": "1600530338920415232", "created_at": "2026-11-10T21:44:48.000Z", "edit_history_tweet_ids": ["2120271481850429777"], "entities": {"urls": [{"display_url": "x.com/zerohedge/stat…", "end": 298, "expanded_url": "https://twitter.com/zerohedge/status/2120264707223470479", "start": 275, "url": "https://t.co/10MWPlg7GT"}]}, "id": "2120271481850429777", "public_metrics": {"bookmark_count": 3, "impression_count": 531, "like_count": 4, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "ZeroHedge highlighting CoreWeave's -$7.5B quarterly cash burn ($14.5B CapEx) exposes the structural divide in AI infrastructure financing:\n\nThe spike in CapEx reflects physical Blackwell GB200 NVL72 rack deliveries hitting datacenter floors. These deployments are funded via https://t.co/10MWPlg7GT", "url": "https://x.com/LiDaosen/status/2120271481850429777"}, {"author_id": "37011010", "created_at": "2026-11-12T16:03:16.000Z", "edit_history_tweet_ids": ["2120910307073618316", "2120911034185601452", "2120911421802197294", "2120913329128345770"], "entiti