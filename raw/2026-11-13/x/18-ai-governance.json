20578888816320514", "start": 278, "url": "https://t.co/jeFwWsP9AE"}]}, "id": "2120578891546788187", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Oracle is bringing frontier AI into the heart of enterprise computing with OpenAI to transform how organizations work. Run your business through ChatGPT. Strengthen security with frontier AI. Turn ideas into enterprise applications. Learn more: https://t.co/ENdUyTMGcj #AIWorld https://t.co/jeFwWsP9AE", "url": "https://x.com/jamieblommaert/status/2120578891546788187"}, {"author_id": "2087567944934981632", "created_at": "2026-11-11T13:09:38.000Z", "edit_history_tweet_ids": ["2120504221615497475"], "entities": {"urls": [{"description": "Governor Hochul launched a first-of-its-kind statewide effort to advance artificial intelligence science and safety – the New York Center for AI Responsibility and Research based at State University of New York’s (SUNY) Binghamton University.", "display_url": "governor.ny.gov/news/governor-…", "end": 274, "expanded_url": "https://www.governor.ny.gov/news/governor-hochul-declares-ny-will-lead-nation-ai-science-and-safety-launches-new-research", "images": [{"height": 400, "url": "https://pbs.twimg.com/news_img/2120264565355159552/bSHdD4wd?format=jpg&name=orig", "width": 660}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120264565355159552/bSHdD4wd?format=jpg&name=150x150", "width": 150}], "start": 251, "status": 200, "title": "Governor Hochul Declares NY Will Lead the Nation in AI Science and Safety; Launches New Research Institute", "unwound_url": "https://www.governor.ny.gov/news/governor-hochul-declares-ny-will-lead-nation-ai-science-and-safety-launches-new-research", "url": "https://t.co/JbilrlOsJE"}]}, "id": "2120504221615497475", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "New York opened RAISE Act registration: large frontier AI developers must sign up by Jan 1 and then report critical safety incidents within 72 hours. It also launched a Binghamton center with 80+ scientists to independently test frontier AI systems.\n\nhttps://t.co/JbilrlOsJE", "url": "https://x.com/peanutkunjan/status/2120504221615497475"}, {"author_id": "1165305169824899073", "created_at": "2026-11-11T16:54:58.000Z", "edit_history_tweet_ids": ["2120560931528745221"], "entities": {"mentions": [{"end": 12, "id": "1909780830597042176", "start": 3, "username": "AVERIorg"}]}, "id": "2120560931528745221", "public_metrics": {"bookmark_count": 2, "impression_count": 919, "like_count": 17, "quote_count": 0, "reply_count": 2, "retweet_count": 3}, "text": "At @AVERIorg, we’re hiring an Audit Manager.\n\nAVERI’s mission is to ensure that the most powerful AI systems, and the companies that build them, are rigorously audited for safety and security. To do so, we run pilot project which break new ground, and help us  develop tools and", "url": "https://x.com/GeorgeBalston/status/2120560931528745221"}, {"author_id": "2112339659732971522", "created_at": "2026-11-12T00:15:51.000Z", "edit_history_tweet_ids": ["2120671881279799807"], "entities": {"urls": [{"description": "By January 1, 2045, will at least one nation-state have enacted a legally… for 'frontier' AI models prior to their public release? — Settled Question in General. 36 Answers.", "display_url": "dialectica.xyz/i/rf_kfSfIBp4X…", "end": 276, "expanded_url": "https://dialectica.xyz/i/rf_kfSfIBp4X0n", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2120671888078700544/SLL5TZ_Z?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120671888078700544/SLL5TZ_Z?format=jpg&name=150x150", "width": 150}], "start": 253, "status": 200, "title": "Will a nation-state mandate safety evaluations for frontier AI models by 2045? — Dialectica", "unwound_url": "https://dialectica.xyz/isr/27751eaf-c52e-40bc-8410-725f22b42e70", "url": "https://t.co/XE7zfNJDzC"}, {"display_url": "pic.x.com/nNopEbSk31", "end": 300, "expanded_url": "https://x.com/DialecticaQA/status/2120671881279799807/photo/1", "media_key": "3_2120671879006466048", "start": 277, "url": "https://t.co/nNopEbSk31"}]}, "id": "2120671881279799807", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Will a nation-state mandate safety evaluations for frontier AI models…\n\nExperts conclude multiple nation-states already mandate safety evaluations for frontier AI models.\n\n15 answers judged. ✅ 11 survived. ❌ 4 didn't.\n\n👇 See what the Experts concluded:\nhttps://t.co/XE7zfNJDzC https://t.co/nNopEbSk31", "url": "https://x.com/DialecticaQA/status/2120671881279799807"}, {"author_id": "1582414884179804160", "created_at": "2026-11-12T07:56:28.000Z", "edit_history_tweet_ids": ["2120787798957441435"], "entities": {"hashtags": [{"end": 277, "start": 269, "tag": "AIWorld"}], "urls": [{"description": "Oracle brings frontier AI into the heart of enterprise computing with OpenAI to transform how organizations work.", "display_url": "social.ora.cl/6019ByGFwH", "end": 268, "expanded_url": "https://social.ora.cl/6019ByGFwH", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2120578898031185921/vO1VSaB9?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120578898031185921/vO1VSaB9?format=jpg&name=150x150", "width": 150}], "start": 245, "status": 200, "title": "Oracle Reinvents Enterprise Computing for the AI Era with OpenAI", "unwound_url": "https://www.oracle.com/news/announcement/ai-world-oracle-reinvents-enterprise-computing-for-the-ai-era-with-openai-2026-10-27/?source=:so:ch:or:awr::::RC_WWMK260421P00055:OpenAI&SC=:so:ch:or:awr::::RC_WWMK260421P00055:OpenAI&pcode=WWMK260421P00055", "url": "https://t.co/BSmK21AC9B"}, {"display_url": "pic.x.com/lfPzyC