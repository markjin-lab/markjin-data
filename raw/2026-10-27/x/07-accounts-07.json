ky/status/2114789984385511788"}, {"author_id": "626660983", "created_at": "2026-10-26T18:27:44.000Z", "edit_history_tweet_ids": ["2114786069946544400"], "entities": {"urls": [{"display_url": "x.com/highbrow_nobro…", "end": 38, "expanded_url": "https://twitter.com/highbrow_nobrow/status/2114190465528389989", "start": 15, "url": "https://t.co/qotnD2MUvR"}]}, "id": "2114786069946544400", "public_metrics": {"bookmark_count": 2, "impression_count": 2745, "like_count": 58, "quote_count": 0, "reply_count": 3, "retweet_count": 5}, "referenced_tweets": [{"id": "2114190465528389989", "type": "quoted"}], "text": "brb saving god https://t.co/qotnD2MUvR", "url": "https://x.com/lymanstoneky/status/2114786069946544400"}, {"author_id": "626660983", "created_at": "2026-10-26T18:22:03.000Z", "edit_history_tweet_ids": ["2114784640481591620"], "entities": {"urls": [{"display_url": "x.com/lymanstoneky/s…", "end": 126, "expanded_url": "https://twitter.com/lymanstoneky/status/2114780407812305358", "start": 103, "url": "https://t.co/zHDueMklu8"}]}, "id": "2114784640481591620", "public_metrics": {"bookmark_count": 2, "impression_count": 807, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2114780407812305358", "type": "quoted"}], "text": "one exciting part of this project was make sure i can spell \"Homonadensian\" correctly on the first try https://t.co/zHDueMklu8", "url": "https://x.com/lymanstoneky/status/2114784640481591620"}, {"author_id": "17217640", "created_at": "2026-10-26T18:17:54.000Z", "edit_history_tweet_ids": ["2114783594388332677"], "entities": {"mentions": [{"end": 36, "id": "26014305", "start": 23, "username": "UAHuntsville"}, {"end": 116, "id": "12701122", "start": 103, "username": "astrosociety"}, {"end": 158, "id": "1700538650", "start": 142, "username": "w_robinsonsmith"}], "urls": [{"display_url": "pic.x.com/flaPhObzhg", "end": 263, "expanded_url": "https://x.com/SpaceflightNow/status/2114783594388332677/photo/1", "media_key": "3_2114783589627748352", "start": 240, "url": "https://t.co/flaPhObzhg"}]}, "id": "2114783594388332677", "public_metrics": {"bookmark_count": 2, "impression_count": 3914, "like_count": 21, "quote_count": 1, "reply_count": 2, "retweet_count": 5}, "text": "We’re on the ground at @UAHuntsville for the 2026 AAS von Braun Space Exploration Symposium, hosted by @astrosociety. Follow this account and @w_robinsonsmith for updates from the multi-day event in the Rocket City.\n\n📸: Will Robinson-Smith https://t.co/flaPhObzhg", "url": "https://x.com/SpaceflightNow/status/2114783594388332677"}, {"author_id": "626660983", "created_at": "2026-10-26T18:06:43.000Z", "edit_history_tweet_ids": ["2114780779272130839"], "entities": {"urls": [{"display_url": "x.com/lymanstoneky/s…", "end": 146, "expanded_url": "https://twitter.com/lymanstoneky/status/2114780583704322553", "start": 123, "url": "https://t.co/DyFBlTj18D"}]}, "id": "2114780779272130839", "public_metrics": {"bookmark_count": 0, "impression_count": 1519, "like_count": 12, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2114780583704322553", "type": "quoted"}], "text": "it ends up not solving the textual issue\n\nbut i'm prepared to die on this hill:\n\nQuirinius was legate of Syria in 3 BC!!!! https://t.co/DyFBlTj18D", "url": "https://x.com/lymanstoneky/status/2114780779272130839"}, {"author_id": "626660983", "created_at": "2026-10-26T18:05:14.000Z", "edit_history_tweet_ids": ["2114780407812305358"], "entities": {"urls": [{"display_url": "pic.x.com/gxwVgPKBox", "end": 177, "expanded_url": "https://x.com/lymanstoneky/status/2114780407812305358/photo/1", "media_key": "3_2114780399058513921", "start": 154, "url": "https://t.co/gxwVgPKBox"}]}, "id": "2114780407812305358", "public_metrics": {"bookmark_count": 5, "impression_count": 3534, "like_count": 40, "quote_count": 1, "reply_count": 3, "retweet_count": 3}, "text": "I wanted to write about the census of Quirinius in Luke 2 so naturally I made a tool to browse all 132 censuses documented in 800 years of Roman history. https://t.co/gxwVgPKBox", "url": "https://x.com/lymanstoneky/status/2114780407812305358"}, {"author_id": "626660983", "created_at": "2026-10-26T17:52:07.000Z", "edit_history_tweet_ids": ["2114777106999542267"], "entities": {"urls": [{"display_url": "pic.x.com/bMwPkoozKS", "end": 61, "expanded_url": "https://x.com/lymanstoneky/status/2114777106999542267/photo/1", "media_key": "3_2114777097033949184", "start": 38, "url": "https://t.co/bMwPkoozKS"}]}, "id": "2114777106999542267", "public_metrics": {"bookmark_count": 12, "impression_count": 1883, "like_count": 26, "quote_count": 0, "reply_count": 4, "retweet_count": 1}, "text": "you must make your churches beautiful https://t.co/bMwPkoozKS", "url": "https://x.com/lymanstoneky/status/2114777106999542267"}, {"author_id": "610659001", "created_at": "2026-10-26T17:39:25.000Z", "edit_history_tweet_ids": ["2114773909388099872"], "entities": {"urls": [{"display_url": "pic.x.com/RwuuknQXCW", "end": 298, "expanded_url": "https://x.com/MaxCRoser/status/2114773909388099872/photo/1", "media_key": "3_2114772969759105024", "start": 275, "url": "https://t.co/RwuuknQXCW"}]}, "id": "2114773909388099872", "public_metrics": {"bookmark_count": 8, "impression_count": 5999, "like_count": 149, "quote_count": 0, "reply_count": 0, "retweet_count": 25}, "text": "The Wikipedia community has built a tool that makes it possible to embed our interactive Our World in Data charts right in any Wikipedia page.\n\nI have always admired Wikipedia and all the people contributing to it. And I'm very happy that our work now can get used this way! https://t.co/RwuuknQXCW", "url": "https://x.com/MaxCRoser/status/2114773909388099872"}, {"author_id": "626660983", "created_at": "2026-10-26T16:11:31.000Z", "edit_history_tweet_ids": ["2114751789371150795"], "entities": {"urls": [{"display_url": "x.com/raybury/status…", "end": 274, "expanded_url": "https://twitter.com/raybury/status/2114747623802650753", "start": 251, "url": "https://t.co/1IOhNVCVSH"}]}, "id": "2114751789371150795", "public_metrics": {"bookmark_count": 0, "impression_count": 1571, "like_count": 15, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2114747623802650753", "type": "quoted"}], "text": "Correct, he is saying we belong to God, so give yourself to God\n\nYet by that very same statement, he is saying the coin belongs to Caesar, so give the coin to God\n\nIf you think Jesus is defending hoarding money for yourself, my dude, you are mixed up https://t.co/1IOhNVCVSH", "url": "https://x.com/lymanstoneky/status/2114751789371150795"}, {"author_id": "626660983", "created_at": "2026-10-26T15:48:46.000Z", "edit_history_tweet_ids": ["2114746066213978327"], "entities": {"urls": [{"display_url": "pic.x.com/mp0GkOf2NF", "end": 217, "expanded_url": "https://x.com/lymanstoneky/status/2114746066213978327/photo/1", "media_key": "3_2114745785430560769", "start": 194, "url": "https://t.co/mp0GkOf2NF"}, {"display_url": "x.com/Doug_Bandow/st…", "end": 241, "expanded_url": "https://twitter.com/Doug_Bandow/status/2114726792720531756", "start": 218, "url": "https://t.co/wjaVZqfFA4"}]}, "id": "2114746066213978327", "public_metrics": {"bookmark_count": 1, "impression_count": 2198, "like_count": 15, "quote_count": 2, "reply_count": 2, "retweet_count": 0}, "referenced_tweets": [{"id": "2114726792720531756", "type": "quoted"}], "text": "the rebuke is to the pharisees who are trying to trap him with an anti-Roman take; he rebukes them by inviting them to define \"what is God's\", but it is unambiguous what he thinks is \"Caesar's\" https://t.co/mp0GkOf2NF https://t.co/wjaVZqfFA4", "url": "https://x.com/lymanstoneky/status/2114746066213978327"}, {"author_id": "626660983", "created_at": "2026-10-26T13:33:23.000Z", "edit_history_tweet_ids": ["2114711995874246810"], "entities": {"urls": [{"display_url": "x.com/InfoAtJames/st…", "end": 28, "expanded_url": "https://twitter.com/InfoAtJames/status/2113792737615270114", "start": 5, "url": "https://t.co/oitzhsTyTP"}]}, "id": "2114711995874246810", "public_metrics": {"bookmark_count": 1, "impression_count": 2218, "like_count": 32, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2113792737615270114", "type": "quoted"}], "text": "💪💪💪💪 https://t.co/oitzhsTyTP", "url": "https://x.com/lymanstoneky/status/2114711995874246810"}, {"author_id": "626660983", "created_at": "2026-10-26T13:24:08.000Z", "edit_history_tweet_ids": ["2114709666425159734"], "entities": {"urls": [{"display_url": "x.com/stephmurrayyyy…", "end": 123, "expanded_url": "https://twitter.com/stephmurrayyyy/status/2114481579305369894", "start": 100, "url": "https://t.co/MCJlq5Vgz0"}]}, "id": "2114709666425159734", "public_metrics": {"bookmark_count": 16, "impression_count": 7071, "like_count": 167, "quote_count": 3, "reply_count": 24, "retweet_count": 5}, "referenced_tweets": [{"id": "2114481579305369894", "type": "quoted"}], "text": "The people who find parenting hardest are people with the most support and money to make it easiest https://t.co/MCJlq5Vgz0", "url": "https://x.com/lymanstoneky/status/2114709666425159734"}, {"author_id": "626660983", "created_at": "2026-10-26T11:46:30.000Z", "edit_history_tweet_ids": ["2114685095336620190"], "entities": {"urls": [{"display_url": "x.com/iwomansplainer…", "end": 302, "expanded_url": "https://twitter.com/iwomansplainer/status/2114337882282312038", "start": 279, "url": "https://t.co/sMnleTmbuC"}]}, "id": "2114685095336620190", "public_metrics": {"bookmark_count": 25, "impression_count": 14517, "like_count": 396, "quote_count": 0, "reply_count": 33, "retweet_count": 8}, "referenced_tweets": [{"id": "2114337882282312038", "type": "quoted"}], "text": "My rule of thumb is you can usually leave a child with a trusted family member for the number of nights equal to their year of age, and if you have not done so, YOU NEED TO. Occasionally ge