4808268987985980/photo/1", "media_key": "3_2114808266463002624", "start": 181, "url": "https://t.co/IYXu2BjWQq"}]}, "id": "2114808268987985980", "public_metrics": {"bookmark_count": 0, "impression_count": 967, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 3}, "text": "\"I am a family nurse practitioner who works in both primary care and emergency medicine, and I now have this conversation with patients on a regular basis.\" https://t.co/hmmqSQEtAJ https://t.co/IYXu2BjWQq", "url": "https://x.com/statnews/status/2114808268987985980"}, {"author_id": "15862891", "created_at": "2026-10-26T19:28:16.000Z", "edit_history_tweet_ids": ["2114801303922602315"], "entities": {"urls": [{"description": "Nature - Scientific organizations in Brazil had rallied around the incumbent president, who defied expectations to defeat his opponent in a run-off.", "display_url": "go.nature.com/4ijbH21", "end": 199, "expanded_url": "https://go.nature.com/4ijbH21", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2114801309228437505/ZiF1maHu?format=jpg&name=orig", "width": 1066}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114801309228437505/ZiF1maHu?format=jpg&name=150x150", "width": 150}], "start": 176, "status": 200, "title": "Brazil election: many scientists relieved as Lula wins surprise victory", "unwound_url": "https://www.nature.com/articles/d41586-026-03446-9?utm_source=x&utm_medium=social&utm_campaign=nature&linkId=64240685&error=cookies_not_supported&code=5343e928-088e-4f22-93fb-e1ae81faaca8", "url": "https://t.co/KPckMLE0i6"}]}, "id": "2114801303922602315", "public_metrics": {"bookmark_count": 2, "impression_count": 4814, "like_count": 20, "quote_count": 0, "reply_count": 5, "retweet_count": 9}, "text": "Brazil’s President Lula won his bid for re-election on 25 October, to the relief of many scientists who feared for the future of Brazilian research if his opponent prevailed.\n\nhttps://t.co/KPckMLE0i6", "url": "https://x.com/Nature/status/2114801303922602315"}, {"author_id": "32372834", "created_at": "2026-10-26T19:25:04.000Z", "edit_history_tweet_ids": ["2114800497844531596"], "entities": {"mentions": [{"end": 192, "id": "17089636", "start": 176, "username": "NewsfromScience"}], "urls": [{"description": "Samples from Japan’s MMX mission could reveal how Phobos formed—and may contain pieces of Mars", "display_url": "scim.ag/4sgWWRI", "end": 175, "expanded_url": "https://scim.ag/4sgWWRI", "images": [{"height": 847, "url": "https://pbs.twimg.com/news_img/2113722239140929536/S6QH0rpm?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113722239140929536/S6QH0rpm?format=jpg&name=150x150", "width": 150}], "start": 152, "status": 200, "title": "Audacious space heist aims to bring home bits of mysterious martian moon", "unwound_url": "https://www.science.org/content/article/audacious-space-heist-japan-aims-bring-home-bits-martian-moon?utm_campaign=ScienceMagazine&utm_source=twitter&utm_medium=ownedSocial", "url": "https://t.co/chKYyAKkz7"}, {"display_url": "pic.x.com/QsvOvrDO7c", "end": 216, "expanded_url": "https://x.com/ScienceMagazine/status/2114800497844531596/photo/1", "media_key": "3_2114800487828434944", "start": 193, "url": "https://t.co/QsvOvrDO7c"}]}, "id": "2114800497844531596", "public_metrics": {"bookmark_count": 3, "impression_count": 6251, "like_count": 25, "quote_count": 0, "reply_count": 2, "retweet_count": 6}, "text": "Japan’s MMX mission aims to retrieve samples from Mars’s mysterious moon. They could reveal how it formed—and hold pieces of Mars itself. \n\nLearn more: https://t.co/chKYyAKkz7 @NewsfromScience https://t.co/QsvOvrDO7c", "url": "https://x.com/ScienceMagazine/status/2114800497844531596"}, {"author_id": "15862891", "created_at": "2026-10-26T19:04:40.000Z", "edit_history_tweet_ids": ["2114795362653249572"], "entities": {"urls": [{"description": "Nature - The emerging science — and industry — of animal longevity is attracting interest from companies and academics alike.", "display_url": "go.nature.com/4zd7tjL", "end": 250, "expanded_url": "https://go.nature.com/4zd7tjL", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2114795367187251200/S9ECtihC?format=jpg&name=orig", "width": 1066}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114795367187251200/S9ECtihC?format=jpg&name=150x150", "width": 150}], "start": 227, "status": 200, "title": "Can science make your dog live longer? Longevity craze comes to pets", "unwound_url": "https://www.nature.com/articles/d41586-026-03447-8?utm_source=x&utm_medium=social&utm_campaign=nature&linkId=64240489&error=cookies_not_supported&code=05e89899-0dea-4d72-a6a6-a0a622128a5a", "url": "https://t.co/z297hvHak2"}]}, "id": "2114795362653249572", "public_metrics": {"bookmark_count": 2, "impression_count": 5572, "like_count": 15, "quote_count": 1, "reply_count": 2, "retweet_count": 4}, "text": "As the pursuit of increasing human longevity and healthspan has grown, researchers and companies are investigating anti-ageing measures for dogs and cats, from probiotic kibble to gene therapy to treat canine heart disease.  \n\nhttps://t.co/z297hvHak2", "url": "https://x.com/Nature/status/2114795362653249572"}, {"author_id": "15134240", "created_at": "2026-10-26T19:04:02.000Z", "edit_history_tweet_ids": ["2114795205907927384"], "entities": {"urls": [{"description": "A.gov website belongs to an official government organization in the United States. Secure .gov websites use HTTPS A lock () or https:// means you’ve safely connected to the .gov website. Share sensitive information only on official, secure websites. Lewy body dementia is a complex disorder characterized by progressive cognitive decline and problems with movement, behavior, and mood. It is one of the most common causes of dementia, after Alzheimer's disease and vascular disease. This publication is meant", "display_url": "bit.ly/4kg9OWi", "end": 276, "expanded_url": "https://bit.ly/4kg9OWi", "images": [{"height": 418, "url": "https://pbs.twimg.com/news_img/2114795217047941120/yWyVGGMX?format=png&name=orig", "width": 800}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114795217047941120/yWyVGGMX?format=png&name=150x150", "width": 150}], "start": 253, "status": 200, "title": "Lewy Body Dementia: Information for Patients, Families, and Professionals", "unwound_url": "https://www.ninds.nih.gov/publications/lewy-body-dementia-information-patients-families-and-professionals", "url": "https://t.co/XXg8tcp0Px"}, {"display_url": "pic.x.com/HiissFqMrp", "end": 301, "expanded_url": "https://x.com/NIH/status/2114795205907927384/photo/1", "media_key": "3_2114795203231944705", "start": 278, "url": "https://t.co/HiissFqMrp"}]}, "id": "2114795205907927384", "public_metrics": {"bookmark_count": 0, "impression_count": 2584, "like_count": 4, "quote_count": 0, "reply_count": 2, "retweet_count": 4}, "text": "🧠 You’ve probably heard of Alzheimer’s disease. But what about Lewy body dementia (LBD)? LBD is the second most common form of dementia, and it can affect thinking, movement, sleep, and mood.  \n\nDownload or order a free booklet about LBD to learn more: https://t.co/XXg8tcp0Px. https://t.co/HiissFqMrp", "url": "https://x.com/NIH/status/2114795205907927384"}, {"author_id": "3290364847", "created_at": "2026-10-26T19:02:50.000Z", "edit_history_tweet_ids": ["2114794903288872966"], "entities": {"hashtags": [{"end": 154, "start": 138, "tag": "STATWunderkinds"}], "urls": [{"description": "Figuring out how GLP-1 drugs work in the brain", "display_url": "statnews.com/wunderkinds/cl…", "end": 137, "expanded_url": "https://www.statnews.com/wunderkinds/claire-gao/", "images": [{"height": 576, "url": "https://pbs.twimg.com/news_img/2114794904324804608/VmPXA9G4?format=jpg&name=orig", "width": 1024}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114794904324804608/VmPXA9G4?format=jpg&name=150x150", "width": 150}], "start": 114, "status": 200, "title": "Claire Gao", "unwound_url": "https://www.statnews.com/wunderkinds/claire-gao/", "url": "https://t.co/cKEp8jQArR"}, {"display_url": "pic.x.com/tKm22pjtVS", "end": 178, "expanded_url": "https://x.com/statnews/status/2114794903288872966/photo/1", "media_key": "3_2114794900017340416", "start": 155, "url": "https://t.co/tKm22pjtVS"}]}, "id": "2114794903288872966", "public_metrics": {"bookmark_count": 1, "impression_count": 1161, "like_count": 5, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "Meet STAT Wunderkind Claire Gao — she's figuring out how GLP-1 drugs work in the brain.\nRead more about her work: https://t.co/cKEp8jQArR\n#STATWunderkinds https://t.co/tKm22pjtVS", "url": "https://x.com/statnews/status/2114794903288872966"}, {"author_id": "32372834", "created_at": "2026-10-26T18:00:11.000Z", "edit_history_tweet_ids": ["2114779135679611286"], "entities": {"mentions": [{"end": 12, "id": "248897605", "start": 2, "username": "ScienceTM"}], "urls": [{"display_url": "pic.x.com/qEBzP1RGJy", "end": 293, "expanded_url": "https://x.com/ScienceMagazine/status/2114779135679611286/photo/1", "media_key": "3_2114779133360128000", "start": 270, "url": "https://t.co/qEBzP1RGJy"}]}, "id": "2114779135679611286", "public_metrics": {"bookmark_count": 2, "impression_count": 6876, "like_count": 14, "quote_count": 0, "reply_count": 2, "retweet_count": 3}, "text": "A @ScienceTM analysis of trial data from stem cell transplant recipients shows how immune suppression with either cyclophosphamide or tacrolimus shapes T cell reconstitution—and has opposing effects on the risk of graft-versus-host disease or infection post-transplant. https://t.co/qEBzP1RGJy", "url": "https://x.com/ScienceMagazine/status/2114779135679611286"}, {"author_id": "28164923", "created_at": "2026-10-26T17:50:00.000Z", "edit_history_tweet_ids": ["2114776572519424130"], "entities": {"urls": [{"description": "Executives have said the airline remains confident in its strategy and sees progress in returning 