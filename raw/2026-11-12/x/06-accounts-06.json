ds": ["2120399390879994223"], "entities": {"cashtags": [{"end": 254, "start": 250, "tag": "TSM"}, {"end": 260, "start": 255, "tag": "INTC"}, {"end": 267, "start": 261, "tag": "SSNLF"}]}, "id": "2120399390879994223", "public_metrics": {"bookmark_count": 8, "impression_count": 9290, "like_count": 69, "quote_count": 3, "reply_count": 9, "retweet_count": 10}, "text": "Rapidus, Japan’s state-backed chip foundry, may push 2nm mass production back by a year to fiscal 2028 due to technical difficulties including trouble connecting transistors and slow progress on yields, media report, citing unnamed industry sources. $TSM $INTC $SSNLF", "url": "https://x.com/dnystedt/status/2120399390879994223"}, {"author_id": "45483286", "created_at": "2026-11-11T06:00:37.000Z", "edit_history_tweet_ids": ["2120396256774422565"], "entities": {"urls": [{"display_url": "pic.x.com/6PqBHB2AEM", "end": 275, "expanded_url": "https://x.com/dnystedt/status/2120396256774422565/photo/1", "media_key": "3_2120395964750139392", "start": 252, "url": "https://t.co/6PqBHB2AEM"}]}, "id": "2120396256774422565", "public_metrics": {"bookmark_count": 18, "impression_count": 16579, "like_count": 93, "quote_count": 4, "reply_count": 6, "retweet_count": 15}, "text": "\"The demand on our leading node [most advanced] silicon is insatiable,\" said TSMC Co-COO Kevin Zhang, Nikkei Asia reports, adding clients \"...want to get [their] hands around any compute capability they can have. It's truly an insatiable environment.\" https://t.co/6PqBHB2AEM", "url": "https://x.com/dnystedt/status/2120396256774422565"}, {"author_id": "45483286", "created_at": "2026-11-11T02:22:13.000Z", "edit_history_tweet_ids": ["2120341293398397029"], "id": "2120341293398397029", "public_metrics": {"bookmark_count": 7, "impression_count": 8019, "like_count": 37, "quote_count": 2, "reply_count": 3, "retweet_count": 3}, "text": "Inventec, the Taiwan AI server maker, blame ongoing components shortages – CPUs, memory, HDDs, passive components, PCBs,