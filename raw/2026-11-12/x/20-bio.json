"start": 194, "tag": "AI"}], "urls": [{"description": "Can rewriting DNA change the future for families living with rare g...", "display_url": "youtu.be/bsjvU2BFTxo", "end": 251, "expanded_url": "https://youtu.be/bsjvU2BFTxo", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2119485302360133632/hzzBfMxa?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2119485302360133632/hzzBfMxa?format=jpg&name=150x150", "width": 150}], "start": 228, "status": 200, "title": "David Liu: Gene Editing to Treat Rare Disease", "unwound_url": "https://www.youtube.com/watch?v=bsjvU2BFTxo&feature=youtu.be", "url": "https://t.co/r1ZeMwYDyo"}, {"display_url": "pic.x.com/TuNcNcYs7f", "end": 275, "expanded_url": "https://x.com/GENErationHopee/status/2120574334905573738/video/1", "media_key": "13_2120574206211506177", "start": 252, "url": "https://t.co/TuNcNcYs7f"}]}, "id": "2120574334905573738", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "An AI built around how prime editing works. Dr. David R. Liu on a machine-learning model that predicts editing outcomes, so researchers test a dozen designs instead of thousands.\n\n#PrimeEditing #AI\n\nWatch the full conversation: https://t.co/r1ZeMwYDyo https://t.co/TuNcNcYs7f", "url": "https://x.com/GENErationHopee/status/2120574334905573738"}, {"author_id": "346441888", "created_at": "2026-11-11T11:18:55.000Z", "edit_history_tweet_ids": ["2120476360657588591"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "BEAM"}], "mentions": [{"end": 226, "id": "21079030", "start": 214, "username": "PharmaScrip"}]}, "id": "2120476360657588591", "public_metrics": {"bookmark_count": 0, "impression_count": 70, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "$BEAM Therapeutics is targeting a year-end US regulatory filing for risto-cel after the investigational base-editing therapy met the primary efficacy and safety endpoints in its pivotal BEACON trial. My latest for @PharmaScrip", "url": "https://x.com/SushmitaPanda/status/2120476360657588591"}, {"author_id": "1869735207978295296", "created_at": "2026-11-10T15:12:50.000Z", "edit_history_tweet_ids": ["2120172839328432404"], "entities": {"urls": [{"display_url": "x.com/adamfeuerstein…", "end": 214, "expanded_url": "https://twitter.com/adamfeuerstein/status/2120125396037583217", "start": 191, "url": "https://t.co/BooYJgt9lT"}]}, "id": "2120172839328432404", "public_metrics": {"bookmark_count": 0, "impression_count": 170, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120125396037583217", "type": "quoted"}], "text": "The detail I'd watch: 31 patients had completed the 12-month follow-up at this cutoff, and Beam says a BLA could go in as early as year-end, potentially the first for a base editing therapy. https://t.co/BooYJgt9lT", "url": "https://x.com/buzztickr/status/2120172839328432404"}, {"author_id": "1677076957908066305", "created_at": "2026-11-10T09:02:58.000Z", "edit_history_tweet_ids": ["2120079760189751719"], "entities": {"hashtags": [{"end": 236, "start": 224, "tag": "Epigenetics"}, {"end": 247, "start": 237, "tag": "Chromatin"}], "mentions": [{"end": 184, "id": "984673911789977600", "start": 172, "username": "mafvg_mafvg"}, {"end": 222, "id": "1345385060", "start": 208, "username": "MolecularCell"}], "urls": [{"description": "Wang, Zittersteijn et al. show that the chromatin landscape of a target sequence is a key determinant of DSB-free genome-editing outcomes. Strikingly, while heterochromatin often impairs prime editing, it can enhance base editing and additionally control the fidelity and purity of the DNA modification products generated.", "display_url": "cell.com/molecular-cell…", "end": 170, "expanded_url": "https://www.cell.com/molecular-cell/abstract/S1097-2765(26)00717-3", "images": [{"height": 375, "url": "https://pbs.twimg.com/news_img/2117737904881688576/tNbNs5ob?format=jpg&name=orig", "width": 375}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2117737904881688576/tNbNs5ob?format=jpg&name=150x150", "width": 150}], "start": 147, "status": 200, "title": "The chromatin context differently impacts prime editors and base editors and controls the fidelity and purity of base editing", "unwound_url": "https://www.cell.com/molecular-cell/abstract/S1097-2765(26)00717-3", "url": "https://t.co/EDD69LITfl"}, {"description": "Quantitative chromatin profiling technologies and services for translational research teams", "display_url": "epigenometech.com", "end": 276, "expanded_url": "https://epigenometech.com", "start": 253, "status": 200, "title": "Epigenome Technologies", "unwound_url": "https://epigenometech.com", "url": "https://t.co/WmSYDGXnzb"}, {"display_url": "pic.x.com/jepVBcUpNI", "end": 300, "expanded_url": "https://x.com/EpigenomeTech/status/2120079760189751719/photo/1", "media_key": "3_2120079674046926848", "start": 277, "url": "https://t.co/jepVBcUpNI"}]}, "id": "2120079760189751719", "public_metrics": {"bookmark_count": 1, "impression_count": 486, "like_count": 13, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Epigenetics Update - The chromatin context differently impacts prime editors and base editors and controls the fidelity and purity of base editing https://t.co/EDD69LITfl\n\n@mafvg_mafvg (Leiden University) in @MolecularCell\n\n#Epigenetics #Chromatin\n---\n\nhttps://t.co/WmSYDGXnzb https://t.co/jepVBcUpNI", "url": "https://x.com/EpigenomeTech/status/2120079760189751719"}, {"author_id": "1187686290269097985", "created_at": "2026-11-11T08:03:18.000Z", "edit_history_tweet_ids": ["2120427132262244395"], "entities": {"hashtags": [{"end": 259, "start": 247, "tag": "GeneEditing"}, {"end": 271, "start": 260, "tag": "Hepatology"}], "urls": [{"display_url": "doi.org/10.1016/j.jhep…", "end": 245, "expanded_url": "https://doi.org/10.1016/j.jhep.2026.09.028", "start": 222, "unwound_url": "https://www.sciencedirect.com/science/article/pii/S0168827826029351", "url": "https://t.co/oaioz0LD5V"}]}, "id": "2120427132262244395", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Our clinic at Hannover Medical School has reason to celebrate! 🧬 In one patient with AAT deficiency, liver biopsy confirmed 54–57% SERPINA1 allele correction after in vivo base editing. An important proof of feasibility.\n\nhttps://t.co/oaioz0LD5V\n\n#GeneEditing #Hepatology", "url": "https://x.com/HardtkeWolenski/status/2120427132262244395"}, {"author_id": "1556815411332759552", "created_at": "2026-11-10T07:36:00.000Z", "edit_history_tweet_ids": ["2120057874525381084"], "entities": {"urls": [{"display_url": "pic.x.com/fqwjc7RZA3", "end": 286, "expanded_url": "https://x.com/YinfengLife/status/2120057874525381084/photo/1", "media_key": "3_2120057865193025538", "start": 263, "url": "https://t.co/fqwjc7RZA3"}]}, "id": "2120057874525381084", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "A human first: prime editing has rewritten DNA inside a patient's body. Prime Medicine treated the first Wilson disease patient, fixing the copper-processing gene in liver cells — no cell removal, no chemo. In vivo gene editing just went from theory to clinic. 🧬 https://t.co/fqwjc7RZA3", "url": "https://x.com/YinfengLife/status/2120057874525381084"}, {"author_id": "1572818562036957185", "created_at": "2026-11-10T13:33:45.000Z", "edit_history_tweet_ids": ["2120147904887451838"], "id": "2120147904887451838", "public_metrics": {"bookmark_count": 0, "impression_count": 404, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "The most valuable in the PR is the safety profile. For base editing, the biggest fear is “leukemogenesis caused by off-target effects” or “unknown genotoxicity.” In this trial, Beam’s base editor has not triggered any unexpected genotoxicity red flags in humans.$Beam", "url": "https://x.com/Vincent15101/status/2120147904887451838"}, {"author_id": "1832077594923012096", "created_at": "2026-11-10T19:15:38.000Z", "edit_history_tweet_ids": ["2120233942859014158"], "entities": {"urls": [{"display_url": "pic.x.com/UmLVSUXPvd", "end": 289, "expanded_url": "https://x.com/allsci_corp/status/2120233942859014158/photo/1", "media_key": "3_2120233941294530560", "start": 266, "url": "https://t.co/UmLVSUXPvd"}]}, "id": "2120233942859014158", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Beam Therapeutics' risto-cel hits primary endpoint in pivotal sickle cell trial — all 31 evaluable patients cleared 12 months free of severe vaso-occlusive crises. BLA filing on track for year-end 2026, potentially the first base-editing therapy approved in the US. https://t.co/UmLVSUXPvd", "url": "https://x.com/allsci_corp/status/2120233942859014158"}, {"author_id": "4058194633", "created_at": "2026-11-11T14:22:39.000Z", "edit_history_tweet_ids": ["2120522596538306608"], "entities": {"cashtags": [{"end": 5, "start": 0, "tag": "BEAM"}, {"end": 12, "start": 7, "tag": "CRSP"}, {"end": 19, "start": 14, "tag": "VRTX"}], "urls": [{"description": "The result represents a scientific milestone and positions Beam to submit a first-of-its-kind FDA application as soon as the end of the year.", "display_url": "biopharmadive.com/news/beam-sick…", "end": 262, "expanded_url": "https://www.biopharmadive.com/news/beam-sickle-cell-base-editing-risto-cel-results/874242/", "images": [{"height": 380, "url": "https://pbs.twimg.com/news_img/2120204382314856448/rJZ7DKli?format=jpg&name=orig", "width": 770}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120204382314856448/rJZ7DKli?format=jpg&name=150x150", "width": 150}], "start": 239, "status": 200, "title": "Beam’s base editing therapy for sickle cell hits goal in pivotal trial", "unwound_url": "https://www.biopharmadive.com/news/beam-sickle-cell-base-editing-risto-cel-results/874242/", "url": "https://t.co/WsSeTR58xV"}]}, "id": "2120522596538306608", "public_metrics": {"bookmark_count": 0, "impression_count": 266, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "$BEAM  $CRSP  $VRTX \nBeam’s base editing therapy for sickle cell hits goal in pivotal trial \n\n- The result represents a scientific milestone and positions Beam to submit a first-of-its-kind FDA application as soon as the end of the year.\n\nhttps://t.co/WsSeTR58xV via", "url": "https://x.com/MarcJacksonLA/status/2120522596538306608"}, {"author_id": "50076223", "created_at": "2026-11-10T19:11:00.000Z", "edit_history_tweet_ids": ["2120232776909688845"], "entities": {"urls": [{"display_url": "pic.x.com/PshdRk2aJw", "end": 295, "expanded_url": "https://x.com/RevvityLifeSci/status/2120232776909688845/photo/1", "media_key": "3_2119924411629187072", "start": 272, "url": "https://t.co/PshdRk2aJw"}, {"display_url": "pic.x.com/PshdRk2aJw", "end": 295, "expanded_url": "https://x.com/RevvityLifeSci/status/2120232776909688845/photo/1", "media_key": "3_2119924422479953920", "start": 272, "url": "https://t.co/PshdRk2aJw"}, {"display_url": "pic.x.com/PshdRk2aJw", "end": 295, "expanded_url": "https://x.com/RevvityLifeSci/status/2120232776909688845/photo/1", "media_key": "3_2119924433695485952", "start": 272, "url": "https://t.co/PshdRk2aJw"}, {"display_url": "pic.x.com/PshdRk2aJw", "end": 295, "expanded_url": "https://x.com/RevvityLifeSci/status/2120232776909688845/photo/1", "media_key": "3_2119924444827197440", "start": 272, "url": "https://t.co/PshdRk2aJw"}]}, "id": "2120232776909688845", "public_metrics": {"bookmark_count": 0, "impression_count": 70, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "We’re excited to share new data demonstrating high-efficiency in vivo editing with the Pin-point™ base editing platform following LNP delivery at modest total RNA doses [link], performing with editing levels within the range reported for established and optimized ABE LNP https://t.co/PshdRk2aJw", "url": "https://x.com/RevvityLifeSci/status/2120232776909688845"}, {"author_id": "1517054690898309120", "created_at": "2026-11-11T08:24:32.000Z", "edit_history_tweet_ids": ["2120432474002276435"], "entities": {"cashtags": [{"end": 277, "start": 273, "tag": "LLY"}]}, "id": "2120432474002276435", "public_metrics": {"bookmark_count": 0, "impression_count": 67, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Lilly has refiled an IND in China for VERVE-102, the PCSK9 base-editing therapy it picked up through its Verve acquisition. An earlier August filing did not receive implied approval. Another sign Lilly is pushing in vivo gene editing for cardiovascular disease into China. $LLY", "url": "https://x.com/CNBioXYZ/status/2120432474002276435"}, {"author_id": "1959679445033164801", "created_at": "2026-11-11T12:23:09.000Z", "edit_history_tweet_ids": ["2120492524116820224"], "entities": {"mentions": [{"end": 38, "id": "940684399456280578", "start": 31, "username": "BeamTx"}], "urls": [{"display_url": "pic.x.com/NLipWdsrRt", "end": 302, "expanded_url": "https://x.com/jayvberube/status/2120492524116820224/photo/1", "media_key": "3_2120492457242550272", "start": 279, "url": "https://t.co/NLipWdsrRt"}]}, "id": "2120492524116820224", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "I had the opportunity to visit @BeamTx’s lab in Cambridge a few years ago and worked with many of their scientists. Always enjoyed supporting their team.\n\nGreat to see their recent success with risto-cel and the positive BEACON trial results. A major milestone for base editing! https://t.co/NLipWdsrRt", "url": "https://x.com/jayvberube/status/2120492524116820224"}], "includes": {"users": [{"id": "1444516072292593664", "name": "Next Science", "username": "NextScience"}, {"id": "2445528445", "name": "Inside Precision Medicine", "username": "Inside_PM"}, {"id": "1589485943446126592", "name": "M.T 陽光普照", "username": "talkmang"}, {"id": "2801692272", "name": "Maz", "username": "LordHodler"}, {"id": "1410008852171411461", "name": "OMBI.MrPresentable", "username": "CouncilShiba"}, {"id": "68942483", "name": "Gènéthique", "username": "Genethique"}, {"id": "35789155", "name": "FirstWord Pharma", "username": "fwpharma"}, {"id": "1564125781", "name": "BioPharma Dive", "username": "BioPharmaDive"}, {"id": "2361611131", "name": "Molecular Therapy Family of Journals", "username": "MolTherapy"}, {"id": "1060595604022280192", "name": "quantumup", "username": "Quantumup1"}, {"id": "1330055544", "name": "Ben Fidler", "username": "BentheFidler"}, {"id": "3407436940", "name": "Blood Journals Portfolio", "username": "BloodPortfolio"}, {"id": "2110437865809174528", "name": "GENEration Hope", "username": "GENErationHopee"}, {"id": "346441888", "name": "Sushmita Panda", "username": "SushmitaPanda"}, {"id": "1869735207978295296", "name": "BuzzTickr", "username": "buzztickr"}, {"id": "1677076957908066305", "name": "Epigenome Technologies Inc.", "username": "EpigenomeTech"}, {"id": "1187686290269097985", "name": "Matthias Hardtke-Wolenski", "username": "HardtkeWolenski"}, {"id": "1556815411332759552", "name": "Yinfeng Life Extension Program", "username": "YinfengLife"}, {"id": "1572818562036957185", "name": "BloomBio", "username": "Vincent15101"}, {"id": "1832077594923012096", "name": "allsci", "username": "allsci_corp"}, {"id": "4058194633", "name": "stock setter", "username": "MarcJacksonLA"}, {"id": "50076223", "name": "Revvity for Life Sciences", "username": "RevvityLifeSci"}, {"id": "1517054690898309120", "name": "CBX", "username": "CNBioXYZ"}, {"id": "1959679445033164801", "na