{"data": [{"author_id": "11348282", "created_at": "2026-11-11T00:00:00.000Z", "edit_history_tweet_ids": ["2120305504295510080"], "entities": {"mentions": [{"end": 134, "id": "12415722", "start": 122, "username": "chandraxray"}], "urls": [{"description": "Using NASA’s Chandra X-ray Observatory, astronomers have discovered what is triggering repeated outbursts from a giant, unstable star.", "display_url": "go.nasa.gov/4kK4xGH", "end": 255, "expanded_url": "https://go.nasa.gov/4kK4xGH", "images": [{"height": 1280, "url": "https://pbs.twimg.com/news_img/2120305511140581377/wu52UJAe?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120305511140581377/wu52UJAe?format=jpg&name=150x150", "width": 150}], "start": 232, "status": 200, "title": "NASA’s Chandra Finds Source of Star’s Mysterious Outbursts - NASA Science", "unwound_url": "https://science.nasa.gov/missions/chandra/nasas-chandra-finds-source-of-stars-mysterious-outbursts/?utm_source=TWITTER&utm_medium=NASA&utm_campaign=NASASocial&linkId=1035124941", "url": "https://t.co/Q3J9uOmEVM"}, {"display_url": "pic.x.com/bB3nIrowVZ", "end": 279, "expanded_url": "https://x.com/NASA/status/2120305504295510080/photo/1", "media_key": "3_2120284305175793664", "start": 256, "url": "https://t.co/bB3nIrowVZ"}]}, "id": "2120305504295510080", "public_metrics": {"bookmark_count": 139, "impression_count": 492806, "like_count": 3474, "quote_count": 35, "reply_count": 180, "retweet_count": 502}, "text": "How’s that for a starburst?\n\nFound in this distant spiral galaxy is a giant star prone to mysterious outbursts. Thanks to @ChandraXray, scientists identified the culprit behind the eruptions—a hidden companion to the volatile star. https://t.co/Q3J9uOmEVM https://t.co/bB3nIrowVZ", "url": "https://x.com/NASA/status/2120305504295510080"}, {"author_id": "46648807", "created_at": "2026-11-10T21:35:04.000Z", "edit_history_tweet_ids": ["2120269031798181962"], "entities": {"mentions": [{"end": 100, "id": "166252256", "start": 93, "username": "ENERGY"}], "urls": [{"description": "NIST is helping turn old research material into targeted cancer therapy.", "display_url": "nist.gov/blogs/taking-m…", "end": 249, "expanded_url": "https://www.nist.gov/blogs/taking-measure/nist-turning-scientific-waste-cancer-fighting-material", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2120269045987414016/2tjQ0YE8?format=jpg&name=orig", "width": 1080}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2120269045987414016/2tjQ0YE8?format=jpg&name=150x150", "width": 150}], "start": 226, "status": 200, "title": "NIST Is Turning Scientific Waste Into Cancer-Fighting Material", "unwound_url": "https://www.nist.gov/blogs/taking-measure/nist-turning-scientific-waste-cancer-fighting-material", "url": "https://t.co/CktvZ1WhXt"}, {"display_url": "pic.x.com/394zIGqPS2", "end": 273, "expanded_url": "https://x.com/NIST/status/2120269031798181962/photo/1", "media_key": "3_2120269028467875840", "start": 250, "url": "https://t.co/394zIGqPS2"}]}, "id": "2120269031798181962", "public_metrics": {"bookmark_count": 3, "impression_count": 1255, "like_count": 6, "quote_count": 1, "reply_count": 2, "retweet_count": 0}, "text": "Science and medicine evolve, and so do the materials needed for medical treatments. NIST and @ENERGY are working with partners to recycle old medical materials so they can be made into targeted cancer therapies. \n\nLearn more: https://t.co/CktvZ1WhXt https://t.co/394zIGqPS2", "url": "https://x.com/NIST/status/2120269031798181962"}, {"author_id": "626660983", "created_at": "2026-11-10T19:46:43.000Z", "edit_history_tweet_ids": ["2120241765164712069"], "entities": {"urls": [{"display_url": "x.com/MoritzSchauer/…", "end": 88, "expanded_url": "https://twitter.com/MoritzSchauer/status/2120049961920295069", "start": 65, "url": "https://t.co/aous5nFXuJ"}]}, "id": "2120241765164712069", "public_metrics": {"bookmark_count": 16, "impression_count": 5297, "like_count":