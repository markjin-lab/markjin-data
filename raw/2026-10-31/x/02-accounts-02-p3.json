me=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115566473896992768/rcMpWujs?format=jpg&name=150x150", "width": 150}], "start": 109, "status": 200, "title": "Webcasts: ECB monetary policy decisions", "unwound_url": "https://www.ecb.europa.eu/press/press_conference/html/index.en.html", "url": "https://t.co/Qs8NFQlvQu"}, {"display_url": "pic.x.com/ygxy62rMMq", "end": 156, "expanded_url": "https://x.com/ecb/status/2115798307377488014/photo/1", "media_key": "3_2115792744232763392", "start": 133, "url": "https://t.co/ygxy62rMMq"}]}, "id": "2115798307377488014", "public_metrics": {"bookmark_count": 1, "impression_count": 12872, "like_count": 35, "quote_count": 2, "reply_count": 6, "retweet_count": 9}, "text": "Watch the ECB press conference live: President Christine @Lagarde explains today’s monetary policy decisions https://t.co/Qs8NFQlvQu https://t.co/ygxy62rMMq", "url": "https://x.com/ecb/status/2115798307377488014"}, {"author_id": "83466368", "created_at": "2026-10-29T13:17:08.000Z", "edit_history_tweet_ids": ["2115795068095430841"], "entities": {"urls": [{"description": "The European Central Bank (ECB) is the central bank of the European Union countries which have adopted the euro. Our main task is to maintain price stability in the euro area and so preserve the purchasing power of the single currency.", "display_url": "ecb.europa.eu/press/pr/date/…", "end": 119, "expanded_url": "https://www.ecb.europa.eu/press/pr/date/2026/html/ecb.mp261029~9a493adf17.en.html", "images": [{"height": 600, "url": "https://pbs.twimg.com/news_img/2115794808702930944/hY0133tU?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115794808702930944/hY0133tU?format=jpg&name=150x150", "width": 150}], "start": 96, "status": 200, "title": "Monetary policy decisions", "unwound_url": "https://www.ecb.europa.eu/press/pr/date/2026/html/ecb.mp261029~9a493adf17.en.html", "url": "https://t.co/EUVjWyn6rU"}, {"display_url": "pic.x.com/uliu9SrBsw", "end": 143, "expanded_url": "https://x.com/ecb/status/2115795068095430841/photo/1", "media_key": "3_2115794959269834752", "start": 120, "url": "https://t.co/uliu9SrBsw"}]}, "id": "2115795068095430841", "public_metrics": {"bookmark_count": 10, "impression_count": 71184, "like_count": 83, "quote_count": 13, "reply_count": 23, "retweet_count": 46}, "text": "We kept our key interest rates at their current levels.\n\nRead today’s monetary policy decisions https://t.co/EUVjWyn6rU https://t.co/uliu9SrBsw", "url": "https://x.com/ecb/status/2115795068095430841"}, {"author_id": "279036722", "created_at": "2026-10-29T12:59:27.000Z", "edit_history_tweet_ids": ["2115790619515773178"], "entities": {"mentions": [{"end": 107, "id": "2106937651173445632", "start": 96, "username": "econvitals"}], "urls": [{"display_url": "x.com/econvitals/sta…", "end": 131, "expanded_url": "https://twitter.com/econvitals/status/2115785797177602335", "start": 108, "url": "https://t.co/Ye8Kd5FNWZ"}]}, "id": "2115790619515773178", "public_metrics": {"bookmark_count": 5, "impression_count": 7732, "like_count": 39, "quote_count": 0, "reply_count": 1, "retweet_count": 5}, "referenced_tweets": [{"id": "2115785797177602335", "type": "quoted"}], "text": "Very strong GDP numbers, a touch higher than expected. More later from me, for now you can read @econvitals https://t.co/Ye8Kd5FNWZ", "url": "https://x.com/jasonfurman/status/2115790619515773178"}, {"author_id": "279036722", "created_at": "2026-10-29T12:55:39.000Z", "edit_history_tweet_ids": ["2115789660001562655"], "entities": {"urls": [{"display_url": "x.com/econvitals/sta…", "end": 265, "expanded_url": "https://twitter.com/econvitals/status/2115787210020499658", "start": 242, "url": "https://t.co/ZyuNXPcEWv"}]}, "id": "2115789660001562655", "public_metrics": {"bookmark_count": 5, "impression_count": 7632, "like_count": 37, "quote_count": 1, "reply_count": 4, "retweet_count": 2}, "referenced_tweets": [{"id": "2115787210020499658", "type": "quoted"}], "text": "Inflation came in pretty much as expected which is, well, quite high.\n\nIn Econvitals charts the solid dots are compared to what people thought yesterday, those are all close to zero. The hollow circles are absolute, those are all quite high. https://t.co/ZyuNXPcEWv", "url": "https://x.com/jasonfurman/status/2115789660001562655"}, {"author_id": "59603406", "created_at": "2026-10-29T12:53:43.000Z", "edit_history_tweet_ids": ["2115789173588144329"], "entities": {"urls": [{"display_url": "pic.x.com/HqmQI2VeFP", "end": 302, "expanded_url": "https://x.com/NickTimiraos/status/2115789173588144329/photo/1", "media_key": "3_2115788440209858561", "start": 279, "url": "https://t.co/HqmQI2VeFP"}, {"display_url": "x.com/NickTimiraos/s…", "end": 326, "expanded_url": "https://twitter.com/NickTimiraos/status/2115784547132387675", "start": 303, "url": "https://t.co/8Y02s0jwcB"}]}, "id": "2115789173588144329", "public_metrics": {"bookmark_count": 33, "impression_count": 59436, "like_count": 271, "quote_count": 7, "reply_count": 29, "retweet_count": 69}, "referenced_tweets": [{"id": "2115784547132387675", "type": "quoted"}], "text": "Prices of core PCE services ex-housing rose 0.37% in September, pushing the 12-month change to 3.6% and matching the highest such reading since 2024.\n\nCore goods was also firm at 0.20%. While core goods prices were back in 2024 were falling on a year-over-year basis (as was the https://t.co/HqmQI2VeFP https://t.co/8Y02s0jwcB", "url": "https://x.com/NickTimiraos/status/2115789173588144329"}, {"author_id": "321536046", "created_at": "2026-10-29T12:51:45.000Z", "edit_history_tweet_ids": ["2115788681143304324"], "entities": {"urls": [{"display_url": "bea.gov/data/income-sa…", "end": 124, "expanded_url": "https://www.bea.gov/data/income-saving/personal-income", "start": 101, "status": 200, "title": "Personal Income | U.S. Bureau of Economic Analysis (BEA)", "unwound_url": "https://www.bea.gov/data/income-saving/personal-income", "url": "https://t.co/eDZgP9dcXM"}, {"display_url": "pic.x.com/mdJmQ4mS3j", "end": 148, "expanded_url": "https://x.com/BEA_News/status/2115788681143304324/photo/1", "media_key": "3_2115788670431092736", "start": 125, "url": "https://t.co/mdJmQ4mS3j"}]}, "id": "2115788681143304324", "public_metrics": {"bookmark_count": 0, "impression_count": 954, "like_count": 2, "quote_count": 1, "reply_count": 0, "retweet_count": 1}, "text": "People’s incomes rose 0.2% in September; spending grew 0.5%. Both figures are in current dollars. \n \nhttps://t.co/eDZgP9dcXM https://t.co/mdJmQ4mS3j", "url": "https://x.com/BEA_News/status/2115788681143304324"}, {"author_id": "321536046", "created_at": "2026-10-29T12:42:53.000Z", "edit_history_tweet_ids": ["2115786447869333535"], "entities": {"hashtags": [{"end": 90, "start": 86, "tag": "GDP"}], "urls": [{"display_url": "bea.gov/data/gdp/gross…", "end": 82, "expanded_url": "https://www.bea.gov/data/gdp/gross-domestic-product", "start": 59, "status": 200, "title": "Gross Domestic Product | U.S. Bureau of Economic Analysis (BEA)", "unwound_url": "https://www.bea.gov/data/gdp/gross-domestic-product", "url": "https://t.co/qHGf5n47pp"}, {"display_url": "pic.x.com/AjPetTgIbk", "end": 114, "expanded_url": "https://x.com/BEA_News/status/2115786447869333535/photo/1", "media_key": "3_2115786437761069056", "start": 91, "url": "https://t.co/AjPetTgIbk"}]}, "id": "2115786447869333535", "public_metrics": {"bookmark_count": 1, "impression_count": 1235, "like_count": 9, "quote_count": 4, "reply_count": 0, "retweet_count": 7}, "text": "The U.S. economy grew at a 3.4% annualized rate in Q3.  \n \nhttps://t.co/qHGf5n47pp \n \n#GDP https://t.co/AjPetTgIbk", "url": "https://x.com/BEA_News/status/2115786447869333535"}, {"author_id": "59603406", "created_at": "2026-10-29T12:35:20.000Z", "edit_history_tweet_ids": ["2115784547132387675"], "entities": {"urls": [{"display_url": "pic.x.com/cXCYbI3y4V", "end": 303, "expanded_url": "https://x.com/NickTimiraos/status/2115784547132387675/photo/1", "media_key": "3_2115784521111031808", "start": 280, "url": "https://t.co/cXCYbI3y4V"}, {"display_url": "x.com/NickTimiraos/s…", "end": 327, "expanded_url": "https://twitter.com/NickTimiraos/status/2115745464590954925", "start": 304, "url": "https://t.co/PWDUZJu7P4"}]}, "id": "2115784547132387675", "public_metrics": {"bookmark_count": 32, "impression_count": 117568, "like_count": 275, "quote_count": 11, "reply_count": 35, "retweet_count": 75}, "referenced_tweets": [{"id": "2115745464590954925", "type": "quoted"}], "text": "Core PCE was 0.32% in September.\n\nThe 12-month change was 3.1% (vs 3.0% in August and  2.8% one year earlier).\n\nThe 6-month annualized rate was 2.9% (vs 2.8% in August and 2.9% one year earlier).\n\nThe 3-month annualized rate was 2.9% (vs 2.2% in August and 2.6% one year earlier) https://t.co/cXCYbI3y4V https://t.co/PWDUZJu7P4", "url": "https://x.com/NickTimiraos/status/2115784547132387675"}, {"author_id": "321536046", "created_at": "2026-10-29T12:33:13.000Z", "edit_history_tweet_ids": ["2115784016603344932"], "entities": {"urls": [{"display_url": "bea.gov/data/income-sa…", "end": 87, "expanded_url": "https://www.bea.gov/data/income-saving/personal-income", "start": 64, "status": 200, "title": "Personal Income | U.S. Bureau of Economic Analysis (BEA)", "unwound_url": "https://www.bea.gov/data/income-saving/personal-income", "url": "https://t.co/eDZgP9dcXM"}]}, "id": "2115784016603344932", "public_metrics": {"bookmark_count": 0, "impression_count": 2036, "like_count": 2, "quote_count": 1, "reply_count": 0, "retweet_count": 5}, "text": "Americans saved 3.8% of their after-tax income in September. \n \nhttps://t.co/eDZgP9dcXM", "url": "https://x.com/BEA_News/status/2115784016603344932"}], "includes": {"users": [{"id": "83466368", "name": "European Central Bank", "username": "ecb"}, {"id": "279036722", "name": "Jason Furman", "username": "jasonfurman"}, {"id": "39125788", "name": "Ethan Mollick", "username": "emollick"}, {"id":