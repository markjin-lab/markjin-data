{"data": [{"author_id": "1482283068555546627", "created_at": "2026-10-30T14:24:31.000Z", "edit_history_tweet_ids": ["2116174415503528240"], "entities": {"urls": [{"display_url": "pic.x.com/GT2ktDgkPf", "end": 290, "expanded_url": "https://x.com/ricci_nov/status/2116174415503528240/photo/1", "media_key": "3_2116174412286451712", "start": 267, "url": "https://t.co/GT2ktDgkPf"}]}, "id": "2116174415503528240", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "SemiEngineering week: TSMC said to weigh ~20% CoWoS hikes; ASE sees advanced-packaging revenue doubling in 2027; CXMT plans limited HBM3E at ~20–30% yields (Reuters); Solidigm reportedly talks a ~$45B U.S. NAND fab; Anthropic IPO flags HBM/TSMC capacity constraints. https://t.co/GT2ktDgkPf", "url": "https://x.com/ricci_nov/status/2116174415503528240"}, {"author_id": "2112143643108671488", "created_at": "2026-10-30T15:18:55.000Z", "edit_history_tweet_ids": ["2116188102117232664"], "entities": {"urls": [{"display_url": "pic.x.com/rKTqgAkszs", "end": 276, "expanded_url": "https://x.com/OrangeOpHq/status/2116188102117232664/photo/1", "media_key": "3_2116188097448935424", "start": 253, "url": "https://t.co/rKTqgAkszs"}]}, "id": "2116188102117232664", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "What is CoWoS? TSMC says it integrates multiple chips and HBM memory stacks in one package. NVIDIA's 10-K says: \"We utilize CoWoS technology for semiconductor packaging.\" Our read: one shared base plate, the processor and its memory side by side on it. https://t.co/rKTqgAkszs", "url": "https://x.com/OrangeOpHq/status/2116188102117232664"}, {"author_id": "1828694705506500608", "created_at": "2026-10-30T08:32:06.000Z", "edit_history_tweet_ids": ["2116085724240105783"], "entities": {"urls": [{"display_url": "pic.x.com/PGSAtWEdHa", "end