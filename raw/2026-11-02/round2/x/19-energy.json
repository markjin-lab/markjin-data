{"data": [{"author_id": "2095946293034266624", "created_at": "2026-11-01T21:39:31.000Z", "edit_history_tweet_ids": ["2117008658848706925"], "entities": {"hashtags": [{"end": 145, "start": 134, "tag": "PeakEnergy"}, {"end": 149, "start": 146, "tag": "GM"}], "urls": [{"display_url": "pic.x.com/s1z2jBygC2", "end": 173, "expanded_url": "https://x.com/iCleanAI/status/2117008658848706925/photo/1", "media_key": "3_2117008651223433216", "start": 150, "url": "https://t.co/s1z2jBygC2"}]}, "id": "2117008658848706925", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "Peak Energy raised $108M in a round led by GM to build its first sodium-ion battery factory, in Sacramento, The Information reports.\n\n#PeakEnergy #GM https://t.co/s1z2jBygC2", "url": "https://x.com/iCleanAI/status/2117008658848706925"}, {"author_id": "1881168794", "created_at": "2026-11-01T21:00:07.000Z", "edit_history_tweet_ids": ["2116998745279578278"], "entities": {"urls": [{"description": "General Motors–backed startup Peak Energy boasts that it’s on a pathway to undercut China’s dominance of the massive batteries that power AI data centers and the grid. Its approach involves deploying an entirely different chemistry from the lithium-based ones China controls.But success, Peak ...", "display_url": "thein.fo/4ztQWrJ", "end": 219, "expanded_url": "https://thein.fo/4ztQWrJ", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2116636370626027520/TFsSdp1m?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116636370626027520/TFsSdp1m?format=jpg&name=150x150", "width": 150}], "start": 196, "status": 200, "title": "At Peak Energy, the Focus is on Avoiding the Missteps of a Big Battery Industry Failure", "unwound_url": "https://www.theinformation.com/newsletters/the-electric/peak-energy-focus-avoiding-missteps-big-battery-industry-failure?utm_campaign=Editorial&utm