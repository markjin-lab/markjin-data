{"data": [{"author_id": "17468569", "created_at": "2026-11-01T19:43:37.000Z", "edit_history_tweet_ids": ["2116979494699647184"], "entities": {"urls": [{"display_url": "pic.x.com/SHZBSiGtR0", "end": 277, "expanded_url": "https://x.com/bryan_johnson/status/2116979494699647184/photo/1", "media_key": "3_2116977943163609088", "start": 254, "url": "https://t.co/SHZBSiGtR0"}]}, "id": "2116979494699647184", "public_metrics": {"bookmark_count": 21, "impression_count": 25540, "like_count": 120, "quote_count": 0, "reply_count": 30, "retweet_count": 2}, "text": "My chef get's my sleep resting heart rate every am. \n\nMy AI auto sends. \n\nAfter 1,800+ days of experimentation, I know the exact impact of meal timing, food composition, and calories on my resting heart rate.\n\n42 bpm and below: 😃\n43-45 bpm: 😐\n45 bpm+: 🙁 https://t.co/SHZBSiGtR0", "url": "https://x.com/bryan_johnson/status/2116979494699647184"}, {"author_id": "17468569", "created_at": "2026-11-01T19:23:34.000Z", "edit_history_tweet_ids": ["2116974448402456988"], "entities": {"urls": [{"display_url": "pic.x.com/IE68T6DNDp", "end": 47, "expanded_url": "https://x.com/bryan_johnson/status/2116974448402456988/video/1", "media_key": "13_2116974268005457920", "start": 24, "url": "https://t.co/IE68T6DNDp"}]}, "id": "2116974448402456988", "public_metrics": {"bookmark_count": 30, "impression_count": 24934, "like_count": 171, "quote_count": 7, "reply_count": 41, "retweet_count": 10}, "text": "finding forever friends https://t.co/IE68T6DNDp", "url": "https://x.com/bryan_johnson/status/2116974448402456988"}, {"author_id": "17468569", "created_at": "2026-11-01T18:36:45.000Z", "edit_history_tweet_ids": ["2116962664572477809"], "entities": {"urls": [{"display_url": "pic.x.com/F0kDhZHwiE", "end": 228, "expanded_url": "https://x.com/bryan_johnson/status/2116962664572477809/photo/1", "media_key": "3_2116962138275430400", "start": 205, "url": "https://t.co/F0kDhZHwiE"}]}, "id": "2116962664572477809", "public_metrics": {"bookmark_coun