[{"description": "A new topological model connects a centuries-old voting paradox to a surface with no distinct inside or outside.", "display_url": "quantamagazine.org/how-voting-is-…", "end": 199, "expanded_url": "https://www.quantamagazine.org/how-voting-is-like-a-klein-bottle-20261026/", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2114732782253408256/Yn0_hsrK?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2114732782253408256/Yn0_hsrK?format=jpg&name=150x150", "width": 150}], "start": 176, "status": 200, "title": "How Voting Is Like a Klein Bottle | Quanta Magazine", "unwound_url": "https://www.quantamagazine.org/how-voting-is-like-a-klein-bottle-20261026/", "url": "https://t.co/GIopSlQKNM"}, {"display_url": "pic.x.com/jzqufIICbb", "end": 223, "expanded_url": "https://x.com/QuantaMagazine/status/2116488359212163557/photo/1", "media_key": "3_2116488356951457792", "start": 200, "url": "https://t.co/jzqufIICbb"}]}, "id": "2116488359212163557", "public_metrics": {"bookmark_count": 17, "impression_count": 8695, "like_count": 82, "quote_count": 0, "reply_count": 9, "retweet_count": 14}, "text": "What happens when you twist a tube? You end up with something remarkable and strange: a Klein bottle. It turns out that the math of voting maps well onto this peculiar shape. \nhttps://t.co/GIopSlQKNM https://t.co/jzqufIICbb", "url": "https://x.com/QuantaMagazine/status/2116488359212163557"}, {"author_id": "860158302", "created_at": "2026-10-31T11:12:01.000Z", "edit_history_tweet_ids": ["2116488355835793796"], "entities": {"urls": [{"description": "To invade red blood cells, the deadly protists create temporary molecular portals that disappear behind them — doors we can now see in fine detail.", "display_url": "quantamagazine.org/malaria-parasi…", "end": 255, "expanded_url": "https://www.quantamagazine.org/malaria-parasite-caught-in-the-act-of-breaking-and-entering-20261023/", "images": [{"height": 630, "url": 