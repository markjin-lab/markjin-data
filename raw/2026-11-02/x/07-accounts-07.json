tch?v=BEnnrp…", "end": 183, "expanded_url": "https://www.youtube.com/watch?v=BEnnrpwGnMQ", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2116372524405571584/dshlkASr?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116372524405571584/dshlkASr?format=jpg&name=150x150", "width": 150}], "start": 160, "status": 200, "title": "SpaceX Falcon 9 rocket launches batch of Starlink satellites from California", "unwound_url": "https://www.youtube.com/watch?v=BEnnrpwGnMQ", "url": "https://t.co/GjeOdNzjJS"}, {"display_url": "pic.x.com/YbJc1CenwI", "end": 207, "expanded_url": "https://x.com/SpaceflightNow/status/2116381200927641965/photo/1", "media_key": "3_2116381185341292544", "start": 184, "url": "https://t.co/YbJc1CenwI"}]}, "id": "2116381200927641965", "public_metrics": {"bookmark_count": 4, "impression_count": 9766, "like_count": 111, "quote_count": 2, "reply_count": 10, "retweet_count": 13}, "text": "Liftoff! SpaceX's Falcon 9 rocket takes off from Vandenberg Space Force Base on the Starlink 15-18 mission at 9:04 pm PT (12:04 am ET / 0404 UTC).\n\nWatch live: https://t.co/GjeOdNzjJS https://t.co/YbJc1CenwI", "url": "https://x.com/SpaceflightNow/status/2116381200927641965"}, {"author_id": "34743251", "created_at": "2026-10-31T03:53:56.000Z", "edit_history_tweet_ids": ["2116378109218009267"], "entities": {"mentions": [{"end": 34, "id": "1330170106501079041", "start": 25, "username": "Starlink"}], "urls": [{"description": "Starlink Mission", "display_url": "x.com/i/broadcasts/1…", "end": 94, "expanded_url": "https://x.com/i/broadcasts/1DGleVlqoaqJL", "images": [{"height": 675, "url": "https://pbs.twimg.com/news_img/2115622006523846657/5CNSAzMi?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2115622006523846657/5CNSAzMi?format=jpg&name=150x150", "width": 150}], "start": 71, "status": 200, "title": "SpaceX", "unwound_url": "https://x.com/i/broadcasts/1DGleVlqoaqJL", "url": "https://t.co/aLuStYQVeG"}]}, "id": "2116378109218009267", "public_metrics": {"bookmark_count": 588, "impression_count": 1258742, "like_count": 10578, "quote_count": 146, "reply_count": 650, "retweet_count": 1404}, "text": "Watch Falcon 9 launch 27 @Starlink satellites to orbit from California https://t.co/aLuStYQVeG", "url": "https://x.com/SpaceX/status/2116378109218009267"}, {"author_id": "626660983", "created_at": "2026-10-31T03:41:23.000Z", "edit_history_tweet_ids": ["2116374950445723914"], "id": "2116374950445723914", "public_metrics": {"bookmark_count": 1, "impression_count": 6295, "like_count": 51, "quote_count": 1, "reply_count": 9, "retweet_count": 0}, "text": "So… coup-ish in Poland???", "url": "https://x.com/lymanstoneky/status/2116374950445723914"}, {"author_id": "17217640", "created_at": "2026-10-31T03:31:44.000Z", "edit_history_tweet_ids": ["2116372524036473319"], "entities": {"urls": [{"description": "Watch live coverage as SpaceX launches a Falcon 9 rocket from Calif...", "display_url": "youtube.com/watch?v=BEnnrp…", "end": 202, "expanded_url": "https://www.youtube.com/watch?v=BEnnrpwGnMQ", "images": [{"height": 720, "url": "https://pbs.twimg.com/news_img/2116372524405571584/dshlkASr?format=jpg&name=orig", "width": 1280}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2116372524405571584/dshlkASr?format=jpg&name=150x150", "width": 150}], "start": 179, "status": 200, "title": "SpaceX Falcon 9 rocket launches batch of Starlink satellites from California", "unwound_url": "https://www.youtube.com/watch?v=BEnnrpwGnMQ", "url": "https://t.co/GjeOdNyLUk"}]}, "id": "2116372524036473319", "public_metrics": {"bookmark_count": 3, "impression_count": 12581, "like_count": 57, "quote_count": 2, "reply_count": 2, "retweet_count": 11}, "text": "SpaceX is currently fueling its Falcon 9 rocket at Vandenberg Space Force Base. Liftoff of the Starlink 15-18 mission is set for 9:04 pm PT (12:04 am ET / 0404 UTC).\n\nWatch live: https://t.co/GjeOdNyLUk", "url": "https://x.com/SpaceflightNow/status/2116372524036473319"}, {"author_id": "626660983", "created_at": "2026-10-31T01:21:51.000Z", "edit_history_tweet_ids": ["2116339837129437639"], "entities": {"urls": [{"display_url": "x.com/kpottermn/stat…", "end": 29, "expanded_url": "https://twitter.com/kpottermn/status/2116229041413898736", "start": 6, "url": "https://t.co/zyyHsgNA4G"}]}, "id": "2116339837129437639", "public_metrics": {"bookmark_count": 0, "impression_count": 1994, "like_count": 7, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2116229041413898736", "type": "quoted"}], "text": "💪💪💪💪💪 https://t.co/zyyHsgNA4G", "url": "https://x.com/lymanstoneky/status/2116339837129437639"}, {"author_id": "626660983", "created_at": "2026-10-31T01:02:40.000Z", "edit_history_tweet_ids": ["2116335008759861680"], "entities": {"urls": [{"display_url": "x.com/alisonsomin/st…", "end": 300, "expanded_url": "https://twitter.com/alisonsomin/status/2116333016934907925", "start": 277, "url": "https://t.co/yVZ8sTYTti"}]}, "id": "2116335008759861680", "public_metrics": {"bookmark_count": 15, "impression_count": 10683, "like_count": 107, "quote_count": 2, "reply_count": 10, "retweet_count": 2}, "referenced_tweets": [{"id": "2116333016934907925", "type": "quoted"}], "text": "This is such an absurd view.\n\nWHY do couples considering an extra kid want more bedrooms?\n\nBecause normative parenting actually is space intensive!\n\nParents want rooms *because rooms are a condition for kids*.\n\nIt’s not a selection effect! If no bedrooms exist the kids aren’t https://t.co/yVZ8sTYTti", "url": "https://x.com/lymanstoneky/status/2116335008759861680"}, {"author_id": "626660983", "created_at": "2026-10-30T23:54:43.000Z", "edit_history_tweet_ids": ["2116317907244154951"], "entities": {"urls": [{"display_url": "x.com/skirtsnhose/st…", "end": 97, "expanded_url": "https://twitter.com/skirtsnhose/status/2116301529770868975", "start": 74, "url": "https://t.co/qTOpEtA10K"}]}, "id": "2116317907244154951", "public_metrics": {"bookmark_count": 2, "impression_count": 4455, "like_count": 42, "quote_count": 1, "reply_count": 9, "retweet_count": 3}, "referenced_tweets": [{"id": "2116301529770868975", "type": "quoted"}], "text": "The Chrysler Pacific is the only PHEV minivan…\n\nAnd was JUST DISCONTINUED https://t.co/qTOpEtA10K", "url": "https://x.com/lymanstoneky/status/2116317907244154951"}, {"author_id": "17217640", "created_at": "2026-10-30T22:54:09.000Z", "edit_history_tweet_ids": ["2116302668859600951"], "entities": {"urls": [{"display_url": "pic.x.com/uCX0IUu9Mg", "end": 303, "expanded_url": "https://x.com/SpaceflightNow/status/2116302668859600951/video/1", "media_key": "13_2116299095996350464", "start": 280, "url": "https://t.co/uCX0IUu9Mg"}]}, "id": "2116302668859600951", "public_metrics": {"bookmark_count": 109, "impression_count": 68809, "like_count": 484, "quote_count": 18, "reply_count": 25, "retweet_count": 56}, "text": "With SpaceX recently completing static fire tests on the ship and booster for the Starship Flight 15 mission, this week we spoke with the deputy manager of NASA's Human Landing System Program about some of SpaceX's critical milestones on the road to the Artemis 3 and 4 missions. https://t.co/uCX0IUu9Mg", "url": "https://x.com/SpaceflightNow/status/2116302668859600951"}, {"author_id": "46648807", "created_at": "2026-10-30T21:17:22.000Z", "edit_history_tweet_ids": ["2116278310095249881"], "entities": {"urls": [{"display_url": "pic.x.com/TMbAsJR5El", "end": 151, "expanded_url": "https://x.com/NIST/status/2116278310095249881/video/1", "media_key": "7_2116278223843594240", "start": 128, "url": "https://t.co/TMbAsJR5El"}]}, "id": "2116278310095249881", "public_metrics": {"bookmark_count": 1, "impression_count": 1770, "like_count": 11, "quote_count": 0, "reply_count": 1, "retweet_count": 1}, "text": "NIST is no haunted house, but our science is pretty thrilling. These are just some of the robots at NIST’s Robot Test Facility. https://t.co/TMbAsJR5El", "url": "https://x.com/NIST/status/2116278310095249881"}], "includes": {"users": [{"id": "19355829", "name": "Jonathan McDowell", "username": "planet4589"}, {"id": "610659001", "name": "Max Roser", "username": "MaxCRoser"}, {"id": "626660983", "name": "Lyman Stone 石來民 🦬🦬🦬", "username": "lymanstoneky"}, {"id": "21436960", "name": "European Space Agency", "username": "esa"}, {"id": "34743251", "name": "SpaceX", "username": "SpaceX"}, {"id": "17217640", "name": "Spaceflight Now", "username": "SpaceflightNow"}, {"id": "46648807", "name": "National Institute of Standards and Technology", "username": "NIST"}]}, "meta": {"newest_id": "2116977455160299962", "next_token": "b26v89c19zqg8o3juzly33rdrg9zl3wte3ca9m6904zgd", "oldest_id": "2116278310095249881", "result_count": 23}}
