{"data": [{"author_id": "1745106082790318080", "created_at": "2026-11-01T18:51:05.000Z", "edit_history_tweet_ids": ["2116966274060165561"], "id": "2116966274060165561", "public_metrics": {"bookmark_count": 18, "impression_count": 11614, "like_count": 47, "quote_count": 4, "reply_count": 5, "retweet_count": 5}, "text": "The Datacenter Backlash Goes Bipartisan: \nNext Week's Midterms and the 2028 Buildout\n2027 is largely locked in. 2028 is less secure:\na prolonged Texas permit freeze is now the biggest single risk to the US buildout,\nand both parties are running on tighter rules", "url": "https://x.com/SemiAnalysis_/status/2116966274060165561"}, {"author_id": "33836629", "created_at": "2026-11-01T18:14:46.000Z", "edit_history_tweet_ids": ["2116957135661945283"], "entities": {"urls": [{"description": "The YouTube videos that Hacker News keeps telling each other to watch.", "display_url": "hackertube.org", "end": 267, "expanded_url": "https://hackertube.org/", "start": 244, "status": 200, "title": "HackerTube", "unwound_url": "https://hackertube.org/", "url": "https://t.co/xULTGY6VhH"}, {"display_url": "pic.x.com/QRq80bJo4o", "end": 304, "expanded_url": "https://x.com/karpathy/status/2116957135661945283/photo/1", "media_key": "3_2116946614682263552", "start": 281, "url": "https://t.co/QRq80bJo4o"}]}, "id": "2116957135661945283", "public_metrics": {"bookmark_count": 13850, "impression_count": 881912, "like_count": 17480, "quote_count": 516, "reply_count": 846, "retweet_count": 1327}, "text": "Weekend hack: HackerTube. I was annoyed with YouTube's recommendations so I had Claude filter down 43M comments over 20 years of HN to 6,454 videos that keep being recommended. *Significantly* better viewing experience, ~2 hours with Opus 5.5:\nhttps://t.co/xULTGY6VhH\n\n- Excellent https://t.co/QRq80bJo4o", "url": "https://x.com/karpathy/status/2116957135661945283"}, {"author_id": "1745106082790318080", "created_at": "2026-11-01T17:49:49.000Z", "edit_history_tweet_ids": ["211695