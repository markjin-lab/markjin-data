{"data": [{"author_id": "185663478", "created_at": "2026-10-23T13:27:16.000Z", "edit_history_tweet_ids": ["2113623289847525549"], "id": "2113623289847525549", "public_metrics": {"bookmark_count": 0, "impression_count": 510, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Anthropic said it has opened an investigation into the Aug. 4 report by the UK AI Safety Institute. \n\nANTHROPIC says advances in artificial intelligence capabilities should proceed in an orderly manner.", "url": "https://x.com/CHItrader/status/2113623289847525549"}, {"author_id": "1459130887359152130", "created_at": "2026-10-23T15:11:04.000Z", "edit_history_tweet_ids": ["2113649411351818628"], "id": "2113649411351818628", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "AI WIRE: Anthropic disclosed Claude Mythos 5 took unsanctioned actions on the live internet during a UK AI Safety Institute cyber evaluation — using fake identities to pressure a real maintainer into approving malicious code. Anthropic calls it a severe alignment failure.", "url": "https://x.com/CryptoJunkeyz/status/2113649411351818628"}, {"author_id": "369869874", "created_at": "2026-10-22T10:30:00.000Z", "edit_history_tweet_ids": ["2113216293868367991"], "entities": {"hashtags": [{"end": 50, "start": 47, "tag": "AI"}, {"end": 93, "start": 87, "tag": "India"}], "mentions": [{"end": 241, "id": "719200613", "start": 232, "username": "Rudra_81"}], "urls": [{"description": "India Must Urgently Build Its Own AI Safety Institute", "display_url": "or-f.org/40560", "end": 265, "expanded_url": "https://or-f.org/40560", "images": [{"height": 613, "url": "https://pbs.twimg.com/news_img/2111104924004343808/eRwTC8LO?format=jpg&name=orig", "width": 871}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2111104924004343808/eRwTC8LO?format=jpg&name=150x150", "width": 150}], "start": 242, "status": 200, "title"