{"data": [{"attachments": {"media_keys": ["3_2113373882497294336"]}, "author_id": "46648807", "created_at": "2026-10-22T20:56:26.000Z", "edit_history_tweet_ids": ["2113373941444284900"], "entities": {"urls": [{"description": "Mission: SURF is designed to inspire undergraduate students to pursue careers in STEM (science, technology, engineering, and mathematics) through a unique research experience that supports the NIST mission.", "display_url": "nist.gov/surf", "end": 219, "expanded_url": "https://www.nist.gov/surf", "images": [{"height": 1152, "url": "https://pbs.twimg.com/news_img/2113373988475088896/f0YT1-3Y?format=png&name=orig", "width": 2048}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2113373988475088896/f0YT1-3Y?format=png&name=150x150", "width": 150}], "start": 196, "status": 200, "title": "Summer Undergraduate Research Fellowship (SURF)", "unwound_url": "https://www.nist.gov/surf", "url": "https://t.co/YGiYQXN9KK"}, {"display_url": "pic.x.com/OW5ztKhTZ3", "end": 243, "expanded_url": "https://x.com/NIST/status/2113373941444284900/photo/1", "media_key": "3_2113373882497294336", "start": 220, "url": "https://t.co/OW5ztKhTZ3"}]}, "id": "2113373941444284900", "public_metrics": {"bookmark_count": 4, "impression_count": 2230, "like_count": 19, "quote_count": 0, "reply_count": 1, "retweet_count": 9}, "text": "Picture yourself at NIST.  \n\nCalling all undergraduate students! We’re now accepting applications for our 2027 summer internship programs. \n\nCheck out this link for more information and to apply: https://t.co/YGiYQXN9KK https://t.co/OW5ztKhTZ3", "url": "https://x.com/NIST/status/2113373941444284900"}, {"author_id": "626660983", "created_at": "2026-10-22T20:12:49.000Z", "edit_history_tweet_ids": ["2113362961800835154"], "entities": {"urls": [{"display_url": "x.com/nayibbukele/st…", "end": 50, "expanded_url": "https://twitter.com/nayibbukele/status/2112981920741310695", "start": 27, "url": "https://t.co/U5KMivTBvq"}]}, "id": "211336296180083515