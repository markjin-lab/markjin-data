ded_url": "https://x.com/lymanstoneky/status/2119838430536331378/photo/1", "media_key": "16_2119838423343075328", "start": 0, "url": "https://t.co/m0lcl3BQQL"}, {"display_url": "x.com/Smirkley/statu…", "end": 47, "expanded_url": "https://twitter.com/Smirkley/status/2119835026036584841", "start": 24, "url": "https://t.co/T7BHUkfkD6"}]}, "id": "2119838430536331378", "public_metrics": {"bookmark_count": 0, "impression_count": 1161, "like_count": 6, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2119835026036584841", "type": "quoted"}], "text": "https://t.co/m0lcl3BQQL https://t.co/T7BHUkfkD6", "url": "https://x.com/lymanstoneky/status/2119838430536331378"}, {"author_id": "11348282", "created_at": "2026-11-09T16:45:44.000Z", "edit_history_tweet_ids": ["2119833829389041896"], "entities": {"urls": [{"display_url": "pic.x.com/C5d5Z0imPm", "end": 114, "expanded_url": "https://x.com/NASA/status/2119833829389041896/video/1", "media_key": "13_2119833138889158657", "start": 91, "url": "https://t.co/C5d5Z0imPm"}]}, "id": "2119833829389041896", "public_metrics": {"bookmark_count": 71, "impression_count": 329687, "like_count": 1130, "quote_count": 12, "reply_count": 55, "retweet_count": 186}, "text": "The weekend ends. The mission keeps going.\n\nThis is what American ambition looks like. 🇺🇸🚀 https://t.co/C5d5Z0imPm", "url": "https://x.com/NASA/status/2119833829389041896"}, {"author_id": "626660983", "created_at": "2026-11-09T16:40:55.000Z", "edit_history_tweet_ids": ["2119832618313121799"], "entities": {"urls": [{"display_url": "x.com/RichardHanania…", "end": 56, "expanded_url": "https://twitter.com/RichardHanania/status/2119828294090760686", "start": 33, "url": "https://t.co/6YjA3NGpKk"}]}, "id": "2119832618313121799", "public_metrics": {"bookmark_count": 5, "impression_count": 1991, "like_count": 32, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2119828294090760686", "type": "quoted"}], "text": "human tastes.... aren't fake.... https://t.co/6YjA3NGpKk", "url": "https://x.com/lymanstoneky/status/2119832618313121799"}, {"author_id": "626660983", "created_at": "2026-11-09T16:33:40.000Z", "edit_history_tweet_ids": ["2119830793279197612"], "entities": {"urls": [{"description": "(3) You became an orphan suddenly before the day of our wedding, when both your parents were murdered together in the solitude of the countryside. It was mainly due to your efforts that the death of your parents was not left unavenged. For I had left for Macedonia, and your sister's husband Cluvius had gone to the Province of Africa. (7) So strenuously did you perform your filial duty by your insistent demands and your pursuit of justice that we could not have done more if we had been present. But these", "display_url": "droitromain.univ-grenoble-alpes.fr/Anglica/Laudat…", "end": 279, "expanded_url": "https://droitromain.univ-grenoble-alpes.fr/Anglica/Laudatio_Turiae_Wistrand.htm", "start": 256, "status": 200, "title": "Laudatio funebris quae dicitur Turiae ( English translation )", "unwound_url": "https://droitromain.univ-grenoble-alpes.fr/Anglica/Laudatio_Turiae_Wistrand.htm", "url": "https://t.co/VuN43SK3Rd"}, {"display_url": "x.com/CarterSkeel/st…", "end": 303, "expanded_url": "https://twitter.com/CarterSkeel/status/2119803446412878094", "start": 280, "url": "https://t.co/0NWPRIv2ED"}]}, "id": "2119830793279197612", "public_metrics": {"bookmark_count": 211, "impression_count": 15128, "like_count": 606, "quote_count": 5, "reply_count": 6, "retweet_count": 44}, "referenced_tweets": [{"id": "2119803446412878094", "type": "quoted"}], "text": "The single longest Roman inscription EVER discovered is a 2000+ word INCREDIBLE wifeguy inscription honoring his (objectively incredible) wife. It includes detailed descriptions of her being revenged on her parent's killers and getting into street brawls.\nhttps://t.co/VuN43SK3Rd https://t.co/0NWPRIv2ED", "url": "https://x.com/lymanstoneky/status/2119830793279197612"}, {"author_id": "626660983", "created_at": "2026-11-09T16:29:56.000Z", "edit_history_tweet_ids": ["2119829855227285731"], "entities": {"urls": [{"display_url": "x.com/davidroodman/s…", "end": 141, "expanded_url": "https://twitter.com/davidroodman/status/2119798307509944500", "start": 118, "url": "https://t.co/jJm6myoRUx"}]}, "id": "2119829855227285731", "public_metrics": {"bookmark_count": 2, "impression_count": 1985, "like_count": 13, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2119798307509944500", "type": "quoted"}], "text": "I wrote about this on my Substack last month-- I refer to it as Foomsday, the day population was supposed to go foom. https://t.co/jJm6myoRUx", "url": "https://x.com/lymanstoneky/status/2119829855227285731"}, {"author_id": "626660983", "created_at": "2026-11-09T16:29:09.000Z", "edit_history_tweet_ids": ["2119829659109953756"], "entities": {"urls": [{"display_url": "x.com/dwallacewells/…", "end": 289, "expanded_url": "https://twitter.com/dwallacewells/status/2119607889103142974", "start": 266, "url": "https://t.co/JFxbYdvhvq"}]}, "id": "2119829659109953756", "public_metrics": {"bookmark_count": 5, "impression_count": 2246, "like_count": 76, "quote_count": 0, "reply_count": 3, "retweet_count": 7}, "referenced_tweets": [{"id": "2119607889103142974", "type": "quoted"}], "text": "i actually agree that infidelity was not the worst thing jensen huang did\n\nshilling for the ccp's policies and trying to extort the republic into changing foreign policy to fit his company's, and the ccp's, bottom line was, in fact, the worst thing jensen huang did https://t.co/JFxbYdvhvq", "url": "https://x.com/lymanstoneky/status/2119829659109953756"}, {"author_id": "626660983", "created_at": "2026-11-09T15:00:01.000Z", "edit_history_tweet_ids": ["2119807227473326349"], "entities": {"urls": [{"display_url": "x.com/SCHIZO_FREQ/st…", "end": 174, "expanded_url": "https://twitter.com/SCHIZO_FREQ/status/2119779258