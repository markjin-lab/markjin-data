[{"end": 280, "id": "61559439", "start": 273, "username": "nvidia"}], "urls": [{"display_url": "pic.x.com/sZsNRGlYpW", "end": 304, "expanded_url": "https://x.com/elerianm/status/2119837930050986340/photo/1", "media_key": "3_2119837927018532864", "start": 281, "url": "https://t.co/sZsNRGlYpW"}, {"display_url": "pic.x.com/sZsNRGlYpW", "end": 304, "expanded_url": "https://x.com/elerianm/status/2119837930050986340/photo/1", "media_key": "3_2119837927010172929", "start": 281, "url": "https://t.co/sZsNRGlYpW"}]}, "id": "2119837930050986340", "public_metrics": {"bookmark_count": 8, "impression_count": 27576, "like_count": 192, "quote_count": 6, "reply_count": 35, "retweet_count": 26}, "text": "Given Nvidia’s role in tech, this combination (Nasdaq up 2.4% and Nvidia down 5.8%) seemed highly unlikely before today.\nIt signals strong dip-buying investor appetite across the sector, coupled with market optimism that Nvidia’s issues remain contained.\n#economy #markets @nvidia https://t.co/sZsNRGlYpW", "url": "https://x.com/elerianm/status/2119837930050986340"}, {"author_id": "612896910", "created_at": "2026-11-09T16:33:26.000Z", "edit_history_tweet_ids": ["2119830736979239286"], "entities": {"hashtags": [{"end": 92, "start": 84, "tag": "BLSData"}], "urls": [{"description": "The .gov means it's official. Federal government websites often end in .gov or .mil. Before sharing sensitive information, make sure you're on a federal government site. The site is secure. The https:// ensures that you are connecting to the official website and that any information you provide is encrypted and transmitted securely. Doctor’s appointments (for ourselves, our family, and our pets), school functions, errands—occasionally workers need to take an hour or two off during work hours. Whatever", "display_url": "bls.gov/opub/ted/2026/…", "end": 116, "expanded_url": "https://www.bls.gov/opub/ted/2026/ease-of-taking-time-off-during-the-workday-varied-by-sex-and-educational-attainment.htm", "images": [{"