{"data": [{"author_id": "3407436940", "created_at": "2026-11-09T21:05:13.000Z", "edit_history_tweet_ids": ["2119899132152123836"], "entities": {"urls": [{"description": "Key PointsPrime editing enables immunosuppression-resistant genetic, antigen-specific, and CAR T-cell therapies.Edited T cells are controllable in vivo usi", "display_url": "ow.ly/ay1h5104eE3", "end": 275, "expanded_url": "https://ow.ly/ay1h5104eE3", "images": [{"height": 685, "url": "https://pbs.twimg.com/news_img/2118530755878080512/BpZ_qk5e?format=png&name=orig", "width": 520}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2118530755878080512/BpZ_qk5e?format=png&name=150x150", "width": 150}], "start": 252, "status": 200, "title": "Prime editing enables drug-controllable T-cell therapies with clinical immunosuppression", "unwound_url": "https://ashpublications.org/blood/article/148/19/2354/569935/Prime-editing-enables-drug-controllable-T-cell?utm_source=twitter&utm_campaign=2026_qiti&utm_medium=organic_social", "url": "https://t.co/DkkEfFLzBr"}, {"display_url": "pic.x.com/tz7AwH8qBr", "end": 299, "expanded_url": "https://x.com/BloodPortfolio/status/2119899132152123836/photo/1", "media_key": "3_2119899130130485248", "start": 276, "url": "https://t.co/tz7AwH8qBr"}]}, "id": "2119899132152123836", "public_metrics": {"bookmark_count": 0, "impression_count": 279, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "text": "Prime editing enables immunosuppression-resistant genetic, antigen-specific, and CAR T-cell therapies. Edited T cells are controllable in vivo using common immunosuppressants with minimal perturbation of T-cell biology. Read the full article in Blood: https://t.co/DkkEfFLzBr https://t.co/tz7AwH8qBr", "url": "https://x.com/BloodPortfolio/status/2119899132152123836"}, {"author_id": "218673086", "created_at": "2026-11-09T21:19:59.000Z", "edit_history_tweet_ids": ["2119902846854582725"], "entities": {"urls": [{"display_url": "pic.x.com/LclIe12B7h", "end": 282, "expanded_url": "https://x.com/CELLECTA/status/2119902846854582725/photo/1", "media_key": "3_2119902827875344384", "start": 259, "url": "https://t.co/LclIe12B7h"}]}, "id": "2119902846854582725", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Planning a CRISPR screen? Start with the response you want to measure. \n\nCellecta supports targeted and genome-wide screens with viability and FACS-based selection options. Explore how the cell model, perturbation, and readout can fit your research question. https://t.co/LclIe12B7h", "url": "https://x.com/CELLECTA/status/2119902846854582725"}, {"author_id": "818008252814217217", "created_at": "2026-11-09T21:43:05.000Z", "edit_history_tweet_ids": ["2119908660575134020"], "entities": {"urls": [{"description": "AbstractMotivation. Current CRISPR guide RNA design tools rely on reference genomes, overlooking how genetic variation impacts editing outcomes. As genome", "display_url": "doi.org/10.1093/bioinf…", "end": 191, "expanded_url": "https://doi.org/10.1093/bioinformatics/btag708", "images": [{"height": 577, "url": "https://pbs.twimg.com/news_img/2119908667747336192/RywZhd8i?format=jpg&name=orig", "width": 520}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2119908667747336192/RywZhd8i?format=jpg&name=150x150", "width": 150}], "start": 168, "status": 200, "title": "CRISPR-HAWK: haplotype- and variant-aware guide design toolkit for CRISPR-Cas", "unwound_url": "https://academic.oup.com/bioinformatics/article/42/10/btag708/8916269", "url": "https://t.co/CaSXkGFr4l"}, {"display_url": "pic.x.com/vXn8DOsv2h", "end": 215, "expanded_url": "https://x.com/ScienceCrisp/status/2119908660575134020/photo/1", "media_key": "3_2119908543637950464", "start": 192, "url": "https://t.co/vXn8DOsv2h"}]}, "id": "2119908660575134020", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "CRISPR-HAWK: haplotype- and variant-aware guide design toolkit for CRISPR-Cas.\nBioiformatics. 2026 Oct 2;42(10):btag708.\nKumbara A, Tognon M [ ..] Giugno R, Pinello L.\nhttps://t.co/CaSXkGFr4l https://t.co/vXn8DOsv2h", "url": "https://x.com/ScienceCrisp/status/2119908660575134020"}, {"author_id": "2557183916", "created_at": "2026-11-09T20:52:04.000Z", "edit_history_tweet_ids": ["2119895821739339918"], "entities": {"urls": [{"display_url": "pic.x.com/Uwu4hxMaXh", "end": 285, "expanded_url": "https://x.com/Tran_KVT/status/2119895821739339918/photo/1", "media_key": "3_2119895817653825536", "start": 262, "url": "https://t.co/Uwu4hxMaXh"}, {"display_url": "pic.x.com/Uwu4hxMaXh", "end": 285, "expanded_url": "https://x.com/Tran_KVT/status/2119895821739339918/photo/1", "media_key": "3_2119895817691508736", "start": 262, "url": "https://t.co/Uwu4hxMaXh"}]}, "id": "2119895821739339918", "public_metrics": {"bookmark_count": 0, "impression_count": 18, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Phase 1b data for CTX310: a single infusion of CRISPR-Cas9 targeting ANGPTL3 ⬇️ triglycerides 63% and ApoB 23% at day 30 in patients with sHTG (n=10). Remarkable proof-of-concept! Excited and curious about long-term efficacy, safety, and potential off-target. 🧬 https://t.co/Uwu4hxMaXh", "url": "https://x.com/Tran_KVT/status/2119895821739339918"}, {"author_id": "1673930263", "created_at": "2026-11-09T20:55:34.000Z", "edit_history_tweet_ids": ["2119896701955649989"], "id": "2119896701955649989", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "CRISPR-Cas9 is one of biotechnology’s greatest breakthroughs🙌🏾 tuwale to the two female scientists 🙌🏾🙌🏾😃", "url": "https://x.com/fatima_zaya/status/2119896701955649989"}, {"author_id": "1553387762429988864", "created_at": "2026-11-09T21:53:02.000Z", "edit_history_tweet_ids": ["2119911166688268371"], "entities": {"hashtags": [{"end": 23, "start": 2, "tag": "ScientificSessions26"}, {"end": 269, "start": 263, "tag": "AHA26"}], "urls": [{"display_url": "pic.x.com/9aK8qKn0nv", "end": 293, "expanded_url": "https://x.com/BinayMd/status/2119911166688268371/photo/1", "media_key": "3_2119911162162610176", "start": 270, "url": "https://t.co/9aK8qKn0nv"}]}, "id": "2119911166688268371", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "🔴 #ScientificSessions26 | CTX310\n\nIn Phase 1b (n=10), a single CRISPR-Cas9 infusion targeting ANGPTL3 reduced at Day 30:\n\n✅ Triglycerides ↓63%\n✅ ANGPTL3 ↓65%\n✅ Non-HDL-C ↓51%\n\nNo treatment-related serious adverse events.\n\nPromising results, ? long-term outcomes. #AHA26 https://t.co/9aK8qKn0nv", "url": "https://x.com/BinayMd/status/2119911166688268371"}, {"author_id": "818008252814217217", "created_at": "2026-11-09T21:49:11.000Z", "edit_history_tweet_ids": ["2119910194994163905"], "entities": {"urls": [{"display_url": "doi.org/10.1016/j.jgg.…", "end": 161, "expanded_url": "https://doi.org/10.1016/j.jgg.2026.10.004", "start": 138, "unwound_url": "https://www.sciencedirect.com/science/article/pii/S1673852726003267", "url": "https://t.co/JRajXBT45C"}]}, "id": "2119910194994163905", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Development and optimization of a cell cycle molecular clock based on the ABE-CRISPR system.\nJournal of Genetics and Genomics. 2026 Oct 9\nhttps://t.co/JRajXBT45C\nThe Adenine Base Editor Template Number (ATN) is a cellular “molecular clock” that links cell age to inducible genetic", "url": "https://x.com/ScienceCrisp/status/2119910194994163905"}, {"author_id": "818008252814217217", "created_at": "2026-11-09T21:43:29.000Z", "edit_history_tweet_ids": ["2119908760307241364"], "entities": {"urls": [{"description": "背　景：CRISPRガイドRNA設計における課題既存のCRISPRガイドRNA（gRNA）設計ツールはリファレンス・ゲノムに依存しているため、遺伝的変異が編集結果に与える影響を見過ごすことになります。ゲノム編集が臨床応用へと進展する中、多様な集団全体で治療効果を確実に得るため", "display_url": "crisp-bio.blog.jp/archives/40954…", "end": 133, "expanded_url": "https://crisp-bio.blog.jp/archives/40954912.html", "images": [{"height": 278, "url": "https://pbs.twimg.com/news_img/2119908761120960512/e5Ab5OZD?format=png&name=orig", "width": 240}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2119908761120960512/e5Ab5OZD?format=png&name=150x150", "width": 150}], "start": 110, "status": 200, "title": "ハプロタイプおよび変異を考慮したCRISPR-Cas用ガイドRNA設計ツールキット。 ーー個人差や多様なアレルの違いによる編集効率のばらつきを克服するための高度な設計支援 : crisp_bio", "unwound_url": "https://crisp-bio.blog.jp/archives/40954912.html", "url": "https://t.co/FwmUlM8I00"}]}, "id": "2119908760307241364", "public_metrics": {"bookmark_count": 1, "impression_count": 26, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "ハプロタイプおよび変異を考慮したCRISPR-Cas用ガイドRNA設計ツールキット。 ーー個人差や多様なアレルの違いによる編集効率のばらつきを克服するための高度な設計支援\n[Bioinformatics誌刊行論文から]\nhttps://t.co/FwmUlM8I00", "url": "https://x.com/ScienceCrisp/status/2119908760307241364"}, {"author_id": "1341779270629285888", "created_at": "2026-11-09T21:00:00.000Z", "edit_history_tweet_ids": ["2119897820194918852"], "id": "2119897820194918852", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Today's CRISPR trial at AHA was in people with very high triglycerides, so a quick guide to what that means on a lab report.\n\n1. Normal is under 150 mg/dL (1.7 mmol/L). Severe is 500 mg/dL (5.6 mmol/L) or more.\n2. Above about 1,000 mg/dL (11.3 mmol/L), the blood is usually full", "url": "https://x.com/abdlbee/status/2119897820194918852"}, {"article": {"title": "Reverse Engineering Fable 5.2: What You're Paying For, What Anthropic Held Back, and How to Use It"}, "author_id": "1755493156403990528", "created_at": "2026-11-09T21:44:06.000Z", "edit_history_tweet_ids": ["2119908918172532791"], "entities": {"urls": [{"display_url": "x.com/i/article/2119…", "end": 23, "expanded_url": "https://x.com/i/article/2119900524246122496", "start": 0, "status": 404, "unwound_url": "https://x.com/i/article/2119900524246122496", "url": "https://t.co/IIPeeFQTrF"}]}, "id": "2119908918172532791", "public_metrics": {"bookmark_count": 7, "impression_count": 244, "like_count": 9, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "https://t.co/IIPeeFQTrF", "url": "https://x.com/anstapnever/status/2119908918172532791"}], "includes": {"users": [{"id": "3407436940", "name": "Blood Journals Portfolio", "username": "BloodPortfolio"}, {"id": "218673086", "name": "Cellecta, Inc.", "username": "CELLECTA"}, {"id": "818008252814217217", "name": "CRISP_SCIENCE", "username": "ScienceCrisp"}, {"id": "2557183916", "name": "Khanh-Van T. Tran, MD PhD", "username": "Tran_KVT"}, {"id": "1673930263", "name": "Amma", "username": "fatima_zaya"}, {"id": "1553387762429988864", "name": "Binay Panjiyar MD GCSRT SOCI", "username": "BinayMd"}, {"id": "1341779270629285888", "name": "Dr Abdulbasit Sadiq", "username": "abdlbee"}, {"id": "1755493156403990528", "name": "anstap", "username": "anstapnever"}]}, "meta": {"newest_id": "2119911166688268371", "next_token": "b26v89c19zqg8o3juzlzcxe5uxzo3y5ac1advv5y4cfwd", "oldest_id": "2119895821739339918", "result_count": 10}}
