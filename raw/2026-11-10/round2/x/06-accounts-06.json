{"data": [{"author_id": "84679163", "created_at": "2026-11-09T21:45:08.000Z", "edit_history_tweet_ids": ["2119909175585042674"], "entities": {"urls": [{"display_url": "iea.li/4ktuZUX", "end": 283, "expanded_url": "https://iea.li/4ktuZUX", "start": 260, "status": 403, "unwound_url": "https://www.iea.org/events/summit-on-clean-cooking-in-africa-2?utm_content=buffer546d0&utm_medium=social&utm_source=twitter.com&utm_campaign=buffer", "url": "https://t.co/qnLCjY0eI4"}, {"display_url": "pic.x.com/OCYUYd3XV1", "end": 307, "expanded_url": "https://x.com/IEA/status/2119909175585042674/photo/1", "media_key": "3_2119909173072740352", "start": 284, "url": "https://t.co/OCYUYd3XV1"}]}, "id": "2119909175585042674", "public_metrics": {"bookmark_count": 0, "impression_count": 910, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 2}, "text": "Nearly 1 billion people across Africa still lack access to clean cooking solutions today.\n \nThe 2nd Summit on Clean Cooking in Africa, taking place on 27-28 Jan, will drive concrete action towards closing this gap &amp; expanding access across the continent 👉 https://t.co/qnLCjY0eI4 https://t.co/OCYUYd3XV1", "url": "https://x.com/IEA/status/2119909175585042674"}, {"author_id": "325581008", "created_at": "2026-11-09T21:38:24.000Z", "edit_history_tweet_ids": ["2119907482164146216"], "entities": {"mentions": [{"end": 189, "id": "3388125610", "start": 174, "username": "xenergynuclear"}, {"end": 223, "id": "235190657", "start": 214, "username": "RepChuck"}, {"end": 241, "id": "1039879658400112640", "start": 225, "username": "RepMichaelCloud"}, {"end": 264, "id": "1874580463752196096", "start": 248, "username": "RepAprilDelaney"}], "urls": [{"display_url": "pic.x.com/THRpxz6rJp", "end": 304, "expanded_url": "https://x.com/NRCgov/status/2119907482164146216/photo/1", "media_key": "3_2119907449238933504", "start": 281, "url": "https://t.co/THRpxz6rJp"}]}, "id": "2119907482164146216", "public_metrics": {"bookmark_count": 1, "impres