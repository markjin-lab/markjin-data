3800356092"},{"attachments":{"media_keys":["3_2111090703451213824"]},"author_id":"17217640","created_at":"2026-10-16T13:44:01.000Z","edit_history_tweet_ids":["2111090790781100055"],"id":"2111090790781100055","public_metrics":{"bookmark_count":1,"impression_count":5599,"like_count":71,"quote_count":1,"reply_count":5,"retweet_count":9},"text":"While Blue Origin continues its recovery work at Launch Complex 36A following the explosion in May, it's making multiple infrastructure investments to greatly increase launch cadence following their return to flight with New Glenn.\n\n📰: https://t.co/XjIgEwyUNq https://t.co/3JATKNgBYP","url":"https://x.com/SpaceflightNow/status/2111090790781100055"},{"author_id":"6374602","created_at":"2026-10-16T13:25:43.000Z","edit_history_tweet_ids":["2111086187016331394"],"id":"2111086187016331394","public_metrics":{"bookmark_count":0,"impression_count":2442,"like_count":14,"quote_count":0,"reply_count":0,"retweet_count":3},"referenced_tweets":[{"id":"2111064691980087375","type":"quoted"}],"text":"Among the donors listed in the documents: Charlie Ergen of Dish Network/EchoStar ($25M), Lockheed Martin ($10M) and commercial space station developer Vast ($1M). https://t.co/0B84wqdGEC","url":"https://x.com/jeff_foust/status/2111086187016331394"},{"attachments":{"media_keys":["3_2111072607173009408"]},"author_id":"34743251","created_at":"2026-10-16T12:32:07.000Z","edit_history_tweet_ids":["2111072697690317011"],"id":"2111072697690317011","public_metrics":{"bookmark_count":299,"impression_count":593924,"like_count":6211,"quote_count":89,"reply_count":202,"retweet_count":647},"text":"We will post our Q3 2026 financial and operational results on October 20, 2026. We will host a live audio-only webcast at 3:30 p.m. CT the same day → https://t.co/PqK9HnyGyw https://t.co/dls3x7s5uq","url":"https://x.com/SpaceX/status/2111072697690317011"},{"author_id":"19355829","created_at":"2026-10-16T06:16:09.000Z","edit_history_tweet_ids":["2110978080038912310"],"i