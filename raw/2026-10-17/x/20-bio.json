&name=orig","width":1536},{"height":150,"url":"https://pbs.twimg.com/news_img/2110504748961169408/ULHvHg87?format=jpg&name=150x150","width":150}],"start":77,"status":200,"title":"NeoMD | Prime Editing Repairs Genetic Defect in Blood Stem Cells for Immune Disorder","unwound_url":"https://neomd.org/story/prime-editing-repairs-genetic-defect-in-blood-stem-cells-for-immune-disorder-40e3b0","url":"https://t.co/l1C69YuxMs"}]},"id":"2110504741629481302","public_metrics":{"bookmark_count":0,"impression_count":4,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"Prime Editing Repairs Genetic Defect in Blood Stem Cells for Immune Disorder https://t.co/l1C69YuxMs","url":"https://x.com/NeoMDorg/status/2110504741629481302"},{"author_id":"129518539","created_at":"2026-10-16T02:26:09.000Z","edit_history_tweet_ids":["2110920199218266611"],"entities":{"urls":[{"description":"Phenylketonuria (PKU) is a monogenic metabolic disorder caused by mutations in the phenylalanine hydroxylase (PAH) gene, the most common of which is c.1222C>T (p.R408W). Current treatment options, including dietary restriction and enzyme substitution, can be effective but are often challenging for patients to maintain and do not address the underlying genetic defect. Gene editing represents a compelling one-time treatment approach for PKU. Herein, we demonstrate mRNA:LNP-mediated delivery of prime editors that enable therapeutically-relevant levels of correction of the R408W mutation in both in vitro and in vivo model systems. Further, we found that co-delivery of the DNA repair modulator RAD18 and engineering of the prime editor protein, enabled 2-fold and 3-fold increases in prime editing relative to PE3 respectively, resulting in ~50% correction efficiency in a humanized PKU mouse model. Collectively, this work identifies novel potential approaches to enhancing prime editing and est","display_url":"biorxiv.org/content/10.648…","end":63,"expanded_url":"https://www.biorxiv.org/content/10.64898/2026.10.06.753751v1","images":[{"height":252,"url":"https://pbs.twimg.com/news_img/2110763086214828032/Jy8yStid?format=png&name=orig","width":252},{"height":150,"url":"https://pbs.twimg.com/news_img/2110763086214828032/Jy8yStid?format=png&name=150x150","width":150}],"start":40,"status":200,"title":"LNP Delivery of Prime Editors Enables Durable Correction of PAH R408W in Phenylketonuria Models","unwound_url":"https://www.biorxiv.org/content/10.64898/2026.10.06.753751v1","url":"https://t.co/8VUP3XwmsH"}]},"id":"2110920199218266611","public_metrics":{"bookmark_count":0,"impression_count":94,"like_count":0,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"PRME の Prime Editing 技術が前臨床データで話題なのかな。\n\nhttps://t.co/8VUP3XwmsH","url":"https://x.com/libersrocks/status/2110920199218266611"},{"attachments":{"media_keys":["3_2110805480318685184","3_2110805715451363328"]},"author_id":"30820266","created_at":"2026-10-15T18:51:30.000Z","edit_history_tweet_ids":["2110805783458074861"],"entities":{"cashtags":[{"end":5,"start":0,"tag":"PRME"},{"end":11,"start":6,"tag":"mrna"}],"mentions":[{"end":112,"id":"752940576631250944","start":99,"username":"alamentarius"}],"urls":[{"display_url":"pic.x.com/mYfUmqiREv","end":136,"expanded_url":"https://x.com/srqstockpicker/status/2110805783458074861/photo/1","media_key":"3_2110805480318685184","start":113,"url":"https://t.co/mYfUmqiREv"},{"display_url":"pic.x.com/mYfUmqiREv","end":136,"expanded_url":"https://x.com/srqstockpicker/status/2110805783458074861/photo/1","media_key":"3_2110805715451363328","start":113,"url":"https://t.co/mYfUmqiREv"},{"display_url":"x.com/alamentarius/s…","end":160,"expanded_url":"https://twitter.com/alamentarius/status/2110799882625937670","start":137,"url":"https://t.co/gFCZyKMeqB"}]},"id":"2110805783458074861","public_metrics":{"bookmark_count":1,"impression_count":1358,"like_count":18,"quote_count":0,"reply_count":0,"retweet_count":0},"text":"$PRME $mrna big tell here that Moderna called their research